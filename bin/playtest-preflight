#!/usr/bin/env node
//
// Make a play-test round dispatchable, and say so — or exit non-zero and say why.
//
//   bin/playtest-preflight <Game>              one game
//   bin/playtest-preflight --all               every game .mcp.json registers
//   bin/playtest-preflight <Game> --headless   dispatch the round through `claude -p`
//
// This is the front door. `.claude/skills/playtest/SKILL.md` is the operator's
// manual and `.claude/workflows/playtest.js` is the round itself; this is the one
// command that has to run before either means anything.
//
// **Why it exists.** A round fails at `ToolSearch` for every tester when the game's
// MCP server did not connect, and the two ways that happens were both prose
// warnings nobody read at dispatch time. Rounds died before a tester typed a
// command, and the reports said "I don't know how to use MCP" — which is what an
// agent says when `ToolSearch` returns nothing and its prompt has no branch for it.
//
// **What it can check that nothing else can.** It speaks JSON-RPC at
// `bin/gnusto-mcp` over a pipe, so it never asks the session's MCP client anything.
// That is the whole point: when registration has already failed, the client is
// exactly the wrong thing to ask. `node .claude/workflows/playtest.dryrun.mjs` is
// the other half of the pre-dispatch check and covers the orchestration; between
// them, SKILL.md's "two things it cannot tell you" are both told.
//
// It also automates the staleness ritual SKILL.md used to ask an operator to
// perform by hand — open a session, finish it, read four field names off the
// result — because a check performed from memory is a check that gets skipped.

'use strict'

const { spawn, spawnSync } = require('node:child_process')
const fs = require('node:fs')
const path = require('node:path')

// What the game's focus file declares — the coverage split and the sighted-only
// half of it — plus the committed deep starts a round hands out, which are read
// here and cut by `bin/playtest-routes`: one store, two readers, and neither with a
// list of its own.
const {
  ROOT, SCRATCH, GREEN, RED, DIM, OFF,
  gameDoc, focusParts, seedFor, routesDir, routeManifests, usableRoutes, routeSeeds,
  describePackage, executableProducts, resolveGame, ledgerScan,
} = require('./lib/playtest-focus')

process.chdir(ROOT)

const REPLAY_TREE = path.join(SCRATCH, '.replays')
const ARGS_OUT = '.context/playtest-round-args.json'

// Every tool the session server declares. A server listing fewer is older than the
// harness about to drive it, and the round would fail at whichever call reached the
// gap first rather than here.
const EXPECTED_TOOLS = [
  'survey', 'vocabulary', 'resolve', 'open', 'move', 'recall', 'coverage',
  'note', 'checkpoint', 'restore', 'rewind', 'finish', 'export', 'replay',
]

// What a current `finish` folds into closing.json. Each is a number some later
// phase reports, so a server predating any of them makes the round's coverage
// arithmetic silently wrong rather than absent — the worse failure, and the reason
// this is checked rather than assumed.
const CLOSING_FIELDS = [
  'roomsVisited', 'roomsWorked', 'unknownWords', 'firedTimers', 'prefixTurns',
]

const sh = (cmd, args, opts = {}) =>
  spawnSync(cmd, args, { encoding: 'utf8', cwd: ROOT, ...opts })

const exists = fs.existsSync

const readJSON = (p, fallback = null) => {
  try { return JSON.parse(fs.readFileSync(p, 'utf8')) } catch { return fallback }
}

const rmrf = (p) => fs.rmSync(p, { recursive: true, force: true })

// ---------------------------------------------------------------------------
// One conversation with one server
// ---------------------------------------------------------------------------

// The calls have to share a process: `finish` names the session `open` returned,
// and a session lives in the server that created it. So this is a live connection
// with an awaitable `call`, not a batch of frames fired at a pipe — the first
// draft of this script batched them, and asked a second server to finish a session
// it had never opened.
class Server {
  constructor(game) {
    this.proc = spawn('bin/gnusto-mcp', [game], { cwd: ROOT, stdio: ['pipe', 'pipe', 'pipe'] })
    this.pending = new Map()
    this.stderr = ''
    this.buf = ''
    this.nextId = 1
    this.dead = null

    this.proc.stderr.on('data', (d) => { this.stderr += d })
    this.proc.on('error', (e) => this.die(e.message))
    this.proc.on('exit', (code) => this.die(`server exited (${code})`))
    this.proc.stdout.on('data', (d) => {
      this.buf += d
      let i
      while ((i = this.buf.indexOf('\n')) >= 0) {
        const line = this.buf.slice(0, i)
        this.buf = this.buf.slice(i + 1)
        if (!line.trim()) continue
        let msg
        try { msg = JSON.parse(line) } catch { continue }
        const waiter = this.pending.get(msg.id)
        if (waiter) { this.pending.delete(msg.id); waiter.resolve(msg) }
      }
    })
  }

  die(reason) {
    if (this.dead) return
    this.dead = reason
    for (const w of this.pending.values()) w.resolve({ error: { message: reason } })
    this.pending.clear()
  }

  send(method, params, timeoutMs = 240000) {
    if (this.dead) return Promise.resolve({ error: { message: this.dead } })
    const id = this.nextId++
    return new Promise((resolve) => {
      const timer = setTimeout(
        () => { this.pending.delete(id); resolve({ error: { message: `timed out after ${timeoutMs / 1000}s` } }) },
        timeoutMs
      )
      this.pending.set(id, { resolve: (m) => { clearTimeout(timer); resolve(m) } })
      this.proc.stdin.write(JSON.stringify({ jsonrpc: '2.0', id, method, params }) + '\n')
    })
  }

  handshake() {
    return this.send('initialize', {
      protocolVersion: '2024-11-05',
      capabilities: {},
      clientInfo: { name: 'playtest-preflight', version: '1' },
    })
  }

  callTool(name, args) { return this.send('tools/call', { name, arguments: args }) }

  close() { try { this.proc.kill() } catch { /* already gone */ } }
}

// Where every one of these tools actually answers.
const textOf = (msg) => (msg?.result?.content || []).map((c) => c.text || '').join('\n')

// Every play-test tool answers with a JSON object encoded in that text. Parsing it
// is how `open`'s `session` is read — the first draft scraped the text with a
// regex and matched the label instead, so `finish` named a session that did not
// exist and the closing record this script exists to check was never written.
const payloadOf = (msg) => { try { return JSON.parse(textOf(msg)) } catch { return null } }

// ---------------------------------------------------------------------------
// The checks
// ---------------------------------------------------------------------------

async function checkGame(game, mcpKey) {
  const rows = []
  const add = (name, ok, detail, remedy) => rows.push({ game, name, ok, detail, remedy })
  let roster = []

  // 1. Build once, serially, holding the package lock alone. This is the step that
  //    keeps `bin/gnusto-mcp` from having to build at connect — which is what used
  //    to put seven servers in a queue for a lock, to perform seven no-ops.
  const build = sh('bin/playtest-replay', ['--build', game])
  if (build.status !== 0) {
    // The compiler's own line if there is one. swiftpm's last two lines are
    // usually "error: fatalError" and a path, which says nothing an operator can
    // act on; the line carrying `error:` is the one worth the width.
    const out = `${build.stderr || ''}\n${build.stdout || ''}`.split('\n').map((l) => l.trim())
    const detail = out.find((l) => /error:/.test(l)) || out.filter(Boolean).slice(-1)[0] || ''
    add('build', false, detail.slice(0, 100), `swift build --product ${game}`)
    return rows // nothing below could mean anything
  }
  add('build', true, path.basename(String(build.stdout).trim()))

  const label = `preflight-${game}`
  const server = new Server(game)
  let replayProbe = null
  try {
    // 2. The server answers, and declares every tool the round will call.
    const init = await server.handshake()
    if (init.error) {
      // Surface the server's own stderr, which is where the interesting half is.
      // A game whose bootstrap fails writes its diagnostic there and exits 1, and
      // the engine's diagnostics name the entity and the conflict — so reporting
      // only "server exited (1)" throws away the one line that says what to fix.
      const said = server.stderr.trim().split('\n').filter(Boolean).slice(-1)[0] || ''
      add('server', false, said ? `${init.error.message}: ${said.slice(0, 80)}` : init.error.message,
        `bin/gnusto-mcp ${game}  # run it and read its stderr in full`)
      return rows
    }
    const listed = await server.send('tools/list', {})
    const tools = (listed.result?.tools || []).map((t) => t.name)
    const missingTools = EXPECTED_TOOLS.filter((t) => !tools.includes(t))
    add('tools', missingTools.length === 0, `${tools.length} declared`,
      missingTools.length
        ? `missing ${missingTools.join(', ')} — the binary predates this harness`
        : null)

    // 3. The staleness check SKILL.md used to ask for by hand. A server frozen at
    //    an older commit answers every call successfully and writes none of this,
    //    and a round dispatched against it collates nothing and reports every
    //    session as never having finished — indistinguishable from a round where
    //    the testers all crashed.
    const opened = await server.callTool('open', { label, seed: 0 })
    const sessionId = payloadOf(opened)?.session
    if (!sessionId) {
      add('open', false, textOf(opened).split('\n')[0].slice(0, 80) || 'no session in the reply', null)
    } else {
      add('open', true, sessionId)
      // The room roster, while a session is open to ask. This is the only place in
      // the whole pre-dispatch path where it is available: the dry run has no game
      // binary, so its firewall check runs against a fixture and proves the check
      // exists rather than that this game's focus file passes it. See the `focus`
      // row below, which is the half only this script can perform.
      //
      // Asked only when there is a focus file to check it against. Five of the seven
      // games this package builds declare no split, and `--all` would otherwise pull
      // five whole surveys across the wire for nobody to read.
      if (gameDoc(game, '-playtest-focus')) {
        roster = payloadOf(await server.callTool('survey', { session: sessionId }))?.rooms || []
      }
      await server.callTool('finish', { session: sessionId, summary: 'preflight staleness check' })
    }

    // Read the fields off disk rather than off the reply: the file is what the
    // collator globs, so the file existing is the thing worth proving.
    const closingFile = findFile(path.join(SCRATCH, label), 'closing.json')
    const closing = closingFile ? readJSON(closingFile, {}) : null
    const missingFields = closing ? CLOSING_FIELDS.filter((f) => !(f in closing)) : CLOSING_FIELDS
    add('closing.json', !!closing && missingFields.length === 0,
      closing
        ? `${CLOSING_FIELDS.length - missingFields.length}/${CLOSING_FIELDS.length} fields`
        : 'not written',
      missingFields.length
        ? 'stale server — restart the session so it re-execs at this commit'
        : null)

    // 4. The other half, because the round's turn count depends on it: a server
    //    predating the sessionless replay tool writes nothing under `.replays/`,
    //    and the collator's glob comes back empty — which reads as verifiers who
    //    checked nothing rather than as a stale binary.
    //
    //    `.replays` is the ONE tree every sessionless replay in the checkout
    //    writes to (`PlaytestSessions.replayLabel`), so it is shared with every
    //    round this checkout has ever run. Two consequences, and the first draft
    //    got both wrong. Asking `exists(REPLAY_TREE)` is satisfied by any probe
    //    any previous round left, so a stale server passed the check on somebody
    //    else's evidence. And cleaning up by removing the tree deleted that
    //    evidence — it ran once against a finished round and destroyed the 29
    //    probes its report cited, which is the opposite of the invariant CLAUDE.md
    //    states, that `.context/playtest/` may hold every round the checkout ever
    //    ran. So: name the probe this call wrote, prove *it* appeared, and remove
    //    only that one.
    const before = new Set(probeDirsIn(REPLAY_TREE))
    const replayed = await server.callTool('replay', { commands: ['look'] })
    const replayText = textOf(replayed)
    replayProbe = probeDirsIn(REPLAY_TREE).find((d) => !before.has(d)) || null
    add('replay', !!replayProbe && /lines=/.test(replayText),
      replayProbe ? (replayText.split('\n')[0] || '').slice(0, 60) : 'wrote no probe directory',
      replayProbe ? null : 'server predates the replay tool — restart the session')
  } finally {
    server.close()
    rmrf(path.join(SCRATCH, label))
    // Only this call's own probe. Never the tree.
    if (replayProbe) rmrf(replayProbe)
  }

  // 5. The convention `playtest.js` falls back on when nothing hands it a key,
  //    checked rather than trusted. Get this wrong and every tester fails
  //    identically, with no diagnostic anywhere.
  const enabled = (readJSON('.claude/settings.json', {}) || {}).enabledMcpjsonServers || []
  add('mcp key', !!mcpKey && enabled.includes(mcpKey),
    mcpKey ? `${mcpKey}${enabled.includes(mcpKey) ? '' : ' — registered but not enabled'}` : 'no .mcp.json entry',
    !mcpKey
      ? `add a .mcp.json server whose args are ["${game}"]`
      : (enabled.includes(mcpKey) ? null : `add "${mcpKey}" to enabledMcpjsonServers`))

  // 6. What the ledger can actually hand over. A dedupe set that silently holds
  //    nothing looks exactly like a game nothing has ever been refuted about, and
  //    three ledgers spent their whole lives in that state: Gramarye, KindlyDeep
  //    and Lighthouse recorded every key in the abbreviated *display* form,
  //    ellipsis and all, and `normalize()` emits nothing but `[a-z0-9 ]`, so not
  //    one of them could ever equal a key a round produced. The rounds went on
  //    re-finding and re-refuting the same symptoms, and the only signal was a
  //    `ledgerKeys 0` in a line of dim text at the bottom of this script.
  //
  //    So the count is a check and not a note, the same shape the `routes` row
  //    uses. The inert count rides along even when the row is green, because two
  //    ledgers still carry abbreviated rows beside working ones and a number in
  //    the detail column is how that stops being invisible.
  const ledgerPath = gameDoc(game, '-playtest-ledger')
  if (ledgerPath) {
    // A game with no ledger has nothing to be wrong about, so it gets no row.
    const ledger = ledgerScan(ledgerPath)
    add('ledger', ledger.ok, `${ledger.keys.length} usable${ledger.inert ? `, ${ledger.inert} inert` : ''}`,
      ledger.ok
        ? null
        : `${ledgerPath} stores every refutation abbreviated`
          + ' — re-key them as `decl::<file>::<declaration>`')
  }

  rows.push(...routesRows(game))
  rows.push(...focusRows(game, roster))
  return rows
}

// The deep starts this game ships, checked as files rather than as replays.
//
// A deep start that cannot be handed out is a round dispatched to the wrong end of
// the map, and neither way it happens is visible without opening the files. A route
// that will not parse, or declares no landing, is one `open` refuses or replays
// unchecked. And the seeds have to agree: `open` refuses a session whose seed is not
// the route's, a round pins ONE seed for every seat, and `seedFor` derives that seed
// from these same manifests — so this row is what stops it being derived from a
// disagreement.
//
// Deliberately *not* checked: whether a route still lands where it claims. That is
// `bin/playtest-routes verify`, which replays every one of them. A front door costing
// four thousand turns stops being run.
function routesRows(game) {
  const routes = routeManifests(game)
  // A game with no routes needs nothing: `.playtest/` starts empty, testers play
  // cold, and the round's own output is the next round's deep starts.
  if (!routes.length) return []

  const usable = new Set(usableRoutes(game))
  const broken = routes.filter((r) => !usable.has(r.name)).map((r) => r.name)
  const seeds = routeSeeds(game)
  const ok = !broken.length && seeds.length === 1
  return [{
    game,
    name: 'routes',
    ok,
    detail: `${routes.length} in ${routesDir(game)} `
      + (seeds.length === 1 ? `at seed ${seeds[0]}` : `across seeds ${seeds.join(', ') || '(none)'}`),
    remedy: ok
      ? null
      : (broken.length
        ? `bin/playtest-routes ${game} list   # ${broken.join(', ')}: no seed, no commands, or no landing`
        : `the round pins one seed and \`open\` refuses any other — re-cut whichever is the odd one out`),
  }]
}

// ---------------------------------------------------------------------------
// What the focus file promises, checked against what is actually there
// ---------------------------------------------------------------------------

// A check only this script can perform, and a failure that
// used to be invisible at dispatch time.
//
// *The rooms.* A region between the two `---` rules is pasted verbatim into a blind
// explorer's prompt, and the room roster is the answer key that charter exists to
// reconstruct. `playtest.dryrun.mjs` asserts the property, but against its own
// fixture — it has no game binary and so no roster to check a real file against. The
// 2026-08-25 Dungeon operator did this by hand, against 129 display names, and wrote
// in the report that it had been done. A check performed from memory is a check that
// gets skipped.
function focusRows(game, roster) {
  const rows = []
  const add = (name, ok, detail, remedy) => rows.push({ game, name, ok, detail, remedy })
  const focusPath = gameDoc(game, '-playtest-focus')
  if (!focusPath) return rows // a game small enough to need no split declares nothing

  const { blind } = focusParts(focusPath)
  // Whole names and whole ids, the same rule the dry run uses: it catches the
  // copy-paste version of breaking the firewall and not an operator who writes
  // "Landing" for "Upstairs Landing". The rule stays a person's to keep.
  const leaks = [...new Set(roster.flatMap((r) => [r.name, r.id]))]
    .filter((word) => word && blind.includes(word))
  // A roster arrives only if the session above opened. Reporting green on an empty
  // one would let the check that exists *because* the manual version got skipped be
  // skipped itself, silently, in the run where the server was broken.
  // *The routes.* A region tells its tester which deep start to open with, and the
  // name is now free text where it used to be a declaration a script parsed — the
  // slot machinery read `` `d-1` (cut at `route[0:113]`) `` out of these sentences and
  // failed loudly on one that would not parse. Losing that parse lost the check with
  // it, and a renamed or mistyped route now reaches a live tester and dies at `open`,
  // which is the class of failure "green means dispatchable" exists to move earlier.
  //
  // Both halves are scanned: the sighted addendum names routes too.
  //
  // **The shape is the convention and the check fails open.** A backticked token is a
  // route reference when it reads `<letters>-<digits>`, which every route this repo
  // has ever cut does and no verb, tool name or file path does. A route named outside
  // it goes unchecked rather than falsely red — a heuristic that invents failures is
  // one an operator learns to skip past, and this row has to stay worth reading.
  const { sighted } = focusParts(focusPath)
  const usable = new Set(usableRoutes(game))
  const named = [...new Set(
    [...`${blind}\n${sighted}`.matchAll(/`([A-Za-z]{1,4}-\d+)`/g)].map((m) => m[1])
  )]
  const missing = named.filter((name) => !usable.has(name))
  add('focus routes', missing.length === 0,
    named.length ? `${named.length} named, ${missing.length} missing` : 'none named',
    missing.length
      ? `${focusPath} sends a tester to ${missing.join(', ')}, which ${routesDir(game)} does not hold`
      : null)

  add('focus rooms', roster.length > 0 && leaks.length === 0,
    roster.length ? `${leaks.length ? leaks.slice(0, 3).join(', ') : 'none'} of ${roster.length} named` : 'no roster to check against',
    !roster.length
      ? 'the session never opened, so the firewall went unchecked — fix the row above'
      : (leaks.length
        ? `${focusPath} names a room a blind explorer is meant to find; say the affordance instead`
        : null))

  return rows
}

function findFile(dir, name) {
  if (!exists(dir)) return null
  const hit = fs.readdirSync(dir, { recursive: true }).find((p) => path.basename(p) === name)
  return hit ? path.join(dir, hit) : null
}

// The probe directories under a label, as full paths. Used to name the one probe a
// single `replay` call wrote, by diffing the set across it — `.replays` is shared
// with every round in the checkout, so "a probe exists" and "this call wrote a
// probe" are very different questions.
function probeDirsIn(dir) {
  if (!exists(dir)) return []
  return fs.readdirSync(dir, { withFileTypes: true })
    .filter((e) => e.isDirectory() && e.name.startsWith('probe-'))
    .map((e) => path.join(dir, e.name))
}

// ---------------------------------------------------------------------------
// The round's arguments, derived
// ---------------------------------------------------------------------------

const localDate = () => {
  const d = new Date()
  const pad = (n) => String(n).padStart(2, '0')
  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`
}

// Six paragraphs of SKILL.md an operator used to re-derive by hand every round.
// SKILL.md's own rule is "don't work from a list, here or anywhere" — which is an
// argument for computing these, not for remembering to.
function roundArgs(game, mcpKey) {
  const docPath = gameDoc(game, '')
  const ledgerPath = gameDoc(game, '-playtest-ledger')
  const focusPath = gameDoc(game, '-playtest-focus')
  // One read, so the two halves cannot come from two different states of the file.
  const split = focusPath ? focusParts(focusPath) : { blind: '', sighted: '' }

  return {
    game,
    packagePath: '.',
    // Derived, not assumed — see the `mcp key` check above for what assuming costs.
    mcpServer: mcpKey || null,
    docPath,
    capabilities: capabilitiesOf(game),
    // Never `null` here: the `routes` row refuses a game whose routes disagree about
    // a seed, and a failed row exits before this is reached.
    seed: seedFor(game),
    turns: 60,
    // Workflow scripts cannot call Date.now(), so the round's identity has to
    // arrive in args. It is also the date the report will be filed under — which
    // is why it is the LOCAL date: `toISOString()` is UTC, so a round dispatched
    // after about five in the afternoon in the Americas filed itself, and named
    // its report file, under tomorrow.
    roundId: localDate(),
    // The split the blind seats are chunked across, and the half of it they may
    // not have. A row that names the walkthrough, a route index or a ledger
    // verdict goes below the focus file's second `---` rule and reaches the
    // sighted charters only — which is a rule the file can state and only this
    // pair of fields can enforce.
    focus: split.blind,
    focusSighted: split.sighted,
    // The deep starts this round can hand out, by name — the same predicate the
    // `routes` row above turns red on, so a game cannot be dispatchable and broken in
    // the same breath about the same file.
    //
    // **Names only.** The manifest also holds the room each route lands in, and that
    // room is precisely what the firewall withholds: a blind explorer's coverage plan
    // is written in affordances because a display name in its prompt is a room it was
    // meant to discover. The landings are printed by the `routes` row, for the
    // operator, and go no further.
    routes: usableRoutes(game),
    ledgerKeys: ledgerPath ? ledgerScan(ledgerPath).keys : [],
    // Issues that OWN a defect class the round should forward rather than judge.
    // Ownership is a judgement and not a query, so this stays empty — the safe
    // default SKILL.md names — and the operator adds a number when one applies.
    // The harness once shipped three baked in; all were fixed within days, and
    // until the list was corrected the briefs were telling testers to forward the
    // exact symptoms that had just become regressions.
    routedIssues: [],
  }
}

// Off the manifest, never a table here: a game with no clock must get no
// clock-watcher, and the manifest is the only thing that knows which it is.
function capabilitiesOf(game) {
  const byProduct = {
    GnustoClock: 'clock',
    GnustoConversation: 'talk',
    GnustoScoring: 'score',
    GnustoSpellcasting: 'magic',
  }
  const targets = describePackage()?.targets || []
  const seen = new Set()
  const walk = (name) => {
    if (!name || seen.has(name)) return
    seen.add(name)
    const t = targets.find((x) => x.name === name)
    if (!t) return
    for (const d of t.product_dependencies || []) seen.add(d)
    for (const d of t.target_dependencies || []) walk(d)
  }
  walk(game)
  const caps = []
  for (const name of seen) {
    const cap = byProduct[name]
    if (cap && !caps.includes(cap)) caps.push(cap)
  }
  return caps
}

// ---------------------------------------------------------------------------
// Main
// ---------------------------------------------------------------------------

function mcpKeyFor(game) {
  const cfg = readJSON('.mcp.json', { mcpServers: {} })
  for (const [key, server] of Object.entries(cfg.mcpServers || {})) {
    if ((server.args || []).includes(game)) return key
  }
  return null
}

async function main() {
  const argv = process.argv.slice(2)
  const headless = argv.includes('--headless')
  const all = argv.includes('--all')
  const words = argv.filter((a) => !a.startsWith('--')).join(' ')

  let games
  if (all) {
    const cfg = readJSON('.mcp.json', { mcpServers: {} })
    games = Object.values(cfg.mcpServers || {}).flatMap((s) => s.args || [])
  } else {
    if (!words) {
      console.error('usage: bin/playtest-preflight <Game> | --all   [--headless]')
      process.exit(2)
    }
    const { game: product, products } = resolveGame(words)
    if (!product) {
      console.error(`playtest-preflight: no executable product matches "${words}"`)
      console.error(`  this package builds: ${products.join(', ') || '(none)'}`)
      process.exit(2)
    }
    games = [product]
  }

  const keys = new Map(games.map((g) => [g, mcpKeyFor(g)]))
  const rows = []
  for (const game of games) rows.push(...await checkGame(game, keys.get(game)))

  const width = Math.max(...rows.map((r) => `${r.game} ${r.name}`.length)) + 2
  console.log('')
  for (const r of rows) {
    const mark = r.ok ? `${GREEN}ok  ${OFF}` : `${RED}FAIL${OFF}`
    console.log(`  ${mark} ${`${r.game} ${r.name}`.padEnd(width)} ${DIM}${r.detail || ''}${OFF}`)
    if (!r.ok && r.remedy) console.log(`       ${' '.repeat(width)} ${RED}->${OFF} ${r.remedy}`)
  }

  // What is sitting in the scratch tree. With a round-scoped label this is no
  // longer something an operator has to clear, but a surprising number is still
  // worth seeing before a round rather than inside its arithmetic afterwards.
  const labels = exists(SCRATCH) ? fs.readdirSync(SCRATCH).filter((d) => !d.startsWith('.')) : []
  const shown = labels.slice(0, 4).join(', ') + (labels.length > 4 ? ', ...' : '')
  console.log(`\n  ${DIM}${SCRATCH}: ${labels.length} label director${labels.length === 1 ? 'y' : 'ies'}`
    + `${labels.length ? ` (${shown})` : ''}${OFF}`)

  const failed = rows.filter((r) => !r.ok)
  if (failed.length) {
    console.log(`\n  ${RED}${failed.length} check${failed.length === 1 ? '' : 's'} failed`
      + `${OFF} — the round is not dispatchable.\n`)
    process.exit(1)
  }

  if (all) { console.log(''); return }

  const game = games[0]
  const args = roundArgs(game, keys.get(game))
  fs.writeFileSync(ARGS_OUT, JSON.stringify(args, null, 2) + '\n')
  console.log(`\n  Round args -> ${ARGS_OUT}`)
  console.log(`    ${DIM}seed ${args.seed} | roundId ${args.roundId}`
    + ` | capabilities [${args.capabilities.join(', ')}]`
    + ` | routes [${args.routes.join(', ') || 'none — testers play cold'}]${OFF}`)
  console.log(`    ${DIM}docPath ${args.docPath || 'null'} | ledgerKeys ${args.ledgerKeys.length}`
    + ` | focus ${args.focus ? args.focus.length + ' chars' : 'none'}`
    + ` | sighted-only ${args.focusSighted ? args.focusSighted.length + ' chars' : 'none'}`
    + `${OFF}`)

  if (headless) {
    // The fallback two of the last three rounds needed by hand: the `Workflow`
    // tool is not on every agent's tool surface, and a headless session in this
    // checkout has it. Two environment variables have to be set for it, and
    // `.claude/settings.json` is where they live — `MCP_TIMEOUT` past the 46
    // seconds a first-connect-after-an-edit costs, and
    // `CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS: 0` because without it the session
    // terminates its own background tasks after 600 seconds and the round dies
    // silently at whatever phase it had reached.
    //
    // They are spread from the settings file rather than repeated here. Repeating
    // them made two owners of one pair of values, kept in sync by hand, with the
    // dry run asserting only that the settings copy exists — so raising the
    // timeout there would have left this path on the old number.
    console.log('\n  Dispatching through `claude -p` ...\n')
    const prompt = 'Run the play-test round, and write the report it returns:'
      + ` Workflow({scriptPath: ".claude/workflows/playtest.js", args: ${JSON.stringify(args)}})`
    const r = spawnSync('claude', ['-p', prompt], {
      cwd: ROOT,
      stdio: 'inherit',
      env: { ...process.env, ...(readJSON('.claude/settings.json', {}) || {}).env },
    })
    process.exit(r.status === null ? 1 : r.status)
  }

  console.log('\n  Dispatch with:\n')
  console.log('    Workflow({ scriptPath: ".claude/workflows/playtest.js",')
  console.log(`               args: <the JSON at ${ARGS_OUT}> })\n`)
}

main().catch((e) => { console.error(e); process.exit(2) })
