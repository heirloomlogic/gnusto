#!/usr/bin/env bash
#
# Write a new Gnusto game package, named for your game, from bin/templates.
#
# Usage:  bin/new-game <GameName> <destination-dir>
#         bin/new-game Zwank ~/dev/Zwank
#         bin/new-game Zwank /tmp/scratch --dep-path /path/to/gnusto
#
# There used to be a checked-in starter directory and a README telling you to
# copy it and then rename MyGame in ten places by hand. This does that, and does
# the part the README could not: the generated bin/ holds shims over Gnusto's own
# tools rather than copies of them, so an author's tooling cannot drift from the
# engine it is driving.
#
# --dep-path makes the generated package depend on a Gnusto checkout by path
# instead of by version. CI uses it to test the working tree; an author does not
# need it.

set -euo pipefail

# Captured before the cd below moves the shell: a relative destination or
# --dep-path is the caller's to interpret, and once we cd into the repo root a
# relative path re-resolved from there lands inside the repo instead of where
# the caller stood. Verified from /tmp/relcheck: `…/bin/new-game Relgame
# ./Relgame` wrote the package inside this checkout, not /tmp/relcheck/Relgame
# (whole-branch review, #368 follow-up).
invocation_dir="$PWD"

cd "$(dirname "$0")/.."

die() { echo "new-game: $*" >&2; exit 2; }

usage_line="usage: bin/new-game <GameName> <destination-dir> [--dep-path <path>]"

usage() {
  echo "$usage_line" >&2
  exit 2
}

game=""
destination=""
dep_path=""
stale_pin_warning=""
traitless_pin_warning=""
dev_tooling_warning=""
while [ $# -gt 0 ]; do
  case "$1" in
    --dep-path) dep_path="${2:-}"; [ -n "$dep_path" ] || usage; shift 2 ;;
    -h|--help) echo "$usage_line"; exit 0 ;;
    -*) die "unknown option '$1'" ;;
    *)
      if [ -z "$game" ]; then game="$1"
      elif [ -z "$destination" ]; then destination="$1"
      else die "unexpected argument '$1'"
      fi
      shift
      ;;
  esac
done

[ -n "$game" ] && [ -n "$destination" ] || usage

# Resolve both against the invocation directory captured above, not against
# the repo root this script already cd'd to -- see the comment on
# invocation_dir. An already-absolute path is left alone.
case "$destination" in
  /*) ;;
  *) destination="$invocation_dir/$destination" ;;
esac
if [ -n "$dep_path" ]; then
  case "$dep_path" in
    /*) ;;
    *) dep_path="$invocation_dir/$dep_path" ;;
  esac
fi

# The name becomes a struct, two target names and two directory names, so it has
# to be something Swift will accept in all five places. Checked here rather than
# left to the compiler, because the compiler's complaint arrives after the files
# are already on disk under the bad name.
#
#
# Narrower than a Swift identifier: no underscore anywhere. The name is also the
# product bin/playtest-replay is handed, and that script validates it with this
# same expression -- so a package generated for My_Game built and then never got
# a green `build` row from preflight (#441). Refusing here is the one place the
# author can still pick another name cheaply.
printf '%s' "$game" | grep -qE '^[A-Za-z][A-Za-z0-9]*$' \
  || die "'$game' is not a valid game name: a letter first, then letters and digits only"

if [ -e "$destination" ]; then
  [ -d "$destination" ] || die "'$destination' exists and is not a directory"
  if [ -n "$(ls -A "$destination" 2>/dev/null)" ]; then
    die "'$destination' is not empty"
  fi
fi

# Does the Gnusto whose manifest is on stdin declare the Playtest trait?
#
# SwiftPM validates trait forwarding when it resolves, not when it compiles, and
# it refuses outright: "Package 'zwank' (Zwank) enables traits [Playtest] on
# package 'gnusto' (Gnusto) that declares no traits." So a generated package that
# forwards the trait to a Gnusto predating it does not resolve at all -- and every
# release up to and including 0.5.0 predates it. The generated line looks perfectly
# correct in isolation, which is why a manifest a test only string-matches sails
# past this.
#
# Asked of the Gnusto actually depended on rather than hardcoded against a tag, so
# the forwarding comes back by itself the day a release declaring the trait ships
# and nobody has to remember to come back and delete this.
#
# Whitespace is stripped before the match because the declaration is one line in
# bin/templates/Package.swift and four in the engine's own, and a literal grep
# would see only one of those spellings.
declares_playtest_trait() {
  tr -d ' \t\n' | grep -q '\.trait(name:"Playtest"'
}

if [ -n "$dep_path" ]; then
  [ -d "$dep_path" ] || die "--dep-path '$dep_path' is not a directory"
  dep_path="$(cd "$dep_path" && pwd)"
  swift_path="${dep_path//\\/\\\\}"
  swift_path="${swift_path//\"/\\\"}"
  swift_path="${swift_path//$'\n'/\\n}"
  swift_path="${swift_path//$'\r'/\\r}"
  swift_path="${swift_path//$'\t'/\\t}"
  if [ -f "$dep_path/Package.swift" ] && declares_playtest_trait < "$dep_path/Package.swift"; then
    dependency=".package(name: \"Gnusto\", path: \"$swift_path\", traits: gnusto)"
  else
    dependency=".package(name: \"Gnusto\", path: \"$swift_path\")"
    traitless_pin_warning="1"
  fi
  # Gnusto's Package.swift gates its dev-only tooling (the Persnoop lint plugin,
  # the DocC plugin) on a gitignored .dev-tooling sentinel it finds through
  # #filePath -- the engine's own directory, whichever package is root. A manifest
  # cannot tell it is a dependency, so a path pin at a maintainer's checkout
  # resolves Persnicket and runs the lint plugin over the engine on every build of
  # the generated package: the exact leak the sentinel exists to prevent (#441).
  # Nothing here can fix that; the author is told at the one moment they are
  # looking.
  if [ -e "$dep_path/.dev-tooling" ]; then
    dev_tooling_warning="1"
  fi
else
  # Pin to whatever this checkout's newest release is, read now rather than
  # hardcoded, so the generator cannot fall behind the tags.
  #
  # This asks "what is the newest tag by version, full stop" rather than
  # `git describe --tags --abbrev=0`, which asks "what is the newest tag
  # reachable from HEAD" -- a different question, and one this script cannot
  # answer at all from a shallow clone: CI checks out at depth 1, so no tag's
  # commit is an ancestor of HEAD and `git describe` fails with "No tags can
  # describe" even once the tags themselves have been fetched (#384). A
  # version sort needs only the tag objects, which `fetch-tags: true` in
  # .github/workflows/test.yml supplies, and it is also the better question
  # on a branch that isn't a descendant of the release tag, where `describe`
  # would answer wrong instead of just failing.
  version="$(git tag --sort=-v:refname | head -1)"
  [ -n "$version" ] || die "no git tag found to pin against; pass --dep-path instead"
  if git show "$version:Package.swift" 2>/dev/null | declares_playtest_trait; then
    dependency=".package(url: \"https://github.com/HeirloomLogic/Gnusto\", from: \"$version\", traits: gnusto)"
  else
    dependency=".package(url: \"https://github.com/HeirloomLogic/Gnusto\", from: \"$version\")"
    traitless_pin_warning="1"
  fi

  # Every tool the template shims reads GNUSTO_PACKAGE_PATH or
  # GNUSTO_INVOCATION_DIR (itself or through a bin/lib module) to find out which
  # package the shim meant, because $0 by then points into Gnusto's own checkout
  # rather than the game's. A released tag can predate that for any one of them,
  # and a package pinned to such a tag gets a tool that quietly builds and lists
  # Gnusto's own demo games instead of this one. 0.4.0 predated it for
  # bin/export-game; 0.5.0 had export-game and not bin/playtest-preflight, and a
  # guard that asked only export-game let that pin through without a word (#441).
  # So the question is asked of every shim, and of the lib modules they route
  # through: does the tag's copy make the package-aware read the current copy
  # makes? Derived from the template and the tag rather than a list kept by hand,
  # so it retires itself the day a complete tag ships, and comes back on its own
  # the day a new shim lands ahead of the tag that carries it.
  stale_tools=""
  for shim in bin/templates/bin/* bin/lib/*; do
    [ -f "$shim" ] || continue
    tool="${shim#bin/templates/bin/}"
    tool="${tool#bin/}"
    if ! released="$(git show "$version:bin/$tool" 2>/dev/null)"; then
      stale_tools="$stale_tools $tool"
    elif grep -q 'GNUSTO_PACKAGE_PATH\|GNUSTO_INVOCATION_DIR' "bin/$tool" \
        && ! printf '%s' "$released" | grep -q 'GNUSTO_PACKAGE_PATH\|GNUSTO_INVOCATION_DIR'; then
      stale_tools="$stale_tools $tool"
    fi
  done
  [ -z "$stale_tools" ] || stale_pin_warning="1"
fi

mkdir -p "$destination"
destination="$(cd "$destination" && pwd)"

# bin/templates/.build can run to hundreds of megabytes on any machine that has
# ever run `swift test --package-path bin/templates` (Tasks 1 and 3 both did, and
# so does CI). Copying it and then deleting it would multiply that cost by every
# game generated, so it is excluded from the copy itself -- via a tar pipe rather
# than cp, because cp has no --exclude and a post-hoc `find -prune` would still
# have to walk the tree it is throwing away. Both BSD tar (macOS) and GNU tar
# (Linux/CI) accept -C and --exclude, and both preserve the executable bits the
# shims need.
tar -c -f - -C bin/templates --exclude .build --exclude Package.resolved . \
  | tar -x -f - -C "$destination"

lower="$(echo "$game" | tr '[:upper:]' '[:lower:]')"

# Rename the directories and the one file that carry the name, before rewriting
# contents, so nothing is edited twice.
mv "$destination/Sources/MyGame" "$destination/Sources/$game"
mv "$destination/Sources/$game/MyGame.swift" "$destination/Sources/$game/$game.swift"
mv "$destination/Tests/MyGameTests" "$destination/Tests/${game}Tests"
mv "$destination/Tests/${game}Tests/MyGameTests.swift" \
   "$destination/Tests/${game}Tests/${game}Tests.swift"

# MyGameTests is MyGame + Tests, so one substitution covers both. The lowercase
# pass is for the .mcp.json server key, which is keyed lowercase by convention —
# .claude/workflows/playtest.js reads it that way.
while IFS= read -r file; do
  sed -e "s/MyGame/$game/g" -e "s/mygame/$lower/g" "$file" > "$file.new"
  # Preserve the mode: sed writing to a new file would otherwise strip the
  # executable bit off every shim.
  chmod --reference="$file" "$file.new" 2>/dev/null \
    || chmod "$(stat -f '%OLp' "$file")" "$file.new"
  mv "$file.new" "$file"
done < <(find "$destination" -type f ! -path "*/.git/*")

# Write the marked dependency line literally: paths may contain sed syntax.
manifest="$destination/Package.swift"
replaced=""
while IFS= read -r line || [ -n "$line" ]; do
  case "$line" in
    *'// gnusto-dependency')
      printf '        %s\n' "$dependency"
      replaced=1
      ;;
    *) printf '%s\n' "$line" ;;
  esac
done < "$manifest" > "$manifest.new"
[ -n "$replaced" ] || die "internal error: dependency marker missing"
mv "$manifest.new" "$manifest"

echo "Wrote $game to $destination"
echo
echo "  cd $destination"
echo "  swift test        # run the transcript tests"
echo "  swift build && \"\$(swift build --show-bin-path)/$game\"   # play it"

if [ -n "$traitless_pin_warning" ]; then
  echo
  echo "warning: the Gnusto this package depends on predates the Playtest trait, so"
  echo "  Package.swift forwards nothing to it and $game's own Playtest trait reaches"
  echo "  only $game. The play-test server is compiled into the engine unconditionally"
  echo "  on that version, so bin/export-game and .github/workflows/release.yml still"
  echo "  ship a binary carrying it. Nothing else is affected, and the forwarding comes"
  echo "  back on its own once you depend on a Gnusto that declares the trait."
fi

if [ -n "$stale_pin_warning" ]; then
  echo
  echo "warning: pinned to Gnusto $version, which predates shim support in:"
  for tool in $stale_tools; do echo "    bin/$tool"; done
  echo "  Until a newer Gnusto release ships, a tool listed there runs against the"
  echo "  Gnusto engine checkout instead of $game -- it will build, list or preflight"
  echo "  the engine's own demo games and report that no product matches $game."
  echo "  A tool not listed is unaffected. --dep-path is also unaffected: re-run with"
  echo "  it against a checkout that has the fix, or re-run without it once a newer"
  echo "  tag exists."
fi

if [ -n "$dev_tooling_warning" ]; then
  echo
  echo "warning: $dep_path carries a .dev-tooling sentinel, so every build of $game"
  echo "  will also resolve Gnusto's maintainer-only tooling (Persnicket, the DocC"
  echo "  plugin) and run the lint plugin over the engine. The engine's manifest reads"
  echo "  the sentinel by its own path and cannot tell it is not the root package."
  echo "  To keep $game's build clean, remove that file and run"
  echo "  \`swift package purge-cache\` in the checkout, or point --dep-path at a"
  echo "  checkout without it."
fi
