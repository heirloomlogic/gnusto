#!/usr/bin/env bash
#
# Write a new Gnusto game package, named for your game, from bin/templates.
#
# Usage:  bin/new-game <GameName> <destination-dir>
#         bin/new-game Zwank ~/dev/Zwank
#         bin/new-game Zwank /tmp/scratch --dep-path /path/to/gnusto
#
# There used to be a checked-in starter directory and a README telling you to
# copy it and then rename MyGame in ten places by hand. This does that, and does
# the part the README could not: the generated bin/ holds shims over Gnusto's own
# tools rather than copies of them, so an author's tooling cannot drift from the
# engine it is driving.
#
# --dep-path makes the generated package depend on a Gnusto checkout by path
# instead of by version. CI uses it to test the working tree; an author does not
# need it.

set -euo pipefail

# Captured before the cd below moves the shell: a relative destination or
# --dep-path is the caller's to interpret, and once we cd into the repo root a
# relative path re-resolved from there lands inside the repo instead of where
# the caller stood. Verified from /tmp/relcheck: `…/bin/new-game Relgame
# ./Relgame` wrote the package inside this checkout, not /tmp/relcheck/Relgame
# (whole-branch review, #368 follow-up).
invocation_dir="$PWD"

cd "$(dirname "$0")/.."

die() { echo "new-game: $*" >&2; exit 2; }

usage() {
  echo "usage: bin/new-game <GameName> <destination-dir> [--dep-path <path>]" >&2
  exit 2
}

game=""
destination=""
dep_path=""
stale_pin_warning=""
while [ $# -gt 0 ]; do
  case "$1" in
    --dep-path) dep_path="${2:-}"; [ -n "$dep_path" ] || usage; shift 2 ;;
    -h|--help) usage ;;
    -*) die "unknown option '$1'" ;;
    *)
      if [ -z "$game" ]; then game="$1"
      elif [ -z "$destination" ]; then destination="$1"
      else die "unexpected argument '$1'"
      fi
      shift
      ;;
  esac
done

[ -n "$game" ] && [ -n "$destination" ] || usage

# Resolve both against the invocation directory captured above, not against
# the repo root this script already cd'd to -- see the comment on
# invocation_dir. An already-absolute path is left alone.
case "$destination" in
  /*) ;;
  *) destination="$invocation_dir/$destination" ;;
esac
if [ -n "$dep_path" ]; then
  case "$dep_path" in
    /*) ;;
    *) dep_path="$invocation_dir/$dep_path" ;;
  esac
fi

# The name becomes a struct, two target names and two directory names, so it has
# to be something Swift will accept in all five places. Checked here rather than
# left to the compiler, because the compiler's complaint arrives after the files
# are already on disk under the bad name.
case "$game" in
  [A-Za-z_]*) ;;
  *) die "'$game' is not a valid Swift identifier: it must start with a letter or underscore" ;;
esac
case "$game" in
  *[!A-Za-z0-9_]*) die "'$game' is not a valid Swift identifier: only letters, digits and underscores" ;;
esac

if [ -e "$destination" ]; then
  [ -d "$destination" ] || die "'$destination' exists and is not a directory"
  if [ -n "$(ls -A "$destination" 2>/dev/null)" ]; then
    die "'$destination' is not empty"
  fi
fi

if [ -n "$dep_path" ]; then
  [ -d "$dep_path" ] || die "--dep-path '$dep_path' is not a directory"
  dep_path="$(cd "$dep_path" && pwd)"
  swift_path="${dep_path//\\/\\\\}"
  swift_path="${swift_path//\"/\\\"}"
  swift_path="${swift_path//$'\n'/\\n}"
  swift_path="${swift_path//$'\r'/\\r}"
  swift_path="${swift_path//$'\t'/\\t}"
  dependency=".package(name: \"Gnusto\", path: \"$swift_path\", traits: gnusto)"
else
  # Pin to whatever this checkout's newest release is, read now rather than
  # hardcoded, so the generator cannot fall behind the tags.
  #
  # This asks "what is the newest tag by version, full stop" rather than
  # `git describe --tags --abbrev=0`, which asks "what is the newest tag
  # reachable from HEAD" -- a different question, and one this script cannot
  # answer at all from a shallow clone: CI checks out at depth 1, so no tag's
  # commit is an ancestor of HEAD and `git describe` fails with "No tags can
  # describe" even once the tags themselves have been fetched (#384). A
  # version sort needs only the tag objects, which `fetch-tags: true` in
  # .github/workflows/test.yml supplies, and it is also the better question
  # on a branch that isn't a descendant of the release tag, where `describe`
  # would answer wrong instead of just failing.
  version="$(git tag --sort=-v:refname | head -1)"
  [ -n "$version" ] || die "no git tag found to pin against; pass --dep-path instead"
  dependency=".package(url: \"https://github.com/HeirloomLogic/Gnusto\", from: \"$version\", traits: gnusto)"

  # bin/gnusto-mcp and bin/export-game read GNUSTO_PACKAGE_PATH to find out which
  # package a shim meant, because $0 by then points into Gnusto's own checkout
  # rather than the game's. A released tag can predate that -- 0.4.0 does -- and a
  # package pinned to one gets two tools that quietly build and list Gnusto's own
  # demo games instead of this one (caught in the whole-branch review after #368
  # shipped shims but not a release containing them). Checked against the tag
  # actually pinned, not hardcoded against "0.4.0", so this warning retires itself
  # the day a fixed tag ships and nobody has to remember to come back and delete it.
  if ! git show "$version:bin/export-game" 2>/dev/null | grep -q GNUSTO_PACKAGE_PATH; then
    stale_pin_warning="1"
  fi
fi

mkdir -p "$destination"
destination="$(cd "$destination" && pwd)"

# bin/templates/.build can run to hundreds of megabytes on any machine that has
# ever run `swift test --package-path bin/templates` (Tasks 1 and 3 both did, and
# so does CI). Copying it and then deleting it would multiply that cost by every
# game generated, so it is excluded from the copy itself -- via a tar pipe rather
# than cp, because cp has no --exclude and a post-hoc `find -prune` would still
# have to walk the tree it is throwing away. Both BSD tar (macOS) and GNU tar
# (Linux/CI) accept -C and --exclude, and both preserve the executable bits the
# shims need.
tar -c -f - -C bin/templates --exclude .build --exclude Package.resolved . \
  | tar -x -f - -C "$destination"

lower="$(echo "$game" | tr '[:upper:]' '[:lower:]')"

# Rename the directories and the one file that carry the name, before rewriting
# contents, so nothing is edited twice.
mv "$destination/Sources/MyGame" "$destination/Sources/$game"
mv "$destination/Sources/$game/MyGame.swift" "$destination/Sources/$game/$game.swift"
mv "$destination/Tests/MyGameTests" "$destination/Tests/${game}Tests"
mv "$destination/Tests/${game}Tests/MyGameTests.swift" \
   "$destination/Tests/${game}Tests/${game}Tests.swift"

# MyGameTests is MyGame + Tests, so one substitution covers both. The lowercase
# pass is for the .mcp.json server key, which is keyed lowercase by convention —
# .claude/workflows/playtest.js reads it that way.
while IFS= read -r file; do
  sed -e "s/MyGame/$game/g" -e "s/mygame/$lower/g" "$file" > "$file.new"
  # Preserve the mode: sed writing to a new file would otherwise strip the
  # executable bit off every shim.
  chmod --reference="$file" "$file.new" 2>/dev/null \
    || chmod "$(stat -f '%OLp' "$file")" "$file.new"
  mv "$file.new" "$file"
done < <(find "$destination" -type f ! -path "*/.git/*")

# Write the marked dependency line literally: paths may contain sed syntax.
manifest="$destination/Package.swift"
replaced=""
while IFS= read -r line || [ -n "$line" ]; do
  case "$line" in
    *'// gnusto-dependency')
      printf '        %s\n' "$dependency"
      replaced=1
      ;;
    *) printf '%s\n' "$line" ;;
  esac
done < "$manifest" > "$manifest.new"
[ -n "$replaced" ] || die "internal error: dependency marker missing"
mv "$manifest.new" "$manifest"

echo "Wrote $game to $destination"
echo
echo "  cd $destination"
echo "  swift test        # run the transcript tests"
echo "  swift build && \"\$(swift build --show-bin-path)/$game\"   # play it"

if [ -n "$stale_pin_warning" ]; then
  echo
  echo "warning: pinned to Gnusto $version, which predates shim support in"
  echo "  bin/gnusto-mcp and bin/export-game. Until a newer Gnusto release ships,"
  echo "  those two tools will run against the Gnusto engine checkout instead of"
  echo "  $game -- bin/gnusto-mcp will try to build $game inside the engine repo,"
  echo "  and bin/export-game will list the engine's own demo games. bin/playtest-replay"
  echo "  and bin/playtest-measure are unaffected. --dep-path is also unaffected:"
  echo "  re-run with it against a checkout that has the fix, or re-run without it"
  echo "  once a newer tag exists."
fi
