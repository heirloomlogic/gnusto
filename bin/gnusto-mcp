#!/usr/bin/env bash
# Serve one catalog game to an MCP client over stdio.
# Usage: bin/gnusto-mcp <Game>
# The shared development builder validates its fingerprint on every connection.
# Warm launches invoke no SwiftPM; build diagnostics go to stderr, while stdout
# belongs exclusively to JSON-RPC. Preflight primes the development cache.
# GNUSTO_MCP_BUILD=1 forces a build. Deployment has its own traits-off cache.
set -euo pipefail
for arg in "$@"; do
  if [[ "$arg" == "-h" || "$arg" == "--help" ]]; then
    sed -n '2,${/^#/!q; s/^# \{0,1\}//; p;}' "$0"
    exit 0
  fi
done
die() { echo "gnusto-mcp: $*" >&2; exit 2; }
script_dir="$(cd "$(dirname "$0")" && pwd -P)"
package_root="${GNUSTO_PACKAGE_PATH:-$script_dir/..}"
cd "$package_root"
export GNUSTO_PACKAGE_PATH="$PWD"
game="${1:-}"
[[ -n "$game" && $# -eq 1 ]] || die "usage: bin/gnusto-mcp <Game>"
# Folded catalog lookup accepts phrases, but a cache stem cannot carry a path.
[[ "$game" != */* && "$game" != *\\* && "$game" != *$'\n'* && "$game" != *$'\r'* ]] \
  || die "bad game name '$game'"
build_args=("$game" --mode development)
[[ "${GNUSTO_MCP_BUILD:-}" != 1 ]] || build_args+=(--force)
binary="$("$script_dir/build-game" "${build_args[@]}")" || die "could not build game $game"
[[ "$binary" == /* && -x "$binary" ]] || die "builder returned no absolute runnable path for game $game: $binary"
binpath_cache=".context/playtest/.bin/$game.path"
mkdir -p "$(dirname "$binpath_cache")"
printf '%s\n' "$binary" > "$binpath_cache"
exec "$binary" --mcp
