#!/usr/bin/env bash
#
# Replay a Gnusto game non-interactively and print the transcript. This is the
# one command a play-tester needs: write a command list, run it, read the prose.
#
# Usage:
#   bin/playtest-replay --build <Game>
#   bin/playtest-replay <Game> --commands FILE [options]
#
# Options:
#   --commands FILE     One command per line. Two kinds of line never reach the
#                       engine, so neither costs a turn or a clock tick. A line
#                       whose first non-space characters are // or # is a tester
#                       comment: the engine records it in the transcript and
#                       skips it, so annotate freely. A blank line is a
#                       separator: this tool strips it while building the
#                       file it feeds the engine, so group your probes with them.
#   --keep-blank-lines  Pass blank lines through to the engine instead of
#                       stripping them. The one reason to: probing what the
#                       parser does with empty input, which is otherwise
#                       unreachable. Every blank line then costs a turn.
#   --seed N            GNUSTO_SEED (default 0). Pins the one random stream, so
#                       the transcript you read is the transcript that
#                       play(Game(), commands, seed: N) produces in the suite.
#   --tail N            Print only the last N lines. Use it. Iterative replay is
#                       O(n^2) in engine turns, which is free — a 120-turn
#                       replay is milliseconds — and O(n^2) in tokens if you
#                       re-read the whole transcript every turn, which is not.
#   --label NAME        Names the tester's scratch directory. One label per tester,
#                       so parallel testers cannot read each other's saves. A label
#                       is a namespace, not a file: every run allocates a fresh
#                       probe directory beneath it, so re-using a label — or two
#                       testers colliding on one — never overwrites a transcript.
#   --probe NAME        Names this run's probe directory instead of taking the next
#                       probe-NNN. Refuses a name that already holds anything, so a
#                       transcript somebody cited cannot be replaced by another run.
#   --restore SLOT      Prologue: restore SLOT before the command list, to reach
#                       a deep state without replaying its prologue.
#   --save SLOT         Epilogue: save to SLOT before quitting, so a later probe
#                       can --restore it.
#   --saves-from SRC    Copy *.gnusto slots into this run's saves before it starts,
#                       so --restore can reach a save this run never wrote. SRC is
#                       another LABEL, or — anything holding a slash — the PATH of
#                       a directory of slots. One way: the copy lands in THIS
#                       label's saves directory, so a --save here cannot reach back
#                       into SRC. This is what a verifier needs to replay a
#                       reproducer that begins `restore`; without it the game
#                       answers "Restore failed." and the verdict is about the
#                       harness rather than about the finding.
#
#                       **The path form is what a fixer uses.** Labels are cleaned
#                       between rounds and a fixer picks up a finding after that,
#                       so the label named in the report is usually gone by then.
#                       Every staged probe keeps the bytes it ran on in saves-in/
#                       beside its transcript, and that directory is the durable
#                       source: --saves-from <probe>/saves-in reproduces a
#                       reported finding with nothing else surviving.
#
#                       **The slots join this label permanently.** Saves belong to
#                       the label here (see below), so there is nowhere per-run to
#                       stage into — which means every later probe under this label
#                       can restore them without passing the flag. That is why the
#                       trailer is read off a `.staged-from` marker rather than off
#                       this argument: a run that inherits staged slots says so too.
#                       The MCP `replay` tool's `savesFrom` differs here, and only
#                       here: it stages into a throwaway it deletes.
#
#                       Either way the transcript reproduces only while LABEL still
#                       holds those slots, so the probe keeps its own copy of the
#                       bytes in saves-in/ and summary.txt records the label.
#   --max-turns N       Refuse a command list longer than N engine commands
#                       (default 250). A runaway probe is a token fire.
#   --timeout SECS      Wall-clock kill (default 60).
#   --package-path DIR  Drive a different checkout — used to replay against an
#                       older commit in a git worktree, which has no bin/ of
#                       its own.
#
# Why the built binary and not `swift run`: SharingYourGame.md warns that
# `swift run` interferes with stdin for this project, it prints build chatter
# into the output, and under a dozen concurrent testers it would trigger a dozen
# builds. Build once with --build; replaying never builds.
#
# Where the output lands:
#
#   .context/playtest/<label>/saves/          shared by every probe under the label
#   .context/playtest/<label>/<probe>/transcript.txt
#                                    /commands.txt
#                                    /stderr.txt
#                                    /summary.txt
#
# Saves belong to the label because that is what makes --save/--restore work across
# two runs. Transcripts belong to the probe because they are evidence: a finding
# cites the path this run printed, and that path has to still hold this run's
# transcript when somebody follows it a year later.
#
# `commands.txt` is the name the session server and its sessionless `replay` tool
# already use, and all three hold the same thing: every line actually fed to the
# engine, comments included. This script called it `commands.effective.txt` until
# #299, which is one probe layout written down twice — every reader of a probe
# opens `commands.txt`. `SKILL.md`'s "Measuring a change to the harness" says what
# that cost.
#
# Why it prints the transcript FILE and not stdout: the plain ConsoleIOHandler
# writes the "> " prompt but not the piped command, so stdout is answers with
# the questions missing. GNUSTO_TRANSCRIPT records "> command" interleaved with
# the output, byte-for-byte what ScriptedIOHandler produces in the test suite —
# so the file printed here is the string a transcript test asserts on, once the
# `[status]` lines below are dropped from the excerpt.
#
# Why every turn carries a `[status]` footer: GNUSTO_STATUS is set here, always,
# the way the play-test session server hardcodes StatusFooter.always for the
# same reason. Two of them. A reader gets the room, the move counter and whether
# the command cost a turn without reconstructing any of it from prose — and a
# round counts its own turns by grepping these transcripts for `turn=cost`,
# which is a number nothing else can produce. It is not conditional on an
# inherited GNUSTO_STATUS: a stray exported `0` would put the count back to
# silently missing every CLI replay, which is the bug this replaced (#288).

set -euo pipefail

cd "$(dirname "$0")/.."

die() { echo "playtest-replay: $*" >&2; exit 2; }

# Prints the comment block at the top of this file as the usage text, stopping
# at the first non-comment line, so adding a flag above documents it here too.
usage() { sed -n '2,${/^#/!q; s/^# \{0,1\}//; p;}' "$0"; }

need_number() { [[ "$2" =~ ^[0-9]+$ ]] || die "$1 must be a whole number, got '$2'"; }

# A label and a probe both become a directory name under .context/playtest, so both
# keep to one alphabet. The first character may not be a dot: that is what stops a
# name reaching `.bin`, the build-path cache this script keeps beside the labels.
plain_name() { [[ "$1" =~ ^[A-Za-z0-9_-][A-Za-z0-9._-]*$ ]]; }

game=""; commands=""; seed=0; tail_lines=0; restore_slot=""; save_slot=""
max_turns=250; timeout_secs=60; label=""; probe=""; pkg="$PWD"; build_only=0
keep_blanks=0; saves_from=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --build)        build_only=1; shift ;;
    --commands)     commands="${2:-}"; shift 2 ;;
    --seed)         seed="${2:-}"; shift 2 ;;
    --tail)         tail_lines="${2:-}"; shift 2 ;;
    --label)        label="${2:-}"; shift 2 ;;
    --probe)        probe="${2:-}"; shift 2 ;;
    --restore)      restore_slot="${2:-}"; shift 2 ;;
    --save)         save_slot="${2:-}"; shift 2 ;;
    --saves-from)   saves_from="${2:-}"; shift 2 ;;
    --max-turns)    max_turns="${2:-}"; shift 2 ;;
    --timeout)      timeout_secs="${2:-}"; shift 2 ;;
    --package-path) pkg="${2:-}"; shift 2 ;;
    --keep-blank-lines) keep_blanks=1; shift ;;
    -h|--help)      usage; exit 0 ;;
    -*)             die "unknown option $1" ;;
    *)              [[ -z "$game" ]] || die "unexpected argument '$1'"; game="$1"; shift ;;
  esac
done

[[ -n "$game" ]] || die "usage: bin/playtest-replay <Game> --commands FILE"
# The game name reaches a shell command and a file path, so keep it to the
# shape a Swift product name actually has.
[[ "$game" =~ ^[A-Za-z][A-Za-z0-9]*$ ]] || die "bad game name '$game'"
need_number --seed "$seed"
need_number --tail "$tail_lines"
need_number --max-turns "$max_turns"
need_number --timeout "$timeout_secs"
[[ -d "$pkg" ]] || die "--package-path '$pkg' is not a directory"
pkg="$(cd "$pkg" && pwd)"

# One spelling of the tree every label, save and probe hangs off. It is also
# `GNUSTO_PLAYTEST_DIR`'s default in the session server, which is what makes a
# save written here readable by the MCP `replay` tool's `savesFrom`.
playtest_root="$pkg/.context/playtest"

# Where --build records the binary it resolved. Keyed by game, kept inside the
# checkout it belongs to, so a worktree at an old commit gets its own.
binpath_cache="$playtest_root/.bin/$game.path"

# --- build mode ---------------------------------------------------------------
# A one-shot, not a lazy build. A dozen concurrent `swift build` calls serialize
# on SwiftPM's package lock, so each tester would block on a build it cannot
# see; and macOS ships bash 3.2, which has no flock to coordinate better.
# Making the build explicit removes the race, and turns a stale binary into a
# legible error instead of a mystery.
if [[ $build_only -eq 1 ]]; then
  echo "Building $game (debug) in $pkg …" >&2
  ( cd "$pkg" && swift build --product "$game" ) >&2
  # Ask for the bin path, never guess it. Under the swiftbuild build system it
  # is .build/out/Products/Debug, not .build/debug — and a stale .build/debug
  # copy from an earlier `swift run` may also exist, so guessing is a coin flip
  # between the binary you just built and one from last week.
  bindir="$( cd "$pkg" && swift build --product "$game" --show-bin-path )"
  [[ -x "$bindir/$game" ]] || die "built $game but found no executable at $bindir/$game"
  mkdir -p "$(dirname "$binpath_cache")"
  printf '%s\n' "$bindir/$game" > "$binpath_cache"
  echo "$bindir/$game"
  exit 0
fi

[[ -n "$commands" ]] || die "--commands FILE is required"
[[ -f "$commands" ]] || die "no such command file: $commands"
[[ -f "$binpath_cache" ]] \
  || die "no build recorded for $game — run: bin/playtest-replay --build $game"
read -r binary < "$binpath_cache"
[[ -x "$binary" ]] \
  || die "recorded binary '$binary' is gone — re-run: bin/playtest-replay --build $game"

[[ -n "$label" ]] || label="$game-adhoc"
plain_name "$label" || die "bad --label '$label'"
scratch="$playtest_root/$label"
mkdir -p "$scratch/saves"

# --saves-from: resolve and check the source, but copy nothing yet. Staging is a
# side effect on the LABEL — the destination is this label's shared saves
# directory, because the script has no per-run save directory to use — so it must
# not happen before the probe directory is allocated, or a --probe collision or
# the 999-probe die leaves another tester's slots behind in a label the run never
# wrote a transcript into.
staged_slots=()
if [[ -n "$saves_from" ]]; then
  # A slash means a path, exactly as it does at the game's own save prompt and in
  # the MCP tool's `savesFrom` — one rule for "bare name or path" in the package.
  # The path form is the one that still works after a round's labels are cleaned:
  # it names a probe's own saves-in/, which is where the bytes durably live.
  if [[ "$saves_from" == */* || "$saves_from" == "~"* ]]; then
    from_dir="${saves_from/#\~/$HOME}"
    [[ -d "$from_dir" ]] \
      || die "--saves-from '$saves_from' was read as a path, and '$from_dir' is not a directory"
    [[ "$(cd "$from_dir" && pwd)" != "$(cd "$scratch/saves" && pwd)" ]] \
      || die "--saves-from '$saves_from' is this run's own saves directory; it already reads those slots"
  else
    plain_name "$saves_from" || die "bad --saves-from '$saves_from'"
    [[ "$saves_from" != "$label" ]] \
      || die "--saves-from '$saves_from' is this run's own label; it already reads those slots"
    from_dir="$playtest_root/$saves_from/saves"
  fi
  # bash 3.2 ships no nullglob, so an unmatched pattern comes back literal and
  # has to be tested rather than counted.
  staged_slots=("$from_dir"/*.gnusto)
  [[ -e "${staged_slots[0]}" ]] \
    || die "--saves-from '$saves_from' holds no .gnusto slots in $from_dir"
fi

# One directory per run. A label is a tester's namespace, and re-using one — either
# on purpose, replaying an appended command list, or by two testers picking the same
# short name — used to overwrite the previous transcript in place. That silently
# destroyed the evidence a finding cites, which is worse than losing it noisily,
# because the path still resolves and now holds somebody else's session.
if [[ -n "$probe" ]]; then
  plain_name "$probe" || die "bad --probe '$probe'"
  [[ "$probe" != "saves" ]] || die "--probe 'saves' collides with the label's save directory"
  probe_dir="$scratch/$probe"
  # A name a tester chose is a name they mean to cite, so refuse rather than clobber.
  [[ -z "$(ls -A "$probe_dir" 2>/dev/null)" ]] \
    || die "--probe '$probe' already holds output at $probe_dir — pick another name"
  mkdir -p "$probe_dir"
else
  # mkdir IS the lock: it fails when the directory exists, and it fails atomically.
  # macOS ships bash 3.2, which has no flock, so this is the coordination a dozen
  # concurrent testers get.
  probe_dir=""
  n=1
  while [[ "$n" -le 999 ]]; do
    candidate="$(printf '%s/probe-%03d' "$scratch" "$n")"
    if mkdir "$candidate" 2>/dev/null; then probe_dir="$candidate"; break; fi
    n=$((n + 1))
  done
  [[ -n "$probe_dir" ]] || die "999 probes under $scratch already — start a fresh --label"
  probe="${probe_dir##*/}"
fi

# Now stage, with somewhere to record it. Two copies: one into the label, which
# is what --restore reads, and one into the probe, which is what a reader follows
# a year later — labels get cleaned between rounds and probe directories are the
# durable evidence, so a probe holding only the label's *path* stops reproducing
# the moment that label goes. Only *.gnusto, the extension
# SaveStore.existingSaveNames filters on, so the game's restore prompt lists
# exactly what was copied and the .history sidecar stays behind.
#
# The marker is what makes the receipt honest for the runs that follow. Staged
# slots join the label PERMANENTLY — unlike the MCP side, which stages into a
# throwaway it deletes — so a later probe under the same label restores them
# without passing the flag, and would otherwise write a summary claiming the
# strong "reproduces from its command list alone" that every other probe makes.
# Reading the trailer off the marker rather than off $saves_from means every
# probe under a staged label says so.
if [[ -n "$saves_from" ]]; then
  cp "${staged_slots[@]}" "$scratch/saves/"
  printf '%s\n' "$saves_from" > "$scratch/saves/.staged-from"
  echo "[playtest] staged ${#staged_slots[@]} slot(s) from '$saves_from' ($from_dir)" >&2
fi

# The probe copy is keyed off the MARKER, not off this run's argument, so a run
# that merely inherited staged slots keeps the bytes too — it restores from them
# just as much as the run that staged them did, and its receipt has to be worth
# as much. Keyed off the argument, a later probe named a saves-in/ it had never
# written.
staged_from_marker=""
[[ -f "$scratch/saves/.staged-from" ]] \
  && read -r staged_from_marker < "$scratch/saves/.staged-from"
staged_here=()
if [[ -n "$staged_from_marker" ]]; then
  staged_here=("$scratch"/saves/*.gnusto)
  if [[ -e "${staged_here[0]}" ]]; then
    mkdir -p "$probe_dir/saves-in"
    cp "${staged_here[@]}" "$probe_dir/saves-in/"
  fi
fi

# The same warning the MCP `replay` tool prints, for the harness that a fixer
# actually drives. A `restore` with nothing staged meets a refusal that is a fact
# about this script and not about the game, and every turn after it is the wrong
# game — which is how four real defects were discarded on 2026-08-25. Read off
# the command list rather than off the transcript, because the refusal is
# `GameText.restoreFailed` and any game may re-skin it; a `save` earlier in the
# list closes the question, since that run wrote its own slot.
if [[ -z "$staged_from_marker" && -z "$restore_slot" ]]; then
  first_save_or_restore="$(
    grep -oiE '^[[:space:]]*(save|restore)\b' "$commands" | head -1 | tr -d '[:space:]' \
      | tr '[:upper:]' '[:lower:]'
  )"
  if [[ "$first_save_or_restore" == "restore" ]]; then
    echo "[playtest] restore-unreachable — this list types 'restore' and nothing was staged," >&2
    echo "[playtest]   so the save it asked for cannot exist and every turn after it is the" >&2
    echo "[playtest]   wrong game. Re-run with --saves-from <label>, or with the path of a" >&2
    echo "[playtest]   saves-in directory beside an earlier probe's transcript." >&2
  fi
fi

# The cap counts engine commands only. Neither a comment (the REPL skips it) nor
# a blank line (stripped below, when the fed file is built) reaches
# perform(), so they are free and must not count against the budget.
engine_lines="$(grep -cvE '^[[:space:]]*(//|#|$)' "$commands" || true)"
[[ "$engine_lines" -le "$max_turns" ]] \
  || die "$engine_lines commands exceeds --max-turns $max_turns"

fed="$probe_dir/commands.txt"
{
  # save and restore are two-turn interactions: the parser knows only the bare
  # verbs, and the engine then asks for a filename on the *next* input line.
  [[ -n "$restore_slot" ]] && printf 'restore\n%s\n' "$restore_slot"
  # A blank line groups probes in a command file, but the engine has no notion of
  # one: it reaches perform(), fails to parse, and prints "I beg your pardon?"
  # into a transcript another agent reads as evidence. Strip it here, where the
  # file is assembled. Comments pass through, because the REPL records them in
  # the transcript before skipping them, and that record is the point of writing
  # one. awk, not `grep -v` — which exits 1 on an all-blank file and would trip
  # set -e — and not BSD sed, which passes an unterminated last line through
  # unterminated: awk always emits the trailing newline, so a command file saved
  # without one can no longer glue its last command onto the epilogue below.
  #
  # --keep-blank-lines passes them through instead, which is the only way to
  # probe what the engine does with empty input: the strip is right for every
  # ordinary probe and made that one case unreachable from any charter. The
  # `1` branch is still an awk pass rather than `cat`, so the trailing-newline
  # guarantee above holds either way.
  if [[ $keep_blanks -eq 1 ]]; then
    awk '1' "$commands"
  else
    awk '!/^[[:space:]]*$/' "$commands"
  fi
  [[ -n "$save_slot" ]] && printf 'save\n%s\n' "$save_slot"
  # Twice. `quit` needs no confirmation on this path — the confirm prompt lives
  # only in TerminalIOHandler, which piped input never builds — but a pending
  # save/restore filename prompt or a death prompt is answered before any verb
  # is parsed, so the first `quit` can be eaten as an answer. The second is
  # simply unread in the ordinary case. The epilogue it produces — the stock
  # "Your score is N, in M turns.", or whatever the game has re-skinned
  # `text.scoreLine` to — is the proof the session ran to the end rather than
  # wedging partway.
  printf 'quit\nquit\n'
} > "$fed"

transcript="$probe_dir/transcript.txt"
errlog="$probe_dir/stderr.txt"

status=0
# GNUSTO_TRANSCRIPT with a slash in it is honored verbatim and its parent
# directories are created, so one variable is enough. GNUSTO_SAVE_DIR keeps
# saves inside this tester's scratch. GNUSTO_STATUS is set for the reason given
# in the header: the transcript is evidence for a counter as well as prose for a
# reader. perl's alarm stands in for timeout(1), which macOS does not ship.
GNUSTO_PLAIN=1 \
GNUSTO_SEED="$seed" \
GNUSTO_STATUS=1 \
GNUSTO_TRANSCRIPT="$transcript" \
GNUSTO_SAVE_DIR="$scratch/saves" \
  perl -e 'alarm shift; exec @ARGV or die "exec failed: $!\n"' \
       "$timeout_secs" "$binary" \
  < "$fed" > /dev/null 2> "$errlog" || status=$?

if [[ ! -f "$transcript" ]]; then
  detail=""
  [[ -s "$errlog" ]] && detail=" — stderr: $(head -c 400 "$errlog")"
  die "no transcript written at $transcript; engine exited $status$detail"
fi

if [[ "$tail_lines" -gt 0 ]]; then
  total="$(grep -c '' "$transcript" || true)"
  if [[ "$total" -gt "$tail_lines" ]]; then
    echo "[playtest] showing the last $tail_lines of $total lines; full file at the path below"
  fi
  tail -n "$tail_lines" "$transcript"
else
  cat "$transcript"
fi

# The trailer is the machine-readable part: what ran, and whether it finished. It is
# written into the probe directory as well as printed, so the directory a finding
# cites says which game, seed and label produced it without a reader reconstructing
# that from the surrounding round report.
summary="$probe_dir/summary.txt"
{
  echo "[playtest] game=$game seed=$seed label=$label probe=$probe commands=$engine_lines exit=$status"
  echo "[playtest] transcript=$transcript"
  echo "[playtest] commands=$fed"
  # Only when there was one, so an ordinary probe's summary reads as it always
  # has — and a staged one says in the receipt that its command list alone will
  # not reproduce it, which is the one claim this file otherwise always makes.
  if [[ -n "$staged_from_marker" ]]; then
    echo "[playtest] saves-from=$staged_from_marker slots=${#staged_here[@]} copy=$probe_dir/saves-in"
  fi
  # perl's alarm kills with SIGALRM (14); the shell reports 128+14.
  if [[ "$status" -eq 142 || "$status" -eq 14 ]]; then
    echo "[playtest] TIMEOUT after ${timeout_secs}s — the game never reached quit. Report this."
  elif [[ "$status" -ne 0 ]]; then
    echo "[playtest] NONZERO EXIT — engine crash or bootstrap failure. Report this."
  fi
} > "$summary"

echo
cat "$summary"
if [[ -s "$errlog" ]]; then
  echo "[playtest] stderr (bootstrap warnings and GNUSTO_SEED complaints land here):"
  sed -n '1,40p' "$errlog"
fi
