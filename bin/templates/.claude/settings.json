{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "MCP_TIMEOUT": "180000",
    "CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS": "0"
  },
  "enabledMcpjsonServers": [
    "mygame"
  ],
  "permissions": {
    "allow": [
      "Bash(bin/playtest-preflight:*)",
      "Bash(bin/playtest-replay:*)",
      "Bash(bin/playtest-routes:*)",
      "Bash(bin/playtest-measure:*)",
      "Bash(bin/export-game:*)",
      "Bash(swift build:*)",
      "Bash(swift test:*)",
      "Bash(swift package describe)",
      "mcp__mygame",
      "Workflow",
      "Bash(gh issue list:*)"
    ],
    "ask": [
      "Bash(gh issue create:*)"
    ]
  }
}
