#!/usr/bin/env node
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {loadGames, resolveCatalogGame} from './lib/game-catalog.mjs';
import {findEngineRoot, makeBuildSpec, buildGame} from './lib/game-build.mjs';
import {stageTerminalExport} from './lib/game-export.mjs';
const usage = 'Usage: bin/export-game [<Game>] [--frontend terminal|yonk]\nWithout a game, lists catalog game names. Builds a release distribution without Playtest.';
try {
  const words = process.argv.slice(2);
  if (words.includes('--help') || words.includes('-h')) { console.log(usage); process.exit(0); }
  let frontend = 'terminal', gameName;
  while (words.length) {
    const word = words.shift();
    if (word === '--frontend' || word.startsWith('--frontend=')) {
      frontend = word === '--frontend' ? words.shift() : word.slice('--frontend='.length);
      if (!frontend || frontend.startsWith('-')) throw new Error('--frontend needs a value');
    } else if (word.startsWith('-')) throw new Error(`unknown option: ${word}`);
    else if (gameName !== undefined) throw new Error(`unexpected argument: ${word}`);
    else gameName = word;
  }
  if (frontend === 'yonk') throw new Error('yonk frontend is unavailable until milestone 2');
  if (frontend !== 'terminal') throw new Error(`unknown frontend: ${frontend}`);
  const packageRoot = path.resolve(process.env.GNUSTO_PACKAGE_PATH || path.join(path.dirname(fileURLToPath(import.meta.url)), '..'));
  const catalog = loadGames(packageRoot);
  if (gameName === undefined) { console.log(catalog.games.map(game => game.name).join('\n')); process.exit(0); }
  const game = resolveCatalogGame(catalog, gameName);
  const spec = makeBuildSpec({packageRoot, engineRoot: findEngineRoot(packageRoot), terminalRoot: process.env.GNUSTO_TERMINAL_PATH, game, mode: 'deployment'});
  console.error(`Building ${game.name} (release, no play-test server)…`);
  const built = await buildGame(spec, {swift: process.env.GNUSTO_SWIFT || 'swift'});
  const controller = new AbortController();
  const interrupt = () => controller.abort();
  process.once('SIGINT', interrupt); process.once('SIGTERM', interrupt);
  let staged;
  try { staged = await stageTerminalExport({...built, destination: path.join(packageRoot, 'dist', game.name), signal: controller.signal}); }
  finally { process.removeListener('SIGINT', interrupt); process.removeListener('SIGTERM', interrupt); }
  console.log(`\n✔ Exported dist/${game.name}\n\nPlay it:      ./dist/${game.name}`);
  if (staged.resources.length) {
    console.log(`Share it:     distribute the complete directory ${path.relative(packageRoot, path.dirname(staged.resources[0]))}, including the executable and resource bundles.`);
  } else console.log(`Share it:     send the single file dist/${game.name} to a friend on the same platform.`);
  if (process.platform === 'darwin') console.log(`\nRequires macOS 15+. A downloaded distribution may need its quarantine flag cleared:\n  xattr -dr com.apple.quarantine <distribution>`);
} catch (error) { console.error(`export-game: ${error.message}`); process.exitCode = 2; }
