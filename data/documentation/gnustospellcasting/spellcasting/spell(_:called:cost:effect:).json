e spell names it by its "},{"type":"strong","inlineContent":[{"text":"word","type":"text"}]},{"type":"text","text":":"},{"type":"text","text":" "},{"type":"text","text":"“You fix the "},{"type":"emphasis","inlineContent":[{"text":"unbar","type":"text"}]},{"type":"text","text":" spell in your memory”, “You hold in mind: "},{"type":"emphasis","inlineContent":[{"text":"glow","type":"text"}]},{"type":"text","text":"”."},{"type":"text","text":" "},{"type":"text","text":"That word is the intent’s own name unless "},{"type":"codeVoice","code":"called:"},{"type":"text","text":" says otherwise,"},{"type":"text","text":" "},{"type":"text","text":"which it should whenever the intent is not a word a player reads —"},{"type":"text","text":" "},{"type":"codeVoice","code":"#verb(\"castFire\", …)"},{"type":"text","text":" wants "},{"type":"codeVoice","code":"called: \"fire\""},{"type":"text","text":", or every line says “the"},{"type":"text","text":" "},{"type":"text","text":"castFire spell”. The word is display only: memory is keyed on the"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"intent","type":"text"}]},{"type":"text","text":", so two spells may be called the same thing and still be"},{"type":"text","text":" "},{"type":"text","text":"memorized, cast and spent one at a time."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"One memorize verb per prepared spell.","type":"text"}]},{"type":"text","text":" A "},{"type":"codeVoice","code":".prepared"},{"type":"text","text":" cost registers a"},{"type":"text","text":" "},{"type":"text","text":"stage-4 action on its "},{"type":"codeVoice","code":"learnVia"},{"type":"text","text":" intent, and two spells declaring the"},{"type":"text","text":" "},{"type":"text","text":"same one collide: the bootstrap keeps the later and warns that it"},{"type":"text","text":" "},{"type":"text","text":"overrides the earlier. "},{"type":"codeVoice","code":"memorize unbar"},{"type":"text","text":" and "},{"type":"codeVoice","code":"memorize seal"},{"type":"text","text":" are two"},{"type":"text","text":" "},{"type":"text","text":"intents, not one "},{"type":"codeVoice","code":"memorize"},{"type":"text","text":" with an object."}]}]}],"kind":"symbol","references":{"doc://GnustoSpellcasting/documentation/GnustoSpellcasting/SpellCost":{"role":"symbol","type":"topic","title":"SpellCost","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SpellCost","kind":"identifier"}],"abstract":[{"type":"text","text":"How a spell becomes available to cast, and what casting it costs — the axis"},{"type":"text","text":" "},{"type":"text","text":"that lets one spellcasting system express the common RPG magic paradigms"},{"type":"text","text":" "},{"type":"text","text":"without changing how a spell’s "},{"inlineContent":[{"type":"text","text":"effect"}],"type":"emphasis"},{"text":" is written.","type":"text"}],"identifier":"doc:\/\/GnustoSpellcasting\/documentation\/GnustoSpellcasting\/SpellCost","url":"\/documentation\/gnustospellcasting\/spellcost","navigatorTitle":[{"kind":"identifier","text":"SpellCost"}],"kind":"symbol"},"doc://GnustoSpellcasting/documentation/GnustoSpellcasting":{"role":"collection","type":"topic","title":"GnustoSpellcasting","abstract":[{"text":"Four ways a spell becomes available, over one way of writing what it does.","type":"text"}],"identifier":"doc:\/\/GnustoSpellcasting\/documentation\/GnustoSpellcasting","url":"\/documentation\/gnustospellcasting","kind":"symbol"},"doc://Gnusto/documentation/Gnusto/Intent":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Intent"}],"navigatorTitle":[{"text":"Intent","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/gnusto\/intent","abstract":[{"text":"A canonical action the player can attempt. Games can mint their own —","type":"text"},{"text":" ","type":"text"},{"text":"most readably with ","type":"text"},{"type":"