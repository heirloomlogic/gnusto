ls as"},{"type":"text","text":" "},{"type":"text","text":"the hoard is rearranged."}],"type":"paragraph"},{"inlineContent":[{"code":"maxScore","type":"codeVoice"},{"text":" is still the host’s own literal — the engine reads it at","type":"text"},{"text":" ","type":"text"},{"text":"bootstrap, before any rule can run — but it is no longer unchecked. The","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/awards","isActive":true,"type":"reference"},{"text":" table is the one place a register’s value is written, so the","type":"text"},{"text":" ","type":"text"},{"text":"manifest and the payout cannot drift apart, and ","type":"text"},{"code":"ScoreDeclaring","type":"codeVoice"},{"text":" hands","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the total to the bootstrap, which warns when it disagrees with "},{"type":"codeVoice","code":"maxScore"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"relationshipsSections":[{"kind":"relationships","type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/GameContent","doc:\/\/Gnusto\/documentation\/Gnusto\/ScoreDeclaring","doc:\/\/GnustoScoring\/s8CopyableP","doc:\/\/GnustoScoring\/s9EscapableP","doc:\/\/GnustoScoring\/s8SendableP","doc:\/\/GnustoScoring\/s16SendableMetatypeP"]}],"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"paths":["\/documentation\/gnustoscoring\/scoring"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://GnustoScoring/documentation/GnustoScoring/Scoring/GameContent-Implementations":{"abstract":[],"type":"topic","url":"\/documentation\/gnustoscoring\/scoring\/gamecontent-implementations","title":"GameContent Implementations","identifier":"doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/GameContent-Implementations","kind":"article","role":"collectionGroup"},"doc://GnustoScoring/documentation/GnustoScoring/Scor