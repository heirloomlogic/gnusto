falls as"},{"type":"text","text":" "},{"type":"text","text":"the hoard is rearranged."}]},{"type":"paragraph","inlineContent":[{"code":"maxScore","type":"codeVoice"},{"type":"text","text":" is still the host’s own literal — the engine reads it at"},{"type":"text","text":" "},{"type":"text","text":"bootstrap, before any rule can run — but it is no longer unchecked. The"},{"type":"text","text":" "},{"identifier":"doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/awards","type":"reference","isActive":true},{"type":"text","text":" table is the one place a register’s value is written, so the"},{"type":"text","text":" "},{"type":"text","text":"manifest and the payout cannot drift apart, and "},{"code":"ScoreDeclaring","type":"codeVoice"},{"type":"text","text":" hands"},{"type":"text","text":" "},{"type":"text","text":"the total to the bootstrap, which warns when it disagrees with "},{"code":"maxScore","type":"codeVoice"},{"type":"text","text":"."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/gnustoscoring\/scoring"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/GnustoScoring\/documentation\/GnustoScoring"]]},"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/GameContent","doc:\/\/Gnusto\/documentation\/Gnusto\/ScoreDeclaring","doc:\/\/GnustoScoring\/s8CopyableP","doc:\/\/GnustoScoring\/s9EscapableP","doc:\/\/GnustoScoring\/s8SendableP","doc:\/\/GnustoScoring\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships"}],"references":{"doc://GnustoScoring/s8SendableP":{"identifier":"doc:\/\/GnustoScoring\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://GnustoScoring/documentation/GnustoScoring/Scoring/init(awards:)":{"kind":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"awards"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"Stri