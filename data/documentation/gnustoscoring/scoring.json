type":"text","text":" "},{"type":"text","text":"good), and its "},{"code":".depositValue","type":"codeVoice"},{"type":"text","text":" follows the trophy case — credited when"},{"type":"text","text":" "},{"type":"text","text":"the treasure lands inside, debited when it is taken back out, the"},{"type":"text","text":" "},{"type":"text","text":"original’s in-case accounting. Register keys derive from the item’s"},{"type":"text","text":" "},{"type":"text","text":"entity ID (“take.greenGem”) — the property it was declared as, dotted"},{"type":"text","text":" "},{"type":"text","text":"under its bundle for a treasure a "},{"code":"GameContent","type":"codeVoice"},{"type":"text","text":" declares"},{"type":"text","text":" "},{"type":"text","text":"(“take.AtticContent.greenGem”) — so two treasures that share a display"},{"type":"text","text":" "},{"type":"text","text":"name still score separately, and rewording a treasure’s "},{"code":"name","type":"codeVoice"},{"type":"text","text":" in a"},{"type":"text","text":" "},{"type":"text","text":"later build does not strand the credit a player’s save is holding."}],"type":"topic"},"doc://GnustoScoring/s8CopyableP":{"identifier":"doc:\/\/GnustoScoring\/s8CopyableP","type":"unresolvable","title":"Swift.Copyable"},"doc://GnustoScoring/documentation/GnustoScoring/Scoring":{"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Scoring"}],"navigatorTitle":[{"text":"Scoring","kind":"identifier"}],"url":"\/documentation\/gnustoscoring\/scoring","role":"symbol","identifier":"doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring","title":"Scoring","abstract":[{"type":"text","text":"Treasure scoring: typed point values on items, a declared table of"},{"type":"text","text":" "},{"type":"text","text":"award-once registers, and take\/deposit wiring for a trophy case. Add it to"},{"type":"text","text":" "},{"text":"a game’s ","type":"text"},{"code":"content","type":"codeVoice"},{"type":"text","text":" block, name every award it can pay, put values on the"},{"type":"text","text":" "},{"type":"text","text":"treasures, and splice one factory call into the rules:"}],"type":"topic"},"doc://Gnusto/documentation/Gnusto/GameContent":{"abstract":[{"type":"text","text":"A self-contained slice of a game’s world: its own rooms, items, and"},{"type":"text","text":" "},{"code":"@Global","type":"codeVoice"},{"type":"text","text":" state, plus the geography, rules, and verbs that go with them."}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"GameContent"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameContent","url":"\/documentation\/gnusto\/gamecontent","title":"GameContent","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"GameContent"}]},"doc://GnustoScoring/documentation/GnustoScoring/Scoring/penalize(_:)":{"abstract":[{"type":"text","text":"Deducts "},{"code":"points","type":"codeVoice"},{"type":"text","text":" from the score — the flip side of "},{"code":"awardOnce","type":"codeVoice"},{"type":"text","text":", for"},{"type":"text","text":" "},{"type":"text","text":"penalties that aren’t award-once (a death toll charged every time)."},{"type":"text","text":" "},{"type":"text","text":"Unlike an award, this is not registered and can repeat."}],"kind":"symbol","identifier":"doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/penalize(_:)","url":"\/documentation\/gnustoscoring\/scoring\/penalize(_:)","title":"penalize(_:)","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"penalize"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":")"}]},"doc://GnustoScoring/documentation/GnustoScoring/Scoring/awardOnce(_:)":{"abstract":[{"type":"text","text":"Awards a register’s declared points e