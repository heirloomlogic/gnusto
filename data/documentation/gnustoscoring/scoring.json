{"seeAlsoSections":[{"generated":true,"title":"The content bundle","anchor":"The-content-bundle","identifiers":["doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/init(awards:)","doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/awards"]}],"metadata":{"roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scoring","kind":"identifier"}],"role":"symbol","modules":[{"name":"GnustoScoring"}],"externalID":"s:13GnustoScoring0B0V","title":"Scoring","symbolKind":"struct","navigatorTitle":[{"text":"Scoring","kind":"identifier"}]},"sections":[],"abstract":[{"text":"Treasure scoring: typed point values on items, a declared table of","type":"text"},{"text":" ","type":"text"},{"text":"award-once registers, and take\/deposit wiring for a trophy case. Add it to","type":"text"},{"text":" ","type":"text"},{"text":"a game’s ","type":"text"},{"code":"content","type":"codeVoice"},{"text":" block, name every award it can pay, put values on the","type":"text"},{"text":" ","type":"text"},{"text":"treasures, and splice one factory call into the rules:","type":"text"}],"hierarchy":{"paths":[["doc:\/\/GnustoScoring\/documentation\/GnustoScoring"]]},"topicSections":[{"generated":true,"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/init(awards:)"]},{"generated":true,"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/awards"]},{"generated":true,"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/awardOnce(_:)","doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/penalize(_:)","doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/treasures(_:into:)","doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/visit(_:register:)"]},{"generated":true,"title"