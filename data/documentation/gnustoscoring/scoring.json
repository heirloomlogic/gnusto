":"reference","identifier":"doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/awards"},{"text":" table is the one place a register’s value is written, so the","type":"text"},{"text":" ","type":"text"},{"text":"manifest and the payout cannot drift apart, and ","type":"text"},{"type":"codeVoice","code":"ScoreDeclaring"},{"text":" hands","type":"text"},{"text":" ","type":"text"},{"text":"the total to the bootstrap, which warns when it disagrees with ","type":"text"},{"type":"codeVoice","code":"maxScore"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/gnustoscoring\/scoring"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Scoring"}],"title":"Scoring","navigatorTitle":[{"text":"Scoring","kind":"identifier"}],"modules":[{"name":"GnustoScoring"}],"symbolKind":"struct","role":"symbol","externalID":"s:13GnustoScoring0B0V"},"sections":[],"identifier":{"url":"doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/GnustoScoring\/documentation\/GnustoScoring"]]},"seeAlsoSections":[{"title":"The content bundle","anchor":"The-content-bundle","identifiers":["doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/init(awards:)","doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/awards"],"generated":true}],"references":{"doc://GnustoScoring/documentation/GnustoScoring/Scoring/treasures(_:into:)":{"title":"treasures(_:into:)","abstract":[{"text":"For each treasure: the first ","type":"text"},{"type":"codeVoice","code":"take"},{"text":" pays its ","type":"text"},{"type":"codeVoice","code":".takeValue"},{"text":" (once, for","type":"text"},{"text":" ","type":"text"},{"text":"good), and its ","type":"text"},{"type":"codeVoice","code":".depositValue"},{"text":" follows the trophy case — credited when","type":"text"},{"text":" ","type":"text"},{"text":"the treasure lands inside, debited when it is taken back out, the","type":"text"},{"text":" ","type":"text"},{"text":"original’s in-case accounting. Register keys derive from the item’s","type":"text"},{"text":" ","type":"text"},{"text":"entity ID (“take.greenGem”) — the property it was declared as, dotted","type":"text"},{"text":" ","type":"text"},{"text":"under its bundle for a treasure a ","type":"text"},{"type":"codeVoice","code":"GameContent"},{"text":" declares","type":"text"},{"text":" ","type":"text"},{"text":"(“take.AtticContent.greenGem”) — so two treasures that share a display","type":"text"},{"text":" ","type":"text"},{"text":"name still score separately, and rewording a treasure’s ","type":"text"},{"type":"codeVoice","code":"name"},{"text":" in a","type":"text"},{"text":" ","type":"text"},{"text":"later build does not strand the credit a player’s save is holding.","type":"text"}],"url":"\/documentation\/gnustoscoring\/scoring\/treasures(_:into:)","kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/treasures(_:into:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"treasures","kind":"identifier"},{"text":"([","kind":"text"},{"preciseIdentifier":"s:6Gnusto4ItemV","text":"Item","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"into","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6Gnusto4ItemV","text":"Item","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:6Gnusto5RulesV","text":"Rules","kind":"typeIdentifier"}]},"doc://GnustoScoring/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/GnustoScoring\/s8SendableP"},"doc://GnustoScoring/documentation/GnustoScoring/Scoring/awardOnce(_:)":{"type":"topic","kind":"symbol","url":"\/documentation\/gnustoscor