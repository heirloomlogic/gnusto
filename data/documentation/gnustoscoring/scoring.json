{"metadata":{"title":"Scoring","symbolKind":"struct","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Scoring"}],"externalID":"s:13GnustoScoring0B0V","modules":[{"name":"GnustoScoring"}],"roleHeading":"Structure","navigatorTitle":[{"kind":"identifier","text":"Scoring"}]},"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/GameContent","doc:\/\/Gnusto\/documentation\/Gnusto\/ScoreDeclaring","doc:\/\/GnustoScoring\/s8CopyableP","doc:\/\/GnustoScoring\/s9EscapableP","doc:\/\/GnustoScoring\/s8SendableP","doc:\/\/GnustoScoring\/s16SendableMetatypeP"]}],"seeAlsoSections":[{"title":"The content bundle","generated":true,"anchor":"The-content-bundle","identifiers":["doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/init(awards:)","doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/awards"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Scoring"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"syntax":"swift","code":["let scoring = Scoring(awards: [\"cellar\": 25])","","let idol = Item { name(\"jade idol\"); trait(.takeValue, 5); trait(.depositValue, 8) }","","var content: GameContents { scoring }","var rules: Rules {","    scoring.treasures([idol], into: trophyCase)","    scoring.visit(cellar, register: \"cellar\")","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The engine’s own "},{"type":"codeVoice","code":"score"},{"type":"text","text":" verb, status line, and end-of-game epilogue do"},{"type":"text","text":" "},{"type":"text","text":"the reporting; this plugin only moves the number. "},{"type":"strong","inlineContent":[{"type":"text","text":"Take"}]},{"type":"text","text":" value is paid"},{"type":"text","text":" "},{"type":"text","text":"once per register and never taken back (re-taking a dropped treasure is a"},{"type":"text","text":" "},{"type":"text","text":"no-op). "},{"type":"strong","inlineContent":[{"type":"text","text":"Deposit"}]},{"type":"text","text":" value follows the original Zork’s in-case accounting:"},{"type":"text","text":" "},{"type":"text","text":"it is credited each time a treasure lands in the trophy case and debited"},{"type":"text","text":" "},{"type":"text","text":"again when the treasure leaves, so the displayed score rises and falls as"},{"type":"text","text":" "},{"type":"text","text":"the hoard is rearranged."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"maxScore"},{"type":"text","text":" is still the host’s own literal — the engine reads it at"},{"type":"text","text":" "},{"type":"text","text":"bootstrap, before any rule can run — but it is no longer unchecked. The"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/awards"},{"type":"text","text":" table is the one place a register’s value is written, so the"},{"type":"text","text":" "},{"type":"text","text":"manifest and the payout cannot drift apart, and "},{"type":"codeVoice","code":"ScoreDeclaring"},{"type":"text","text":" hands"},{"type":"text","text":" "},{"type":"text","text":"the total to the bootstrap, which warns when it disagrees with "},{"type":"codeVoice","code":"maxScore"},{"type":"text","text":"."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnustoscoring\/scoring"]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GnustoScoring\/documentation\/GnustoScoring"]]},"abstract":[{"type":"text","text":"Treasure scoring: typed point values on items, a declared table of"},{"type":"text","text":" "},{"type":"text","text":"award-once registers, and take\/d