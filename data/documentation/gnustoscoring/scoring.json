{"abstract":[{"text":"Treasure scoring: typed point values on items, a declared table of","type":"text"},{"text":" ","type":"text"},{"text":"award-once registers, and take\/deposit wiring for a trophy case. Add it to","type":"text"},{"type":"text","text":" "},{"type":"text","text":"a game’s "},{"type":"codeVoice","code":"content"},{"type":"text","text":" block, name every award it can pay, put values on the"},{"text":" ","type":"text"},{"type":"text","text":"treasures, and splice one factory call into the rules:"}],"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/init(awards:)"],"anchor":"Initializers","generated":true},{"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/awards"],"generated":true},{"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/awardOnce(_:)","doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/penalize(_:)","doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/treasures(_:into:)","doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/visit(_:register:)"],"generated":true},{"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/GameContent-Implementations","doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/ScoreDeclaring-Implementations"],"generated":true}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/GameContent","doc:\/\/Gnusto\/documentation\/Gnusto\/ScoreDeclaring","doc:\/\/GnustoScoring\/s8CopyableP","doc:\/\/GnustoScoring\/s9EscapableP","doc:\/\/GnustoScoring\/s8SendableP","doc:\/\/GnustoScoring\/s16SendableMetatypeP"],"kind":"relationships","type":"conformsTo"}],"kind":"symbol","primaryContentSections":[{"kind":"decla