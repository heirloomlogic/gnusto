{"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","sections":[],"abstract":[{"type":"text","text":"Treasure scoring: typed point values on items, a declared table of"},{"type":"text","text":" "},{"type":"text","text":"award-once registers, and take\/deposit wiring for a trophy case. Add it to"},{"type":"text","text":" "},{"type":"text","text":"a game’s "},{"type":"codeVoice","code":"content"},{"type":"text","text":" block, name every award it can pay, put values on the"},{"type":"text","text":" "},{"type":"text","text":"treasures, and splice one factory call into the rules:"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring"},"metadata":{"symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"Scoring"}],"modules":[{"name":"GnustoScoring"}],"roleHeading":"Structure","role":"symbol","externalID":"s:13GnustoScoring0B0V","title":"Scoring","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Scoring"}]},"topicSections":[{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/init(awards:)"],"generated":true},{"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/awards"],"generated":true},{"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/awardOnce(_:)","doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/penalize(_:)","doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/treasures(_:into:)","doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/visit(_:register:)"],"generated":true},{"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/GameContent-Implementations","doc:\/\/Gnusto