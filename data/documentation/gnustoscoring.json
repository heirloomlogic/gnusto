{"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnustoscoring"]}],"abstract":[{"text":"Treasure and event scoring, over an award table the bootstrap can add up.","type":"text"}],"metadata":{"externalID":"GnustoScoring","symbolKind":"module","modules":[{"name":"GnustoScoring"}],"roleHeading":"Framework","role":"collection","title":"GnustoScoring"},"topicSections":[{"title":"The content bundle","identifiers":["doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring","doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/init(awards:)","doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/awards"],"anchor":"The-content-bundle"},{"identifiers":["doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/treasures(_:into:)","doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/visit(_:register:)"],"title":"Rules the host splices","anchor":"Rules-the-host-splices"},{"identifiers":["doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/awardOnce(_:)","doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/penalize(_:)"],"anchor":"Scoring-from-a-rule-body","title":"Scoring from a rule body"},{"identifiers":["doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Gnusto\/TraitKey\/takeValue","doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Gnusto\/TraitKey\/depositValue"],"anchor":"Declaring-a-treasures-value","title":"Declaring a treasure’s value"},{"identifiers":["doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/declaredMaxScore(items:)"],"anchor":"Checking-the-total","title":"Checking the total"}],"hierarchy":{"paths":[[]]},"identifier":{"url":"doc:\/\/GnustoScoring\/documentation\/GnustoScoring","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"text":"A game’s ","type":"text"},{"code":"maxScore","type":"codeVoice"},{"text":" is a literal, read at bootstrap before a single rule has run,","type":"text"},{"text":" ","type":"text"},{"text":"so on its own it is the author’s arithmetic and nothing else. Add a sixth award","type":"text"},{"text":" ","type":"text"},{"text":"and forget the total, and the game ships with a ceiling the player walks straight","type":"text"},{"text":" ","type":"text"},{"text":"past. This library makes the award table the one place a register’s points are","type":"text"},{"text":" ","type":"text"},{"text":"written, and hands the total to the bootstrap, which compares it against","type":"text"},{"text":" ","type":"text"},{"code":"maxScore","type":"codeVoice"},{"text":" and warns when the two disagree.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring","type":"reference"},{"text":" is a ","type":"text"},{"code":"GameContent","type":"codeVoice"},{"text":" bundle rather than a ","type":"text"},{"code":"GamePlugin","type":"codeVoice"},{"text":", because it owns","type":"text"},{"text":" ","type":"text"},{"text":"saved state: two sets of register names — the awards already paid, and the","type":"text"},{"text":" ","type":"text"},{"text":"treasures currently sitting in the trophy case. Both are ","type":"text"},{"code":"@Global","type":"codeVoice"},{"text":", so they","type":"text"},{"text":" ","type":"text"},{"text":"namespace under ","type":"text"},{"code":"Scoring","type":"codeVoice"},{"text":" and ride along in save files. That makes the wiring two","type":"text"},{"text":" ","type":"text"},{"text":"steps rather than one. List the instance in the game’s ","type":"text"},{"type":"codeVoice","code":"content"},{"text":" block, then","type":"text"},{"text":" ","type":"text"},{"text":"splice its rule factories into the game’s own ","type":"text"},{"code":"rules","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Everything the rules operate on is the host’s. The host declares the treasures","type":"text"},{"text":" ","type":"text"},{"text":"and puts a ","type":"text"},{"code":".takeValue","type":"codeVoice"},{"text":" and a ","type":"text"},{"code":".depositValue","type":"codeVoice"},{"text":" on each, declares the trophy case,","type":"text"},{"text":" ","type":"text"},{"text":"and names the rooms whose first entry pays. ","type":"text"},{"isActive":true,"identifier":"doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring","type":"reference"},{"text":" reads those traits and","type":"text"},{"text":" ","type":"text"},{"text":"moves the number; the engine’s ","type":"text"},{"type":"codeVoice","code":"score"},{"text":" verb, status line and end-of-game epilogue","type":"text"},{"text":" ","type":"text"},{"text":"do all the reporting.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Take","type":"text"}],"type":"strong"},{"text":" value is paid once per treasure and never taken back — dropping a gem","type":"text"},{"text":" ","type":"text"},{"text":"down a well does not refund it. ","type":"text"},{"inlineContent":[{"text":"Deposit","type":"text"}],"type":"strong"},{"text":" value follows the original Zork’s","type":"text"},{"text":" ","type":"text"},{"text":"in-case accounting: credited when the treasure lands in the trophy case, debited","type":"text"},{"text":" ","type":"text"},{"text":"when it comes back out, so the displayed score rises and falls as the hoard is","type":"text"},{"text":" ","type":"text"},{"text":"rearranged. ","type":"text"},{"isActive":true,"identifier":"doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/awardOnce(_:)","type":"reference"},{"text":" on a register missing from the table is a","type":"text"},{"text":" ","type":"text"},{"code":"fatalError","type":"codeVoice"},{"text":" rather than a silent zero, because a typo that pays nothing puts the","type":"text"},{"text":" ","type":"text"},{"text":"game quietly past its own maximum and nothing else would catch it.","type":"text"}],"type":"paragraph"},{"anchor":"Wiring","level":2,"type":"heading","text":"Wiring"},{"syntax":"swift","code":["import Gnusto","import GnustoScoring","","struct Hoard: Game {","    let title = \"Hoard\"","    let maxScore = 38","","    let scoring = Scoring(awards: [\"cellar\": 25])","","    let cellar = Location { name(\"Cellar\"); description(\"A low, dirt-floored cellar.\") }","    let idol = Item {","        name(\"jade idol\")","        trait(.takeValue, 5)","        trait(.depositValue, 8)","    }","    let trophyCase = Item { name(\"trophy case\"); container; openable; transparent }","","    var content: GameContents { scoring }","","    var rules: Rules {","        scoring.treasures([idol], into: trophyCase)","        scoring.visit(cellar, register: \"cellar\")","    }","","    var map: WorldMap { … }","}"],"type":"codeListing"},{"inlineContent":[{"text":"25 for the cellar, 5 for taking the idol, 8 for casing it: 38, which is what","type":"text"},{"text":" ","type":"text"},{"code":"maxScore","type":"codeVoice"},{"text":" says. Change any one of the three and the bootstrap says so.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"An award that fires from somewhere other than a room entry calls","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/awardOnce(_:)","type":"reference"},{"text":" from inside any rule body, and reads its points from","type":"text"},{"text":" ","type":"text"},{"text":"the same table:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["beacon.after(.turnOn) {","    scoring.awardOnce(\"beacon\")","}"],"type":"codeListing"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/penalize(_:)","type":"reference"},{"text":" is the other direction, and is deliberately not","type":"text"},{"text":" ","type":"text"},{"text":"registered — a death toll is charged every time. The score is a plain ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" with","type":"text"},{"text":" ","type":"text"},{"text":"no floor, so it can go negative, as it does in the original after an early death.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Treasure values are not listed in the award table. They are already declared on","type":"text"},{"text":" ","type":"text"},{"text":"the items, and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/declaredMaxScore(items:)","type":"reference"},{"text":" sums them off the world. A","type":"text"},{"text":" ","type":"text"},{"text":"game with an empty table and no valued treasures declares nothing and opts out of","type":"text"},{"text":" ","type":"text"},{"text":"the check.","type":"text"}],"type":"paragraph"},{"anchor":"Worked-examples","level":2,"type":"heading","text":"Worked examples"},{"inlineContent":[{"code":"Sources\/Lighthouse\/","type":"codeVoice"},{"text":" is the shortest: two event awards, one through","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/visit(_:register:)","type":"reference"},{"text":" and one through ","type":"text"},{"isActive":true,"identifier":"doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/awardOnce(_:)","type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"code":"Sources\/Zork1\/","type":"codeVoice"},{"text":" is the full shape — five event awards plus nineteen treasures","type":"text"},{"text":" ","type":"text"},{"text":"whose take and deposit values total exactly the original’s 350.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://GnustoScoring/documentation/GnustoScoring/Scoring/init(awards:)":{"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"awards","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":" : ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"])","kind":"text"}],"url":"\/documentation\/gnustoscoring\/scoring\/init(awards:)","identifier":"doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/init(awards:)","kind":"symbol","role":"symbol","type":"topic","abstract":[{"type":"text","text":"Creates the scoring content."}],"title":"init(awards:)"},"doc://GnustoScoring/documentation/GnustoScoring/Gnusto/TraitKey/depositValue":{"conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"type":"codeVoice","code":"Value"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"Int"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"depositValue"},{"kind":"text","text":": "},{"preciseIdentifier":"s:6Gnusto8TraitKeyV","kind":"typeIdentifier","text":"TraitKey"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":">"}],"url":"\/documentation\/gnustoscoring\/gnusto\/traitkey\/depositvalue","kind":"symbol","identifier":"doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Gnusto\/TraitKey\/depositValue","role":"symbol","type":"topic","abstract":[{"text":"Points awarded the first time this treasure lands in the trophy case.","type":"text"}],"title":"depositValue"},"doc://GnustoScoring/documentation/GnustoScoring/Scoring/treasures(_:into:)":{"identifier":"doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/treasures(_:into:)","role":"symbol","abstract":[{"type":"text","text":"For each treasure: the first "},{"type":"codeVoice","code":"take"},{"type":"text","text":" pays its "},{"type":"codeVoice","code":".takeValue"},{"type":"text","text":" (once, for"},{"type":"text","text":" "},{"type":"text","text":"good), and its "},{"type":"codeVoice","code":".depositValue"},{"type":"text","text":" follows the trophy case — credited when"},{"type":"text","text":" "},{"type":"text","text":"the treasure lands inside, debited when it is taken back out, the"},{"type":"text","text":" "},{"type":"text","text":"original’s in-case accounting. Register keys derive from the item’s"},{"type":"text","text":" "},{"type":"text","text":"display name (“take.green gem”), so treasures wired here need unique"},{"type":"text","text":" "},{"type":"text","text":"names. Splice into the host’s rules:"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"treasures"},{"kind":"text","text":"(["},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto4ItemV","text":"Item"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"into"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto4ItemV","text":"Item"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto5RulesV","text":"Rules"}],"url":"\/documentation\/gnustoscoring\/scoring\/treasures(_:into:)","type":"topic","title":"treasures(_:into:)","kind":"symbol"},"doc://GnustoScoring/documentation/GnustoScoring/Scoring/penalize(_:)":{"abstract":[{"text":"Deducts ","type":"text"},{"code":"points","type":"codeVoice"},{"text":" from the score — the flip side of ","type":"text"},{"code":"awardOnce","type":"codeVoice"},{"text":", for","type":"text"},{"text":" ","type":"text"},{"text":"penalties that aren’t award-once (a death toll charged every time).","type":"text"},{"text":" ","type":"text"},{"text":"Unlike an award, this is not registered and can repeat.","type":"text"}],"role":"symbol","identifier":"doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/penalize(_:)","url":"\/documentation\/gnustoscoring\/scoring\/penalize(_:)","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"penalize"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"text":")","kind":"text"}],"title":"penalize(_:)","type":"topic","kind":"symbol"},"doc://GnustoScoring/documentation/GnustoScoring/Gnusto/TraitKey/takeValue":{"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"takeValue"},{"kind":"text","text":": "},{"preciseIdentifier":"s:6Gnusto8TraitKeyV","kind":"typeIdentifier","text":"TraitKey"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":">"}],"kind":"symbol","identifier":"doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Gnusto\/TraitKey\/takeValue","abstract":[{"text":"Points awarded the first time this treasure is taken.","type":"text"}],"type":"topic","conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"Value","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"url":"\/documentation\/gnustoscoring\/gnusto\/traitkey\/takevalue","role":"symbol","title":"takeValue"},"doc://GnustoScoring/documentation/GnustoScoring/Scoring/visit(_:register:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"visit","kind":"identifier"},{"kind":"text","text":"("},{"preciseIdentifier":"s:6Gnusto8LocationV","kind":"typeIdentifier","text":"Location"},{"kind":"text","text":", "},{"kind":"externalParam","text":"register"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:6Gnusto4RuleV","kind":"typeIdentifier","text":"Rule"}],"url":"\/documentation\/gnustoscoring\/scoring\/visit(_:register:)","identifier":"doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/visit(_:register:)","kind":"symbol","role":"symbol","type":"topic","abstract":[{"type":"text","text":"An "},{"code":"onEnter","type":"codeVoice"},{"type":"text","text":" rule that pays "},{"code":"register","type":"codeVoice"},{"type":"text","text":"‘s declared points the first time"},{"type":"text","text":" "},{"type":"text","text":"the player enters "},{"code":"room","type":"codeVoice"},{"type":"text","text":", through "},{"code":"awardOnce","type":"codeVoice"},{"type":"text","text":" — the event-scoring idiom"},{"type":"text","text":" "},{"type":"text","text":"(Zork’s “into the cellar, +25”). Splice into the host’s rules:"}],"title":"visit(_:register:)"},"doc://GnustoScoring/documentation/GnustoScoring/Scoring/awardOnce(_:)":{"fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"awardOnce","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":")","kind":"text"}],"url":"\/documentation\/gnustoscoring\/scoring\/awardonce(_:)","identifier":"doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/awardOnce(_:)","kind":"symbol","role":"symbol","type":"topic","abstract":[{"text":"Awards a register’s declared points exactly once; later calls with the","type":"text"},{"text":" ","type":"text"},{"text":"same name are silent no-ops, as is a zero-point award. Callable from","type":"text"},{"text":" ","type":"text"},{"text":"any rule body:","type":"text"}],"title":"awardOnce(_:)"},"doc://GnustoScoring/documentation/GnustoScoring/Scoring/declaredMaxScore(items:)":{"identifier":"doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/declaredMaxScore(items:)","role":"symbol","abstract":[{"text":"Everything this plugin can pay over a complete playthrough: the declared","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/awards","type":"reference","isActive":true},{"text":" table, plus every treasure’s ","type":"text"},{"code":".takeValue","type":"codeVoice"},{"text":" and ","type":"text"},{"code":".depositValue","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"The bootstrap compares the total against the game’s ","type":"text"},{"code":"maxScore","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"declaredMaxScore"},{"kind":"text","text":"("},{"kind":"externalParam","text":"items"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto4ItemV","text":"Item"},{"kind":"text","text":"]) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"?"}],"url":"\/documentation\/gnustoscoring\/scoring\/declaredmaxscore(items:)","type":"topic","title":"declaredMaxScore(items:)","kind":"symbol"},"doc://GnustoScoring/documentation/GnustoScoring":{"abstract":[{"text":"Treasure and event scoring, over an award table the bootstrap can add up.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/GnustoScoring\/documentation\/GnustoScoring","type":"topic","url":"\/documentation\/gnustoscoring","role":"collection","title":"GnustoScoring"},"doc://GnustoScoring/documentation/GnustoScoring/Scoring/awards":{"identifier":"doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/awards","role":"symbol","abstract":[{"text":"Every award-once register this game can pay, and what each pays. The","type":"text"},{"text":" ","type":"text"},{"text":"single source of truth: ","type":"text"},{"identifier":"doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/awardOnce(_:)","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring\/visit(_:register:)","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"read their points from here rather than carrying them at the call site,","type":"text"},{"text":" ","type":"text"},{"text":"so the total the bootstrap checks is the total the game pays.","type":"text"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"awards"},{"text":": [","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":" : ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"]","kind":"text"}],"url":"\/documentation\/gnustoscoring\/scoring\/awards","title":"awards","type":"topic","kind":"symbol"},"doc://GnustoScoring/documentation/GnustoScoring/Scoring":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Scoring"}],"kind":"symbol","identifier":"doc:\/\/GnustoScoring\/documentation\/GnustoScoring\/Scoring","abstract":[{"text":"Treasure scoring: typed point values on items, a declared table of","type":"text"},{"text":" ","type":"text"},{"text":"award-once registers, and take\/deposit wiring for a trophy case. Add it to","type":"text"},{"text":" ","type":"text"},{"text":"a game’s ","type":"text"},{"type":"codeVoice","code":"content"},{"text":" block, name every award it can pay, put values on the","type":"text"},{"text":" ","type":"text"},{"text":"treasures, and splice one factory call into the rules:","type":"text"}],"type":"topic","url":"\/documentation\/gnustoscoring\/scoring","navigatorTitle":[{"kind":"identifier","text":"Scoring"}],"role":"symbol","title":"Scoring"}}}