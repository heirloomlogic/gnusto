{"metadata":{"symbolKind":"struct","title":"Clock","role":"symbol","externalID":"s:11GnustoClock0B0V","navigatorTitle":[{"text":"Clock","kind":"identifier"}],"modules":[{"name":"GnustoClock"}],"roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Clock","kind":"identifier"}]},"variants":[{"paths":["\/documentation\/gnustoclock\/clock"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"anchor":"The-clock","title":"The clock","identifiers":["doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/Text"],"generated":true}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Clock"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The clock is "},{"inlineContent":[{"text":"derived, not ticked","type":"text"}],"type":"strong"},{"type":"text","text":". "},{"code":"now","type":"codeVoice"},{"type":"text","text":" is a pure function of the"},{"type":"text","text":" "},{"type":"text","text":"engine’s "},{"code":"moves","type":"codeVoice"},{"type":"text","text":" counter, which means every rule, action, fuse and daemon"},{"type":"text","text":" "},{"type":"text","text":"in a turn reads the same time — including the timer tick at the end of it."},{"type":"text","text":" "},{"text":"A clock advanced by its own daemon would instead be read differently by","type":"text"},{"text":" ","type":"text"},{"text":"daemons sorting before and after it in the tick order, making the time","type":"text"},{"type":"text","text":" "},{"type":"text","text":"depend on other timers’ "},{"inlineContent":[{"type":"text","text":"names"}],"type":"emphasis"},{"type":"text","text":". Deriving also inherits the engine’s notion"},{"type":"text","text":" "},{"type":"text","text":"of world time for free: the clock already doesn’t move on a parse error or"},{"type":"text","text":" "},{"type":"text","text":"a meta command, and "},{"code":"take all","type":"codeVoice"},{"type":"text","text":" already costs one turn, not four."}]},{"code":["let clock = Clock(startingAt: TimeOfDay(17, 30), minutesPerTurn: 2)","","var content: GameContents { clock }        \/\/ registers the verb and the state","var timers: [TimedEvent] {","    clock.at(TimeOfDay(17, 46), named: \"blast\") {","        say(\"The carriage house goes up with a sound like a door slamming in a cave.\")","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Reading ","type":"text"},{"code":"now","type":"codeVoice"},{"text":" needs a live turn, so it belongs in rule bodies, ","type":"text"},{"code":"describe","type":"codeVoice"},{"text":" ","type":"text"},{"text":"blocks and actions — not in a ","type":"text"},{"code":"map","type":"codeVoice"},{"text":" block, which is evaluated at bootstrap.","type":"text"},{"text":" ","type":"text"},{"text":"Ask there and the engine traps, naming the ","type":"text"},{"code":"map","type":"codeVoice"},{"text":" block rather than the rule","type":"text"},{"text":" ","type":"text"},{"text":"body the author never wrote. What a map asks instead is ","type":"text"},{"isActive":true,"identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Timetable","type":"reference"},{"text":", which","type":"text"},{"text":" ","type":"text"},{"text":"reads no world state — the GnustoClock article has the line.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Not provided: "},{"type":"codeVoice","code":"wait until <time>"},{"type":"text","text":"."}]},{"type":"text","text":" The parser has no numeric slot and"},{"type":"text","text":" "},{"type":"text","text":"requires every token to be consumed, so "},{"code":"wait until 8 15","type":"codeVoice"},{"type":"text","text":" can 