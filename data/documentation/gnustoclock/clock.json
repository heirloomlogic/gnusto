{"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Clock"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"The clock is "},{"type":"strong","inlineContent":[{"type":"text","text":"derived, not ticked"}]},{"type":"text","text":". "},{"type":"codeVoice","code":"now"},{"type":"text","text":" is a pure function of the"},{"type":"text","text":" "},{"type":"text","text":"engine’s "},{"type":"codeVoice","code":"moves"},{"type":"text","text":" counter, which means every rule, action, fuse and daemon"},{"type":"text","text":" "},{"type":"text","text":"in a turn reads the same time — including the timer tick at the end of it."},{"type":"text","text":" "},{"type":"text","text":"A clock advanced by its own daemon would instead be read differently by"},{"type":"text","text":" "},{"type":"text","text":"daemons sorting before and after it in the tick order, making the time"},{"type":"text","text":" "},{"type":"text","text":"depend on other timers’ "},{"type":"emphasis","inlineContent":[{"type":"text","text":"names"}]},{"type":"text","text":". Deriving also inherits the engine’s notion"},{"type":"text","text":" "},{"type":"text","text":"of world time for free: the clock already doesn’t move on a parse error or"},{"type":"text","text":" "},{"type":"text","text":"a meta command, and "},{"type":"codeVoice","code":"take all"},{"type":"text","text":" already costs one turn, not four."}],"type":"paragraph"},{"code":["let clock = Clock(startingAt: TimeOfDay(17, 30), minutesPerTurn: 2)","","var content: GameContents { clock }        \/\/ registers the verb and the state","var timers: [TimedEvent] {","    clock.at(TimeOfDay(17, 46), named: \"blast\") {","        say(\"The carriage house goes up with a sound like a door slamming in a cave.\")","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Reading "},{"type":"codeVoice","code":"now"},{"type":"text","text":" needs a live turn, so it belongs in rule bodies, "},{"type":"codeVoice","code":"describe"},{"type":"text","text":" "},{"type":"text","text":"blocks and actions — not in a "},{"type":"codeVoice","code":"map"},{"type":"text","text":" block, which is evaluated at bootstrap."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Not provided: "},{"type":"codeVoice","code":"wait until <time>"},{"type":"text","text":"."}]},{"type":"text","text":" The parser has no numeric slot and"},{"type":"text","text":" "},{"type":"text","text":"requires every token to be consumed, so "},{"type":"codeVoice","code":"wait until 8 15"},{"type":"text","text":" can never match a"},{"type":"text","text":" "},{"type":"text","text":"pattern; and jumping the clock inside one turn would run a single timer"},{"type":"text","text":" "},{"type":"text","text":"tick, silently skipping any alarm in between. Waiting a named number of"},{"type":"text","text":" "},{"type":"text","text":"turns is the honest version, and the engine already does it."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnustoclock\/clock"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock","interfaceLanguage":"swift"},"abstract":[{"text":"A wall clock over the turn counter: a game where it is twenty to six, and","type":"text"},{"text":" ","type":"text"},{"text":"ten to six four turns later.","type":"text"}],"metadata":{"externalID":"s:11GnustoClock0B0V","symbolKind":"struct","modules":[{"name":"GnustoClock"}],"title":"Clock","roleHeading":"Structure","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Clock"}],"