{"topicSections":[{"title":"Structures","identifiers":["doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/Text"],"anchor":"Structures","generated":true},{"title":"Initializers","identifiers":["doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/init(startingAt:minutesPerTurn:format:text:)"],"anchor":"Initializers","generated":true},{"title":"Instance Properties","identifiers":["doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/actions","doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/day","doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/format","doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/minutesPerTurn","doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/now","doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/start","doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/statusFields","doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/verbs"],"anchor":"Instance-Properties","generated":true},{"title":"Instance Methods","identifiers":["doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/advance(by:)","doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/at(_:named:perform:)","doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/location(of:)","doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/location(of:at:)","doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/pause()","doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/resume()","doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/schedule(_:named:_:)","doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/set(to:)"],"anchor":"Instance-Methods","generated":true},{"title":"Default Implementations","identifiers":["doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/GameContent-Implementations"],"anchor":"Default-Implementations","generated":true}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock"},"metadata":{"modules":[{"name":"GnustoClock"}],"roleHeading":"Structure","navigatorTitle":[{"kind":"identifier","text":"Clock"}],"title":"Clock","externalID":"s:11GnustoClock0B0V","symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Clock"}],"role":"symbol"},"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GnustoClock\/documentation\/GnustoClock"]]},"seeAlsoSections":[{"title":"The clock","identifiers":["doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/Text"],"anchor":"The-clock","generated":true}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Clock","kind":"identifier"}]}]},{"kind":"content","content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"The clock is ","type":"text"},{"inlineContent":[{"type":"text","text":"derived, not ticked"}],"type":"strong"},{"type":"text","text":". "},{"code":"now","type":"codeVoice"},{"type":"text","text":" is a pure function of the"},{"type":"text","text":" "},{"type":"text","text":"engine’s "},{"code":"moves","type":"codeVoice"},{"type":"text","text":" counter, which means every rule, action, fuse and daemon"},{"type":"text","text":" "},{"type":"text","text":"in a turn reads the same time — including the timer tick at the end of it."},{"type":"text","text":" "},{"type":"text","text":"A clock advanced by its own daemon would instead be read differently by"},{"type":"text","text":" "},{"type":"text","text":"daemons sorting before and after it in the tick order, making the time"},{"type":"text","text":" "},{"type":"text","text":"depend on other timers’ "},{"type":"emphasis","inlineContent":[{"text":"names","type":"text"}]},{"type":"text","text":". Deriving also inherits the engine’s notion"},{"type":"text","text":" "},{"type":"text","text":"of world time for free: the clock already doesn’t move on a parse error or"},{"type":"text","text":" "},{"type":"text","text":"a meta command, and "},{"code":"take all","type":"codeVoice"},{"type":"text","text":" already costs one turn, not four."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let clock = Clock(startingAt: TimeOfDay(17, 30), minutesPerTurn: 2)","","var content: GameContents { clock }        \/\/ registers the verb and the state","var timers: [TimedEvent] {","    clock.at(TimeOfDay(17, 46), named: \"blast\") {","        say(\"The carriage house goes up with a sound like a door slamming in a cave.\")","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reading "},{"type":"codeVoice","code":"now"},{"type":"text","text":" needs a live turn, so it belongs in rule bodies, "},{"type":"codeVoice","code":"describe"},{"type":"text","text":" "},{"type":"text","text":"blocks and actions — not in a "},{"type":"codeVoice","code":"map"},{"text":" block, which is evaluated at bootstrap.","type":"text"},{"text":" ","type":"text"},{"text":"Ask there and the engine traps, naming the ","type":"text"},{"type":"codeVoice","code":"map"},{"type":"text","text":" block rather than the rule"},{"type":"text","text":" "},{"type":"text","text":"body the author never wrote. What a map asks instead is "},{"type":"reference","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Timetable","isActive":true},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"reads no world state — the GnustoClock article has the line."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Not provided: ","type":"text"},{"code":"wait until <time>","type":"codeVoice"},{"text":".","type":"text"}],"type":"strong"},{"text":" The parser has no numeric slot and","type":"text"},{"text":" ","type":"text"},{"text":"requires every token to be consumed, so ","type":"text"},{"type":"codeVoice","code":"wait until 8 15"},{"text":" can never match a","type":"text"},{"text":" ","type":"text"},{"text":"pattern; and jumping the clock inside one turn would run a single timer","type":"text"},{"text":" ","type":"text"},{"text":"tick, silently skipping any alarm in between. Waiting a named number of","type":"text"},{"text":" ","type":"text"},{"text":"turns is the honest version, and the engine already does it.","type":"text"}]}]}],"abstract":[{"text":"A wall clock over the turn counter: a game where it is twenty to six, and","type":"text"},{"text":" ","type":"text"},{"text":"ten to six four turns later.","type":"text"}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/GameContent","doc:\/\/GnustoClock\/s8SendableP","doc:\/\/GnustoClock\/s16SendableMetatypeP"],"type":"conformsTo"}],"variants":[{"paths":["\/documentation\/gnustoclock\/clock"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://GnustoClock/documentation/GnustoClock/Clock/Text":{"identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/Text","kind":"symbol","url":"\/documentation\/gnustoclock\/clock\/text","navigatorTitle":[{"kind":"identifier","text":"Text"}],"type":"topic","title":"Clock.Text","abstract":[{"type":"text","text":"The clock’s own voice: the one line the mechanics print. Override the"},{"type":"text","text":" "},{"type":"text","text":"line at init to re-skin; the clock stores its table as a "},{"code":"let","type":"codeVoice"},{"type":"text","text":", so init"},{"type":"text","text":" "},{"type":"text","text":"is the only chance."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Text"}],"role":"symbol"},"doc://GnustoClock/s16SendableMetatypeP":{"identifier":"doc:\/\/GnustoClock\/s16SendableMetatypeP","title":"Swift.SendableMetatype","type":"unresolvable"},"doc://GnustoClock/documentation/GnustoClock/Clock/init(startingAt:minutesPerTurn:format:text:)":{"abstract":[{"text":"Creates a clock