{"seeAlsoSections":[{"identifiers":["doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/Text"],"title":"The clock","anchor":"The-clock","generated":true}],"sections":[],"hierarchy":{"paths":[["doc:\/\/GnustoClock\/documentation\/GnustoClock"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Clock","kind":"identifier"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"The clock is ","type":"text"},{"inlineContent":[{"text":"derived, not ticked","type":"text"}],"type":"strong"},{"type":"text","text":". "},{"type":"codeVoice","code":"now"},{"type":"text","text":" is a pure function of the"},{"type":"text","text":" "},{"type":"text","text":"engine’s "},{"type":"codeVoice","code":"moves"},{"type":"text","text":" counter, which means every rule, action, fuse and daemon"},{"type":"text","text":" "},{"type":"text","text":"in a turn reads the same time — including the timer tick at the end of it."},{"type":"text","text":" "},{"type":"text","text":"A clock advanced by its own daemon would instead be read differently by"},{"type":"text","text":" "},{"type":"text","text":"daemons sorting before and after it in the tick order, making the time"},{"type":"text","text":" "},{"type":"text","text":"depend on other timers’ "},{"inlineContent":[{"text":"names","type":"text"}],"type":"emphasis"},{"type":"text","text":". Deriving also inherits the engine’s notion"},{"type":"text","text":" "},{"type":"text","text":"of world time for free: the clock already doesn’t move on a parse error or"},{"type":"text","text":" "},{"type":"text","text":"a meta command, and "},{"type":"codeVoice","code":"take all"},{"type":"text","text":" already costs one turn, not four."}]},{"type":"codeListing","code":["let clock = Clock(startingAt: TimeOfDay(17, 30), minutesPerTurn: 2)","","var content: GameContents { clock }        \/\/ registers the verb and the state","var timers: [TimedEvent] {","    clock.at(TimeOfDay(17, 46), named: \"blast\") {","        say(\"The carriage house goes up with a sound like a door slamming in a cave.\")","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reading "},{"code":"now","type":"codeVoice"},{"type":"text","text":" needs a live turn, so it belongs in rule bodies, "},{"code":"describe","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"blocks and actions — not in a "},{"code":"map","type":"codeVoice"},{"text":" block, which is evaluated at bootstrap.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Not provided: ","type":"text"},{"type":"codeVoice","code":"wait until <time>"},{"text":".","type":"text"}],"type":"strong"},{"text":" The parser has no numeric slot and","type":"text"},{"text":" ","type":"text"},{"text":"requires every token to be consumed, so ","type":"text"},{"code":"wait until 8 15","type":"codeVoice"},{"text":" can never match a","type":"text"},{"text":" ","type":"text"},{"text":"pattern; and jumping the clock inside one turn would run a single timer","type":"text"},{"text":" ","type":"text"},{"text":"tick, silently skipping any alarm in between. Waiting a named number of","type":"text"},{"text":" ","type":"text"},{"text":"turns is the honest version, and the engine already does it.","type":"text"}]}]}],"metadata":{"role":"symbol","roleHeading":"Structure","symbolKind":"struct","navigatorTitle":[{"text":"Clock","kind":"identifier"}],"modules":[{"name":"GnustoClock"}],"externalID":"s:11GnustoClock0B0V","title":"Clock","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Clock","kind":"identifier"}]},"kind":"symbol","abstract":[{"text":"A wall clock over the turn counter: a game where it is twenty to six, and","t