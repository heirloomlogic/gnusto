{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnustoclock\/clock\/schedule(_:daemonname:_:)"]}],"metadata":{"roleHeading":"Instance Method","modules":[{"name":"GnustoClock"}],"role":"symbol","title":"schedule(_:daemonName:_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"schedule"},{"kind":"text","text":"("},{"preciseIdentifier":"s:6Gnusto5ActorV","kind":"typeIdentifier","text":"Actor"},{"kind":"text","text":", "},{"kind":"externalParam","text":"daemonName"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"preciseIdentifier":"s:11GnustoClock9TimetableV","kind":"typeIdentifier","text":"Timetable"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:6Gnusto10TimedEventV","kind":"typeIdentifier","text":"TimedEvent"}],"extendedModule":"GnustoClock","externalID":"s:11GnustoClock0B0V8schedule_10daemonName_0A010TimedEventVAF5ActorV_SSAA9TimetableVtF","symbolKind":"method"},"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"schedule"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"actor"},{"kind":"text","text":": "},{"preciseIdentifier":"s:6Gnusto5ActorV","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Actor","kind":"typeIdentifier","text":"Actor"},{"kind":"text","text":", "},{"kind":"externalParam","text":"daemonName"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"timetable","kind":"internalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Timetable","text":"Timetable","preciseIdentifier":"s:11GnustoClock9TimetableV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TimedEvent","text":"TimedEvent","preciseIdentifier":"s:6Gnusto10TimedEventV","kind":"typeIdentifier"}],"platforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"Whose day this is."}],"type":"paragraph"}],"name":"actor"},{"name":"daemonName","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The daemon’s name, unique across the whole game."}]}]},{"name":"timetable","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The day to keep."}]}]}],"kind":"parameters"},{"content":[{"type":"heading","level":2,"text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The timed event, for the game’s "},{"type":"codeVoice","code":"timers"},{"type":"text","text":" block."}]}],"kind":"content"},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"This is the deterministic counterpart to "},{"type":"codeVoice","code":"GnustoActors"},{"type":"text","text":"’ "},{"type":"codeVoice","code":"roams"},{"type":"text","text":". The"},{"type":"text","text":" "},{"type":"text","text":"announcement discipline is the same — the departure line prints only if"},{"type":"text","text":" "},{"type":"text","text":"the player is standing in the room being left, the arrival line only in"},{"type":"text","text":" "},{"type":"text","text":"the room being entered, and neither in the dark — but nothing here draws"},{"type":"text","text":" "},{"type":"text","text":"from the seeded random stream, because a suspect whose movements are a"},{"type":"text","text":" "},{"type":"text","text":"coin flip has no alibi worth checking."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Movement is a "},{"inlineContent":[{"text":"teleport to the scheduled room, with no exit-graph","type":"text"},{"text":" ","type":"text"},{"text":"awareness","type":"text"}],"type":"strong"},{"type":"text","text":": a locked door on the route will not stop him. The contract"},{"type":"text","text":" "},{"type":"text","text":"a timetable is keeping is that he "},{"inlineContent":[{"text":"is","type":"text"}],"type":"emphasis"},{"type":"text","text":" in the study at a quarter past —"},{"type":"text","text":" "},{"type":"text","text":"not that he plausibly got there."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the physical journey matters, there are two ways to say so and they"},{"type":"text","text":" "},{"type":"text","text":"are not interchangeable:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Make the room he passes through a stop of its own."}],"type":"strong"},{"text":" He is really","type":"text"},{"text":" ","type":"text"},{"text":"there, so ","type":"text"},{"code":"location(of:at:)","type":"codeVoice"},{"text":" will say so and any testimony read off","type":"text"},{"text":" ","type":"text"},{"text":"the timetable inherits it. Costs a tick: the stop has to land on a","type":"text"},{"text":" ","type":"text"},{"text":"time the clock actually samples, which on a multi-minute turn means","type":"text"},{"text":" ","type":"text"},{"text":"taking one off a neighbouring leg.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Say it from the stop that already moves him"}],"type":"strong"},{"text":", with a ","type":"text"},{"code":"perform:","type":"codeVoice"},{"text":" ","type":"text"},{"text":"closure and ","type":"text"},{"code":"say(_:from:)","type":"codeVoice"},{"text":" naming the room passed through. The line","type":"text"},{"text":" ","type":"text"},{"text":"prints on the same turn as that stop’s own departure and arrival, and","type":"text"},{"text":" ","type":"text"},{"text":"in that room only. The timetable does not learn anything — he is","type":"text"},{"text":" ","type":"text"},{"text":"still a teleport, and a lookup will not place him on the grass — so","type":"text"},{"text":" ","type":"text"},{"text":"take this one when the crossing is ","type":"text"},{"inlineContent":[{"type":"text","text":"narration"}],"type":"emphasis"},{"text":" and the stop times are","type":"text"},{"text":" ","type":"text"},{"text":"load-bearing elsewhere.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"code":"Sources\/Fulminate","type":"codeVoice"},{"text":" uses both: five actors on stops, and one crossing","type":"text"},{"text":" ","type":"text"},{"text":"whose middle leg is a ","type":"text"},{"code":"perform:","type":"codeVoice"},{"text":" line because the minutes on either side","type":"text"},{"text":" ","type":"text"},{"text":"of it are quoted by a witness.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"An actor with no room — ","type":"text"},{"code":"vanish()","type":"codeVoice"},{"text":"ed, shut in a chest, carried off —","type":"text"},{"text":" ","type":"text"},{"text":"idles: the daemon does nothing and leaves the timetable’s place","type":"text"},{"text":" ","type":"text"},{"text":"untouched, so he picks his day back up where he left it if he is put","type":"text"},{"text":" ","type":"text"},{"text":"down again. An actor merely ","type":"text"},{"inlineContent":[{"type":"text","text":"moved"}],"type":"emphasis"},{"text":" somewhere off his route, by","type":"text"},{"text":" ","type":"text"},{"text":"contrast, walks back on the next tick, because a timetable means he goes","type":"text"},{"text":" ","type":"text"},{"text":"where he is supposed to be. ","type":"text"},{"inlineContent":[{"type":"text","text":"To take him off his rounds for good —"},{"type":"text","text":" "},{"type":"text","text":"arrested, murdered, sent away — call "},{"code":"stopDaemon(_:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"strong"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Timer names are global across a game; the convention here is"},{"type":"text","text":" "},{"code":"\"<actor>.day\"","type":"codeVoice"},{"type":"text","text":"."}]}]}],"kind":"symbol","abstract":[{"text":"Puts an actor on a timetable: a daemon that keeps them where their day","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"says they should be."}],"hierarchy":{"paths":[["doc:\/\/GnustoClock\/documentation\/GnustoClock","doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/schedule(_:daemonName:_:)","interfaceLanguage":"swift"},"references":{"doc://Gnusto/documentation/Gnusto/TimedEvent":{"role":"symbol","navigatorTitle":[{"text":"TimedEvent","kind":"identifier"}],"url":"\/documentation\/gnusto\/timedevent","title":"TimedEvent","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TimedEvent","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"A named timed event, declared in a game or bundle ","type":"text"},{"code":"timers","type":"codeVoice"},{"text":" block: a fuse","type":"text"},{"text":" ","type":"text"},{"text":"(fires once, N turns after it is started) or a daemon (runs at the end of","type":"text"},{"text":" ","type":"text"},{"text":"every turn while active). The body is registered at bootstrap and never","type":"text"},{"text":" ","type":"text"},{"text":"serialized; only the schedule — name → turns remaining, or the active","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"flag — lives in "},{"type":"codeVoice","code":"WorldState"},{"text":", so it saves and restores like any other","type":"text"},{"text":" ","type":"text"},{"text":"state and a restore re-binds it to the declared body by name.","type":"text"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TimedEvent","type":"topic"},"doc://GnustoClock/documentation/GnustoClock/Clock/schedule(_:daemonName:_:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"schedule"},{"kind":"text","text":"("},{"preciseIdentifier":"s:6Gnusto5ActorV","kind":"typeIdentifier","text":"Actor"},{"kind":"text","text":", "},{"text":"daemonName","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"kind":"text","text":", "},{"text":"Timetable","preciseIdentifier":"s:11GnustoClock9TimetableV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"TimedEvent","preciseIdentifier":"s:6Gnusto10TimedEventV","kind":"typeIdentifier"}],"url":"\/documentation\/gnustoclock\/clock\/schedule(_:daemonname:_:)","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/schedule(_:daemonName:_:)","title":"schedule(_:daemonName:_:)","kind":"symbol","role":"symbol","type":"topic","abstract":[{"text":"Puts an actor on a timetable: a daemon that keeps them where their day","type":"text"},{"text":" ","type":"text"},{"text":"says they should be.","type":"text"}]},"doc://GnustoClock/documentation/GnustoClock":{"role":"collection","title":"GnustoClock","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock","kind":"symbol","abstract":[{"text":"Puts a wall clock over the engine’s turn counter, so a game can be played","type":"text"},{"text":" ","type":"text"},{"text":"against an evening rather than a move count.","type":"text"}],"url":"\/documentation\/gnustoclock","type":"topic"},"doc://GnustoClock/documentation/GnustoClock/Clock":{"role":"symbol","title":"Clock","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock","abstract":[{"type":"text","text":"A wall clock over the turn counter: a game where it is twenty to six, and"},{"type":"text","text":" "},{"type":"text","text":"ten to six four turns later."}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"Clock","kind":"identifier"}],"url":"\/documentation\/gnustoclock\/clock","navigatorTitle":[{"kind":"identifier","text":"Clock"}],"type":"topic"},"doc://Gnusto/documentation/Gnusto/Actor":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Actor","kind":"identifier"}],"url":"\/documentation\/gnusto\/actor","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Actor","title":"Actor","navigatorTitle":[{"text":"Actor","kind":"identifier"}],"kind":"symbol","role":"symbol","type":"topic","abstract":[{"text":"A character in the world — a troll, a thief, a parrot.","type":"text"}]},"doc://GnustoClock/documentation/GnustoClock/Timetable":{"role":"symbol","title":"Timetable","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Timetable","kind":"symbol","abstract":[{"type":"text","text":"An actor’s day, written down: a list of stops the clock walks them through."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Timetable","kind":"identifier"}],"url":"\/documentation\/gnustoclock\/timetable","navigatorTitle":[{"text":"Timetable","kind":"identifier"}],"type":"topic"}}}