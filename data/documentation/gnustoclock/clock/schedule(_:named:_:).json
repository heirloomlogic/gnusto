{"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","sections":[],"metadata":{"modules":[{"name":"GnustoClock"}],"extendedModule":"GnustoClock","roleHeading":"Instance Method","title":"schedule(_:named:_:)","role":"symbol","symbolKind":"method","externalID":"s:11GnustoClock0B0V8schedule_5named_0A010TimedEventVAF5ActorV_SSAA9TimetableVtF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"schedule","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:6Gnusto5ActorV","text":"Actor","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"named","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:11GnustoClock9TimetableV","text":"Timetable","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:6Gnusto10TimedEventV","text":"TimedEvent","kind":"typeIdentifier"}]},"hierarchy":{"paths":[["doc:\/\/GnustoClock\/documentation\/GnustoClock","doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock"]]},"identifier":{"url":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/schedule(_:named:_:)","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnustoclock\/clock\/schedule(_:named:_:)"]}],"abstract":[{"type":"text","text":"Puts an actor on a timetable: a daemon that keeps them where their day"},{"type":"text","text":" "},{"type":"text","text":"says they should be."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"schedule","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"kind":"text","text":" "},{"kind":"internalParam","text":"actor"},{"kind":"text","text":": "},{"preciseIdentifier":"s:6Gnusto5ActorV","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Actor","kind":"typeIdentifier","text":"Actor"},{"kind":"text","text":", "},{"kind":"externalParam","text":"named"},{"kind":"text","text":" "},{"kind":"internalParam","text":"name"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"_"},{"text":" ","kind":"text"},{"text":"timetable","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Timetable","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Timetable","preciseIdentifier":"s:11GnustoClock9TimetableV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"TimedEvent","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TimedEvent","preciseIdentifier":"s:6Gnusto10TimedEventV","kind":"typeIdentifier"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Whose day this is.","type":"text"}]}],"name":"actor"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The daemon’s name, unique across the whole game.","type":"text"}]}],"name":"name"},{"name":"timetable","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The day to keep."}]}]}]},{"content":[{"text":"Return Value","type":"heading","level":2,"anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"The timed event, for the game’s ","type":"text"},{"type":"codeVoice","code":"timers"},{"text":" block.","type":"text"}]}],"kind":"content"},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"This is the deterministic counterpart to "},{"type":"codeVoice","code":"GnustoActors"},{"text":"’ ","type":"text"},{"code":"roams","type":"codeVoice"},{"text":". The","type":"text"},{"text":" ","type":"text"},{"text":"announcement discipline is the same — the departure line prints only if","type":"text"},{"text":" ","type":"text"},{"text":"the player is standing in the room being left, the arrival line only in","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the room being entered, and neither in the dark — but nothing here draws"},{"text":" ","type":"text"},{"text":"from the seeded random stream, because a suspect whose movements are a","type":"text"},{"text":" ","type":"text"},{"text":"coin flip has no alibi worth checking.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Movement is a ","type":"text"},{"inlineContent":[{"type":"text","text":"teleport to the scheduled room, with no exit-graph"},{"type":"text","text":" "},{"type":"text","text":"awareness"}],"type":"strong"},{"text":": a locked door on the route will not stop him. The contract","type":"text"},{"text":" ","type":"text"},{"text":"a timetable is keeping is that he ","type":"text"},{"inlineContent":[{"text":"is","type":"text"}],"type":"emphasis"},{"text":" in the study at a quarter past —","type":"text"},{"text":" ","type":"text"},{"text":"not that he plausibly got there.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the physical journey matters, there are two ways to say so and they"},{"type":"text","text":" "},{"type":"text","text":"are not interchangeable:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Make the room he passes through a stop of its own."}],"type":"strong"},{"text":" He is really","type":"text"},{"text":" ","type":"text"},{"text":"there, so ","type":"text"},{"code":"location(of:at:)","type":"codeVoice"},{"text":" will say so and any testimony read off","type":"text"},{"text":" ","type":"text"},{"text":"the timetable inherits it. Costs a tick: the stop has to land on a","type":"text"},{"text":" ","type":"text"},{"text":"time the clock actually samples, which on a multi-minute turn means","type":"text"},{"text":" ","type":"text"},{"text":"taking one off a neighbouring leg.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Say it from the stop that already moves him"}]},{"text":", with a ","type":"text"},{"code":"perform:","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"closure and "},{"type":"codeVoice","code":"say(_:from:)"},{"type":"text","text":" naming the room passed through. The line"},{"type":"text","text":" "},{"type":"text","text":"prints on the same turn as that stop’s own departure and arrival, and"},{"type":"text","text":" "},{"type":"text","text":"in that room only. The timetable does not learn anything — he is"},{"type":"text","text":" "},{"type":"text","text":"still a teleport, and a lookup will not place him on the grass — so"},{"type":"text","text":" "},{"type":"text","text":"take this one when the crossing is "},{"type":"emphasis","inlineContent":[{"type":"text","text":"narration"}]},{"type":"text","text":" and the stop times are"},{"type":"text","text":" "},{"type":"text","text":"load-bearing elsewhere."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Sources\/Fulminate"},{"type":"text","text":" uses both: five actors on stops, and one crossing"},{"type":"text","text":" "},{"type":"text","text":"whose middle leg is a "},{"type":"codeVoice","code":"perform:"},{"type":"text","text":" line because the minutes on either side"},{"type":"text","text":" "},{"type":"text","text":"of it are quoted by a witness."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An actor with no room — "},{"type":"codeVoice","code":"vanish()"},{"type":"text","text":"ed, shut in a chest, carried off —"},{"type":"text","text":" "},{"type":"text","text":"idles: the daemon does nothing and leaves the timetable’s place"},{"type":"text","text":" "},{"type":"text","text":"untouched, so he picks his day back up where he left it if he is put"},{"type":"text","text":" "},{"type":"text","text":"down again. An actor merely "},{"inlineContent":[{"text":"moved","type":"text"}],"type":"emphasis"},{"type":"text","text":" somewhere off his route, by"},{"type":"text","text":" "},{"type":"text","text":"contrast, walks back on the next tick, because a timetable means he goes"},{"type":"text","text":" "},{"type":"text","text":"where he is supposed to be. "},{"inlineContent":[{"type":"text","text":"To take him off his rounds for good —"},{"type":"text","text":" "},{"type":"text","text":"arrested, murdered, sent away — call "},{"code":"stopDaemon(_:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"strong"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Timer names are global across a game; the convention here is"},{"type":"text","text":" "},{"type":"codeVoice","code":"\"<actor>.day\""},{"type":"text","text":"."}]}]}],"references":{"doc://GnustoClock/documentation/GnustoClock/Timetable":{"title":"Timetable","url":"\/documentation\/gnustoclock\/timetable","abstract":[{"type":"text","text":"An actor’s day, written down: a list of stops the clock walks them through."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Timetable"}],"navigatorTitle":[{"kind":"identifier","text":"Timetable"}],"type":"topic","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Timetable","kind":"symbol","role":"symbol"},"doc://Gnusto/documentation/Gnusto/TimedEvent":{"type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TimedEvent","kind":"identifier"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TimedEvent","kind":"symbol","navigatorTitle":[{"text":"TimedEvent","kind":"identifier"}],"title":"TimedEvent","abstract":[{"text":"A named timed event, declared in a game or bundle ","type":"text"},{"code":"timers","type":"codeVoice"},{"text":" block: a fuse","type":"text"},{"text":" ","type":"text"},{"text":"(fires once, N turns after it is started) or a daemon (runs at the end of","type":"text"},{"text":" ","type":"text"},{"text":"every turn while active). The body is registered at bootstrap and never","type":"text"},{"text":" ","type":"text"},{"text":"serialized; only the schedule — name → turns remaining, or the active","type":"text"},{"text":" ","type":"text"},{"text":"flag — lives in ","type":"text"},{"code":"WorldState","type":"codeVoice"},{"text":", so it saves and restores like any other","type":"text"},{"text":" ","type":"text"},{"text":"state and a restore re-binds it to the declared body by name.","type":"text"}],"url":"\/documentation\/gnusto\/timedevent"},"doc://GnustoClock/documentation/GnustoClock":{"title":"GnustoClock","url":"\/documentation\/gnustoclock","abstract":[{"type":"text","text":"Puts a wall clock over the engine’s turn counter, so a game can be played"},{"type":"text","text":" "},{"type":"text","text":"against an evening rather than a move count."}],"type":"topic","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock","kind":"symbol","role":"collection"},"doc://GnustoClock/documentation/GnustoClock/Clock":{"url":"\/documentation\/gnustoclock\/clock","role":"symbol","abstract":[{"text":"A wall clock over the turn counter: a game where it is twenty to six, and","type":"text"},{"text":" ","type":"text"},{"text":"ten to six four turns later.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Clock"}],"kind":"symbol","title":"Clock","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Clock"}],"type":"topic"},"doc://Gnusto/documentation/Gnusto/Actor":{"role":"symbol","navigatorTitle":[{"text":"Actor","kind":"identifier"}],"title":"Actor","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Actor","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"A character in the world — a troll, a thief, a parrot."}],"url":"\/documentation\/gnusto\/actor","type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Actor"},"doc://GnustoClock/documentation/GnustoClock/Clock/schedule(_:named:_:)":{"abstract":[{"text":"Puts an actor on a timetable: a daemon that keeps them where their day","type":"text"},{"text":" ","type":"text"},{"text":"says they should be.","type":"text"}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"schedule","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Actor","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto5ActorV"},{"text":", ","kind":"text"},{"text":"named","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"Timetable","kind":"typeIdentifier","preciseIdentifier":"s:11GnustoClock9TimetableV"},{"text":") -> ","kind":"text"},{"text":"TimedEvent","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto10TimedEventV"}],"identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/schedule(_:named:_:)","kind":"symbol","title":"schedule(_:named:_:)","type":"topic","url":"\/documentation\/gnustoclock\/clock\/schedule(_:named:_:)"}}}