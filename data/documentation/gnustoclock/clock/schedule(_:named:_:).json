{"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/schedule(_:named:_:)"},"metadata":{"modules":[{"name":"GnustoClock"}],"roleHeading":"Instance Method","extendedModule":"GnustoClock","title":"schedule(_:named:_:)","externalID":"s:11GnustoClock0B0V8schedule_5named_0A010TimedEventVAF5ActorV_SSAA9TimetableVtF","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"schedule","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Actor","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto5ActorV"},{"text":", ","kind":"text"},{"text":"named","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"Timetable","kind":"typeIdentifier","preciseIdentifier":"s:11GnustoClock9TimetableV"},{"text":") -> ","kind":"text"},{"text":"TimedEvent","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto10TimedEventV"}],"role":"symbol"},"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"Puts an actor on a timetable: a daemon that keeps them where their day","type":"text"},{"text":" ","type":"text"},{"text":"says they should be.","type":"text"}],"variants":[{"paths":["\/documentation\/gnustoclock\/clock\/schedule(_:named:_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"schedule","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"actor","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Actor","kind":"typeIdentifier","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Actor","preciseIdentifier":"s:6Gnusto5ActorV"},{"text":", ","kind":"text"},{"text":"named","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"name","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"timetable","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Timetable","kind":"typeIdentifier","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Timetable","preciseIdentifier":"s:11GnustoClock9TimetableV"},{"text":") -> ","kind":"text"},{"text":"TimedEvent","kind":"typeIdentifier","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TimedEvent","preciseIdentifier":"s:6Gnusto10TimedEventV"}]}]},{"kind":"parameters","parameters":[{"name":"actor","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Whose day this is."}]}]},{"name":"name","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The daemon’s name, unique across the whole game."}]}]},{"name":"timetable","content":[{"type":"paragraph","inlineContent":[{"text":"The day to keep.","type":"text"}]}]}]},{"content":[{"anchor":"return-value","type":"heading","level":2,"text":"Return Value"},{"inlineContent":[{"text":"The timed event, for the game’s ","type":"text"},{"code":"timers","type":"codeVoice"},{"text":" block.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"inlineContent":[{"type":"text","text":"This is the deterministic counterpart to "},{"type":"codeVoice","code":"GnustoActors"},{"type":"text","text":"’ "},{"type":"codeVoice","code":"roams"},{"type":"text","text":". The"},{"type":"text","text":" "},{"type":"text","text":"announcement discipline is the same — the departure line prints only if"},{"type":"text","text":" "},{"type":"text","text":"the player is standing in the room being left, the arrival line only in"},{"type":"text","text":" "},{"type":"text","text":"the room being entered, and neither in the dark — but nothing here draws"},{"type":"text","text":" "},{"type":"text","text":"from the seeded random stream, because a suspect whose movements are a"},{"type":"text","text":" "},{"type":"text","text":"coin flip has no alibi worth checking."}],"type":"paragraph"},{"inlineContent":[{"text":"Movement is a ","type":"text"},{"inlineContent":[{"text":"teleport to the scheduled room, with no exit-graph","type":"text"},{"text":" ","type":"text"},{"text":"awareness","type":"text"}],"type":"strong"},{"text":": a locked door on the route will not stop him. The contract","type":"text"},{"text":" ","type":"text"},{"text":"a timetable is keeping is that he ","type":"text"},{"inlineContent":[{"type":"text","text":"is"}],"type":"emphasis"},{"text":" in the study at a quarter past —","type":"text"},{"text":" ","type":"text"},{"text":"not that he plausibly got there.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If the physical journey matters, there are two ways to say so and they","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"are not interchangeable:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Make the room he passes through a stop of its own."}]},{"text":" He is really","type":"text"},{"text":" ","type":"text"},{"text":"there, so ","type":"text"},{"code":"location(of:at:)","type":"codeVoice"},{"text":" will say so and any testimony read off","type":"text"},{"text":" ","type":"text"},{"text":"the timetable inherits it. Costs a tick: for him to be ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"seen","type":"text"}]},{"text":" there","type":"text"},{"text":" ","type":"text"},{"text":"the stop has to land on a time the clock actually samples, which on","type":"text"},{"text":" ","type":"text"},{"text":"a multi-minute turn means taking one off a neighbouring leg. A stop","type":"text"},{"text":" ","type":"text"},{"text":"that falls between two samples is jumped — its ","type":"text"},{"code":"perform:","type":"codeVoice"},{"text":" still runs,","type":"text"},{"text":" ","type":"text"},{"text":"on the tick that passes it, but nobody watched him arrive or leave.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Say it from the stop that already moves him","type":"text"}]},{"text":", with a ","type":"text"},{"code":"perform:","type":"codeVoice"},{"text":" ","type":"text"},{"text":"closure and ","type":"text"},{"code":"say(_:from:)","type":"codeVoice"},{"text":" naming the room passed through. The line","type":"text"},{"type":"text","text":" "},{"type":"text","text":"prints on the same turn as that stop’s own departure and arrival, and"},{"type":"text","text":" "},{"type":"text","text":"in that room only. The timetable does not learn anything — he is"},{"type":"text","text":" "},{"type":"text","text":"still a teleport, and a lookup will not place him on the grass — so"},{"type":"text","text":" "},{"type":"text","text":"take this one when the crossing is "},{"type":"emphasis","inlineContent":[{"type":"text","text":"narration"}]},{"type":"text","text":" and the stop times are"},{"type":"text","text":" "},{"type":"text","text":"load-bearing elsewhere."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Sources\/Fulminate"},{"type":"text","text":" uses both: five actors on stops, and one crossing"},{"type":"text","text":" "},{"type":"text","text":"whose middle leg is a "},{"type":"codeVoice","code":"perform:"},{"type":"text","text":" line because the minutes on either side"},{"type":"text","text":" "},{"type":"text","text":"of it are quoted by a witness."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An actor with no room — "},{"type":"codeVoice","code":"vanish()"},{"type":"text","text":"ed, shut in a chest, carried off —"},{"type":"text","text":" "},{"type":"text","text":"idles: the daemon keeps his place in the day but moves him nowhere and"},{"type":"text","text":" "},{"type":"text","text":"runs no stop’s "},{"type":"codeVoice","code":"perform:"},{"type":"text","text":", so when he is put down again he goes where"},{"type":"text","text":" "},{"type":"text","text":"the day says he is "},{"type":"emphasis","inlineContent":[{"type":"text","text":"now"}]},{"text":", and the stops that came round while he was","type":"text"},{"text":" ","type":"text"},{"text":"gone stay unperformed rather than all firing at once. An actor merely","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"moved"}],"type":"emphasis"},{"text":" somewhere off his route, by contrast, walks back on the next","type":"text"},{"text":" ","type":"text"},{"text":"tick, because a timetable means he goes where he is supposed to be.","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"To take him off his rounds for good — arrested, murdered, sent away —","type":"text"},{"text":" ","type":"text"},{"text":"call ","type":"text"},{"code":"stopDaemon(_:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"strong"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The daemon’s first tick seeds his place from the opening time and runs"},{"type":"text","text":" "},{"type":"text","text":"nothing: the stop in force when the game opens has not "},{"inlineContent":[{"type":"text","text":"come round"}],"type":"emphasis"},{"type":"text","text":", so"},{"type":"text","text":" "},{"type":"text","text":"a 9:00 stop’s "},{"code":"perform:","type":"codeVoice"},{"type":"text","text":" does not fire on turn one of a game that opens"},{"type":"text","text":" "},{"type":"text","text":"at half past five."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"After that, a tick either "},{"inlineContent":[{"text":"walks","type":"text"}],"type":"strong"},{"type":"text","text":" or "},{"type":"strong","inlineContent":[{"type":"text","text":"lands"}]},{"type":"text","text":", and which one depends"},{"type":"text","text":" "},{"type":"text","text":"on the gap since the tick before it. A tick one turn after the last one"},{"type":"text","text":" "},{"type":"text","text":"walks: every stop it passed runs its "},{"type":"codeVoice","code":"perform:"},{"type":"text","text":", in order, wrapping at"},{"type":"text","text":" "},{"type":"text","text":"midnight, which is what makes a clock running fifteen minutes to the"},{"type":"text","text":" "},{"type":"text","text":"turn honest about stops five minutes apart. Any other tick lands — he"},{"type":"text","text":" "},{"type":"text","text":"goes where the day says he is "},{"type":"emphasis","inlineContent":[{"type":"text","text":"now"}]},{"type":"text","text":", the stop in force runs, and the"},{"type":"text","text":" "},{"type":"text","text":"ones the gap flew over stay unperformed. That is the answer for a"},{"type":"text","text":" "},{"type":"text","text":"daemon started again some turns after "},{"type":"codeVoice","code":"stopDaemon(_:)"},{"type":"text","text":", for a clock"},{"type":"text","text":" "},{"type":"text","text":"moved by "},{"identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/advance(by:)","type":"reference","isActive":true},{"type":"text","text":" or "},{"identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/set(to:)","type":"reference","isActive":true},{"type":"text","text":", and for a rewind, none of"},{"type":"text","text":" "},{"type":"text","text":"which mean he spent the interval walking his route. Inside a walk the"},{"type":"text","text":" "},{"type":"text","text":"place is written before each "},{"type":"codeVoice","code":"perform:"},{"type":"text","text":", so a body that throws leaves"},{"type":"text","text":" "},{"type":"text","text":"that stop kept and the next tick picks up at the one after it."}]},{"inlineContent":[{"text":"Timer names are global across a game; the convention here is","type":"text"},{"text":" ","type":"text"},{"code":"\"<actor>.day\"","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/GnustoClock\/documentation\/GnustoClock","doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock"]]},"references":{"doc://GnustoClock/documentation/GnustoClock/Clock/set(to:)":{"identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/set(to:)","role":"symbol","url":"\/documentation\/gnustoclock\/clock\/set(to:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"set","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TimeOfDay","kind":"typeIdentifier","preciseIdentifier":"s:11GnustoClock9TimeOfDayV"},{"text":")","kind":"text"}],"abstract":[{"text":"Moves the clock ","type":"text"},{"inlineContent":[{"type":"text","text":"forward"}],"type":"strong"},{"text":" to the next occurrence of a time, at or","type":"text"},{"text":" ","type":"text"},{"text":"after now. Setting it to the current time does nothing; setting it to","type":"text"},{"text":" ","type":"text"},{"text":"an earlier one lands tomorrow, so the day count never runs backwards.","type":"text"}],"kind":"symbol","title":"set(to:)","type":"topic"},"doc://GnustoClock/documentation/GnustoClock/Timetable":{"kind":"symbol","title":"Timetable","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Timetable"}],"url":"\/documentation\/gnustoclock\/timetable","role":"symbol","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Timetable","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Timetable"}],"abstract":[{"type":"text","text":"An actor’s day, written down: a list of stops the clock walks them through."}]},"doc://GnustoClock/documentation/GnustoClock":{"kind":"symbol","title":"GnustoClock","type":"topic","url":"\/documentation\/gnustoclock","role":"collection","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock","abstract":[{"type":"text","text":"Puts a wall clock over the engine’s turn counter, so a game can be played"},{"type":"text","text":" "},{"type":"text","text":"against an evening rather than a move count."}]},"doc://Gnusto/documentation/Gnusto/TimedEvent":{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TimedEvent","kind":"symbol","url":"\/documentation\/gnusto\/timedevent","navigatorTitle":[{"kind":"identifier","text":"TimedEvent"}],"type":"topic","title":"TimedEvent","abstract":[{"text":"A named timed event, declared in a game or bundle ","type":"text"},{"code":"timers","type":"codeVoice"},{"text":" block: a fuse","type":"text"},{"text":" ","type":"text"},{"text":"(fires once, N turns after it is started) or a daemon (runs at the end of","type":"text"},{"text":" ","type":"text"},{"text":"every turn while active). The body is registered at bootstrap and never","type":"text"},{"text":" ","type":"text"},{"text":"serialized; only the schedule — name → turns remaining, or the active","type":"text"},{"text":" ","type":"text"},{"text":"flag — lives in ","type":"text"},{"code":"WorldState","type":"codeVoice"},{"text":", so it saves and restores like any other","type":"text"},{"text":" ","type":"text"},{"text":"state and a restore re-binds it to the declared body by name.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TimedEvent"}],"role":"symbol"},"doc://GnustoClock/documentation/GnustoClock/Clock/schedule(_:named:_:)":{"abstract":[{"text":"Puts an actor on a timetable: a daemon that keeps them where their day","type":"text"},{"text":" ","type":"text"},{"text":"says they should be.","type":"text"}],"title":"schedule(_:named:_:)","type":"topic","url":"\/documentation\/gnustoclock\/clock\/schedule(_:named:_:)","role":"symbol","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/schedule(_:named:_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"schedule"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto5ActorV","text":"Actor"},{"kind":"text","text":", "},{"kind":"externalParam","text":"named"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:11GnustoClock9TimetableV","text":"Timetable"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto10TimedEventV","text":"TimedEvent"}],"kind":"symbol"},"doc://GnustoClock/documentation/GnustoClock/Clock/advance(by:)":{"identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/advance(by:)","role":"symbol","url":"\/documentation\/gnustoclock\/clock\/advance(by:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"advance","kind":"identifier"},{"text":"(","kind":"text"},{"text":"by","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":")","kind":"text"}],"abstract":[{"text":"Moves the clock by some minutes without the player spending turns —","type":"text"},{"text":" ","type":"text"},{"text":"for an interlude the prose skips over. Negative values rewind, but an","type":"text"},{"text":" ","type":"text"},{"text":"alarm that has already fired stays fired.","type":"text"}],"kind":"symbol","title":"advance(by:)","type":"topic"},"doc://Gnusto/documentation/Gnusto/Actor":{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Actor","kind":"symbol","url":"\/documentation\/gnusto\/actor","navigatorTitle":[{"kind":"identifier","text":"Actor"}],"type":"topic","title":"Actor","abstract":[{"text":"A character in the world — a troll, a thief, a parrot.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Actor"}],"role":"symbol"},"doc://GnustoClock/documentation/GnustoClock/Clock":{"kind":"symbol","title":"Clock","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Clock"}],"url":"\/documentation\/gnustoclock\/clock","role":"symbol","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Clock"}],"abstract":[{"text":"A wall clock over the turn counter: a game where it is twenty to six, and","type":"text"},{"text":" ","type":"text"},{"text":"ten to six four turns later.","type":"text"}]}}}