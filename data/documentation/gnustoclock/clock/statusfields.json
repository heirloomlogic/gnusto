xt","text":" "},{"type":"text","text":"not the other way round. So the clock hands its field up rather than the"},{"type":"text","text":" "},{"type":"text","text":"engine reaching down for it."}],"type":"paragraph"},{"inlineContent":[{"text":"Worth the wiring because a timed game’s every defect is a defect about","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"when"}],"type":"emphasis"},{"text":": a line that is true at half past five and false at six reads","type":"text"},{"text":" ","type":"text"},{"text":"identically in a transcript that never says which it was. Read-only, as","type":"text"},{"text":" ","type":"text"},{"text":"the contract requires — ","type":"text"},{"isActive":true,"identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/now","type":"reference"},{"text":" derives the time from the move counter","type":"text"},{"text":" ","type":"text"},{"text":"and writes nothing.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"It derives it from the counter ","type":"text"},{"inlineContent":[{"type":"text","text":"as the turn closed"}],"type":"strong"},{"text":", because that is","type":"text"},{"text":" ","type":"text"},{"text":"where the engine samples a contributed field: the same reading the","type":"text"},{"text":" ","type":"text"},{"text":"turn’s ","type":"text"},{"code":".time","type":"codeVoice"},{"text":" action, its ","type":"text"},{"code":"describe","type":"codeVoice"},{"text":" blocks, and the alarms and","type":"text"},{"text":" ","type":"text"},{"text":"scheduled moves in its timer phase all took. Until #280 the field was","type":"text"},{"text":" ","type":"text"},{"text":"read one increment later, so every cost turn’s footer stood one","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/minutesPerTurn","type":"reference"},{"text":" ahead of every hour the game itself had just","type":"text"},{"text":" ","type":"text"},{"text":"printed — and because a free turn advances no counter, the offset was","type":"text"},{"text":" ","type":"text"},{"text":"not constant and so could not be corrected by habit. Nothing here","type":"text"},{"text":" ","type":"text"},{"text":"changed to fix it; the sampling point did.","type":"text"}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/statusFields","interfaceLanguage":"swift"},"references":{"doc://GnustoClock/documentation/GnustoClock":{"kind":"symbol","url":"\/documentation\/gnustoclock","type":"topic","abstract":[{"type":"text","text":"Puts a wall clock over the engine’s turn counter, so a game can be played"},{"type":"text","text":" "},{"text":"against an evening rather than a move count.","type":"text"}],"role":"collection","title":"GnustoClock","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock"},"doc://GnustoClock/documentation/GnustoClock/Clock":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Clock","kind":"identifier"}],"url":"\/documentation\/gnustoclock\/clock","type":"topic","abstract":[{"type":"text","text":"A wall clock over the turn counter: a game where it is twenty to six, and"},{"type":"text","text":" "},{"type":"text","text":"ten to six four turns later."}],"identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock","navigatorTitle":[{"text":"Clock","kind":"identifier"}],"title":"Clock","kind":"symbol"},"doc://GnustoClock/documentation/GnustoClock/Clock/statusFields":{"url":"\/documentation\/gnustoclock\/clock\/statusfields","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"statusFields"},{"kind":"text","text":": [("},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":")]"}],"kind":"symbol",