{"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GnustoClock\/documentation\/GnustoClock","doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock"]]},"metadata":{"modules":[{"name":"GnustoClock"}],"roleHeading":"Instance Property","role":"symbol","title":"statusFields","symbolKind":"property","externalID":"s:11GnustoClock0B0V12statusFieldsSaySS_SStGvp","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"statusFields"},{"kind":"text","text":": [("},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":")]"}]},"identifier":{"url":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/statusFields","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnustoclock\/clock\/statusfields"]}],"abstract":[{"type":"text","text":"The hour, for the play-test status footer — "},{"type":"codeVoice","code":"time=5:46 pm"},{"type":"text","text":"."}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"statusFields","kind":"identifier"},{"text":": [(","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":")] { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The engine’s own status line is three fields (room, score, moves) and"},{"type":"text","text":" "},{"type":"text","text":"the engine cannot reach this type: "},{"type":"codeVoice","code":"GnustoClock"},{"type":"text","text":" depends on "},{"type":"codeVoice","code":"Gnusto"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"not the other way round. So the clock hands its field up rather than the"},{"type":"text","text":" "},{"type":"text","text":"engine reaching down for it."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Worth the wiring because a timed game’s every defect is a defect about"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"when"}]},{"type":"text","text":": a line that is true at half past five and false at six reads"},{"type":"text","text":" "},{"type":"text","text":"identically in a transcript that never says which it was. Read-only, as"},{"type":"text","text":" "},{"type":"text","text":"the contract requires — "},{"type":"reference","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/now","isActive":true},{"type":"text","text":" derives the time from the move counter"},{"type":"text","text":" "},{"type":"text","text":"and writes nothing."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It derives it from the counter "},{"type":"strong","inlineContent":[{"type":"text","text":"as the turn closed"}]},{"type":"text","text":", because that is"},{"type":"text","text":" "},{"type":"text","text":"where the engine samples a contributed field: the same reading the"},{"type":"text","text":" "},{"type":"text","text":"turn’s "},{"type":"codeVoice","code":".time"},{"type":"text","text":" action, its "},{"type":"codeVoice","code":"describe"},{"type":"text","text":" blocks, and the alarms and"},{"type":"text","text":" "},{"type":"text","text":"scheduled moves in its timer phase all took. Until #280 the field was"},{"type":"text","text":" "},{"type":"text","text":"read one increment later, so every cost turn’s footer stood one"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/minutesPerTurn","type":"reference"},{"type":"text","text":" ahead of every hour the game itself had just"},{"type":"text","text":" "},{"type":"text","text":"printed — and because a free turn advances no counter, the offset was"},{"type":"text","text":" "},{"type":"text","text":"not constant and so could not be corrected by habit. Nothing here"},{"type":"text","text":" "},{"type":"text","text":"changed to fix it; the sampling point did."}]}]}],"references":{"doc://GnustoClock/documentation/GnustoClock/Clock":{"url":"\/documentation\/gnustoclock\/clock","role":"symbol","abstract":[{"text":"A wall clock over the turn counter: a game where it is twenty to six, and","type":"text"},{"text":" ","type":"text"},{"text":"ten to six four turns later.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Clock"}],"kind":"symbol","title":"Clock","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Clock"}],"type":"topic"},"doc://GnustoClock/documentation/GnustoClock/Clock/minutesPerTurn":{"title":"minutesPerTurn","url":"\/documentation\/gnustoclock\/clock\/minutesperturn","abstract":[{"text":"How much wall-clock time one turn costs.","type":"text"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minutesPerTurn","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/minutesPerTurn","type":"topic","kind":"symbol","role":"symbol"},"doc://GnustoClock/documentation/GnustoClock/Clock/statusFields":{"url":"\/documentation\/gnustoclock\/clock\/statusfields","role":"symbol","abstract":[{"type":"text","text":"The hour, for the play-test status footer — "},{"type":"codeVoice","code":"time=5:46 pm"},{"type":"text","text":"."}],"kind":"symbol","title":"statusFields","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/statusFields","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"statusFields","kind":"identifier"},{"text":": [(","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":")]","kind":"text"}],"type":"topic"},"doc://GnustoClock/documentation/GnustoClock":{"title":"GnustoClock","url":"\/documentation\/gnustoclock","abstract":[{"type":"text","text":"Puts a wall clock over the engine’s turn counter, so a game can be played"},{"type":"text","text":" "},{"type":"text","text":"against an evening rather than a move count."}],"type":"topic","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock","kind":"symbol","role":"collection"},"doc://GnustoClock/documentation/GnustoClock/Clock/now":{"role":"symbol","title":"now","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"now","kind":"identifier"},{"text":": ","kind":"text"},{"text":"TimeOfDay","kind":"typeIdentifier","preciseIdentifier":"s:11GnustoClock9TimeOfDayV"}],"kind":"symbol","abstract":[{"text":"What time it is now.","type":"text"}],"url":"\/documentation\/gnustoclock\/clock\/now","type":"topic","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/now"}}}