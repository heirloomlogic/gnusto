dentifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/TimeOfDay","preciseIdentifier":"s:11GnustoClock9TimeOfDayV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"named","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"name","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"perform","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"body","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"@escaping ","kind":"attribute"},{"text":"@Sendable","kind":"attribute"},{"text":" () ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Void","preciseIdentifier":"s:s4Voida","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"TimedEvent","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TimedEvent","preciseIdentifier":"s:6Gnusto10TimedEventV","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"name":"time","content":[{"type":"paragraph","inlineContent":[{"text":"When it goes off.","type":"text"}]}]},{"name":"name","content":[{"inlineContent":[{"text":"The daemon’s name, unique across the whole game.","type":"text"}],"type":"paragraph"}]},{"name":"body","content":[{"inlineContent":[{"text":"What happens.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"return-value","text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The timed event, for the game’s "},{"type":"codeVoice","code":"timers"},{"type":"text","text":" block."}]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The alarm fires "},{"type":"strong","inlineContent":[{"text":"once","type":"text"}]},{"type":"text","text":", at the end of the first turn on or after its"},{"type":"text","text":" "},{"type":"text","text":"time — so a clock running several minutes per turn that steps over the"},{"type":"text","text":" "},{"type":"text","text":"target still fires, and so does one the host jumps forward by hand. A"},{"type":"text","text":" "},{"type":"text","text":"time earlier in the day than the clock’s start means "},{"type":"emphasis","inlineContent":[{"text":"tomorrow","type":"text"}]},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"is what an overnight game wants."}]},{"type":"paragraph","inlineContent":[{"text":"Firing once is enforced by the alarm stopping its own daemon, so the","type":"text"},{"text":" ","type":"text"},{"text":"arming state is ordinary daemon state: it saves and restores for free,","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"stopDaemon(_:)"},{"text":" cancels an alarm that hasn’t fired, and","type":"text"},{"text":" ","type":"text"},{"code":"startDaemon(_:)","type":"codeVoice"},{"type":"text","text":" re-arms one that has."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Timer names are global across a game, so prefix yours — the clock’s own"},{"type":"text","text":" "},{"type":"text","text":"convention is "},{"type":"codeVoice","code":"\"clock.<something>\""},{"type":"text","text":"."}]}]}],"references":{"doc://Gnusto/documentation/Gnusto/TimedEvent":{"type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TimedEvent","kind":"identifier"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TimedEvent","kind":"symbol","navigatorTitle":[{"text":"TimedEvent","kind":"identifier"}],"title":"TimedEvent","abstract":[{"text":"A named timed event, declared in a game or bundle ","type":"text"},{"code":"timers","type":"codeVoice"},{"text":" block: a fuse","type":"text"},{"text":" ","type":"text"},{"text":"(fires once, N turns after it is started) or a daemon (runs at the end of","type":"text"},{"text":" ","type":"text"},{"text":"every turn while active). The body is registered at bootstrap and never","type":"text"},{"text":" ","type":"text"},{"text":"serialized; only the schedule — name → turns remaining, or the active","type":"text"},{"text":" ","type":"text"},{"text":"flag — lives in ","type":"text"},{"code":"WorldState","type":"codeVoice"},{"text":", so it saves and restores like any other","type":"text"},{"text":" ","type":"text"},{"text":"state and a restore re-binds it to the declared body by name.","type":"text"}],"url":"\/documentation\/gnusto\/timedevent"},"doc://GnustoClock/documentation/GnustoClock":{"title":"GnustoClock","url":"\/documentation\/gnustoclock","abstract":[{"type":"text","text":"Puts a wall clock over the engine’s turn counter, so a game can be played"},{"type":"text","text":" "},{"type":"text","text":"against an evening rather than a move count."}],"type":"topic","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock","kind":"symbol","role":"collection"},"doc://GnustoClock/documentation/GnustoClock/Clock":{"url":"\/documentation\/gnustoclock\/clock","role":"symbol","abstract":[{"text":"A wall clock over the turn counter: a game where it is twenty to six, and","type":"text"},{"text":" ","type":"text"},{"text":"ten to six four turns later.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Clock"}],"kind":"symbol","title":"Clock","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Clock"}],"type":"topic"},"doc://GnustoClock/documentation/GnustoClock/TimeOfDay":{"role":"symbol","navigatorTitle":[{"text":"TimeOfDay","kind":"identifier"}],"title":"TimeOfDay","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TimeOfDay"}],"kind":"symbol","abstract":[{"type":"text","text":"A time on a 24-hour wall clock, with no date attached: 8:15 in the evening"},{"text":" ","type":"text"},{"text":"is ","type":"text"},{"code":"TimeOfDay(20, 15)","type":"codeVoice"},{"text":", and it is the same value tomorrow.","type":"text"}],"url":"\/documentation\/gnustoclock\/timeofday","type":"topic","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/TimeOfDay"},"doc://GnustoClock/documentation/GnustoClock/Clock/at(_:named:perform:)":{"identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/at(_:named:perform:)","kind":"symbol","type":"topic","abstract":[{"text":"Something that happens at a time rather than after a count of turns:","type":"text"},{"text":" ","type":"text"},{"text":"the blast, the last train, the coroner at the door.","type":"text"}],"title":"at(_:named:perform:)","url":"\/documentation\/gnustoclock\/clock\/at(_:named:perform:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"at"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:11GnustoClock9TimeOfDayV","text":"TimeOfDay"},{"kind":"text","text":", "},{"kind":"externalParam","text":"named"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"perform"},{"kind":"text","text":": () "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4Voida","text":"Void"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto10TimedEventV","text":"TimedEvent"}]}}}