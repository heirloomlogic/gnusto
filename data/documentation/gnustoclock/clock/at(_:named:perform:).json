ocumentation/GnustoClock":{"type":"topic","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock","title":"GnustoClock","url":"\/documentation\/gnustoclock","role":"collection","kind":"symbol","abstract":[{"type":"text","text":"Puts a wall clock over the engine’s turn counter, so a game can be played"},{"type":"text","text":" "},{"type":"text","text":"against an evening rather than a move count."}]},"doc://GnustoClock/documentation/GnustoClock/Clock/at(_:named:perform:)":{"url":"\/documentation\/gnustoclock\/clock\/at(_:named:perform:)","title":"at(_:named:perform:)","role":"symbol","type":"topic","abstract":[{"text":"Something that happens at a time rather than after a count of turns:","type":"text"},{"text":" ","type":"text"},{"text":"the blast, the last train, the coroner at the door.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"at","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:11GnustoClock9TimeOfDayV","text":"TimeOfDay","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"named","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"perform","kind":"externalParam"},{"text":": () ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:s4Voida","text":"Void","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:6Gnusto10TimedEventV","text":"TimedEvent","kind":"typeIdentifier"}],"identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/at(_:named:perform:)","kind":"symbol"},"doc://GnustoClock/documentation/GnustoClock/TimeOfDay":{"title":"TimeOfDay","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TimeOfDay","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"A time on a 24-hour wall clock, with no date attached: 8:15 in the evening"},{"type":"text","text":" "},{"type":"text","text":"is "},{"type":"codeVoice","code":"TimeOfDay(20, 15)"},{"type":"text","text":", and it is the same value tomorrow."}],"navigatorTitle":[{"text":"TimeOfDay","kind":"identifier"}],"url":"\/documentation\/gnustoclock\/timeofday","role":"symbol","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/TimeOfDay"},"doc://Gnusto/documentation/Gnusto/TimedEvent":{"url":"\/documentation\/gnusto\/timedevent","title":"TimedEvent","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"TimedEvent"}],"type":"topic","abstract":[{"type":"text","text":"A named timed event, declared in a game or bundle "},{"code":"timers","type":"codeVoice"},{"type":"text","text":" block: a fuse"},{"type":"text","text":" "},{"text":"(fires once, N turns after it is started) or a daemon (runs at the end of","type":"text"},{"text":" ","type":"text"},{"text":"every turn while active). The body is registered at bootstrap and never","type":"text"},{"text":" ","type":"text"},{"text":"serialized; only the schedule — name → turns remaining, or the active","type":"text"},{"text":" ","type":"text"},{"text":"flag — lives in ","type":"text"},{"code":"WorldState","type":"codeVoice"},{"text":", so it saves and restores like any other","type":"text"},{"text":" ","type":"text"},{"text":"state and a restore re-binds it to the declared body by name.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TimedEvent"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TimedEvent","kind":"symbol"}}}