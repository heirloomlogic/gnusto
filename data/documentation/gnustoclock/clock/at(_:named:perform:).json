yV","kind":"typeIdentifier","text":"TimeOfDay"},{"kind":"text","text":", "},{"kind":"externalParam","text":"named"},{"kind":"text","text":" "},{"kind":"internalParam","text":"name"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"perform"},{"kind":"text","text":" "},{"kind":"internalParam","text":"body"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:s4Voida","kind":"typeIdentifier","text":"Void"},{"kind":"text","text":") -> "},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TimedEvent","preciseIdentifier":"s:6Gnusto10TimedEventV","kind":"typeIdentifier","text":"TimedEvent"}],"platforms":["macOS"]}]},{"parameters":[{"name":"time","content":[{"inlineContent":[{"type":"text","text":"When it goes off."}],"type":"paragraph"}]},{"name":"name","content":[{"inlineContent":[{"type":"text","text":"The daemon’s name, unique across the whole game."}],"type":"paragraph"}]},{"name":"body","content":[{"inlineContent":[{"type":"text","text":"What happens."}],"type":"paragraph"}]}],"kind":"parameters"},{"kind":"content","content":[{"type":"heading","anchor":"return-value","text":"Return Value","level":2},{"type":"paragraph","inlineContent":[{"text":"The timed event, for the game’s ","type":"text"},{"code":"timers","type":"codeVoice"},{"text":" block.","type":"text"}]}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"The alarm fires ","type":"text"},{"inlineContent":[{"type":"text","text":"once"}],"type":"strong"},{"text":", at the end of the first turn on or after its","type":"text"},{"text":" ","type":"text"},{"text":"time — so a clock running several minutes per turn that steps over the","type":"text"},{"text":" ","type":"text"},{"text":"target still fires, and so does one the host jumps forward by hand. A","type":"text"},{"text":" ","type":"text"},{"text":"time earlier in the day than the clock’s start means ","type":"text"},{"inlineContent":[{"type":"text","text":"tomorrow"}],"type":"emphasis"},{"text":", which","type":"text"},{"text":" ","type":"text"},{"text":"is what an overnight game wants.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Firing once is enforced by the alarm stopping its own daemon, so the","type":"text"},{"text":" ","type":"text"},{"text":"arming state is ordinary daemon state: it saves and restores for free,","type":"text"},{"text":" ","type":"text"},{"code":"stopDaemon(_:)","type":"codeVoice"},{"text":" cancels an alarm that hasn’t fired, and","type":"text"},{"text":" ","type":"text"},{"code":"startDaemon(_:)","type":"codeVoice"},{"text":" re-arms one that has.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Timer names are global across a game, so prefix yours — the clock’s own","type":"text"},{"text":" ","type":"text"},{"text":"convention is ","type":"text"},{"code":"\"clock.<something>\"","type":"codeVoice"},{"text":".","type":"text"}]}]}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnustoclock\/clock\/at(_:named:perform:)"]}],"references":{"doc://GnustoClock/documentation/GnustoClock":{"kind":"symbol","url":"\/documentation\/gnustoclock","type":"topic","abstract":[{"type":"text","text":"Puts a wall clock over the engine’s turn counter, so a game can be played"},{"type":"text","text":" "},{"text":"against an evening rather than a move count.","type":"text"}],"role":"collection","title":"GnustoClock","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock"},"doc://GnustoClock/documentation/GnustoClock/Clock":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Clock","kind":"identifier"}],"url":"\/documentation\/gnustoclock\/clock","type":"topic","abstract":[{"type":"text","text":"A wall clock over the turn counter: a game where it is twenty to six, and"},{"type":"text","text":" "},{"type":"text","text":"ten to six four turns later."}],"identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock","navigatorTitle":[{"text":"Clock","kind":"identifier"}],"title":"Clock","kind":"symbol"},"doc://Gnusto/documentation/Gnusto/TimedEvent":{"url":"\/documentation\/gnusto\/timedevent","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TimedEvent"}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"TimedEvent"}],"abstract":[{"type":"text","text":"A named timed event, declared in a game or bundle "},{"type":"codeVoice","code":"timers"},{"type":"text","text":" block: a fuse"},{"type":"text","text":" "},{"type":"text","text":"(fires once, N turns after it is started) or a daemon (runs at the end of"},{"type":"text","text":" "},{"type":"text","text":"every turn while active). The body is registered at bootstrap and never"},{"type":"text","text":" "},{"type":"text","text":"serialized; only the schedule — name → turns remaining, or the active"},{"type":"text","text":" "},{"type":"text","text":"flag — lives in "},{"type":"codeVoice","code":"WorldState"},{"type":"text","text":", so it saves and restores like any other"},{"type":"text","text":" "},{"type":"text","text":"state and a restore re-binds it to the declared body by name."}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TimedEvent","title":"TimedEvent"},"doc://GnustoClock/documentation/GnustoClock/TimeOfDay":{"url":"\/documentation\/gnustoclock\/timeofday","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"TimeOfDay"}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"TimeOfDay","kind":"identifier"}],"abstract":[{"type":"text",