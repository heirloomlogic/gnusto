{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/at(_:named:perform:)"},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"at","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"time","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"TimeOfDay","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/TimeOfDay","kind":"typeIdentifier","preciseIdentifier":"s:11GnustoClock9TimeOfDayV"},{"text":", ","kind":"text"},{"text":"named","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"name","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"perform","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"body","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"@escaping ","kind":"attribute"},{"text":"@Sendable","kind":"attribute"},{"text":" () ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Void","preciseIdentifier":"s:s4Voida","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"TimedEvent","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TimedEvent","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto10TimedEventV"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"time","content":[{"type":"paragraph","inlineContent":[{"text":"When it goes off.","type":"text"}]}]},{"name":"name","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The daemon’s name, unique across the whole game."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"What happens."}]}],"name":"body"}]},{"content":[{"anchor":"return-value","level":2,"type":"heading","text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The timed event, for the game’s "},{"type":"codeVoice","code":"timers"},{"type":"text","text":" block."}]}],"kind":"content"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The alarm fires ","type":"text"},{"inlineContent":[{"text":"once","type":"text"}],"type":"strong"},{"text":", at the end of the first turn on or after its","type":"text"},{"text":" ","type":"text"},{"text":"time — so a clock running several minutes per turn that steps over the","type":"text"},{"text":" ","type":"text"},{"text":"target still fires, and so does one the host jumps forward by hand. A","type":"text"},{"text":" ","type":"text"},{"text":"time earlier in the day than the clock’s start means ","type":"text"},{"inlineContent":[{"type":"text","text":"tomorrow"}],"type":"emphasis"},{"text":", which","type":"text"},{"text":" ","type":"text"},{"text":"is what an overnight game wants.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Firing once is enforced by the alarm stopping its own daemon, so the","type":"text"},{"text":" ","type":"text"},{"text":"arming state is ordinary daemon state: it saves and restores for free,","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"stopDaemon(_:)"},{"type":"text","text":" cancels an alarm that hasn’t fired, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"startDaemon(_:)"},{"text":" re-arms one that has.","type":"text"}]},{"inlineContent":[{"text":"Timer names are global across a game, so prefix yours — the clock’s own","type":"text"},{"text":" ","type":"text"},{"text":"convention is ","type":"text"},{"type":"codeVoice","code":"\"clock.<something>\""},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GnustoClock\/documentation\/GnustoClock","doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnustoclock\/clock\/at(_:named:perform:)"]}],"metadata":{"externalID":"s:11GnustoClock0B0V2at_5named7perform0A010TimedEventVAA9TimeOfDayV_SSyyYbKctF","title":"at(_:named:perform:)","roleHeading":"Instance Method","modules":[{"name":"GnustoClock"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"at"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:11GnustoClock9TimeOfDayV","text":"TimeOfDay"},{"kind":"text","text":", "},{"kind":"externalParam","text":"named"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"perform","kind":"externalParam"},{"text":": () ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Void","preciseIdentifier":"s:s4Voida","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"TimedEvent","preciseIdentifier":"s:6Gnusto10TimedEventV","kind":"typeIdentifier"}],"symbolKind":"method","role":"symbol"},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Something that happens at a time rather than after a count of turns:","type":"text"},{"text":" ","type":"text"},{"text":"the blast, the last train, the coroner at the door.","type":"text"}],"references":{"doc://GnustoClock/documentation/GnustoClock":{"kind":"symbol","title":"GnustoClock","type":"topic","url":"\/documentation\/gnustoclock","role":"collection","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock","abstract":[{"type":"text","text":"Puts a wall clock over the engine’s turn counter, so a game can be played"},{"type":"text","text":" "},{"type":"text","text":"against an evening rather than a move count."}]},"doc://GnustoClock/documentation/GnustoClock/Clock/at(_:named:perform:)":{"identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/at(_:named:perform:)","role":"symbol","url":"\/documentation\/gnustoclock\/clock\/at(_:named:perform:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"at","kind":"identifier"},{"text":"(","kind":"text"},{"text":"TimeOfDay","kind":"typeIdentifier","preciseIdentifier":"s:11GnustoClock9TimeOfDayV"},{"text":", ","kind":"text"},{"text":"named","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"perform","kind":"externalParam"},{"text":": () ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Void","kind":"typeIdentifier","preciseIdentifier":"s:s4Voida"},{"text":") -> ","kind":"text"},{"text":"TimedEvent","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto10TimedEventV"}],"abstract":[{"type":"text","text":"Something that happens at a time rather than after a count of turns:"},{"type":"text","text":" "},{"type":"text","text":"the blast, the last train, the coroner at the door."}],"kind":"symbol","title":"at(_:named:perform:)","type":"topic"},"doc://Gnusto/documentation/Gnusto/TimedEvent":{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TimedEvent","kind":"symbol","url":"\/documentation\/gnusto\/timedevent","navigatorTitle":[{"kind":"identifier","text":"TimedEvent"}],"type":"topic","title":"TimedEvent","abstract":[{"text":"A named timed event, declared in a game or bundle ","type":"text"},{"code":"timers","type":"codeVoice"},{"text":" block: a fuse","type":"text"},{"text":" ","type":"text"},{"text":"(fires once, N turns after it is started) or a daemon (runs at the end of","type":"text"},{"text":" ","type":"text"},{"text":"every turn while active). The body is registered at bootstrap and never","type":"text"},{"text":" ","type":"text"},{"text":"serialized; only the schedule — name → turns remaining, or the active","type":"text"},{"text":" ","type":"text"},{"text":"flag — lives in ","type":"text"},{"code":"WorldState","type":"codeVoice"},{"text":", so it saves and restores like any other","type":"text"},{"text":" ","type":"text"},{"text":"state and a restore re-binds it to the declared body by name.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TimedEvent"}],"role":"symbol"},"doc://GnustoClock/documentation/GnustoClock/TimeOfDay":{"kind":"symbol","title":"TimeOfDay","type":"topic","navigatorTitle":[{"text":"TimeOfDay","kind":"identifier"}],"url":"\/documentation\/gnustoclock\/timeofday","role":"symbol","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/TimeOfDay","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TimeOfDay","kind":"identifier"}],"abstract":[{"text":"A time on a 24-hour wall clock, with no date attached: 8:15 in the evening","type":"text"},{"text":" ","type":"text"},{"text":"is ","type":"text"},{"type":"codeVoice","code":"TimeOfDay(20, 15)"},{"text":", and it is the same value tomorrow.","type":"text"}]},"doc://GnustoClock/documentation/GnustoClock/Clock":{"kind":"symbol","title":"Clock","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Clock"}],"url":"\/documentation\/gnustoclock\/clock","role":"symbol","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Clock"}],"abstract":[{"text":"A wall clock over the turn counter: a game where it is twenty to six, and","type":"text"},{"text":" ","type":"text"},{"text":"ten to six four turns later.","type":"text"}]}}}