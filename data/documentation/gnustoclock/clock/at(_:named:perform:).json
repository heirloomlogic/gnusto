ocumentation/GnustoClock":{"role":"collection","title":"GnustoClock","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock","kind":"symbol","abstract":[{"text":"Puts a wall clock over the engine’s turn counter, so a game can be played","type":"text"},{"text":" ","type":"text"},{"text":"against an evening rather than a move count.","type":"text"}],"url":"\/documentation\/gnustoclock","type":"topic"},"doc://GnustoClock/documentation/GnustoClock/Clock/at(_:named:perform:)":{"url":"\/documentation\/gnustoclock\/clock\/at(_:named:perform:)","type":"topic","kind":"symbol","title":"at(_:named:perform:)","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/at(_:named:perform:)","abstract":[{"text":"Something that happens at a time rather than after a count of turns:","type":"text"},{"text":" ","type":"text"},{"text":"the blast, the last train, the coroner at the door.","type":"text"}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"at","kind":"identifier"},{"text":"(","kind":"text"},{"text":"TimeOfDay","preciseIdentifier":"s:11GnustoClock9TimeOfDayV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"named","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"perform","kind":"externalParam"},{"text":": () ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Void","preciseIdentifier":"s:s4Voida","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"TimedEvent","preciseIdentifier":"s:6Gnusto10TimedEventV","kind":"typeIdentifier"}]},"doc://GnustoClock/documentation/GnustoClock/TimeOfDay":{"kind":"symbol","url":"\/documentation\/gnustoclock\/timeofday","type":"topic","title":"TimeOfDay","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/TimeOfDay","abstract":[{"type":"text","text":"A time on a 24-hour wall clock, with no date attached: 8:15 in the evening"},{"type":"text","text":" "},{"text":"is ","type":"text"},{"code":"TimeOfDay(20, 15)","type":"codeVoice"},{"text":", and it is the same value tomorrow.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TimeOfDay","kind":"identifier"}],"navigatorTitle":[{"text":"TimeOfDay","kind":"identifier"}]},"doc://Gnusto/documentation/Gnusto/TimedEvent":{"role":"symbol","navigatorTitle":[{"text":"TimedEvent","kind":"identifier"}],"url":"\/documentation\/gnusto\/timedevent","title":"TimedEvent","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TimedEvent","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"A named timed event, declared in a game or bundle ","type":"text"},{"code":"timers","type":"codeVoice"},{"text":" block: a fuse","type":"text"},{"text":" ","type":"text"},{"text":"(fires once, N turns after it is started) or a daemon (runs at the end of","type":"text"},{"text":" ","type":"text"},{"text":"every turn while active). The body is registered at bootstrap and never","type":"text"},{"text":" ","type":"text"},{"text":"serialized; only the schedule — name → turns remaining, or the active","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"flag — lives in "},{"type":"codeVoice","code":"WorldState"},{"text":", so it saves and restores like any other","type":"text"},{"text":" ","type":"text"},{"text":"state and a restore re-binds it to the declared body by name.","type":"text"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TimedEvent","type":"topic"}}}