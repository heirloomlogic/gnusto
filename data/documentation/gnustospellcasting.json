hich"},{"type":"text","text":" "},{"type":"text","text":"refills the magical-energy pool, and "},{"type":"codeVoice","code":"spells"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"magic"},{"type":"text","text":", which reports the"},{"type":"text","text":" "},{"type":"text","text":"caster’s state."}],"kind":"symbol","type":"topic","role":"symbol"},"doc://GnustoSpellcasting/documentation/GnustoSpellcasting/Spellcasting/maxMana":{"url":"\/documentation\/gnustospellcasting\/spellcasting\/maxmana","identifier":"doc:\/\/GnustoSpellcasting\/documentation\/GnustoSpellcasting\/Spellcasting\/maxMana","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"maxMana"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"title":"maxMana","abstract":[{"type":"text","text":"The full magical-energy pool "},{"type":"codeVoice","code":"rest"},{"type":"text","text":" restores to."}],"kind":"symbol","type":"topic","role":"symbol"},"doc://GnustoSpellcasting/documentation/GnustoSpellcasting/Spellcasting/actions":{"url":"\/documentation\/gnustospellcasting\/spellcasting\/actions","identifier":"doc:\/\/GnustoSpellcasting\/documentation\/GnustoSpellcasting\/Spellcasting\/actions","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"actions"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto12IntentActionV","text":"IntentAction"},{"kind":"text","text":"]"}],"title":"actions","abstract":[{"type":"text","text":"The default actions the spellcasting layer contributes: the "},{"type":"codeVoice","code":"rest"},{"type":"text","text":" "},{"type":"text","text":"handler that restores the energy pool to full, and the "},{"type":"codeVoice","code":"spells"},{"type":"text","text":" status"},{"type":"text","text":" "},{"type":"text","text":"report of memorized spells and remaining energy."}],"kind":"symbol","type":"topic","role":"symbol"},"doc://GnustoSpellcasting/documentation/GnustoSpellcasting/SpellCost/cantrip":{"url":"\/documentation\/gnustospellcasting\/spellcost\/cantrip","identifier":"doc:\/\/GnustoSpellcasting\/documentation\/GnustoSpellcasting\/SpellCost\/cantrip","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cantrip","kind":"identifier"}],"title":"SpellCost.cantrip","abstract":[{"text":"Always castable, free, never consumed.","type":"text"}],"kind":"symbol","type":"topic","role":"symbol"},"doc://GnustoSpellcasting/documentation/GnustoSpellcasting/Gnusto":{"url":"\/documentation\/gnustospellcasting\/gnusto","identifier":"doc:\/\/GnustoSpellcasting\/documentation\/GnustoSpellcasting\/Gnusto","title":"Gnusto","abstract":[],"kind":"symbol","type":"topic","role":"collection"},"doc://GnustoSpellcasting/documentation/GnustoSpellcasting/SpellCost/energy(_:)":{"url":"\/documentation\/gnustospellcasting\/spellcost\/energy(_:)","identifier":"doc:\/\/GnustoSpellcasting\/documentation\/GnustoSpellcasting\/SpellCost\/energy(_:)","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"energy","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":")","kind":"text"}],"title":"SpellCost.energy(_:)","abstract":[{"text":"Draws the given amount from the shared magical-energy pool; refused when","type":"text"},{"text":" ","type":"text"},{"text":"the pool is too low. ","type":"text"},{"code":"rest","type":"codeVoice"},{"text":" restores the pool to full.","type":"text"}],"kind":"symbol","type":"topic","role":"symbol"},"doc://GnustoSpellcasting/documentation/GnustoSpellcasting/SpellCost/prepared(book:learnVia:)":{"url":"\/documentation\/gnustospellcasting\/spellcost\/prepared(book:learnvia:)","identifier":"doc:\/\/GnustoSpellcasting\/documentation\/GnustoSpellcasting\/SpellCost\/prepared(book:learnVia:)","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"prepared","kind":"identifier"},{"text":"(","kind":"text"},{"text":"book","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Item","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto4ItemV"},{"text":"?, ","kind":"text"},{"text":"learnVia","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Intent","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto6IntentV"},{"text":")","kind":"text"}],"title":"SpellCost.prepared(book:learnVia:)","abstract":[{"text":"Must be memorized into the caster’s finite spell memory before casting,","type":"text"},{"text":" ","type":"text"},{"text":"and is spent on cast. ","type":"text"},{"code":"learnVia","type":"codeVoice"},{"text":" is the memorize\/learn intent that","type":"text"},{"text":" ","type":"text"},{"text":"commits it to memory. When ","type":"text"},{"code":"book","type":"codeVoice"},{"text":" is set, memorizing requires that","type":"text"},{"text":" ","type":"text"},{"text":"spellbook be in hand; when nil, the spell can be memorized anywhere.","type":"text"}],"kind":"symbol","type":"topic","role":"symbol"}}}