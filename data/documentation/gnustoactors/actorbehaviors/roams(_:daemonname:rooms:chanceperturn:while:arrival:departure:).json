","kind":"typeIdentifier"},{"text":" = { true }, ","kind":"text"},{"text":"arrival","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"departure","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"? = nil) -> ","kind":"text"},{"preciseIdentifier":"s:6Gnusto10TimedEventV","text":"TimedEvent","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TimedEvent","kind":"typeIdentifier"}],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"name":"actor","content":[{"inlineContent":[{"text":"The NPC to teleport.","type":"text"}],"type":"paragraph"}]},{"name":"daemonName","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The daemon’s global timer name."}]}]},{"name":"rooms","content":[{"inlineContent":[{"type":"text","text":"The set of rooms the actor teleports within."}],"type":"paragraph"}]},{"name":"percent","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Per-Turn chance of a move, while in the set."}]}]},{"name":"gate","content":[{"inlineContent":[{"type":"text","text":"Extra gate checked first — a false gate is a quiet, draw-free turn."}],"type":"paragraph"}]},{"name":"arrival","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Line printed when the player watches the actor arrive."}]}]},{"name":"departure","content":[{"inlineContent":[{"type":"text","text":"Line printed when the player watches the actor leave."}],"type":"paragraph"}]}]},{"content":[{"type":"heading","text":"Return Value","level":2,"anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"The roaming daemon, for the host’s ","type":"text"},{"type":"codeVoice","code":"timers"},{"text":" block.","type":"text"}]}],"kind":"content"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"codeVoice","code":"while:"},{"type":"text","text":" is an extra gate evaluated "},{"type":"emphasis","inlineContent":[{"type":"text","text":"first"}]},{"type":"text","text":", before the position guard"},{"type":"text","text":" "},{"type":"text","text":"and before any draw, exactly as "},{"type":"codeVoice","code":"MeleeCombat.aggression(of:…)"},{"text":"’s is — so","type":"text"},{"text":" ","type":"text"},{"text":"a roamer whose wandering is scoped (the thief holds still while you are","type":"text"},{"type":"text","text":" "},{"type":"text","text":"standing in his lair) burns no randomness on the turns his gate is shut,"},{"type":"text","text":" "},{"type":"text","text":"keeping every seeded draw sequence intact. The default gate is always"},{"type":"text","text":" "},{"type":"text","text":"open, so a caller that does not pass one behaves exactly as before."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"type":"text","text":"A daemon that, with "},{"type":"codeVoice","code":"chancePerTurn"},{"type":"text","text":", moves "},{"type":"codeVoice","code":"actor"},{"type":"text","text":" to a random"},{"text":" ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"other"}]},{"text":" room in ","type":"text"},{"code":"rooms","type":"codeVoice"},{"text":" — a teleport within the set, with no","type":"text"},{"text":" ","type":"text"},{"text":"exit-graph awareness (a wall between two rooms in the set won’t","type":"text"},{"text":" ","type":"text"},{"text":"stop him). Arrival\/departure lines print only when the player’s","type":"text"},{"text":" ","type":"text"},{"text":"room is lit and is the room being entered or left: in the dark, or","type":"text"},{"text":" ","type":"text"},{"text":"a room away, movement is silent. The daemon idles (no RNG drawn)","type":"text"},{"text":" ","type":"text"},{"text":"while the actor is outside ","type":"text"},{"code":"rooms","type":"codeVoice"},{"text":" — including after ","type":"text"},{"code":"vanish()","type":"codeVoice"},{"text":" —","type":"text"},{"text":" ","type":"text"},{"text":"but the host should still ","type":"text"},{"code":"stopDaemon(_:)","type":"codeVoice"},{"text":" on the actor’s death.","type":"text"}],"sections":[],"references":{"doc://GnustoActors/documentation/GnustoActors":{"kind":"symbol","title":"GnustoActors","role":"collection","identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors","type":"topic","url":"\/documentation\/gnustoactors","abstract":[{"text":"Daemons that make an NPC wander, tag along, or go through your pockets.","type":"text"}]},"doc://Gnusto/documentation/Gnusto/TimedEvent":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"TimedEvent"}],"title":"TimedEvent","role":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TimedEvent","url":"\/documentation\/gnusto\/timedevent","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TimedEvent"}],"abstract":[{"text":"A named timed event, declared in a game or bundle ","type":"text"},{"code":"timers","type":"codeVoice"},{"text":" block: a fuse","type":"text"},{"text":" ","type":"text"},{"text":"(fires once, N turns after it is started) or a daemon (runs at the end of","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"every turn while active). The body is registered at bootstrap and never"},{"type":"text","text":" "},{"type":"text","text":"serialized; only the schedule — name → turns remaining, or the active"},{"type":"text","text":" "},{"type":"text","text":"flag — lives in "},{"type":"codeVoice","code":"WorldState"},{"type":"text","text":", so it saves and restores like any other"},{"type":"text","text":" "},{"type":"text","text":"state and a restore re-binds it to the declared body by name."}]},"doc://GnustoActors/documentation/GnustoActors/ActorBehaviors":{"kind":"symbol","navigatorTitle":[{"text":"ActorBehaviors","kind":"identifier"}],"title":"ActorBehaviors","role":"symbol","identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors","type":"topic","url":"\/documentation\/gnustoactors\/actorbehaviors","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"ActorBehaviors"}],"abstract":[{"text":"Logic-only NPC behaviors: roaming, theft, canned reactions. The plugin","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"owns no entities and no state — position "},{"type":"emphasis","inlineContent":[{"type":"text","text":"is"}]},{"text":" the actor’s placement —","type":"text"},{"text":" ","type":"text"},{"text":"so the host declares its actors and splices these factories into its","type":"text"},{"text":" ","type":"text"},{"text":"own ","type":"text"},{"code":"timers","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"rules"},{"type":"text","text":" blocks:"}]},"doc://GnustoActors/documentation/GnustoActors/ActorBehaviors/roams(_:daemonName:rooms:chancePerTurn:while:arrival:departure:)":{"kind":"symbol","title":"roams(_:daemonName:rooms:chancePerTurn:while:arrival:departure:)","role":"symbol","identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/roams(_:daemonName:rooms:chancePerTurn:while:arrival:departure:)","type":"topic","url":"\/documentation\/gnustoactors\/actorbehaviors\/roams(_:daemonname:rooms:chanceperturn:while:arrival:departure:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"roams","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Actor","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto5ActorV"},{"kind":"text","text":", "},{"text":"daemonName","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"kind":"text","text":", "},{"kind":"externalParam","text":"rooms"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"Location","preciseIdentifier":"s:6Gnusto8LocationV"},{"kind":"text","text":"], "},{"text":"chancePerTurn","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"while","kind":"externalParam"},{"kind":"text","text":": () -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"text":", ","kind":"text"},{"text":"arrival","kind":"externalParam"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?, "},{"text":"departure","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?) -> ","kind":"text"},{"text":"TimedEvent","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto10TimedEventV"}],"abstract":[{"type":"text","text":"A daemon that, with "},{"code":"chancePerTurn","type":"codeVoice"},{"text":", moves ","type":"text"},{"code":"actor","type":"codeVoice"},{"text":" to a random","type":"text"},{"type":"text","text":" "},{"inlineContent":[{"text":"other","type":"text"}],"type":"emphasis"},{"text":" room in ","type":"text"},{"type":"codeVoice","code":"rooms"},{"type":"text","text":" — a teleport within the set, with no"},{"type":"text","text":" "},{"text":"exit-graph awareness (a wall between two rooms in the set won’t","type":"text"},{"type":"text","text":" "},{"type":"text","text":"stop him). Arrival\/departure lines print only when the player’s"},{"type":"text","text":" "},{"type":"text","text":"room is lit and is the room being entered or left: in the dark, or"},{"type":"text","text":" "},{"type":"text","text":"a room away, movement is silent. The daemon idles (no RNG drawn)"},{"type":"text","text":" "},{"type":"text","text":"while the actor is outside "},{"code":"rooms","type":"codeVoice"},{"text":" — including after ","type":"text"},{"code":"vanish()","type":"codeVoice"},{"text":" —","type":"text"},{"text":" ","type":"text"},{"text":"but the host should still ","type":"text"},{"code":"stopDaemon(_:)","type":"codeVoice"},{"type":"text","text":" on the actor’s death."}]},"doc://Gnusto/documentation/Gnusto/Actor":{"title":"Actor","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"A character in the world — a troll, a thief, a parrot."}],"fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"Actor"}],"url":"\/documentation\/gnusto\/actor","navigatorTitle":[{"text":"Actor","kind":"identifier"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Actor","type":"topic"},"doc://GnustoActors/documentation/GnustoActors/ActorBehaviors/follows(_:daemonName:rooms:while:arrivals:)":{"title":"follows(_:daemonName:rooms:while:arrivals:)","kind":"symbol","role":"symbol","abstract":[{"text":"A daemon that keeps ","type":"text"},{"code":"actor","type":"codeVoice"},{"type":"text","text":" in the player’s room: each turn, if the"},{"type":"text","text":" "},{"type":"text","text":"actor is onstage but elsewhere, it teleports to wherever the player"},{"type":"text","text":" "},{"type":"text","text":"now stands. Daemons tick at the end of the turn, after the player’s"},{"type":"text","text":" "},{"code":"go","type":"codeVoice"},{"text":" has resolved and the new room is described, so the companion","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"catches up the same turn and its "},{"code":"arrival","type":"codeVoice"},{"type":"text","text":" line trails the room"},{"type":"text","text":" "},{"type":"text","text":"description. The line prints only when the destination is lit: in"},{"type":"text","text":" "},{"type":"text","text":"the dark the companion arrives unseen. There is deliberately no"},{"type":"text","text":" "},{"type":"codeVoice","code":"departure"},{"type":"text","text":" line — the companion only ever moves "},{"type":"emphasis","inlineContent":[{"type":"text","text":"to"}]},{"type":"text","text":" the player,"},{"type":"text","text":" "},{"type":"text","text":"so no one is ever in the room it leaves to watch it go (unlike"},{"text":" ","type":"text"},{"code":"roams","type":"codeVoice"},{"type":"text","text":"). The daemon idles while the actor is offstage — including"},{"type":"text","text":" "},{"type":"text","text":"after "},{"type":"codeVoice","code":"vanish()"},{"type":"text","text":" — and the host may "},{"type":"codeVoice","code":"stopDaemon(_:)"},{"type":"text","text":" to park the"},{"type":"text","text":" "},{"type":"text","text":"companion for a “wait here” beat, then "},{"type":"codeVoice","code":"startDaemon(_:)"},{"type":"text","text":" to resume."},{"type":"text","text":" "},{"type":"text","text":"It draws no randomness at all (unlike "},{"type":"codeVoice","code":"roams"},{"type":"text","text":" and "},{"type":"codeVoice","code":"steals"},{"type":"text","text":"), so a"},{"type":"text","text":" "},{"type":"text","text":"following companion never perturbs the seeded stream: "},{"type":"codeVoice","code":"arrivals"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"cycled by the saved turn counter, so the line varies from arrival to"},{"type":"text","text":" "},{"type":"text","text":"arrival yet stays deterministic across save and restore. Pass one"},{"type":"text","text":" "},{"type":"text","text":"line for a fixed announcement, a dozen so a constant companion does"},{"type":"text","text":" "},{"type":"text","text":"not wear his welcome out. Start the companion co-located with the"},{"type":"text","text":" "},{"type":"text","text":"player ("},{"type":"codeVoice","code":"starts(in:)"},{"type":"text","text":" the player’s start room) to avoid a spurious"},{"type":"text","text":" "},{"type":"text","text":"arrival on turn one."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"follows"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto5ActorV","text":"Actor"},{"kind":"text","text":", "},{"kind":"externalParam","text":"daemonName"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"rooms"},{"kind":"text","text":": ["},{"text":"Location","preciseIdentifier":"s:6Gnusto8LocationV","kind":"typeIdentifier"},{"text":"]?, ","kind":"text"},{"text":"while","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"arrivals","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"]) -> ","kind":"text"},{"text":"TimedEvent","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto10TimedEventV"}],"url":"\/documentation\/gnustoactors\/actorbehaviors\/follows(_:daemonname:rooms:while:arrivals:)","identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/follows(_:daemonName:rooms:while:arrivals:)","type":"topic"},"doc://Gnusto/documentation/Gnusto/Location":{"title":"Location","kind":"symbol","role":"symbol","abstract":[{"text":"A place in the world.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Location"}],"url":"\/documentation\/gnusto\/location","navigatorTitle":[{"kind":"identifier","text":"Location"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Location","type":"topic"}}}