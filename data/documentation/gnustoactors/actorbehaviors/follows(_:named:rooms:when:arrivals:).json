ent","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"rooms:"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"when:"},{"type":"text","text":" are the two ways to scope a follower, and they"},{"type":"text","text":" "},{"type":"text","text":"scope different things. "},{"type":"codeVoice","code":"rooms:"},{"type":"text","text":" is a whitelist of "},{"inlineContent":[{"type":"text","text":"destinations"}],"type":"emphasis"},{"type":"text","text":" — a"},{"type":"text","text":" "},{"type":"text","text":"gaoler who walks the corridors and will not set foot in a cell follows"},{"text":" ","type":"text"},{"text":"you along the one and lets you go into the other, which is what makes","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"“somewhere he will not go” a place you can stand. "},{"type":"codeVoice","code":"when:"},{"type":"text","text":" is an extra"},{"type":"text","text":" "},{"type":"text","text":"gate evaluated first, exactly as "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/roams(_:named:rooms:chancePerTurn:when:arrival:departure:)"},{"type":"text","text":"’s"},{"type":"text","text":" "},{"type":"text","text":"is, for the companion who has been told to wait. Either left out is"},{"type":"text","text":" "},{"type":"text","text":"always open, so a caller that passes neither behaves exactly as before."}]}]}],"references":{"doc://GnustoActors/documentation/GnustoActors/ActorBehaviors/roams(_:named:rooms:chancePerTurn:when:arrival:departure:)":{"role":"symbol","kind":"symbol","type":"topic","title":"roams(_:named:rooms:chancePerTurn:when:arrival:departure:)","abstract":[{"text":"A daemon that, with ","type":"text"},{"type":"codeVoice","code":"chancePerTurn"},{"text":", moves ","type":"text"},{"type":"codeVoice","code":"actor"},{"text":" to a random","type":"text"},{"text":