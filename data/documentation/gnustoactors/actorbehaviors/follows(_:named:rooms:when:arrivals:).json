":"Return Value","level":2,"anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"The following daemon, for the host’s ","type":"text"},{"code":"timers","type":"codeVoice"},{"type":"text","text":" block."}]}],"kind":"content"},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"code":"rooms:","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"when:","type":"codeVoice"},{"type":"text","text":" are the two ways to scope a follower, and they"},{"type":"text","text":" "},{"type":"text","text":"scope different things. "},{"code":"rooms:","type":"codeVoice"},{"type":"text","text":" is a whitelist of "},{"type":"emphasis","inlineContent":[{"type":"text","text":"destinations"}]},{"text":" — a","type":"text"},{"text":" ","type":"text"},{"text":"gaoler who walks the corridors and will not set foot in a cell follows","type":"text"},{"text":" ","type":"text"},{"text":"you along the one and lets you go into the other, which is what makes","type":"text"},{"text":" ","type":"text"},{"text":"“somewhere he will not go” a place you can stand. ","type":"text"},{"type":"codeVoice","code":"when:"},{"type":"text","text":" is an extra"},{"text":" ","type":"text"},{"type":"text","text":"gate evaluated first, exactly as "},{"identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/roams(_:named:rooms:chancePerTurn:when:arrival:departure:)","type":"reference","isActive":true},{"text":"’s","type":"text"},{"text":" ","type":"text"},{"text":"is, for the companion who has been told to wait. Either left out is","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"always open, so a caller that passes neither behaves exactly as before."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/follows(_:named:rooms:when:arrivals:)","interfaceLanguage":"swift"},"seeAlsoSections":[{"generated":true,"anchor":"Moving-an-ac