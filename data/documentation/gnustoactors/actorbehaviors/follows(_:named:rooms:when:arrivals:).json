ustoActors":{"abstract":[{"text":"Daemons that make an NPC wander, tag along, or go through your pockets.","type":"text"}],"type":"topic","kind":"symbol","role":"collection","identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors","url":"\/documentation\/gnustoactors","title":"GnustoActors"},"doc://Gnusto/documentation/Gnusto/Actor":{"abstract":[{"text":"A character in the world — a troll, a thief, a parrot.","type":"text"}],"navigatorTitle":[{"text":"Actor","kind":"identifier"}],"type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Actor","title":"Actor","url":"\/documentation\/gnusto\/actor","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Actor","kind":"identifier"}]},"doc://GnustoActors/documentation/GnustoActors/ActorBehaviors/roams(_:named:rooms:chancePerTurn:when:arrival:departure:)":{"url":"\/documentation\/gnustoactors\/actorbehaviors\/roams(_:named:rooms:chanceperturn:when:arrival:departure:)","type":"topic","kind":"symbol","abstract":[{"text":"A daemon that, with ","type":"text"},{"code":"chancePerTurn","type":"codeVoice"},{"text":", moves ","type":"text"},{"code":"actor","type":"codeVoice"},{"text":" to a random","type":"text"},{"text":" ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"other","type":"text"}]},{"text":" room in ","type":"text"},{"code":"rooms","type":"codeVoice"},{"text":" — a teleport within the set, with no","type":"text"},{"text":" ","type":"text"},{"text":"exit-graph awareness (a wall between two rooms in the set won’t","type":"text"},{"text":" ","type":"text"},{"text":"stop him). Arrival\/departure lines print only when the player’s","type":"text"},{"text":" ","type":"text"},{"text":"room is lit and is the room being entered or left: in the dark, or","type":"text"},{"text":" ","type":"text"},{"text":"a room away, movement is silent. The daemon idles (no RNG drawn)","type":"text"},{"text":" ","type":"text"},{"text":"while the actor is outside ","type":"text"},{"code":"rooms","type":"codeVoice"},{"text":" — including after ","type":"text"},{"code":"vanish()","type":"codeVoice"},{"text":" —","type":"text"},{"text":" ","type":"text"},{"text":"but the host should still ","type":"text"},{"code":"stopDaemon(_:)","type":"codeVoice"},{"text":" on the actor’s death.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"roams"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Actor","preciseIdentifier":"s:6Gnusto5ActorV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"named"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"rooms"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"Location","preciseIdentifier":"s:6Gnusto8LocationV"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"chancePerTurn"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"when"},{"kind":"text","text":": () -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":", "},{"kind":"externalParam","text":"arrival"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"departure"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?) -> "},{"kind":"typeIdentifier","text":"TimedEvent","preciseIdentifier":"s:6Gnusto10TimedEventV"}],"identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/roams(_:named:rooms:chancePerTurn:when:arrival:departure:)","title":"roams(_:named:rooms:chancePerTurn:when:arrival:departure:)"},"doc://Gnusto/documentation/Gnusto/TimedEvent":{"abstract":[{"type":"text","text":"A named timed event, declared in a game or bundle "},{"type":"codeVoice","code":"timers"},{"type":"text","text":" block: a fuse"},{"type":"text","text":" "},{"type":"text","text":"(fires once, N turns after it is started) or a daemon (runs at the end of"},{"type":"text","text":" "},{"type":"text","text":"every turn while active). The body is registered at bootstrap and never"},{"type":"text","text":" "},{"type":"text","text":"serialized; only the schedule — name → turns remaining, or the active"},{"type":"text","text":" "},{"type":"text","text":"flag — lives in "},{"type":"codeVoice","code":"WorldState"},{"type":"text","text":", so it saves and restores like any other"},{"type":"text","text":" "},{"type":"text","text":"state and a restore re-binds it to the declared body by name."}],"type":"topic","title":"TimedEvent","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TimedEvent"}],"navigatorTitle":[{"kind":"identifier","text":"TimedEvent"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TimedEvent","url":"\/documentation\/gnusto\/timedevent","role":"symbol","kind":"symbol"},"doc://GnustoActors/documentation/GnustoActors/ActorBehaviors":{"abstract":[{"type":"text","text":"Logic-only NPC behaviors: roaming, theft, canned reactions. The plugin"},{"type":"text","text":" "},{"text":"owns no entities and no state — position ","type":"text"},{"inlineContent":[{"type":"text","text":"is"}],"type":"emphasis"},{"text":" the actor’s placement —","type":"text"},{"text":" ","type":"text"},{"text":"so the host declares its actors and splices these factories into its","type":"text"},{"text":" ","type":"text"},{"text":"own ","type":"text"},{"code":"timers","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"rules","type":"codeVoice"},{"text":" blocks:","type":"text"}],"navigatorTitle":[{"text":"ActorBehaviors","kind":"identifier"}],"type":"topic","kind":"symbol","role":"symbol","title":"ActorBehaviors","url":"\/documentation\/gnustoactors\/actorbehaviors","identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ActorBehaviors","kind":"identifier"}]},"doc://Gnusto/documentation/Gnusto/Location":{"abstract":[{"type":"text","text":"A place in the world."}],"type":"topic","title":"Location","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Location","kind":"identifier"}],"navigatorTitle":[{"text":"Location","kind":"identifier"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Location","url":"\/documentation\/gnusto\/location","role":"symbol","kind":"symbol"}}}