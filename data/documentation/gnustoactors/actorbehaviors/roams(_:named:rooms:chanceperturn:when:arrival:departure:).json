":"named"},{"kind":"text","text":" "},{"kind":"internalParam","text":"name"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"rooms"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"Location","preciseIdentifier":"s:6Gnusto8LocationV","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Location"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"chancePerTurn"},{"kind":"text","text":" "},{"kind":"internalParam","text":"percent"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":" = 50, "},{"kind":"externalParam","text":"when"},{"kind":"text","text":" "},{"kind":"internalParam","text":"condition"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":" = { true }, "},{"kind":"externalParam","text":"arrival"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"departure"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"? = nil) -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TimedEvent","preciseIdentifier":"s:6Gnusto10TimedEventV","text":"TimedEvent"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The NPC to teleport."}]}],"name":"actor"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The daemon’s global timer name.","type":"text"}]}],"name":"name"},{"content":[{"inlineContent":[{"type":"text","text":"The set of rooms the actor teleports within."}],"type":"paragraph"}],"name":"rooms"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Per-Turn chance of a move, while in the set.","type":"text"}]}],"name":"percent"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An extra gate, checked first — a false gate is a quiet, draw-free turn."}]}],"name":"condition"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Line printed when the player watches the actor arrive."}]}],"name":"arrival"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Line printed when the player watches the actor leave."}]}],"name":"departure"}]},{"content":[{"anchor":"return-value","level":2,"text":"Return Value","type":"heading"},{"inlineContent":[{"text":"The roaming daemon, for the host’s ","type":"text"},{"code":"timers","type":"codeVoice"},{"text":" block.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"inlineContent":[{"type":"codeVoice","code":"when:"},{"type":"text","text":" is an extra gate evaluated "},{"inlineContent":[{"text":"first","type":"text"}],"type":"emphasis"},{"type":"text","text":", before the position guard"},{"type":"text","text":" "},{"type":"text","text":"and before any draw, exactly as "},{"type":"codeVoice","code":"MeleeCombat.aggression(of:…)"},{"type":"text","text":"’s is — so"},{"type":"text","text":" "},{"type":"text","text":"a roamer whose wandering is scoped (the thief holds still while you are"},{"type":"text","text":" "},{"type":"text","text":"standing in his lair) burns no randomness on the turns his gate is shut,"},{"type":"text","text":" "},{"type":"text","text":"keeping every seeded draw sequence intact. The default gate is always"},{"type":"text","text":" "},{"type":"text","text":"open, so a caller that does not pass one behaves exactly as before."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/GnustoActors\/documentation\/GnustoActors","doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/roams(_:named:rooms:chancePerTurn:when:arrival:departure:)"},"references":{"doc://GnustoActors/documentation/GnustoActors/ActorBehaviors/follows(_:named:rooms:when:arrivals:)":{"url":"\/documentation\/gnustoactors\/actorbehaviors\/follows(_:named:rooms:when:arrivals:)","type":"topic","title":"follows(_:named:rooms:when:arrivals:)","identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/follows(_:named:rooms:when:arrivals:)","abstract":[{"text":"A daemon that keeps ","type":"text"},{"type":"codeVoice","code":"actor"},{"text":" in the player’s room: each turn, if the","type":"text"},{"text":" ","type":"text"},{"text":"actor is onstage but elsewhere, it teleports to wherever the player","type":"text"},{"text":" ","type":"text"},{"text":"now stands. Daemons tick at the end of the turn, after the player’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"go"},{"text":" has resolved and the new room is described, so the companion","type":"text"},{"text":" ","type":"text"},{"text":"catches up the same turn and its ","type":"text"},{"type":"codeVoice","code":"arrival"},{"text":" line trails the room","type":"text"},{"text":" ","type":"text"},{"text":"description. The line prints only when the destination is lit: in","type":"text"},{"text":" ","type":"text"},{"text":"the dark the companion arrives unseen. There is deliberately no","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"departure"},{"text":" line — the companion only ever moves ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"to"}]},{"text":" the player,","type":"text"},{"text":" ","type":"text"},{"text":"so no one is ever in the room it leaves to watch it go (unlike","type":"text"},{"text":" ","type":"text"},{"code":"roams","type":"codeVoice"},{"text":"). The daemon idles while the actor is offstage — including","type":"text"},{"text":" ","type":"text"},{"text":"after ","type":"text"},{"code":"vanish()","type":"codeVoice"},{"text":" — and the host may ","type":"text"},{"code":"stopDaemon(_:)","type":"codeVoice"},{"text":" to park the","type":"text"},{"text":" ","type":"text"},{"text":"companion for a “wait here” beat, then ","type":"text"},{"code":"startDaemon(_:)","type":"codeVoice"},{"text":" to resume.","type":"text"},{"text":" ","type":"text"},{"text":"It draws no randomness at all (unlike ","type":"text"},{"code":"roams","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"steals","type":"codeVoice"},{"text":"), so a","type":"text"},{"text":" ","type":"text"},{"text":"following companion never perturbs the seeded stream: ","type":"text"},{"code":"arrivals","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"cycled by the saved turn counter, so the line varies from arrival to","type":"text"},{"text":" ","type":"text"},{"text":"arrival yet stays deterministic across save and restore. Pass one","type":"text"},{"text":" ","type":"text"},{"text":"line for a fixed announcement, a dozen so a constant companion does","type":"text"},{"text":" ","type":"text"},{"text":"not wear his welcome out. Start the companion co-located with the","type":"text"},{"text":" ","type":"text"},{"text":"player (","type":"text"},{"code":"starts(in:)","type":"codeVoice"},{"text":" the player’s start room) to avoid a spurious","type":"text"},{"text":" ","type":"text"},{"text":"arrival on turn one.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"follows","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:6Gnusto5ActorV","text":"Actor","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"named","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"rooms","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:6Gnusto8LocationV","text":"Location","kind":"typeIdentifier"},{"text":"]?, ","kind":"text"},{"text":"when","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"arrivals","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"]) -> ","kind":"text"},{"preciseIdentifier":"s:6Gnusto10TimedEventV","text":"TimedEvent","kind":"typeIdentifier"}],"kind":"symbol","role":"symbol"},"doc://GnustoActors/documentation/GnustoActors/ActorBehaviors":{"abstract":[{"type":"text","text":"Logic-only NPC behaviors: roaming, theft, canned reactions. The plugin"},{"type":"text","text":" "},{"type":"text","text":"owns no entities and no state — position "},{"type":"emphasis","inlineContent":[{"text":"is","type":"text"}]},{"type":"text","text":" the actor’s placement —"},{"type":"text","text":" "},{"type":"text","text":"so the host declares its actors and splices these factories into its"},{"type":"text","text":" "},{"type":"text","text":"own "},{"code":"timers","type":"codeVoice"},{"type":"text","text":" and "},{"code":"rules","type":"codeVoice"},{"type":"text","text":" blocks:"}],"identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors","url":"\/documentation\/gnustoactors\/actorbehaviors","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ActorBehaviors"}],"navigatorTitle":[{"kind":"identifier","text":"ActorBehaviors"}],"title":"ActorBehaviors","type":"topic"},"doc://Gnusto/documentation/Gnusto/TimedEvent":{"type":"topic","title":"TimedEvent","url":"\/documentation\/gnusto\/timedevent","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TimedEvent","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TimedEvent","kind":"identifier"}],"abstract":[{"type":"text","text":"A named timed event, declared in a game or bundle "},{"code":"timers","type":"codeVoice"},{"type":"text","text":" block: a fuse"},{"type":"text","text":" "},{"type":"text","text":"(fires once, N turns after it is started) or a daemon (runs at the end of"},{"type":"text","text":" "},{"type":"text","text":"every turn while active). The body is registered at bootstrap and never"},{"type":"text","text":" "},{"type":"text","text":"serialized; only the schedule — name → turns remaining, or the active"},{"type":"text","text":" "},{"type":"text","text":"flag — lives in "},{"code":"WorldState","type":"codeVoice"},{"type":"text","text":", so it saves and restores like any other"},{"type":"text","text":" "},{"type":"text","text":"state and a restore re-binds it to the declared body by name."}],"navigatorTitle":[{"text":"TimedEvent","kind":"identifier"}],"role":"symbol"},"doc://GnustoActors/documentation/GnustoActors":{"url":"\/documentation\/gnustoactors","type":"topic","title":"GnustoActors","identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors","abstract":[{"type":"text","text":"Daemons that make an NPC wander, tag along, or go through your pockets."}],"kind":"symbol","role":"collection"},"doc://Gnusto/documentation/Gnusto/Location":{"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Location","kind":"symbol","url":"\/documentation\/gnusto\/location","abstract":[{"type":"text","text":"A place in the world."}],"role":"symbol","title":"Location","navigatorTitle":[{"kind":"identifier","text":"Location"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Location"}]},"doc://GnustoActors/documentation/GnustoActors/ActorBehaviors/roams(_:named:rooms:chancePerTurn:when:arrival:departure:)":{"role":"symbol","kind":"symbol","type":"topic",