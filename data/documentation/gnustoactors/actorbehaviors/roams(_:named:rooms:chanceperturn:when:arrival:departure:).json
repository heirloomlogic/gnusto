pe":"text"},{"text":"the dark the companion arrives unseen. There is deliberately no","type":"text"},{"text":" ","type":"text"},{"code":"departure","type":"codeVoice"},{"text":" line — the companion only ever moves ","type":"text"},{"inlineContent":[{"type":"text","text":"to"}],"type":"emphasis"},{"text":" the player,","type":"text"},{"text":" ","type":"text"},{"text":"so no one is ever in the room it leaves to watch it go (unlike","type":"text"},{"text":" ","type":"text"},{"code":"roams","type":"codeVoice"},{"type":"text","text":"). The daemon idles while the actor is offstage — including"},{"type":"text","text":" "},{"type":"text","text":"after "},{"type":"codeVoice","code":"vanish()"},{"type":"text","text":" — and the host may "},{"type":"codeVoice","code":"stopDaemon(_:)"},{"type":"text","text":" to park the"},{"type":"text","text":" "},{"type":"text","text":"companion for a “wait here” beat, then "},{"type":"codeVoice","code":"startDaemon(_:)"},{"type":"text","text":" to resume."},{"type":"text","text":" "},{"type":"text","text":"It draws no randomness at all (unlike "},{"type":"codeVoice","code":"roams"},{"type":"text","text":" and "},{"type":"codeVoice","code":"steals"},{"type":"text","text":"), so a"},{"type":"text","text":" "},{"type":"text","text":"following companion never perturbs the seeded stream: "},{"type":"codeVoice","code":"arrivals"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"cycled by the saved turn counter, so the line varies from arrival to"},{"type":"text","text":" "},{"type":"text","text":"arrival yet stays deterministic across save and restore. Pass one"},{"type":"text","text":" "},{"type":"text","text":"line for a fixed announcement, a dozen so a constant companion does"},{"type":"text","text":" "},{"type":"text","text":"not wear his welcome out. Start the companion co-located with the"},{"type":"text","text":" "},{"type":"text","text":"player ("},{"type":"codeVoice","code":"starts(in:)"},{"type":"text","text":" the player’s start room) to avoid a spurious"},{"type":"text","text":" "},{"type":"text","text":"arrival on turn one."}],"type":"topic","title":"follows(_:named:rooms:when:arrivals:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"follows","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Actor","preciseIdentifier":"s:6Gnusto5ActorV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"named","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"rooms","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Location","preciseIdentifier":"s:6Gnusto8LocationV","kind":"typeIdentifier"},{"text":"]?, ","kind":"text"},{"text":"when","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"arrivals","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"]) -> ","kind":"text"},{"text":"TimedEvent","preciseIdentifier":"s:6Gnusto10TimedEventV","kind":"typeIdentifier"}],"identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/follows(_:named:rooms:when:arrivals:)","url":"\/documentation\/gnustoactors\/actorbehaviors\/follows(_:named:rooms:when:arrivals:)","role":"symbol","kind":"symbol"}}}