eciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"departure","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"? = nil) -> ","kind":"text"},{"preciseIdentifier":"s:6Gnusto10TimedEventV","text":"TimedEvent","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TimedEvent","kind":"typeIdentifier"}]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"The NPC to teleport.","type":"text"}],"type":"paragraph"}],"name":"actor"},{"content":[{"inlineContent":[{"text":"The daemon’s global timer name.","type":"text"}],"type":"paragraph"}],"name":"name"},{"content":[{"inlineContent":[{"text":"The set of rooms the actor teleports within.","type":"text"}],"type":"paragraph"}],"name":"rooms"},{"content":[{"inlineContent":[{"text":"Per-Turn chance of a move, while in the set.","type":"text"}],"type":"paragraph"}],"name":"percent"},{"content":[{"inlineContent":[{"text":"An extra gate, checked first — a false gate is a quiet, draw-free turn.","type":"text"}],"type":"paragraph"}],"name":"condition"},{"content":[{"inlineContent":[{"text":"Line printed when the player watches the actor arrive.","type":"text"}],"type":"paragraph"}],"name":"arrival"},{"content":[{"inlineContent":[{"text":"Line printed when the player watches the actor leave.","type":"text"}],"type":"paragraph"}],"name":"departure"}]},{"kind":"content","content":[{"anchor":"return-value","type":"heading","text":"Return Value","level":2},{"type":"paragraph","inlineContent":[{"text":"The roaming daemon, for the host’s ","type":"text"},{"code":"timers","type":"codeVoice"},{"text":" block.","type":"text"}]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"code":"when:","type":"codeVoice"},{"text":" is an extra gate evaluated ","type":"text"},{"inlineContent":[{"text":"first","type":"text"}],"type":"emphasis"},{"text":", before the position guard","type":"text"},{"text":" ","type":"text"},{"text":"and before any draw, exactly as ","type":"text"},{"code":"MeleeCombat.aggression(of:…)","type":"codeVoice"},{"text":"’s is — so","type":"text"},{"text":" ","type":"text"},{"text":"a roamer whose wandering is scoped (the thief holds still while you are","type":"text"},{"text":" ","type":"text"},{"text":"standing in his lair) burns no randomness on the turns his gate is shut,","type":"text"},{"text":" ","type":"text"},{"text":"keeping every seeded draw sequence intact. The default gate is always","type":"text"},{"text":" ","type":"text"},{"text":"open, so a caller that does not pass one behaves exactly as before.","type":"text"}]}]}],"sections":[],"abstract":[{"type":"text","text":"A daemon that, with "},{"type":"codeVoice","code":"chancePerTurn"},{"type":"text","text":", moves "},{"type":"codeVoice","code":"actor"},{"type":"text","text":" to a random"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"other","type":"text"}]},{"type":"text","text":" room in "},{"type":"codeVoice","code":"rooms"},{"type":"text","text":" — a teleport within the set, with no"},{"type":"text","text":" "},{"type":"text","text":"exit-graph awareness (a wall between two rooms in the set won’t"},{"type":"text","text":" "},{"type":"text","text":"stop him). Arrival\/departure lines print only when the player’s"},{"type":"text","text":" "},{"type":"text","text":"room is lit and is the room being entered or left: in the dark, or"},{"type":"text","text":" "},{"type":"text","text":"a room away, movement is silent. The daemon idles (no RNG drawn)"},{"type":"text","text":" "},{"type":"text","text":"while the actor is outside "},{"type":"codeVoice","code":"rooms"},{"type":"text","text":" — including after "},{"type":"codeVoice","code":"vanish()"},{"type":"text","text":" —"},{"type":"text","text":" "},{"type":"text","text":"but the host should still "},{"type":"codeVoice","code":"stopDaemon(_:)"},{"type":"text","text":" on the actor’s death."}],"kind":"symbol","variants":[{"paths":["\/documentation\/gnustoactors\/actorbehaviors\/roams(_:named:rooms:chanceperturn:when:arrival:departure:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Gnusto/documentation/Gnusto/TimedEvent":{"url":"\/documentation\/gnusto\/timedevent","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TimedEvent"}],"abstract":[{"text":"A named timed event, declared in a game or bundle ","type":"text"},{"code":"timers","type":"codeVoice"},{"text":" block: a fuse","type":"text"},{"text":" ","type":"text"},{"text":"(fires once, N turns after it is started) or a daemon (runs at the end of","type":"text"},{"text":" ","type":"text"},{"text":"every turn while active). The body is registered at bootstrap and never","type":"text"},{"text":" ","type":"text"},{"text":"serialized; only the schedule — name → turns remaining, or the active","type":"text"},{"text":" ","type":"text"},{"text":"flag — lives in ","type":"text"},{"code":"WorldState","type":"codeVoice"},{"text":", so it saves and restores like any other","type":"text"},{"text":" ","type":"text"},{"text":"state and a restore re-binds it to the declared body by name.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"TimedEvent"}],"title":"TimedEvent","type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TimedEvent","role":"symbol","kind":"symbol"},"doc://GnustoActors/documentation/GnustoActors/ActorBehaviors/follows(_:named:rooms:when:arrivals:)":{"url":"\/documentation\/gnustoactors\/actorbehaviors\/follows(_:named:rooms:when:arrivals:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"follows","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Actor","preciseIdentifier":"s:6Gnusto5ActorV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"named","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"rooms","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Location","preciseIdentifier":"s:6Gnusto8LocationV","kind":"typeIdentifier"},{"text":"]?, ","kind":"text"},{"kind":"externalParam","text":"when"},{"kind":"text","text":": () -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":", "},{"kind":"externalParam","text":"arrivals"},{"text":": [","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"]) -> "},{"text":"TimedEvent","preciseIdentifier":"s:6Gnusto10TimedEventV","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"A daemon that keeps "},{"type":"codeVoice","code":"actor"},{"type":"text","text":" in the player’s room: each turn, if the"},{"type":"text","text":" "},{"text":"actor is onstage but elsewhere, it teleports to wherever the player","type":"text"},{"text":" ","type":"text"},{"text":"now stands. Daemons tick at the end of the turn, after the player’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"go"},{"text":" has resolved and the new room is described, so the companion","type":"text"},{"type":"text","text":" "},{"text":"catches up the same turn and its ","type":"text"},{"code":"arrival","type":"codeVoice"},{"text":" line trails the room","type":"text"},{"text":" ","type":"text"},{"text":"description. The line prints only when the destination is lit: in","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the dark the companion arrives unseen. There is deliberately no"},{"text":" ","type":"text"},{"code":"departure","type":"codeVoice"},{"type":"text","text":" line — the companion only ever moves "},{"type":"emphasis","inlineContent":[{"type":"text","text":"to"}]},{"text":" the player,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"so no one is 