ifier":"s:6Gnusto8GameTextV4NounV","text":"Noun","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Noun","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"preciseIdentifier":"s:6Gnusto10TimedEventV","text":"TimedEvent","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TimedEvent","kind":"typeIdentifier"}]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"The thieving NPC.","type":"text"}],"type":"paragraph"}],"name":"actor"},{"content":[{"inlineContent":[{"text":"The daemon’s global timer name.","type":"text"}],"type":"paragraph"}],"name":"name"},{"content":[{"inlineContent":[{"text":"The items eligible to be stolen.","type":"text"}],"type":"paragraph"}],"name":"candidates"},{"content":[{"inlineContent":[{"text":"Per-Turn chance of a theft, while sharing the room.","type":"text"}],"type":"paragraph"}],"name":"percent"},{"content":[{"inlineContent":[{"text":"The theft line, given the stolen item as a","type":"text"},{"text":" ","type":"text"},{"code":"GameText.Noun","type":"codeVoice"},{"text":" — ","type":"text"},{"code":".naming { \"You suddenly notice that \\($0) vanished.\" }","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"announcement"}]},{"kind":"content","content":[{"anchor":"return-value","type":"heading","text":"Return Value","level":2},{"type":"paragraph","inlineContent":[{"text":"The theft daemon, for the host’s ","type":"text"},{"code":"timers","type":"codeVoice"},{"text":" block.","type":"text"}]}]}],"sections":[],"abstract":[{"type":"text","text":"A daemon that, when "},{"type":"codeVoice","code":"actor"},{"type":"text","text":" shares the player’s room, rolls"},{"type":"text","text":" "},{"type":"codeVoice","code":"chancePerTurn"},{"type":"text","text":" and moves one random "},{"type":"emphasis","inlineContent":[{"text":"reachable","type":"text"}]},{"type":"text","text":" item from "},{"type":"codeVoice","code":"candidates"},{"type":"text","text":" "},{"type":"text","text":"into the actor’s inventory, announcing it with the stolen item’s"},{"type":"text","text":" "},{"type":"text","text":"rendered name — “the silver chalice”, “Ozymandias” — so the line writes"},{"type":"text","text":" "},{"type":"text","text":"no article of its own."},{"type":"text","text":" "},{"type":"text","text":"Like the original’s thief, the actor lifts a candidate from wherever it"},{"type":"text","text":" "},{"type":"text","text":"lies in the shared room: out of the player’s hands, off the floor, or"},{"type":"text","text":" "},{"type":"text","text":"from inside anything open — a sack, a trophy case, a table top — to any"},{"type":"text","text":" "},{"type":"text","text":"depth. Only another actor’s hands are beyond reach. The theft is"},{"type":"text","text":" "},{"type":"text","text":"announced only when the player’s room is lit: in the dark you find out"},{"type":"text","text":" "},{"type":"text","text":"when you check your pockets."}],"kind":"symbol","variants":[{"paths":["\/documentation\/gnustoactors\/actorbehaviors\/steals(_:named:candidates:chanceperturn:announcement:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://GnustoActors/documentation/GnustoActors":{"title":"GnustoActors","url":"\/documentation\/gnustoactors","identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors","type":"topic","abstract":[{"type":"text","text":"Daemons that make an NPC wander, tag along, or go through your pockets."}],"kind":"symbol","role":"collection"},"doc://Gnusto/documentation/Gnusto/GameText/Noun":{"title":"GameText.Noun","url":"\/documentation\/gnusto\/gametext\/noun","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Noun","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Noun"}],"navigatorTitle":[{"kind":"identifier","text":"Noun"}],"abstract":[{"type":"text","text":"A rendered noun phrase that also knows its own number, for the lines"},{"type":"text","text"