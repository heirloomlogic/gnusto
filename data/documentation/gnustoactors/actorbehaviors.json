ext","text":"owns no entities and no state — position "},{"type":"emphasis","inlineContent":[{"text":"is","type":"text"}]},{"type":"text","text":" the actor’s placement —"},{"type":"text","text":" "},{"type":"text","text":"so the host declares its actors and splices these factories into its"},{"type":"text","text":" "},{"type":"text","text":"own "},{"type":"codeVoice","code":"timers"},{"type":"text","text":" and "},{"type":"codeVoice","code":"rules"},{"text":" blocks:","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ActorBehaviors","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"type":"codeListing","syntax":"swift","code":["let actors = ActorBehaviors()","","var timers: [TimedEvent] {","    actors.roams(thief, named: \"thief.roam\",","                 rooms: [cellar, gallery, studio])","    actors.steals(thief, named: \"thief.steal\",","                  candidates: [painting],","                  announcement: { \"A shadow relieves you of the \\($0).\" })","}"]},{"type":"paragraph","inlineContent":[{"text":"Every random decision draws from the game’s seeded stream, and draws","type":"text"},{"text":" ","type":"text"},{"text":"happen ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"only after"}]},{"type":"text","text":" a factory’s guards pass — a daemon whose actor is"},{"type":"text","text":" "},{"type":"text","text":"out of position (or whose player has nothing worth taking) consumes no"},{"type":"text","text":" "},{"type":"text","text":"randomness, so transcripts that never meet the actor stay stable no"},{"type":"text","text":" "},{"type":"text","text":"matter what he does elsewhere."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"None of these daemons acts for an actor whose "},{"code":"Actor.isUnconscious","type":"codeVoice"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"set."}],"type":"strong"},{"type":"text","text":" A man lying on the floor does not wander off, catch you up, or lift"},{"type":"text","text":" "},{"type":"text","text":"anything out of your hands, and he draws no randomness deciding not to."},{"type":"text","text":" "},{"text":"That flag is the engine’s rather than this plugin’s for a reason worth","type":"text"},{"text":" ","type":"text"},{"text":"knowing: what usually puts a villain down is a combat plugin, and two","type":"text"},{"text":" ","type":"text"},{"text":"plugins cannot see each other. ","type":"text"},{"code":"GnustoMeleeCombat","type":"codeVoice"},{"text":" sets it and this one","type":"text"},{"text":" ","type":"text"},{"text":"reads it, without either library knowing the other exists.","type":"text"}]}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/GnustoActors\/documentation\/GnustoActors"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnustoactors\/actorbehaviors"]}],"references":{"doc://GnustoActors/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/GnustoActors\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://GnustoActors/documentation/GnustoActors":{"url":"\/documentation\/gnustoactors","type":"topic","title":"GnustoActors","identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors","abstract":[{"type":"text","text":"Daemons that make an NPC wander, tag along, or go through your pockets."}],"kind":"symbol","role":"collection"},"doc://GnustoActors/documentation/GnustoActors/ActorBehaviors/reaction(of:to:reply:)":{"url":"\/documentation\/gnustoactors\/actorbehaviors\/reaction(of:to:reply:)","type":"topic","title":"reaction(of:to:reply:)","abstract":[{"type":"text","text":"A canned reply when any of the named intents target the actor —"},{"type":"text","text