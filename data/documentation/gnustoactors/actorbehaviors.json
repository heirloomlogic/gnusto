t":[{"type":"text","text":"verbs"}],"type":"emphasis"},{"type":"text","text":" and "},{"inlineContent":[{"type":"text","text":"rules"}],"type":"emphasis"},{"type":"text","text":", that a host game opts into."}],"navigatorTitle":[{"text":"GamePlugin","kind":"identifier"}],"title":"GamePlugin","type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin","role":"symbol","kind":"symbol"},"doc://GnustoActors/documentation/GnustoActors/ActorBehaviors/reaction(of:for:reply:)":{"title":"reaction(of:for:reply:)","url":"\/documentation\/gnustoactors\/actorbehaviors\/reaction(of:for:reply:)","identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/reaction(of:for:reply:)","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reaction"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto5ActorV","text":"Actor"},{"kind":"text","text":", "},{"kind":"externalParam","text":"for"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto6IntentV","text":"Intent"},{"text":"], ","kind":"text"},{"text":"reply","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto5RulesV","text":"Rules"}],"abstract":[{"type":"text","text":"A canned reply when any of the named intents target the actor —"},{"type":"text","text":" "},{"type":"text","text":"“talk to troll”, “give sword to troll”, whatever the host’s verbs"},{"type":"text","text":" "},{"type":"text","text":"emit. One line, before-phase, ends the turn."}],"kind":"symbol","role":"symbol"},"doc://GnustoActors/documentation/GnustoActors/ActorBehaviors/steals(_:named:candidates:chancePerTurn:announcement:)":{"title":"steals(_:named:candidates:chancePerTurn:announcement:)","url":"\/documentation\/gnustoactors\/actorbehaviors\/steals(_:named:candidates:chanceperturn:announcement:)","identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/steals(_:named:candidates:chancePerTurn:announcement:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"steals","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Actor","preciseIdentifier":"s:6Gnusto5ActorV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"named","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"candidates","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Item","preciseIdentifier":"s:6Gnusto4ItemV","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"chancePerTurn","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"announcement","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"GameText","preciseIdentifier":"s:6Gnusto8GameTextV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Line","preciseIdentifier":"s:6Gnusto8GameTextV4LineV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"GameText","preciseIdentifier":"s:6Gnusto8GameTextV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:6Gnusto8GameTextV4NounV","text":"Noun","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"preciseIdentifier":"s:6Gnusto10TimedEventV","text":"TimedEvent","kind":"typeIdentifier"}],"abstract":[{"text":"A daemon that, when ","type":"text"},{"code":"actor","type":"codeVoice"},{"text":" shares the player’s room, rolls","type":"text"},{"text":" ","type":"text"},{"code":"chancePerTurn","type":"codeVoice"},{"text":" and moves one random ","type":"text"},{"inlineContent":[{"text":"reachable","type":"text"}],"type":"emphasis"},{"type":"text","text":" item from "},{"type":"codeVoice","code":"candidates"},{"type":"text","text":" "},{"type":"text","text":"into the actor’s inventory, announcing it with the stolen item’s"},{"type":"text","text":" "},{"type":"text","text":"rendered name — “the silver chalice”, “Ozymandias” — so the line writes"},{"type":"text","text":" "},{"type":"text","text":"no article of its own."},{"type":"text","text":" "},{"type":"text","text":"Like the original’s thief, the actor lifts a candidate from wherever it"},{"type":"text","text":" "},{"type":"text","text":"lies in the shared room: out of the player’s hands, off the floor, or"},{"type":"text","text":" "},{"type":"text","text":"from inside anything open — a sack, a trophy case, a table top — to any"},{"type":"text","text":" "},{"type":"text","text":"depth. Only another actor’s hands are beyond reach. The theft is"},{"type":"text","text":" "},{"type":"text","text":"announced only when the player’s room is lit: in the dark you find out"},{"type":"text","text":" "},{"type":"text","text":"when you check your pockets."}],"kind":"symbol","role":"symbol"},"doc://GnustoActors/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/GnustoActors\/s8SendableP","title":"Swift.Sendable"},"doc://GnustoActors/documentation/GnustoActors/ActorBehaviors/GamePlugin-Implementations":{"title":"GamePlugin Implementations","url":"\/documentation\/gnustoactors\/actorbehaviors\/gameplugin-implementations","identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/GamePlugin-Implementations","type":"topic","abstract":[],"kind":"article","role":"collectionGroup"},"doc://GnustoActors/documentation/GnustoActors/ActorBehaviors/init()":{"title":"init()","url":"\/documentation\/gnustoactors\/actorbehaviors\/init()","identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/init()","type":"topic","fragments":[{"text":"init","kind":"identifier"},{"kind":"text","text":"()"}],"abstract":[{"type":"text","text":"Creates the plugin."}],"kind":"symbol","role":"symbol"},"doc://GnustoActors/documentation/GnustoActors":{"title":"GnustoActors","url":"\/documentation\/gnustoactors","identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors","type":"topic","abstract":[{"type":"text","text":"Daemons that make an NPC wander, tag along, or go through your pockets."}],"kind":"symbol","role":"collection"},"doc://GnustoActors/documentation/GnustoActors/ActorBehaviors/follows(_:named:rooms:when:arrivals:)":{"title":"follows(_:named:rooms:when:arrivals:)","url":"\/documentation\/gnustoactors\/actorbehaviors\/follows(_:named:rooms:when:arrivals:)","identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/follows(_:named:rooms:when:arrivals:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"follows","kind":"identifier"},{"kind":"text","text":"("},{"text":"Actor","preciseIdentifier":"s:6Gnusto5ActorV","kind":"typeIdentifier"},{"kind":"text","text":", "},{"text":"named","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"rooms"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto8LocationV","text":"Location"},{"text":"]?, ","kind":"text"},{"kind":"externalParam","text":"when"},{"kind":"text","text":": () -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":", "},{"kind":"externalParam","text":"arrivals"},{"kind":"text","text":": ["},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"]) -> ","kind":"text"},{"kind":"typeIdentifier","text":"TimedEvent","preciseIdentifier":"s:6Gnusto10TimedEventV"}],"abstract":[{"text":"A daemon that keeps ","type":"text"},{"code":"actor","type":"codeVoice"},{"type":"text","text":" in the player’s room: each turn, if the"},{"type":"text","text":" "},{"type":"text","text":"actor is onstage but elsewhere, it teleports to wherever the player"},{"type":"text","text":" "},{"type":"text","text":"now stands. Daemons tick at the end of the turn, after the player’s"},{"type":"text","text":" "},{"code":"go","type":"codeVoice"},{"text":" has resolved and the new room is described, so the companion","type":"text"},{"type":"text","text":" "},{"text":"catches up the same turn and its ","type":"text"},{"code":"arrival","type":"codeVoice"},{"text":" line trails the room","type":"text"},{"text":" ","type":"text"},{"text":"description. The line prints only when the destination is lit: in","type":"text"},{"text":" ","type":"text"},{"text":"the dark the companion arrives unseen. There is deliberately no","type":"text"},{"text":" ","type":"text"},{"code":"departure","type":"codeVoice"},{"text":" line — the companion only ever moves ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"to"}]},{"text":" the player,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"so no one is ever in the room it leaves to watch it go (unlike"},{"text":" ","type":"text"},{"type":"codeVoice","code":"roams"},{"text":"). The daemon idles while the actor is offstage — including","type":"text"},{"text":" ","type":"text"},{"text":"after ","type":"text"},{"type":"codeVoice","code":"vanish()"},{"text":" — and the host may ","type":"text"},{"type":"codeVoice","code":"stopDaemon(_:)"},{"text":" to park the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"companion for a “wait here” beat, then "},{"code":"startDaemon(_:)","type":"codeVoice"},{"type":"text","text":" to resume."},{"type":"text","text":" "},{"type":"text","text":"It draws no randomness at all (unlike "},{"type":"codeVoice","code":"roams"},{"type":"text","text":" and "},{"type":"codeVoice","code":"steals"},{"type":"text","text":"), so a"},{"type":"text","text":" "},{"type":"text","text":"following companion never perturbs the seeded stream: "},{"type":"codeVoice","code":"arrivals"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"cycled by the saved turn counter, so the line varies from arrival to"},{"type":"text","text":" "},{"type":"text","text":"arrival yet stays deterministic across save and restore. Pass one"},{"type":"text","text":" "},{"type":"text","text":"line for a fixed announcement, a dozen so a constant companion does"},{"text":" ","type":"text"},{"text":"not wear his welcome out. Start the companion co-located with the","type":"text"},{"text":" ","type":"text"},{"text":"player (","type":"text"},{"code":"starts(in:)","type":"codeVoice"},{"type":"text","text":" the player’s start room) to avoid a spurious"},{"type":"text","text":" "},{"type":"text","text":"arrival on turn one."}],"kind":"symbol","role":"symbol"}}}