pe":"text"},{"text":"room is lit and is the room being entered or left: in the dark, or","type":"text"},{"text":" ","type":"text"},{"text":"a room away, movement is silent. The daemon idles (no RNG drawn)","type":"text"},{"text":" ","type":"text"},{"text":"while the actor is outside ","type":"text"},{"type":"codeVoice","code":"rooms"},{"text":" — including after ","type":"text"},{"type":"codeVoice","code":"vanish()"},{"text":" —","type":"text"},{"text":" ","type":"text"},{"text":"but the host should still ","type":"text"},{"code":"stopDaemon(_:)","type":"codeVoice"},{"text":" on the actor’s death.","type":"text"}],"url":"\/documentation\/gnustoactors\/actorbehaviors\/roams(_:named:rooms:chanceperturn:when:arrival:departure:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"roams","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Actor","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto5ActorV"},{"text":", ","kind":"text"},{"text":"named","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"rooms","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Location","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto8LocationV"},{"text":"], ","kind":"text"},{"text":"chancePerTurn","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"when","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", ","kind":"text"},{"text":"arrival","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"departure","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?) -> ","kind":"text"},{"text":"TimedEvent","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto10TimedEventV"}],"identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/roams(_:named:rooms:chancePerTurn:when:arrival:departure:)"},"doc://GnustoActors/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/GnustoActors\/s8SendableP"},"doc://Gnusto/documentation/Gnusto/GamePlugin":{"url":"\/documentation\/gnusto\/gameplugin","type":"topic","title":"GamePlugin","navigatorTitle":[{"kind":"identifier","text":"GamePlugin"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin","abstract":[{"type":"text","text":"A reusable game system — commerce, combat, dialog, magic — packaged as an"},{"type":"text","text":" "},{"type":"text","text":"importable unit of "},{"type":"emphasis","inlineContent":[{"text":"verbs","type":"text"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"rules"}]},{"type":"text","text":", that a host game opts into."}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"GamePlugin"}],"kind":"symbol","role":"symbol"},"doc://GnustoActors/documentation/GnustoActors/ActorBehaviors":{"abstract":[{"type":"text","text":"Logic-only NPC behaviors: roaming, theft, canned reactions. The plugin"},{"type":"text","text":" "},{"type":"text","text":"owns no entities and no state — position "},{"type":"emphasis","inlineContent":[{"text":"is","type":"text"}]},{"type":"text","text":" the actor’s placement —"},{"type":"text","text":" "},{"type":"text","text":"so the host declares its actors and splices these factories into its"},{"type":"text","text":" "},{"type":"text","text":"own "},{"code":"timers","type":"codeVoice"},{"type":"text","text":" and "},{"code":"rules","type":"codeVoice"},{"type":"text","text":" blocks:"}],"identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors","url":"\/documentation\/gnustoactors\/actorbehaviors","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ActorBehaviors"}],"navigatorTitle":[{"kind":"identifier","text":"ActorBehaviors"}],"title":"ActorBehaviors","type":"topic"},"doc://GnustoActors/documentation/GnustoActors/ActorBehaviors/steals(_:named:candidates:chancePerTurn:announcement:)":{"role":"symbol","kind":"symbol","type":"topic","title":"steals(_:named:candidates:chancePerTurn:announcement:)","abstract":[{"text":"A daemon that, when ","type":"text"},{"code":"actor","type":"codeVoice"},{"text":" shares the player’s room, rolls","type":"text"},{"text":" ","type":"text"},{"code":"chancePerTurn","type":"codeVoice"},{"text":" and moves one random ","type":"text"},{"inlineContent":[{"type":"text","text":"reachable"}],"type":"emphasis"},{"text":" item from ","type":"text"},{"code":"candidates","type":"codeVoice"},{"text":" ","type":"text"},{"text":"into the actor’s inventory, announcing it with the stolen item’s name.","type":"text"},{"text":" ","type":"text"},{"text":"Like the original’s thief, the actor lifts a candidate from wherever it","type":"text"},{"text":" ","type":"text"},{"text":"lies in the shared room: out of the player’s hands, off the floor, or","type":"text"},{"text":" ","type":"text"},{"text":"from inside anything open — a sack, a trophy case, a table top — to any","type":"text"},{"text":" ","type":"text"},{"text":"depth. Only another actor’s hands are beyond reach. The theft is","type":"text"},{"text":" ","type":"text"},{"text":"announced only when the player’s room is lit: in the dark you find out","type":"text"},{"text":" ","type":"text"},{"text":"when you check your pockets.","type":"text"}],"url":"\/documentation\/gnustoactors\/actorbehaviors\/steals(_:named:candidates:chanceperturn:announcement:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"steals","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Actor","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto5ActorV"},{"text":", ","kind":"text"},{"text":"named","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"candidates","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Item","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto4ItemV"},{"text":"], ","kind":"text"},{"text":"chancePerTurn","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"announcement","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") -> ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") -> ","kind":"text"},{"text":"TimedEvent","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto10TimedEventV"}],"identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/steals(_:named:candidates:chancePerTurn:announcement:)"},"doc://GnustoActors/documentation/GnustoActors/ActorBehaviors/follows(_:named:rooms:when:arrivals:)":{"url":"\/documentation\/gnustoactors\/actorbehaviors\/follows(_:named:rooms:when:arrivals:)","type":"topic","title":"follows(_:named:rooms:when:arrivals:)","identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/follows(_:named:rooms:when:arrivals:)","abstract":[{"text":"A daemon that keeps ","type":"text"},{"type":"codeVoice","code":"actor"},{"text":" in the player’s room: each turn, if the","type":"text"},{"text":" ","type":"text"},{"text":"actor is onstage but elsewhere, it teleports to wherever the player","type":"text"},{"text":" ","type":"text"},{"text":"now stands. Daemons tick at the end of the turn, after the player’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"go"},{"text":" has resolved and the new room is described, so the companion","type":"text"},{"text":" ","type":"text"},{"text":"catches up the same turn and its ","type":"text"},{"type":"codeVoice","code":"arrival"},{"text":" line trails the room","type":"text"},{"text":" ","type":"text"},{"text":"description. The line prints only when the destination is lit: in","type":"text"},{"text":" ","type":"text"},{"text":"the dark the companion arrives unseen. There is deliberately no","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"departure"},{"text":" line — the companion only ever moves ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"to"}]},{"text":" the player,","type":"text"},{"text":" ","type":"text"},{"text":"so no one is ever in the room it leaves to watch it go (unlike","type":"text"},{"text":" ","type":"text"},{"code":"roams","type":"codeVoice"},{"text":"). The daemon idles while the actor is offstage — including","type":"text"},{"text":" ","type":"text"},{"text":"after ","type":"text"},{"code":"vanish()","type":"codeVoice"},{"text":" — and the host may ","type":"text"},{"code":"stopDaemon(_:)","type":"codeVoice"},{"text":" to park the","type":"text"},{"text":" ","type":"text"},{"text":"companion for a “wait here” beat, then ","type":"text"},{"code":"startDaemon(_:)","type":"codeVoice"},{"text":" to resume.","type":"text"},{"text":" ","type":"text"},{"text":"It draws no randomness at all (unlike ","type":"text"},{"code":"roams","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"steals","type":"codeVoice"},{"text":"), so a","type":"text"},{"text":" ","type":"text"},{"text":"following companion never perturbs the seeded stream: ","type":"text"},{"code":"arrivals","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"cycled by the saved turn counter, so the line varies from arrival to","type":"text"},{"text":" ","type":"text"},{"text":"arrival yet stays deterministic across save and restore. Pass one","type":"text"},{"text":" ","type":"text"},{"text":"line for a fixed announcement, a dozen so a constant companion does","type":"text"},{"text":" ","type":"text"},{"text":"not wear his welcome out. Start the companion co-located with the","type":"text"},{"text":" ","type":"text"},{"text":"player (","type":"text"},{"code":"starts(in:)","type":"codeVoice"},{"text":" the player’s start room) to avoid a spurious","type":"text"},{"text":" ","type":"text"},{"text":"arrival on turn one.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"follows","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:6Gnusto5ActorV","text":"Actor","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"named","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"rooms","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:6Gnusto8LocationV","text":"Location","kind":"typeIdentifier"},{"text":"]?, ","kind":"text"},{"text":"when","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"arrivals","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"]) -> ","kind":"text"},{"preciseIdentifier":"s:6Gnusto10TimedEventV","text":"TimedEvent","kind":"typeIdentifier"}],"kind":"symbol","role":"symbol"},"doc://GnustoActors/documentation/GnustoActors/ActorBehaviors/GamePlugin-Implementations":{"role":"collectionGroup","kind":"article","type":"topic","title":"GamePlugin Implementations","abstract":[],"url":"\/documentation\/gnustoactors\/actorbehaviors\/gameplugin-implementations","identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/GamePlugin-Implementations"},"doc://GnustoActors/documentation/GnustoActors/ActorBehavio