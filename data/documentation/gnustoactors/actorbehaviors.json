oActors/documentation/GnustoActors/ActorBehaviors/roams(_:named:rooms:chancePerTurn:when:arrival:departure:)":{"type":"topic","url":"\/documentation\/gnustoactors\/actorbehaviors\/roams(_:named:rooms:chanceperturn:when:arrival:departure:)","abstract":[{"text":"A daemon that, with ","type":"text"},{"code":"chancePerTurn","type":"codeVoice"},{"text":", moves ","type":"text"},{"code":"actor","type":"codeVoice"},{"text":" to a random","type":"text"},{"text":" ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"other","type":"text"}]},{"text":" room in ","type":"text"},{"code":"rooms","type":"codeVoice"},{"text":" — a teleport within the set, with no","type":"text"},{"text":" ","type":"text"},{"text":"exit-graph awareness (a wall between two rooms in the set won’t","type":"text"},{"text":" ","type":"text"},{"text":"stop him). Arrival\/departure lines print only when the player’s","type":"text"},{"text":" ","type":"text"},{"text":"room is lit and is the room being entered or left: in the dark, or","type":"text"},{"text":" ","type":"text"},{"text":"a room away, movement is silent. The daemon idles (no RNG drawn)","type":"text"},{"text":" ","type":"text"},{"text":"while the actor is outside ","type":"text"},{"code":"rooms","type":"codeVoice"},{"text":" — including after ","type":"text"},{"code":"vanish()","type":"codeVoice"},{"text":" —","type":"text"},{"text":" ","type":"text"},{"text":"but the host should still ","type":"text"},{"code":"stopDaemon(_:)","type":"codeVoice"},{"text":" on the actor’s death.","type":"text"}],"title":"roams(_:named:rooms:chancePerTurn:when:arrival:departure:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"roams","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:6Gnusto5ActorV","text":"Actor","kind":"typeIdentifier"},{"kind":"text","text":", "},{"kind":"externalParam","text":"named"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"rooms"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto8LocationV","text":"Location"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"chancePerTurn"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"when"},{"kind":"text","text":": () -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":", "},{"kind":"externalParam","text":"arrival"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"departure"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto10TimedEventV","text":"TimedEvent"}],"kind":"symbol","identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/roams(_:named:rooms:chancePerTurn:when:arrival:departure:)"},"doc://GnustoActors/documentation/GnustoActors/ActorBehaviors":{"navigatorTitle":[{"kind":"identifier","text":"ActorBehaviors"}],"type":"topic","url":"\/documentation\/gnustoactors\/actorbehaviors","title":"ActorBehaviors","abstract":[{"type":"text","text":"Logic-only NPC behaviors: roaming, theft, canned reactions. The plugin"},{"text":" ","type":"text"},{"text":"owns no entities and no state — position ","type":"text"},{"inlineContent":[{"text":"is","type":"text"}],"type":"emphasis"},{"text":" the actor’s placement —","type":"text"},{"type":"text","text":" "},{"text":"so the host declares its actors and splices these factories into its","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"own "},{"type":"codeVoice","code":"timers"},{"type":"text","text":" and "},{"code":"rules","type":"codeVoice"},{"type":"text","text":" blocks:"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ActorBehaviors"}],"kind":"symbol","identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors"},"doc://GnustoActors/documentation/GnustoActors/ActorBehaviors/follows(_:named:rooms:when:arrivals:)":{"abstract":[{"text":"A daemon that keeps ","type":"text"},{"type":"codeVoice","code":"actor"},{"text":" in the player’s room: each turn, if the","type":"text"},{"text":" ","type":"text"},{"text":"actor is onstage but elsewhere, it teleports to wherever the player","type":"text"},{"text":" ","type":"text"},{"text":"now stands. Daemons tick at the end of the turn, after the player’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"go"},{"text":" has resolved and the new room is described, so the companion","type":"text"},{"text":" ","type":"text"},{"text":"catches up the same turn and its ","type":"text"},{"type":"codeVoice","code":"arrival"},{"text":" line trails the room","type":"text"},{"text":" ","type":"text"},{"text":"description. The line prints only when the destination is lit: in","type":"text"},{"text":" ","type":"text"},{"text":"the dark the companion arrives unseen. There is deliberately no","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"departure"},{"text":" line — the companion only ever moves ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"to"}]},{"text":" the player,","type":"text"},{"text":" ","type":"text"},{"text":"so no one is ever in the room it leaves to watch it go (unlike","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"roams"},{"text":"). The daemon idles while the actor is offstage — including","type":"text"},{"text":" ","type":"text"},{"text":"after ","type":"text"},{"type":"codeVoice","code":"vanish()"},{"text":" — and the host may ","type":"text"},{"code":"stopDaemon(_:)","type":"codeVoice"},{"type":"text","text":" to park the"},{"type":"text","text":" "},{"type":"text","text":"companion for a “wait here” beat, then "},{"code":"startDaemon(_:)","type":"codeVoice"},{"type":"text","text":" to resume."},{"type":"text","text":" "},{"type":"text","text":"It draws no randomness at all (unlike "},{"code":"roams","type":"codeVoice"},{"type":"text","text":" and "},{"code":"steals","type":"codeVoice"},{"type":"text","text":"), so a"},{"type":"text","text":" "},{"type":"text","text":"following companion never perturbs the seeded stream: "},{"code":"arrivals","type":"codeVoice"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"cycled by the saved turn counter, so the line varies from arrival to"},{"type":"text","text":" "},{"type":"text","text":"arrival yet stays deterministic across save and restore. Pass one"},{"type":"text","text":" "},{"type":"text","text":"line for a fixed announcement, a dozen so a constant companion does"},{"type":"text","text":" "},{"type":"text","text":"not wear his welcome out. Start the companion co-located with the"},{"type":"text","text":" "},{"type":"text","text":"player ("},{"code":"starts(in:)","type":"codeVoice"},{"type":"text","text":" the player’s start room) to avoid a spurious"},{"type":"text","text":" "},{"type":"text","text":"arrival on turn one."}],"title":"follows(_:named:rooms:when:arrivals:)","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"follows"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto5ActorV","text":"Actor"},{"text":", ","kind":"text"},{"text":"named","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"rooms","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Location","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto8LocationV"},{"text":"]?, ","kind":"text"},{"text":"when","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", ","kind":"text"},{"text":"arrivals","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"]) -> ","kind":"text"},{"text":"TimedEvent","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto10TimedEventV"}],"identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/follows(_:named:rooms:when:arrivals:)","role":"symbol","url":"\/documentation\/gnustoactors\/actorbehaviors\/follows(_:named:rooms:when:arrivals:)"},"doc://GnustoActors/documentation/GnustoActors":{"title":"GnustoActors","kind":"symbol","identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors","abstract":[{"type":"text","text":"Daemons that make an NPC wander, tag along, or go through your pockets."}],"role":"collection","url":"\/documentation\/gnustoactors","type":"topic"},"doc://GnustoActors/documentation/GnustoActors/ActorBehaviors/steals(_:named:candidates:chancePerTurn:announcement:)":{"kind":"symbol","title":"steals(_:named:candidates:chancePerTurn:announcement:)","identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/steals(_:named:candidates:chancePerTurn:announcement:)","abstract":[{"type":"text","text":"A daemon that, when "},{"code":"actor","type":"codeVoice"},{"type":"text","text":" shares the player’s room, rolls"},{"type":"text","text":" "},{"type":"codeVoice","code":"chancePerTurn"},{"type":"text","text":" and moves one random "},{"type":"emphasis","inlineContent":[{"text":"reachable","type":"text"}]},{"text":" item from ","type":"text"},{"type":"codeVoice","code":"candidates"},{"type":"text","text":" "},{"type":"text","text":"into the actor’s inventory, announcing it with the stolen item’s"},{"type":"text","text":" "},{"type":"text","text":"rendered name — “the silver chalice”, “Ozymandias” — so the line writes"},{"type":"text","text":" "},{"text":"no article of its own.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Like the original’s thief, the actor lifts a candidate from wherever it"},{"type":"text","text":" "},{"type":"text","text":"lies in the shared room: out of the player’s hands, off the floor, or"},{"type":"text","text":" "},{"type":"text","text":"from inside anything open — a sack, a trophy case, a table top — to any"},{"type":"text","text":" "},{"type":"text","text":"depth. Only another actor’s hands are beyond reach. The theft is"},{"type":"text","text":" "},{"type":"text","text":"announced only when the player’s room is lit: in the dark you find out"},{"text":" ","type":"text"},{"text":"when you check your pockets.","type":"text"}],"role":"symbol","type":"topic","url":"\/documentation\/gnustoactors\/actorbehaviors\/steals(_:named:candidates:chanceperturn:announcement:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"steals","kind":"identifier"},{"kind":"text","text":"("},{"text":"Actor","preciseIdentifier":"s:6Gnusto5ActorV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"named","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"candidates"},{"text":": [","kind":"text"},{"text":"Item","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto4ItemV"},{"text":"], ","kind":"text"},{"text":"chancePerTurn","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"announcement","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"GameText","preciseIdentifier":"s:6Gnusto8GameTextV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto8GameTextV4LineV","text":"Line"},{"kind":"text","text":"<"},{"text":"GameText","preciseIdentifier":"s:6Gnusto8GameTextV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:6Gnusto8GameTextV4NounV","text":"Noun","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"kind":"typeIdentifier","text":"TimedEvent","preciseIdentifier":"s:6Gnusto10TimedEventV"}]},"doc://GnustoActors/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/GnustoActors\/s16SendableMetatypeP"},"doc://GnustoActors/documentation/GnustoActors/ActorBehaviors/reaction(of:for:reply:)":{"abstract":[{"text":"A canned reply when any of the named intents target the actor —","type":"text"},{"text":" ","type":"text"},{"text":"“talk to troll”, “give sword to troll”, whatever the host’s verbs","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"emit. One line, before-phase, ends the turn."}],"role":"symbol","url":"\/documentation\/gnustoactors\/actorbehaviors\/reaction(of:for:reply:)","identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/reaction(of:for:reply:)","kind":"symbol","type":"topic","title":"reaction(of:for:reply:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reaction"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"preciseIdentifier":"s:6Gnusto5ActorV","kind":"typeIdentifier","text":"Actor"},{"kind":"text","text":", "},{"kind":"externalParam","text":"for"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:6Gnusto6IntentV","kind":"typeIdentifier","text":"Intent"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"reply"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:6Gnusto5RulesV","kind":"typeIdentifier","text":"Rules"}]},"doc://GnustoActors/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/GnustoActors\/s8Sen