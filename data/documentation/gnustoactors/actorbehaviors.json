{"metadata":{"symbolKind":"struct","modules":[{"name":"GnustoActors"}],"title":"ActorBehaviors","roleHeading":"Structure","role":"symbol","externalID":"s:12GnustoActors14ActorBehaviorsV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ActorBehaviors","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"ActorBehaviors"}]},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ActorBehaviors","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"type":"codeListing","syntax":"swift","code":["let actors = ActorBehaviors()","","var timers: [TimedEvent] {","    actors.roams(thief, daemonName: \"thief.roam\",","                 rooms: [cellar, gallery, studio])","    actors.steals(thief, daemonName: \"thief.steal\",","                  candidates: [painting],","                  announcement: { \"A shadow relieves you of the \\($0).\" })","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every random decision draws from the game’s seeded stream, and draws"},{"type":"text","text":" "},{"type":"text","text":"happen "},{"type":"strong","inlineContent":[{"type":"text","text":"only after"}]},{"type":"text","text":" a factory’s guards pass — a daemon whose actor is"},{"type":"text","text":" "},{"type":"text","text":"out of position (or whose player has nothing worth taking) consumes no"},{"type":"text","text":" "},{"type":"text","text":"randomness, so transcripts that never meet the actor stay stable no"},{"type":"text","text":" "},{"type":"text","text":"matter what he does elsewhere."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"None of these daemons acts for an actor whose "},{"type":"codeVoice","code":"Actor.isUnconscious"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"set."}],"type":"strong"},{"type":"text","text":" A man lying on the floor does not wander off, catch you up, or lift"},{"type":"text","text":" "},{"type":"text","text":"anything out of your hands, and he draws no randomness deciding not to."},{"type":"text","text":" "},{"type":"text","text":"That flag is the engine’s rather than this plugin’s for a reason worth"},{"type":"text","text":" "},{"type":"text","text":"knowing: what usually puts a villain down is a combat plugin, and two"},{"type":"text","text":" "},{"type":"text","text":"plugins cannot see each other. "},{"type":"codeVoice","code":"GnustoMeleeCombat"},{"type":"text","text":" sets it and this one"},{"type":"text","text":" "},{"type":"text","text":"reads it, without either library knowing the other exists."}]}]}],"identifier":{"url":"doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"hierarchy":{"paths":[["doc:\/\/GnustoActors\/documentation\/GnustoActors"]]},"abstract":[{"type":"text","text":"Logic-only NPC behaviors: roaming, theft, canned reactions. The plugin"},{"type":"text","text":" "},{"type":"text","text":"owns no entities and no state — position "},{"inlineContent":[{"type":"text","text":"is"}],"type":"emphasis"},{"type":"text","text":" the actor’s placement —"},{"type":"text","text":" "},{"type":"text","text":"so the host declares its actors and splices these factories into its"},{"type":"text","text":" "},{"type":"text","text":"own "},{"code":"timers","type":"codeVoice"},{"type":"text","text":" and "},{"code":"rules","type":"codeVoice"},{"type":"text","text":" blocks:"}],"topicSections":[{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/init()"]},{"title":"Instance Methods","generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/follows(_:daemonName:rooms:while:arrivals:)","doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/reaction(of:to:reply:)","doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/roams(_:daemonName:rooms:chancePerTurn:while:arrival:departure:)","doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/steals(_:daemonName:candidates:chancePerTurn:announcement:)"]},{"title":"Default Implementations","generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/GamePlugin-Implementations"]}],"kind":"symbol","seeAlsoSections":[{"title":"The plugin","generated":true,"anchor":"The-plugin","identifiers":["doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/init()"]}],"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin","doc:\/\/GnustoActors\/s8SendableP","doc:\/\/GnustoActors\/s16SendableMetatypeP"]}],"variants":[{"paths":["\/documentation\/gnustoactors\/actorbehaviors"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Gnusto/documentation/Gnusto/GamePlugin":{"title":"GamePlugin","navigatorTitle":[{"kind":"identifier","text":"GamePlugin"}],"url":"\/documentation\/gnusto\/gameplugin","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin","abstract":[{"text":"A reusable game system — commerce, combat, dialog, magic — packaged as an","type":"text"},{"text":" ","type":"text"},{"text":"importable unit of ","type":"text"},{"inlineContent":[{"type":"text","text":"verbs"}],"type":"emphasis"},{"text":" and ","type":"text"},{"inlineContent":[{"text":"rules","type":"text"}],"type":"emphasis"},{"text":", that a host game opts into.","type":"text"}],"type":"topic","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"GamePlugin"}]},"doc://GnustoActors/documentation/GnustoActors/ActorBehaviors/roams(_:daemonName:rooms:chancePerTurn:while:arrival:departure:)":{"identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/roams(_:daemonName:rooms:chancePerTurn:while:arrival:departure:)","abstract":[{"text":"A daemon that, with ","type":"text"},{"code":"chancePerTurn","type":"codeVoice"},{"text":", moves ","type":"text"},{"code":"actor","type":"codeVoice"},{"text":" to a random","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"other"}],"type":"emphasis"},{"text":" room in ","type":"text"},{"code":"rooms","type":"codeVoice"},{"text":" — a teleport within the set, with no","type":"text"},{"text":" ","type":"text"},{"text":"exit-graph awareness (a wall between two rooms in the set won’t","type":"text"},{"text":" ","type":"text"},{"text":"stop him). Arrival\/departure lines print only when the player’s","type":"text"},{"text":" ","type":"text"},{"text":"room is lit and is the room being entered or left: in the dark, or","type":"text"},{"text":" ","type":"text"},{"text":"a room away, movement is silent. The daemon idles (no RNG drawn)","type":"text"},{"text":" ","type":"text"},{"text":"while the actor is outside ","type":"text"},{"code":"rooms","type":"codeVoice"},{"text":" — including after ","type":"text"},{"code":"vanish()","type":"codeVoice"},{"text":" —","type":"text"},{"text":" ","type":"text"},{"text":"but the host should still ","type":"text"},{"code":"stopDaemon(_:)","type":"codeVoice"},{"text":" on the actor’s death.","type":"text"}],"role":"symbol","title":"roams(_:daemonName:rooms:chancePerTurn:while:arrival:departure:)","url":"\/documentation\/gnustoactors\/actorbehaviors\/roams(_:daemonname:rooms:chanceperturn:while:arrival:departure:)","type":"topic","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"roams","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:6Gnusto5ActorV","text":"Actor","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"daemonName","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"rooms","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Location","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto8LocationV"},{"text":"], ","kind":"text"},{"text":"chancePerTurn","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"while","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", ","kind":"text"},{"text":"arrival","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"departure","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?) -> ","kind":"text"},{"text":"TimedEvent","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto10TimedEventV"}]},"doc://GnustoActors/s16SendableMetatypeP":{"identifier":"doc:\/\/GnustoActors\/s16SendableMetatypeP","title":"Swift.SendableMetatype","type":"unresolvable"},"doc://GnustoActors/documentation/GnustoActors/ActorBehaviors/GamePlugin-Implementations":{"identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/GamePlugin-Implementations","abstract":[],"role":"collectionGroup","title":"GamePlugin Implementations","type":"topic","url":"\/documentation\/gnustoactors\/actorbehaviors\/gameplugin-implementations","kind":"article"},"doc://GnustoActors/documentation/GnustoActors/ActorBehaviors/init()":{"identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/init()","abstract":[{"type":"text","text":"Creates the plugin."}],"role":"symbol","title":"init()","type":"topic","url":"\/documentation\/gnustoactors\/actorbehaviors\/init()","kind":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"()"}]},"doc://GnustoActors/documentation/GnustoActors/ActorBehaviors/follows(_:daemonName:rooms:while:arrivals:)":{"identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/follows(_:daemonName:rooms:while:arrivals:)","abstract":[{"text":"A daemon that keeps ","type":"text"},{"code":"actor","type":"codeVoice"},{"text":" in the player’s room: each turn, if the","type":"text"},{"text":" ","type":"text"},{"text":"actor is onstage but elsewhere, it teleports to wherever the player","type":"text"},{"text":" ","type":"text"},{"text":"now stands. Daemons tick at the end of the turn, after the player’s","type":"text"},{"text":" ","type":"text"},{"code":"go","type":"codeVoice"},{"text":" has resolved and the new room is described, so the companion","type":"text"},{"text":" ","type":"text"},{"text":"catches up the same turn and its ","type":"text"},{"code":"arrival","type":"codeVoice"},{"text":" line trails the room","type":"text"},{"text":" ","type":"text"},{"text":"description. The line prints only when the destination is lit: in","type":"text"},{"text":" ","type":"text"},{"text":"the dark the companion arrives unseen. There is deliberately no","type":"text"},{"text":" ","type":"text"},{"code":"departure","type":"codeVoice"},{"text":" line — the companion only ever moves ","type":"text"},{"inlineContent":[{"type":"text","text":"to"}],"type":"emphasis"},{"text":" the player,","type":"text"},{"text":" ","type":"text"},{"text":"so no one is ever in the room it leaves to watch it go (unlike","type":"text"},{"text":" ","type":"text"},{"code":"roams","type":"codeVoice"},{"text":"). The daemon idles while the actor is offstage — including","type":"text"},{"text":" ","type":"text"},{"text":"after ","type":"text"},{"code":"vanish()","type":"codeVoice"},{"text":" — and the host may ","type":"text"},{"type":"codeVoice","code":"stopDaemon(_:)"},{"text":" to park the","type":"text"},{"text":" ","type":"text"},{"text":"companion for a “wait here” beat, then ","type":"text"},{"type":"codeVoice","code":"startDaemon(_:)"},{"text":" to resume.","type":"text"},{"text":" ","type":"text"},{"text":"It draws no randomness at all (unlike ","type":"text"},{"type":"codeVoice","code":"roams"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"steals"},{"text":"), so a","type":"text"},{"text":" ","type":"text"},{"text":"following companion never perturbs the seeded stream: ","type":"text"},{"type":"codeVoice","code":"arrivals"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"cycled by the saved turn counter, so the line varies from arrival to","type":"text"},{"text":" ","type":"text"},{"text":"arrival yet stays deterministic across save and restore. Pass one","type":"text"},{"text":" ","type":"text"},{"text":"line for a fixed announcement, a dozen so a constant companion does","type":"text"},{"text":" ","type":"text"},{"text":"not wear his welcome out. Start the companion co-located with the","type":"text"},{"text":" ","type":"text"},{"text":"player (","type":"text"},{"type":"codeVoice","code":"starts(in:)"},{"text":" the player’s start room) to avoid a spurious","type":"text"},{"text":" ","type":"text"},{"text":"arrival on turn one.","type":"text"}],"role":"symbol","title":"follows(_:daemonName:rooms:while:arrivals:)","type":"topic","url":"\/documentation\/gnustoactors\/actorbehaviors\/follows(_:daemonname:rooms:while:arrivals:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"follows","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:6Gnusto5ActorV","text":"Actor","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"daemonName","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"rooms","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Location","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto8LocationV"},{"text":"]?, ","kind":"text"},{"text":"while","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", ","kind":"text"},{"text":"arrivals","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"]) -> ","kind":"text"},{"text":"TimedEvent","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto10TimedEventV"}]},"doc://GnustoActors/documentation/GnustoActors/ActorBehaviors":{"kind":"symbol","role":"symbol","abstract":[{"text":"Logic-only NPC behaviors: roaming, theft, canned reactions. The plugin","type":"text"},{"text":" ","type":"text"},{"text":"owns no entities and no state — position ","type":"text"},{"inlineContent":[{"type":"text","text":"is"}],"type":"emphasis"},{"type":"text","text":" the actor’s placement —"},{"type":"text","text":" "},{"type":"text","text":"so the host declares its actors and splices these factories into its"},{"type":"text","text":" "},{"type":"text","text":"own "},{"code":"timers","type":"codeVoice"},{"type":"text","text":" and "},{"code":"rules","type":"codeVoice"},{"type":"text","text":" blocks:"}],"url":"\/documentation\/gnustoactors\/actorbehaviors","identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors","title":"ActorBehaviors","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ActorBehaviors"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"ActorBehaviors"}]},"doc://GnustoActors/documentation/GnustoActors/ActorBehaviors/steals(_:daemonName:candidates:chancePerTurn:announcement:)":{"title":"steals(_:daemonName:candidates:chancePerTurn:announcement:)","url":"\/documentation\/gnustoactors\/actorbehaviors\/steals(_:daemonname:candidates:chanceperturn:announcement:)","identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/steals(_:daemonName:candidates:chancePerTurn:announcement:)","abstract":[{"type":"text","text":"A daemon that, when "},{"type":"codeVoice","code":"actor"},{"type":"text","text":" shares the player’s room, rolls"},{"type":"text","text":" "},{"type":"codeVoice","code":"chancePerTurn"},{"type":"text","text":" and moves one random "},{"inlineContent":[{"type":"text","text":"reachable"}],"type":"emphasis"},{"type":"text","text":" item from "},{"type":"codeVoice","code":"candidates"},{"type":"text","text":" "},{"type":"text","text":"into the actor’s inventory, announcing it with the stolen item’s name."},{"type":"text","text":" "},{"type":"text","text":"Like the original’s thief, the actor lifts a candidate from wherever it"},{"type":"text","text":" "},{"type":"text","text":"lies in the shared room: out of the player’s hands, off the floor, or"},{"type":"text","text":" "},{"type":"text","text":"from inside anything open — a sack, a trophy case, a table top — to any"},{"type":"text","text":" "},{"type":"text","text":"depth. Only another actor’s hands are beyond reach. The theft is"},{"type":"text","text":" "},{"type":"text","text":"announced only when the player’s room is lit: in the dark you find out"},{"type":"text","text":" "},{"type":"text","text":"when you check your pockets."}],"type":"topic","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"steals"},{"kind":"text","text":"("},{"preciseIdentifier":"s:6Gnusto5ActorV","kind":"typeIdentifier","text":"Actor"},{"kind":"text","text":", "},{"kind":"externalParam","text":"daemonName"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"text":"candidates","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Item","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto4ItemV"},{"text":"], ","kind":"text"},{"text":"chancePerTurn","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"announcement","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") -> ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") -> ","kind":"text"},{"text":"TimedEvent","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto10TimedEventV"}]},"doc://GnustoActors/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/GnustoActors\/s8SendableP","title":"Swift.Sendable"},"doc://GnustoActors/documentation/GnustoActors":{"identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors","abstract":[{"type":"text","text":"Daemons that make an NPC wander, tag along, or go through your pockets."}],"role":"collection","title":"GnustoActors","type":"topic","url":"\/documentation\/gnustoactors","kind":"symbol"},"doc://GnustoActors/documentation/GnustoActors/ActorBehaviors/reaction(of:to:reply:)":{"title":"reaction(of:to:reply:)","url":"\/documentation\/gnustoactors\/actorbehaviors\/reaction(of:to:reply:)","identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/reaction(of:to:reply:)","abstract":[{"text":"A canned reply when any of the named intents target the actor —","type":"text"},{"text":" ","type":"text"},{"text":"“talk to troll”, “give sword to troll”, whatever the host’s verbs","type":"text"},{"text":" ","type":"text"},{"text":"emit. One line, before-phase, ends the turn.","type":"text"}],"kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reaction","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Actor","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto5ActorV"},{"text":", ","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Intent","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto6IntentV"},{"text":"], ","kind":"text"},{"text":"reply","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") -> ","kind":"text"},{"text":"Rules","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto5RulesV"}]}}}