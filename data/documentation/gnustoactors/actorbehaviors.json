{"metadata":{"title":"ActorBehaviors","roleHeading":"Structure","externalID":"s:12GnustoActors14ActorBehaviorsV","modules":[{"name":"GnustoActors"}],"role":"symbol","symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ActorBehaviors"}],"navigatorTitle":[{"kind":"identifier","text":"ActorBehaviors"}]},"sections":[],"kind":"symbol","abstract":[{"type":"text","text":"Logic-only NPC behaviors: roaming, theft, canned reactions. The plugin"},{"type":"text","text":" "},{"type":"text","text":"owns no entities and no state — position "},{"inlineContent":[{"type":"text","text":"is"}],"type":"emphasis"},{"type":"text","text":" the actor’s placement —"},{"type":"text","text":" "},{"type":"text","text":"so the host declares its actors and splices these factories into its"},{"type":"text","text":" "},{"type":"text","text":"own "},{"type":"codeVoice","code":"timers"},{"type":"text","text":" and "},{"type":"codeVoice","code":"rules"},{"type":"text","text":" blocks:"}],"topicSections":[{"identifiers":["doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/init()"],"anchor":"Initializers","title":"Initializers","generated":true},{"identifiers":["doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/follows(_:named:rooms:when:arrivals:)","doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/reaction(of:for:reply:)","doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/roams(_:named:rooms:chancePerTurn:when:arrival:departure:)","doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/steals(_:named:candidates:chancePerTurn:announcement:)"],"anchor":"Instance-Methods","title":"Instance Methods","generated":true},{"identifiers":["doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/GamePlugin-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations","generated":true}],"relationshipsSections":[{"identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin","doc:\/\/GnustoActors\/s8SendableP","doc:\/\/GnustoActors\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"seeAlsoSections":[{"identifiers":["doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/init()"],"anchor":"The-plugin","title":"The plugin","generated":true}],"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"paths":["\/documentation\/gnustoactors\/actorbehaviors"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/GnustoActors\/documentation\/GnustoActors"]]},"identifier":{"url":"doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ActorBehaviors","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"syntax":"swift","code":["let actors = ActorBehaviors()","","var timers: [TimedEvent] {","    actors.roams(","        thief, named: \"thief.roam\",","        rooms: [cellar, gallery, studio])","    actors.steals(","        thief, named: \"thief.steal\",","        candidates: [painting],","        announcement: .naming { \"A shadow relieves you of \\($0).\" })","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Every random decision draws from the game’s seeded stream, and draws"},{"type":"text","text":" "},{"type":"text","text":"happen "},{"inlineContent":[{"type":"text","text":"only after"}],"type":"strong"},{"text":" a factory’s guards pass — a daemon whose actor is","type":"text"},{"type":"text","text":" "},{"type":"text","text":"out of position (or whose player has nothing worth taking) consumes no"},{"type":"text","text":" "},{"type":"text","text":"randomness, so transcripts that never meet the actor stay stable no"},{"type":"text","text":" "},{"type":"text","text":"matter what he does elsewhere."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"None of these daemons acts for an actor whose "},{"type":"codeVoice","code":"Actor.isUnconscious"},{"type":"text","text":" is"},{"type":"text","text":" "},{"text":"set.","type":"text"}],"type":"strong"},{"type":"text","text":" A man lying on the floor does not wander off, catch you up, or lift"},{"type":"text","text":" "},{"type":"text","text":"anything out of your hands, and he draws no randomness deciding not to."},{"type":"text","text":" "},{"type":"text","text":"That flag is the engine’s rather than this plugin’s for a reason worth"},{"type":"text","text":" "},{"text":"knowing: what usually puts a villain down is a combat plugin, and two","type":"text"},{"text":" ","type":"text"},{"text":"plugins cannot see each other. ","type":"text"},{"type":"codeVoice","code":"GnustoMeleeCombat"},{"text":" sets it and this one","type":"text"},{"text":" ","type":"text"},{"text":"reads it, without either library knowing the other exists.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://GnustoActors/documentation/GnustoActors/ActorBehaviors":{"abstract":[{"type":"text","text":"Logic-only NPC behaviors: roaming, theft, canned reactions. The plugin"},{"type":"text","text":" "},{"text":"owns no entities and no state — position ","type":"text"},{"inlineContent":[{"type":"text","text":"is"}],"type":"emphasis"},{"text":" the actor’s placement —","type":"text"},{"text":" ","type":"text"},{"text":"so the host declares its actors and splices these factories into its","type":"text"},{"text":" ","type":"text"},{"text":"own ","type":"text"},{"code":"timers","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"rules","type":"codeVoice"},{"text":" blocks:","type":"text"}],"navigatorTitle":[{"text":"ActorBehaviors","kind":"identifier"}],"type":"topic","kind":"symbol","role":"symbol","title":"ActorBehaviors","url":"\/documentation\/gnustoactors\/actorbehaviors","identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ActorBehaviors","kind":"identifier"}]},"doc://GnustoActors/documentation/GnustoActors/ActorBehaviors/roams(_:named:rooms:chancePerTurn:when:arrival:departure:)":{"url":"\/documentation\/gnustoactors\/actorbehaviors\/roams(_:named:rooms:chanceperturn:when:arrival:departure:)","type":"topic","kind":"symbol","abstract":[{"text":"A daemon that, with ","type":"text"},{"code":"chancePerTurn","type":"codeVoice"},{"text":", moves ","type":"text"},{"code":"actor","type":"codeVoice"},{"text":" to a random","type":"text"},{"text":" ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"other","type":"text"}]},{"text":" room in ","type":"text"},{"code":"rooms","type":"codeVoice"},{"text":" — a teleport within the set, with no","type":"text"},{"text":" ","type":"text"},{"text":"exit-graph awareness (a wall between two rooms in the set won’t","type":"text"},{"text":" ","type":"text"},{"text":"stop him). Arrival\/departure lines print only when the player’s","type":"text"},{"text":" ","type":"text"},{"text":"room is lit and is the room being entered or left: in the dark, or","type":"text"},{"text":" ","type":"text"},{"text":"a room away, movement is silent. The daemon idles (no RNG drawn)","type":"text"},{"text":" ","type":"text"},{"text":"while the actor is outside ","type":"text"},{"code":"rooms","type":"codeVoice"},{"text":" — including after ","type":"text"},{"code":"vanish()","type":"codeVoice"},{"text":" —","type":"text"},{"text":" ","type":"text"},{"text":"but the host should still ","type":"text"},{"code":"stopDaemon(_:)","type":"codeVoice"},{"text":" on the actor’s death.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"roams"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Actor","preciseIdentifier":"s:6Gnusto5ActorV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"named"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"rooms"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"Location","preciseIdentifier":"s:6Gnusto8LocationV"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"chancePerTurn"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"when"},{"kind":"text","text":": () -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":", "},{"kind":"externalParam","text":"arrival"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"departure"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?) -> "},{"kind":"typeIdentifier","text":"TimedEvent","preciseIdentifier":"s:6Gnusto10TimedEventV"}],"identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/roams(_:named:rooms:chancePerTurn:when:arrival:departure:)","title":"roams(_:named:rooms:chancePerTurn:when:arrival:departure:)"},"doc://GnustoActors/documentation/GnustoActors/ActorBehaviors/follows(_:named:rooms:when:arrivals:)":{"abstract":[{"text":"A daemon that keeps ","type":"text"},{"code":"actor","type":"codeVoice"},{"text":" in the player’s room: each turn, if the","type":"text"},{"text":" ","type":"text"},{"text":"actor is onstage but elsewhere, it teleports to wherever the player","type":"text"},{"text":" ","type":"text"},{"text":"now stands. Daemons tick at the end of the turn, after the player’s","type":"text"},{"text":" ","type":"text"},{"code":"go","type":"codeVoice"},{"text":" has resolved and the new room is described, so the companion","type":"text"},{"text":" ","type":"text"},{"text":"catches up the same turn and its ","type":"text"},{"code":"arrival","type":"codeVoice"},{"text":" line trails the room","type":"text"},{"text":" ","type":"text"},{"text":"description. The line prints only when the destination is lit: in","type":"text"},{"text":" ","type":"text"},{"text":"the dark the companion arrives unseen. There is deliberately no","type":"text"},{"text":" ","type":"text"},{"code":"departure","type":"codeVoice"},{"text":" line — the companion only ever moves ","type":"text"},{"inlineContent":[{"type":"text","text":"to"}],"type":"emphasis"},{"text":" the player,","type":"text"},{"text":" ","type":"text"},{"text":"so no one is ever in the room it leaves to watch it go (unlike","type":"text"},{"text":" ","type":"text"},{"code":"roams","type":"codeVoice"},{"type":"text","text":"). The daemon idles while the actor is offstage — including"},{"type":"text","text":" "},{"type":"text","text":"after "},{"type":"codeVoice","code":"vanish()"},{"type":"text","text":" — and the host may "},{"type":"codeVoice","code":"stopDaemon(_:)"},{"type":"text","text":" to park the"},{"type":"text","text":" "},{"type":"text","text":"companion for a “wait here” beat, then "},{"type":"codeVoice","code":"startDaemon(_:)"},{"type":"text","text":" to resume."},{"type":"text","text":" "},{"type":"text","text":"It draws no randomness at all (unlike "},{"type":"codeVoice","code":"roams"},{"type":"text","text":" and "},{"type":"codeVoice","code":"steals"},{"type":"text","text":"), so a"},{"type":"text","text":" "},{"type":"text","text":"following companion never perturbs the seeded stream: "},{"type":"codeVoice","code":"arrivals"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"cycled by the saved turn counter, so the line varies from arrival to"},{"type":"text","text":" "},{"type":"text","text":"arrival yet stays deterministic across save and restore. Pass one"},{"type":"text","text":" "},{"type":"text","text":"line for a fixed announcement, a dozen so a constant companion does"},{"type":"text","text":" "},{"type":"text","text":"not wear his welcome out. Start the companion co-located with the"},{"type":"text","text":" "},{"type":"text","text":"player ("},{"type":"codeVoice","code":"starts(in:)"},{"type":"text","text":" the player’s start room) to avoid a spurious"},{"type":"text","text":" "},{"type":"text","text":"arrival on turn one."}],"type":"topic","title":"follows(_:named:rooms:when:arrivals:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"follows","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Actor","preciseIdentifier":"s:6Gnusto5ActorV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"named","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"rooms","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Location","preciseIdentifier":"s:6Gnusto8LocationV","kind":"typeIdentifier"},{"text":"]?, ","kind":"text"},{"text":"when","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"arrivals","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"]) -> ","kind":"text"},{"text":"TimedEvent","preciseIdentifier":"s:6Gnusto10TimedEventV","kind":"typeIdentifier"}],"identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/follows(_:named:rooms:when:arrivals:)","url":"\/documentation\/gnustoactors\/actorbehaviors\/follows(_:named:rooms:when:arrivals:)","role":"symbol","kind":"symbol"},"doc://GnustoActors/documentation/GnustoActors/ActorBehaviors/reaction(of:for:reply:)":{"url":"\/documentation\/gnustoactors\/actorbehaviors\/reaction(of:for:reply:)","type":"topic","abstract":[{"text":"A canned reply when any of the named intents target the actor —","type":"text"},{"text":" ","type":"text"},{"text":"“talk to troll”, “give sword to troll”, whatever the host’s verbs","type":"text"},{"text":" ","type":"text"},{"text":"emit. One line, before-phase, ends the turn.","type":"text"}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reaction"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Actor","preciseIdentifier":"s:6Gnusto5ActorV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"for"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"Intent","preciseIdentifier":"s:6Gnusto6IntentV"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"reply"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Rules","preciseIdentifier":"s:6Gnusto5RulesV"}],"identifier":"doc:\/\/GnustoActors\/documentation\/GnustoActors\/ActorBehaviors\/reaction(of:for:reply:)","title":"reaction(of:for:reply:)"},"doc://GnustoActors/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/GnustoActors\/s8SendableP"},"doc://GnustoActors/documentation/GnustoActors/ActorBehaviors/steals(_:named:candidates:chancePerTurn:announcement:)":{"abstract":[{"type":"text","text":"A daemon that, when "},{"type":"codeVoice","code":"actor"},{"type":"text","text":" shares the player’s room, rolls"},{"type":"text","text":" "},{"type":"codeVoice","code":"chancePerTurn"},{"type":"text","text":" and moves one random "},{"type":"emphasis","inlineContent":[{"text":"reachable","type":"text"}]},{"type":"text","text":" item from "},{"type":"codeVoice","code":"candidates"},{"type":"text","text":" "},{"type":"text","text":"into the actor’s inventory, announcing it with the stolen item’s"},{"type":"text","text":" "},{"type":"text","text":"rendered name — “the silver chalice”, “Ozymandias” — so the line writes"},{"type":"text","text":" "},{"type":"text","text":"no article of its own."},{"type":"text","text":" "},{"type":"text","text":"Like the original’s thief, the actor lifts a candidate from wherever it"},{"type":"text","text":" "},{"type":"text","text":"lies in the shared room: out of the player’s hands, off the floor, or"},{"type":"text","text":" "},{"type":"text","text":"from inside anything open — a sack, a trophy case, a table top — to any"},{"type":"text","text":" "},{"type":"text","text":"depth. Only another actor’s hands are beyond reach. The theft is"},{"type":"text","text":" "},{"type":"text","text":"announced only when the player’s room is lit: in the dark you find out"},{"type":"text","text":" "},{"type":"text","text":"when you check your pockets."}],"type":"topic","title":"steals(_:named:candidates:chancePerTurn:announcement:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"steals","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Actor","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto5ActorV"},{"text":", ","kind":"text"},{"text":"named","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"candidates","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Item","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto4ItemV"},{"text":"], ","kind":"text"},{"text":"chancePerTurn","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"announcement","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"GameText","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto8GameTextV"},{"text":".","kind":"text"},{"text":"Line","kind":"