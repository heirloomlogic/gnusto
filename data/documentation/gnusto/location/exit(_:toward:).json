nchor":"discussion","type":"heading"},{"inlineContent":[{"text":"This is the non-Euclidean passage — the Bank of Zork’s curtain of","type":"text"},{"text":" ","type":"text"},{"text":"light, where the room you arrive in depends on state rather than on","type":"text"},{"text":" ","type":"text"},{"text":"the exit you took:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["depository.north { lastViewingRoom == .west ? smallRoom : vault }"],"type":"codeListing"},{"inlineContent":[{"text":"Travel runs through the same path as every other passable exit, so the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"destination’s "},{"type":"codeVoice","code":"onEnter"},{"type":"text","text":" rules fire and a boarded vehicle rides along —"},{"type":"text","text":" "},{"type":"text","text":"which is the difference between this and assigning "},{"type":"codeVoice","code":"player.location"},{"type":"text","text":" "},{"type":"text","text":"from a rule, where neither happens."}],"type":"paragraph"},{"inlineContent":[{"text":"The closure is a ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"read","type":"text"}]},{"text":": it may run more than once in a turn — FOLLOW","type":"text"},{"text":" ","type":"text"},{"text":"asks it which way the quarry went before travel takes it — so it must","type":"text"},{"text":" ","type":"text"},{"text":"answer from state rather than change any.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Two consequences of the destination being a closure:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"It is not validated at bootstrap."}]},{"text":" The other exit forms name a","type":"text"},{"type":"text","text":" "},{"type":"text","text":"room the bootstrap can resolve; this one is opaque until it runs, so"},{"type":"text","text":" "},{"type":"text","text":"a destination that isn’t a stored property of the game surfaces on"},{"type":"text","text":" "},{"type":"text","text":"the turn the player takes the exit, not at launch."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"It contributes nothing to the reachable-room set","type":"text"}]},{"type":"text","text":", which is built"},{"type":"text","text":" "},{"type":"text","text":"from declared destinations, and nothing to the adjacency the naming"},{"type":"text","text":" "},{"type":"text","text":"reach is drawn from. A room reachable "},{"type":"emphasis","inlineContent":[{"type":"text","text":"only"}]},{"type":"text","text":" this way reads to the"},{"type":"text","text":" "},{"type":"text","text":"engine as off-map, so FOLLOW will not name somebody standing there;"},{"type":"text","text":" "},{"type":"text","text":"and standing on this side of a dynamic exit does not make the far"},{"type":"text","text":" "},{"type":"text","text":"side “next door”, so somebody over there is nameable once they have"},{"type":"text","text":" "},{"type":"text","text":"been met and not before. Both are the same reason — the destination"},{"type":"text","text":" "},{"type":"text","text":"is code, and scope is computed on every parse rather than on every"},{"type":"text","text":" "},{"type":"text","text":"move. For a room the map doesn’t admit to, that is usually what you"},{"type":"text","text":" "},{"type":"text","text":"want; when it isn’t, declare an ordinary exit as well, from whichever"},{"type":"text","text":" "},{"type":"text","text":"room you want the adjacency to hold from."}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"symbolKind":"method","externalID":"s:6Gnusto8LocationV4exit_6towardAA8MapEntryVAA9DirectionO_ACyYbctF","roleHeading":"Instance Method","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"exit","kind":"identifier"},{"text":"(","kind":"text"},{"tex