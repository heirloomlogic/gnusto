{"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameContent"},"relationshipsSections":[{"title":"Inherits From","type":"inheritsFrom","identifiers":["doc:\/\/Gnusto\/s8SendableP","doc:\/\/Gnusto\/s16SendableMetatypeP"],"kind":"relationships"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"A self-contained slice of a game’s world: its own rooms, items, and"},{"type":"text","text":" "},{"code":"@Global","type":"codeVoice"},{"type":"text","text":" state, plus the geography, rules, and verbs that go with them."}],"sections":[],"metadata":{"modules":[{"name":"Gnusto"}],"symbolKind":"protocol","title":"GameContent","roleHeading":"Protocol","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"text":"GameContent","kind":"identifier"}],"externalID":"s:6Gnusto11GameContentP","navigatorTitle":[{"text":"GameContent","kind":"identifier"}]},"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto"]]},"variants":[{"paths":["\/documentation\/gnusto\/gamecontent"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"title":"Composing Large Games","generated":true,"identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/SplittingAGameAcrossFiles","doc:\/\/Gnusto\/documentation\/Gnusto\/ContentBundles","doc:\/\/Gnusto\/documentation\/Gnusto\/Plugins","doc:\/\/Gnusto\/documentation\/Gnusto\/GameContents","doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin"],"anchor":"Composing-Large-Games"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GameContent","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s8SendableP","text":"Sendable","kind":"typeIdentifier"}]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/Gnusto\/documentation\/Gnusto\/Plugins","doc:\/\/Gnusto\/documentation\/Gnusto\/AddingCustomVerbs","doc:\/\/Gnusto\/documentation\/Gnusto\/AnatomyOfAGame","doc:\/\/Gnusto\/documentation\/Gnusto\/ContentBundles","doc:\/\/Gnusto\/documentation\/Gnusto\/SplittingAGameAcrossFiles","doc:\/\/Gnusto\/documentation\/Gnusto\/WritingRules"]},{"content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"text":"A bundle lets a large game split its declarations across many types — and","type":"text"},{"text":" ","type":"text"},{"text":"even many SPM packages — instead of cramming every ","type":"text"},{"code":"let room = Location { … }","type":"codeVoice"},{"text":" ","type":"text"},{"text":"into one struct. The game stores bundle instances as properties and lists","type":"text"},{"text":" ","type":"text"},{"text":"them in its ","type":"text"},{"code":"content","type":"codeVoice"},{"text":" block; the bootstrap discovers each bundle’s","type":"text"},{"text":" ","type":"text"},{"text":"declarations by reflection, exactly as it does the game’s own.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct Attic: GameContent {","    let landing = Location { name(\"Attic Landing\") }","    let trunk = Item { name(\"steamer trunk\") }","","    var map: WorldMap { trunk.starts(in: landing) }","    var rules: Rules { trunk.before(.open) { try reply(\"It's locked.\") } }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A bundle must be stored by the game and yielded from "},{"type":"codeVoice","code":"content"},{"type":"text","text":" as that same"},{"type":"text","text":" "},{"type":"text","text":"instance ("},{"type":"codeVoice","code":"var content { attic }"},{"type":"text","text":"), never freshly constructed inside the"},{"type":"text","text":" "},{"type":"text","text":"block. Each "},{"type":"codeVoice","code":"Location"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"Item"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"@Global"},{"type":"text","text":" mints a reference token at creation,"},{"type":"text","text":" "},{"type":"text","text":"and the bootstrap matches the tokens it discovers against the tokens the"},{"type":"text","text":" "},{"type":"codeVoice","code":"map"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"rules"},{"type":"text","text":" reference; a fresh instance would carry different tokens and"},{"type":"text","text":" "},{"type":"text","text":"fail to resolve."}],"type":"paragraph"}],"kind":"content"}],"topicSections":[{"title":"Instance Properties","generated":true,"identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/GameContent\/actions","doc:\/\/Gnusto\/documentation\/Gnusto\/GameContent\/command","doc:\/\/Gnusto\/documentation\/Gnusto\/GameContent\/gameText","doc:\/\/Gnusto\/documentation\/Gnusto\/GameContent\/map","doc:\/\/Gnusto\/documentation\/Gnusto\/GameContent\/namespace","doc:\/\/Gnusto\/documentation\/Gnusto\/GameContent\/noiseWords","doc:\/\/Gnusto\/documentation\/Gnusto\/GameContent\/player","doc:\/\/Gnusto\/documentation\/Gnusto\/GameContent\/rules","doc:\/\/Gnusto\/documentation\/Gnusto\/GameContent\/statusFields","doc:\/\/Gnusto\/documentation\/Gnusto\/GameContent\/timers","doc:\/\/Gnusto\/documentation\/Gnusto\/GameContent\/verbs","doc:\/\/Gnusto\/documentation\/Gnusto\/GameContent\/world"],"anchor":"Instance-Properties"}],"references":{"doc://Gnusto/documentation/Gnusto/GameContent/gameText":{"kind":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameContent\/gameText","type":"topic","abstract":[{"type":"text","text":"The stock lines the engine is speaking this turn — usable as a bare"},{"type":"text","text":" "},{"type":"text","text":"identifier in a bundle’s rule bodies, exactly as in a "},{"code":"Game","type":"codeVoice"},{"type":"text","text":"."}],"title":"gameText","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"gameText","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6Gnusto8GameTextV","text":"GameText","kind":"typeIdentifier"}],"url":"\/documentation\/gnusto\/gamecontent\/gametext"},"doc://Gnusto/documentation/Gnusto/GameContent/timers":{"title":"timers","type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameContent\/timers","abstract":[{"type":"text","text":"The bundle’s fuses and daemons, in the same form as a game’s "},{"type":"codeVoice","code":"timers"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Defaults to empty. Timer names are global — NOT namespaced, since the"},{"type":"text","text":" "},{"type":"text","text":"bundle’s own rules start them by the literal name — so a name shared"},{"type":"text","text":" "},{"type":"text","text":"with the host or another bundle is a fatal bootstrap diagnostic."}],"url":"\/documentation\/gnusto\/gamecontent\/timers","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"timers"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto10TimedEventV","text":"TimedEvent"},{"kind":"text","text":"]"}],"role":"symbol","defaultImplementations":1,"kind":"symbol","required":true},"doc://Gnusto/documentation/Gnusto/GameContent/actions":{"title":"actions","type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameContent\/actions","abstract":[{"type":"text","text":"Stage-4 default actions the bundle replaces or adds, in the same form"},{"type":"text","text":" "},{"type":"text","text":"as a game’s "},{"code":"actions","type":"codeVoice"},{"type":"text","text":". Defaults to empty. Precedence runs built-ins <"},{"type":"text","text":" "},{"type":"text","text":"bundles\/plugins < host game, so a host action for the same intent beats"},{"type":"text","text":" "},{"type":"text","text":"this one."}],"url":"\/documentation\/gnusto\/gamecontent\/actions","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"actions","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:6Gnusto12IntentActionV","text":"IntentAction","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"role":"symbol","defaultImplementations":1,"kind":"symbol","required":true},"doc://Gnusto/documentation/Gnusto/GameContent/namespace":{"kind":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameContent\/namespace","type":"topic","abstract":[{"type":"text","text":"Prefixes this bundle’s entity IDs so its rooms\/items\/"},{"type":"codeVoice","code":"@Global"},{"type":"text","text":"s can’t"},{"type":"text","text":" "},{"type":"text","text":"collide with the host game’s or another bundle’s. A bundle entity stored"},{"type":"text","text":" "},{"type":"text","text":"as "},{"type":"codeVoice","code":"let hall = Location { … }"},{"type":"text","text":" becomes "},{"type":"codeVoice","code":"EntityID(\"\\(namespace).hall\")"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"while the game’s own entities stay bare. This is what lets a reusable"},{"type":"text","text":" "},{"type":"text","text":"content-bearing plugin be dropped into any host without name clashes."}],"title":"namespace","role":"symbol","required":true,"url":"\/documentation\/gnusto\/gamecontent\/namespace","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"namespace","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"}],"defaultImplementations":1},"doc://Gnusto/documentation/Gnusto/WritingRules":{"kind":"article","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/WritingRules","type":"topic","abstract":[{"type":"text","text":"Attach game logic to items, locations, and the world."}],"title":"Writing Rules","role":"article","url":"\/documentation\/gnusto\/writingrules"},"doc://Gnusto/documentation/Gnusto/GamePlugin":{"url":"\/documentation\/gnusto\/gameplugin","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin","role":"symbol","abstra