e":"text","text":" turns after the fuse is"},{"type":"text","text":" "},{"type":"text","text":"started — by "},{"type":"codeVoice","code":"startFuse(_:after:)"},{"type":"text","text":" in a rule, or from turn one with"},{"type":"text","text":" "},{"type":"codeVoice","code":"autostart"},{"type":"text","text":". Starting a running fuse resets its count."}]},"doc://Gnusto/documentation/Gnusto/stopFuse(_:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"stopFuse"},{"text":"(","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":")","kind":"text"}],"type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/gnusto\/stopfuse(_:)","title":"stopFuse(_:)","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/stopFuse(_:)","abstract":[{"type":"text","text":"Stops the named fuse; it will not fire. A no-op if it isn’t running."}]},"doc://Gnusto/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/Gnusto\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://Gnusto/documentation/Gnusto/daemon(_:autostart:perform:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"daemon","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"autostart","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"perform","kind":"externalParam"},{"text":": () ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:s4Voida","text":"Void","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:6Gnusto10TimedEventV","text":"TimedEvent","kind":"typeIdentifier"}],"type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/gnusto\/daemon(_:autostart:perform:)","identifi