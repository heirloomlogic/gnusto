{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Gnusto\/documentation\/Gnusto\/StubVerbs"},"seeAlsoSections":[{"generated":true,"anchor":"Adding-Vocabulary","identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/AddingCustomVerbs","doc:\/\/Gnusto\/documentation\/Gnusto\/verb(_:_:)","doc:\/\/Gnusto\/documentation\/Gnusto\/SyntaxRule","doc:\/\/Gnusto\/documentation\/Gnusto\/SyntaxElement"],"title":"Adding Vocabulary"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"A player five minutes into their first room will type ","type":"text"},{"type":"codeVoice","code":"attack the chair"},{"text":", ","type":"text"},{"type":"codeVoice","code":"smell"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"listen"},{"text":", ","type":"text"},{"type":"codeVoice","code":"climb the ladder"},{"text":", ","type":"text"},{"type":"codeVoice","code":"jump"},{"text":", ","type":"text"},{"type":"codeVoice","code":"dig"},{"text":", ","type":"text"},{"type":"codeVoice","code":"buy lamp"},{"text":". None of those is a verb","type":"text"},{"text":" ","type":"text"},{"text":"most games implement. All of them are verbs every player tries.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"I don't know the word \"attack\"","type":"codeVoice"},{"type":"text","text":" answers the wrong question. It says the"},{"type":"text","text":" "},{"inlineContent":[{"text":"program","type":"text"}],"type":"emphasis"},{"type":"text","text":" is unfinished. "},{"type":"codeVoice","code":"Attacking the chair rarely improves matters."},{"type":"text","text":" says the"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"world"}]},{"type":"text","text":" is — and the player learns something from the second answer and nothing"},{"type":"text","text":" "},{"type":"text","text":"from the first."}],"type":"paragraph"},{"inlineContent":[{"text":"So the engine ships about fifty of these words with a line of stock prose each.","type":"text"},{"text":" ","type":"text"},{"text":"Nothing about them is a special case in the parser. A stub verb is an ordinary","type":"text"},{"text":" ","type":"text"},{"text":"row in the standard table whose intent happens to have no mechanic behind it,","type":"text"},{"text":" ","type":"text"},{"text":"which means it:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Is in the vocabulary"}]},{"type":"text","text":", so it is never "},{"code":"I don't know the word","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Resolves its objects through normal scope.","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":"attack the grue","type":"codeVoice"},{"text":" where there","type":"text"},{"text":" ","type":"text"},{"text":"is no grue still answers ","type":"text"},{"inlineContent":[{"type":"text","text":"“You can’t see any such thing.”"}],"type":"emphasis"},{"text":" A stub doesn’t buy","type":"text"},{"text":" ","type":"text"},{"text":"politeness by weakening scope honesty.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Scope is the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"visible"}]},{"text":" set, which admits what can be seen through the glass","type":"text"},{"text":" ","type":"text"},{"text":"of a shut jar or in somebody else’s hands — so the physical stubs re-check","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"reach","type":"text"}],"type":"strong"},{"text":" and refuse with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/cantReach"},{"text":", exactly as ","type":"text"},{"code":"push","type":"codeVoice"},{"text":" does.","type":"text"},{"text":" ","type":"text"},{"text":"Through the shut bottle in Zork’s kitchen, ","type":"text"},{"code":"push water","type":"codeVoice"},{"text":", ","type":"text"},{"code":"squeeze water","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"burn water","type":"codeVoice"},{"text":" now all answer ","type":"text"},{"inlineContent":[{"type":"text","text":"“You can’t reach the quantity of water.”"}],"type":"emphasis"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"opening the bottle lets all three through.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Which verbs check is a call made per verb, because a blanket guard would be"},{"type":"text","text":" "},{"type":"text","text":"wrong: "},{"code":"smell","type":"codeVoice"},{"type":"text","text":", "},{"code":"listen to","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"point at"},{"type":"text","text":", "},{"type":"codeVoice","code":"count"},{"text":", ","type":"text"},{"code":"buy","type":"codeVoice"},{"text":", ","type":"text"},{"code":"sell","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"wake","type":"codeVoice"},{"text":" ","type":"text"},{"text":"are fine at a distance — you can smell a fire across a room, count coins","type":"text"},{"text":" ","type":"text"},{"text":"behind glass, and shout somebody awake. ","type":"text"},{"code":"throw … at …","type":"codeVoice"},{"text":" checks the projectile","type":"text"},{"text":" ","type":"text"},{"text":"and deliberately not the target, and ","type":"text"},{"code":"give … to …","type":"codeVoice"},{"text":" is the one stub that","type":"text"},{"text":" ","type":"text"},{"text":"checks both slots, since handing something over is contact with the gift and","type":"text"},{"text":" ","type":"text"},{"text":"with whoever takes it.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Costs a turn.","type":"text"}]},{"type":"text","text":" Flailing at the chair takes time; fuses and daemons tick."},{"type":"text","text":" "},{"type":"text","text":"This is the substantive difference from the parse error it replaces, which was"},{"type":"text","text":" "},{"type":"text","text":"free."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Is overridable at every layer, with no warning"}]},{"text":" — because overriding is","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the expected end state, not a mistake."}],"type":"paragraph"}]}],"type":"orderedList"},{"anchor":"Whats-in-the-set","text":"What’s in the set","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Violence and force: "},{"type":"codeVoice","code":"attack"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"kill"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"hit"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"fight"},{"type":"text","text":" (bare or "},{"type":"codeVoice","code":"with"},{"type":"text","text":" a weapon),"},{"type":"text","text":" "},{"type":"codeVoice","code":"break"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"smash"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"destroy"},{"type":"text","text":", "},{"type":"codeVoice","code":"burn"},{"type":"text","text":", "},{"type":"codeVoice","code":"cut"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"slice"},{"type":"text","text":", "},{"type":"codeVoice","code":"dig"},{"type":"text","text":", "},{"type":"codeVoice","code":"pull"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"drag"},{"type":"text","text":","},{"text":" ","type":"text"},{"code":"turn","type":"codeVoice"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"rotate"},{"type":"text","text":", "},{"type":"codeVoice","code":"squeeze"},{"type":"text","text":", "},{"type":"codeVoice","code":"shake"},{"type":"text","text":", "},{"type":"codeVoice","code":"knock (on)"},{"type":"text","text":", "},{"type":"codeVoice","code":"throw … at …"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Senses: ","type":"text"},{"type":"codeVoice","code":"touch"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"feel"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"rub"},{"text":", ","type":"text"},{"type":"codeVoice","code":"smell"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"sniff"},{"text":", ","type":"text"},{"type":"codeVoice","code":"listen (to)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"taste"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"lick"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Body: ","type":"text"},{"code":"eat","type":"codeVoice"},{"text":", ","type":"text"},{"code":"drink","type":"codeVoice"},{"text":", ","type":"text"},{"code":"sleep","type":"codeVoice"},{"text":", ","type":"text"},{"code":"wake (up)","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Social: ","type":"text"},{"code":"kiss","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"hug","type":"codeVoice"},{"text":", ","type":"text"},{"code":"give","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"hand … to …","type":"codeVoice"},{"text":", ","type":"text"},{"code":"yell","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"shout","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"scream","type":"codeVoice"},{"text":", ","type":"text"},{"code":"wave","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"point at","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Motion: "},{"type":"codeVoice","code":"climb (up\/down\/on)"},{"type":"text","text":", "},{"type":"codeVoice","code":"jump (over)"},{"type":"text","text":", "},{"type":"codeVoice","code":"swim"},{"type":"text","text":", "},{"type":"codeVoice","code":"dive"},{"type":"text","text":", "},{"type":"codeVoice","code":"stand (up)"},{"type":"text","text":","},{"text":" ","type":"text"},{"code":"sit (down\/on)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"lie (down)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"kneel","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Liquids and containers: "},{"type":"codeVoice","code":"fill"},{"type":"text","text":", "},{"type":"codeVoice","code":"pour"},{"type":"text","text":", "},{"type":"codeVoice","code":"empty"},{"type":"text","text":", "},{"type":"codeVoice","code":"tie"},{"type":"text","text":", "},{"type":"codeVoice","code":"untie"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"Ritual and flavor: ","type":"text"},{"type":"codeVoice","code":"pray"},{"text":", ","type":"text"},{"type":"codeVoice","code":"sing"},{"text":", ","type":"text"},{"type":"codeVoice","code":"curse"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"swear"},{"text":", ","type":"text"},{"type":"codeVoice","code":"xyzzy"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"plugh"},{"text":", ","type":"text"},{"type":"codeVoice","code":"count"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"think"},{"text":", ","type":"text"},{"code":"wish","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Commerce: "},{"code":"buy","type":"codeVoice"},{"type":"text","text":", "},{"code":"sell","type":"codeVoice"},{"type":"text","text":". Fixtures: "},{"code":"blow","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"Deliberately ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" stubs: ","type":"text"},{"code":"again","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"oops","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"verbose","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"brief","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"notify","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"script","type":"codeVoice"},{"text":" ","type":"text"},{"text":"are missing ","type":"text"},{"inlineContent":[{"type":"text","text":"features"}],"type":"emphasis"},{"text":", and a canned refusal would be a worse answer than the","type":"text"},{"text":" ","type":"text"},{"text":"error. ","type":"text"},{"code":"ask","type":"codeVoice"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"tell"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"show"},{"type":"text","text":" belong to "},{"type":"codeVoice","code":"GnustoConversation"},{"type":"text","text":", which has a topic slot"},{"type":"text","text":" "},{"type":"text","text":"and somebody to ask. Bare "},{"type":"codeVoice","code":"hello"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"hi"},{"type":"text","text":", "},{"type":"codeVoice","code":"ring"},{"type":"text","text":" and "},{"type":"codeVoice","code":"wind"},{"type":"text","text":" are left free for games"},{"type":"text","text":" "},{"type":"text","text":"that want to own them outright."}]},{"type":"heading","anchor":"Aimed-at-yourself","text":"Aimed at yourself","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The player is an entity, and it is called “yourself” — so a stub line that names"},{"type":"text","text":" "},{"type":"text","text":"its object would read "},{"type":"emphasis","inlineContent":[{"type":"text","text":"“The yourself is not food.”"}]},{"type":"text","text":" Every name-carrying stub"},{"type":"text","text":" "},{"type":"text","text":"checks for the player and answers "},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/StubReplies\/yourself","isActive":true,"type":"reference"},{"type":"text","text":" instead."},{"type":"text","text":" "},{"type":"text","text":"Stubs whose lines name nothing keep their own answer, because it already reads"},{"type":"text","text":" "},{"type":"text","text":"correctly: "},{"code":"taste me","type":"codeVoice"},{"type":"text","text":" still says "},{"type":"emphasis","inlineContent":[{"text":"“You’d rather not.”","type":"text"}]}]},{"inlineContent":[{"type":"text","text":"Eighteen of them are handed an "},{"type":"strong","inlineContent":[{"text":"optional","type":"text"}]},{"type":"text","text":" name, and either of two things puts"},{"type":"text","text":" "},{"type":"text","text":"a verb there. Some have rows that carry no object at all — "},{"type":"codeVoice","code":"smell"},{"type":"text","text":" and "},{"type":"codeVoice","code":"smell the troll"},{"type":"text","text":" are one intent — so one sentence has to read both ways. The rest fill the"},{"type":"text","text":" "},{"text":"slot on every row but read perfectly well with the name left out: ","type":"text"},{"code":"knock","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"taste","type":"codeVoice"},{"text":", ","type":"text"},{"code":"kiss","type":"codeVoice"},{"text":", ","type":"text"},{"code":"count","type":"codeVoice"},{"text":", ","type":"text"},{"code":"buy","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"sell","type":"codeVoice"},{"text":" are about the player as much as the","type":"text"},{"text":" ","type":"text"},{"text":"thing, so the name is offered rather than required.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The player takes the nameless half rather than the "},{"code":"yourself","type":"codeVoice"},{"type":"text","text":" deferral, which is"},{"type":"text","text":" "},{"type":"text","text":"the same answer by a different road: "},{"code":"smell me","type":"codeVoice"},{"type":"text","text":" still says "},{"inlineContent":[{"type":"text","text":"“You smell nothing"},{"type":"text","text":" "},{"type":"text","text":"out of the ordinary.”"}],"type":"emphasis"},{"type":"text","text":" Seventeen of the eighteen also skip the "},{"code":"somebodyElse","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"guard, and that follows from the shape rather than being a convenience — a line"},{"type":"text","text":" "},{"type":"text","text":"with a nameless half is a line that can be said about anybody. "},{"type":"codeVoice","code":"touch"},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"one that keeps it, because laying hands on somebody is not the same as listening"},{"type":"text","text":" "},{"type":"text","text":"to them; "},{"type":"codeVoice","code":"kiss"},{"type":"text","text":" is the one that shows why the call is per verb, since kissing"},{"type":"text","text":" "},{"type":"text","text":"somebody is what the verb is "},{"type":"emphasis","inlineContent":[{"text":"for","type":"text"}]},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Re-skinning-a-line","text":"Re-skinning a line","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Every stub line lives on "},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/stubs","isActive":true,"type":"reference"},{"type":"text","text":", one property per intent. Override"},{"type":"text","text":" "},{"type":"text","text":"the ones that clash with your voice and leave the rest:"}],"type":"paragraph"},{"syntax":"swift","code":["var text: GameText {","    var text = GameText()","    text.stubs.attack = .naming { \"The Institute frowns on assaulting \\($0).\" }","    text.stubs.pray = \"No one is listening. You checked.\"","    return text","}"],"type":"codeListing"},{"level":2,"anchor":"Promoting-a-stub-to-real-behavior","type":"heading","text":"Promoting a stub to real behavior"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is the part that makes the whole design worth it: the parser already knows"},{"type":"text","text":" "},{"type":"text","text":"the word, so a game only has to add a rule. No "},{"type":"codeVoice","code":"#verb"},{"type":"text","text":", no "},{"type":"codeVoice","code":"verbs"},{"type":"text","text":" entry, no"},{"type":"text","text":" "},{"type":"text","text":"warning. Zork’s climbable tree is one line:"}]},{"type":"codeListing","syntax":"swift","code":["tree.before(.climb) {","    try reply(Prose.treeClimb)","}"]},{"inlineContent":[{"type":"text","text":"For behavior that spans every object rather than one, use an "},{"type":"codeVoice","code":"actions"},{"type":"text","text":" row —"},{"type":"text","text":" "},{"type":"codeVoice","code":"GnustoMeleeCombat"},{"type":"text","text":" turns the whole "},{"type":"codeVoice","code":"attack"},{"type":"text","text":" family into real combat that way:"}],"type":"paragraph"},{"code":["public var actions: [IntentAction] {","    action(.attack) {","        try reply(","            text.attackFutile(command.directObject?.indefiniteNoun ?? GameText.Noun(\"that\")))","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","anchor":"To-change-only-the-words-assign-the-line","level":3,"text":"To change only the words, assign the line"},{"inlineContent":[{"type":"text","text":"An "},{"type":"codeVoice","code":"actions"},{"type":"text","text":" row replaces the stub’s "},{"type":"strong","inlineContent":[{"text":"whole","type":"text"}]},{"type":"text","text":" default, and the reach guard is"},{"type":"text","text":" "},{"type":"text","text":"part of that default: "},{"type":"codeVoice","code":"DefaultActions.run"},{"type":"text","text":" returns from an override before it"},{"type":"text","text":" "},{"text":"calls ","type":"text"},{"code":"requireReach","type":"codeVoice"},{"text":", because a game that claims the verb is saying it will","type":"text"},{"text":" ","type":"text"},{"text":"decide for itself what “close enough to touch” means. ","type":"text"},{"code":"GnustoMeleeCombat","type":"codeVoice"},{"text":" wants","type":"text"},{"text":" ","type":"text"},{"text":"exactly that.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"A game that only wants a different sentence does not, and gets it anyway. So","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"re-voicing is an assignment, not a row — and the assignment is a sentence:"}]},{"code":["var text: GameText {","    var text = GameText()","    text.stubs.climb = \"That is not something you could climb.\"","    return text","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A line that "},{"type":"emphasis","inlineContent":[{"type":"text","text":"does"}]},{"type":"text","text":" want to name what the player pointed at says so, in the same"},{"type":"text","text":" "},{"type":"text","text":"slot:"}]},{"code":["text.stubs.climb = .naming(orBare: \"There's nothing here worth climbing.\") {","    \"You can't climb onto \\($0).\"","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both halves, because a line that owns a nameless half has two things to say and"},{"type":"text","text":" "},{"type":"text","text":"writing only one leaves the engine’s narrator answering the other. See"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Line","type":"reference"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"The assignment keeps the reach guard, the object’s rendered name, its number","type":"text"},{"text":" ","type":"text"},{"text":"agreement, and the ","type":"text"},{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/StubReplies\/yourself","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/StubReplies\/somebodyElse","isActive":true},{"type":"text","text":" guards — and, since wanting the name is"},{"type":"text","text":" "},{"type":"text","text":"now something an assignment can do, it has stopped being a reason to reach for a"},{"type":"text","text":" "},{"type":"text","text":"row at all. The row keeps none of them, and"},{"type":"text","text":" "},{"type":"text","text":"nothing warns — a row and an assignment look equally reasonable at the call site."},{"type":"text","text":" "},{"type":"codeVoice","code":"Sources\/Dungeon\/"},{"type":"text","text":" re-skinned seventeen stubs with rows and had given all four"},{"type":"text","text":" "},{"type":"text","text":"away without noticing."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"The rule of thumb:","type":"text"}],"type":"strong"},{"text":" an ","type":"text"},{"code":"actions","type":"codeVoice"},{"text":" row means ","type":"text"},{"inlineContent":[{"text":"this game has behavior here","type":"text"}],"type":"emphasis"},{"text":". If","type":"text"},{"text":" ","type":"text"},{"text":"all it has is a sentence, assign the sentence.","type":"text"}]},{"level":3,"anchor":"Use-reply-not-say","type":"heading","text":"Use `reply`, not `say`"},{"type":"paragraph","inlineContent":[{"text":"The stage-4 default ","type":"text"},{"inlineContent":[{"type":"text","text":"says"}],"type":"emphasis"},{"text":" its line rather than refusing, so world time passes on","type":"text"},{"text":" ","type":"text"},{"text":"a stub turn. That means a ","type":"text"},{"code":"before","type":"codeVoice"},{"text":" rule which only ","type":"text"},{"code":"say","type":"codeVoice"},{"text":"s does ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"text":" suppress","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the stock line — the player gets both. Promote a stub with "},{"isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/reply(_:)","type":"reference"},{"type":"text","text":" or"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/refuse(_:)","type":"reference"},{"type":"text","text":", which end the turn."}]},{"anchor":"Precedence","level":3,"type":"heading","text":"Precedence"},{"inlineContent":[{"type":"text","text":"Not “item beats room”. "},{"type":"codeVoice","code":"before"},{"type":"text","text":" rules run outside-in, so whoever "},{"type":"codeVoice","code":"reply"},{"type":"text","text":"s or"},{"type":"text","text":" "},{"type":"codeVoice","code":"refuse"},{"type":"text","text":"s "},{"inlineContent":[{"type":"text","text":"first"}],"type":"strong"},{"type":"text","text":" wins:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"World ","type":"text"},{"type":"codeVoice","code":"before"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Location "},{"code":"beforeEachTurn","type":"codeVoice"},{"text":", then location ","type":"text"},{"code":"before","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Item "},{"type":"codeVoice","code":"before"},{"type":"text","text":" — indirect object, then direct object"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The game’s ","type":"text"},{"code":"actions","type":"codeVoice"},{"text":" row for that intent","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The engine’s stub line","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"text":"So a ","type":"text"},{"code":"world.before(.dig)","type":"codeVoice"},{"text":" pre-empts a ","type":"text"},{"code":"sand.before(.dig)","type":"codeVoice"},{"type":"text","text":". See"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TheTurnPipeline","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Reclaiming the word entirely","anchor":"Reclaiming-the-word-entirely"},{"inlineContent":[{"text":"If you want the ","type":"text"},{"inlineContent":[{"type":"text","text":"word"}],"type":"emphasis"},{"text":" to mean something else, claim its row. Reclaiming a stub","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"row is silent, unlike reclaiming a core row:"}],"type":"paragraph"},{"syntax":"swift","code":["var verbs: [SyntaxRule] {","    SyntaxRule(\"attack\", .directObject, intent: Intent(\"brawl\"))","}"],"type":"codeListing"},{"text":"Notes for engine work","type":"heading","anchor":"Notes-for-engine-work","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The table is split: ","type":"text"},{"code":"SyntaxRule\/coreTable","type":"codeVoice"},{"text":" is the rows with real behavior,","type":"text"},{"text":" ","type":"text"},{"code":"SyntaxRule\/stubTable","type":"codeVoice"},{"text":" is these, and ","type":"text"},{"code":"standardTable","type":"codeVoice"},{"text":" is both. Bootstrap keys","type":"text"},{"type":"text","text":" "},{"type":"text","text":"its override warning off "},{"code":"coreTable","type":"codeVoice"},{"text":", and that split ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"is","type":"text"}]},{"text":" the stub flag.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A stub’s intent, rows and line are one ","type":"text"},{"code":"StubVerb","type":"codeVoice"},{"text":" value, so a stub can’t be","type":"text"},{"text":" ","type":"text"},{"text":"half-declared — rows with no line would fall through to stage 4’s last resort,","type":"text"},{"text":" ","type":"text"},{"text":"so a word the engine advertises would answer “You can’t do that.” Core verbs","type":"text"},{"text":" ","type":"text"},{"text":"have the same shape for the same reason: a ","type":"text"},{"code":"CoreVerb","type":"codeVoice"},{"text":" is an intent, its rows","type":"text"},{"text":" ","type":"text"},{"text":"and its handler, and both tables and both intent sets are derived from those","type":"text"},{"text":" ","type":"text"},{"text":"two arrays rather than restated.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Stub intents are deliberately "},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" in "},{"code":"DefaultActions.builtInIntents","type":"codeVoice"},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"is what keeps "},{"code":"action(.dig)","type":"codeVoice"},{"type":"text","text":" from warning. "},{"type":"codeVoice","code":"handledIntents"},{"type":"text","text":" is the union, used"},{"type":"text","text":" "},{"type":"text","text":"for the dead-intent check. "},{"type":"codeVoice","code":"engineIntents"},{"type":"text","text":" is the third set — UNDO, RESTART,"},{"type":"text","text":" "},{"type":"text","text":"SAVE and RESTORE, which "},{"type":"codeVoice","code":"GameWorld.run"},{"type":"text","text":" answers before the pipeline — and an"},{"type":"text","text":" "},{"type":"codeVoice","code":"actions"},{"type":"text","text":" row for one of those warns that it can never run."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"No stub row uses a "},{"type":"codeVoice","code":".topic"},{"type":"text","text":" slot, and none should. A topic never fails to"},{"type":"text","text":" "},{"type":"text","text":"match, so a low-specificity topic row silently absorbs the scope failures of"},{"type":"text","text":" "},{"type":"text","text":"every more specific row sharing its verb word — "},{"type":"codeVoice","code":"say hello to butler"},{"type":"text","text":" with no"},{"type":"text","text":" "},{"type":"text","text":"butler present would answer a canned line instead of “You can’t see any such"},{"type":"text","text":" "},{"type":"text","text":"thing.”"}]}]},{"content":[{"inlineContent":[{"text":"A bare ","type":"text"},{"code":"verb <object>","type":"codeVoice"},{"text":" row suppresses the ","type":"text"},{"code":"missingIndirect","type":"codeVoice"},{"text":" prompt from any","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"verb <object> PREP <second object>"},{"type":"text","text":" row on the same verb word, because the"},{"type":"text","text":" "},{"type":"text","text":"parser returns on the first row that "},{"type":"emphasis","inlineContent":[{"type":"text","text":"matches"}]},{"type":"text","text":" and only falls back to a"},{"type":"text","text":" "},{"type":"text","text":"near-miss when nothing matched. That is why "},{"type":"codeVoice","code":"give"},{"type":"text","text":" and "},{"type":"codeVoice","code":"throw"},{"type":"text","text":" ship"},{"type":"text","text":" "},{"type":"text","text":"second-object-only: "},{"type":"codeVoice","code":"give lamp"},{"type":"text","text":" asking "},{"type":"emphasis","inlineContent":[{"text":"“What do you want to give the lamp","type":"text"},{"text":" ","type":"text"},{"text":"to?”","type":"text"}]},{"type":"text","text":" beats a canned line."}],"type":"paragraph"}]}]},{"anchor":"See-also","type":"heading","level":2,"text":"See also"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/AddingCustomVerbs","isActive":true,"type":"reference"}]}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/WritingRules","type":"reference"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TheTurnPipeline","type":"reference"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextAndRandomness","type":"reference","isActive":true}]}]}]}]}],"abstract":[{"type":"text","text":"The verbs the parser knows as words even where your game has no mechanic."}],"variants":[{"paths":["\/documentation\/gnusto\/stubverbs"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"article","roleHeading":"Article","title":"Stub Verbs","modules":[{"name":"Gnusto"}]},"sections":[],"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"article","references":{"doc://Gnusto/documentation/Gnusto/GameText/stubs":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stubs","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6Gnusto8GameTextV","text":"GameText","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:6Gnusto8GameTextV11StubRepliesV","text":"StubReplies","kind":"typeIdentifier"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/stubs","title":"stubs","type":"topic","abstract":[{"type":"text","text":"The stock replies for the verbs the parser knows as words but the engine"},{"type":"text","text":" "},{"type":"text","text":"gives no mechanic. Re-skin one with "},{"type":"codeVoice","code":"text.stubs.dig = \"…\""},{"type":"text","text":"; give one real"},{"type":"text","text":" "},{"type":"text","text":"behavior with a rule or an "},{"type":"codeVoice","code":"actions"},{"type":"text","text":" row."}],"url":"\/documentation\/gnusto\/gametext\/stubs"},"doc://Gnusto/documentation/Gnusto/SyntaxRule":{"navigatorTitle":[{"text":"SyntaxRule","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SyntaxRule","kind":"identifier"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/SyntaxRule","role":"symbol","abstract":[{"text":"One row of the verb table: a pattern of literal words and slots, and the","type":"text"},{"type":"text","text":" "},{"text":"intent a match produces. Data, not code — games can add rows through their","type":"text"},{"text":" ","type":"text"},{"code":"verbs","type":"codeVoice"},{"text":" block to teach the parser new player-typeable verbs.","type":"text"}],"url":"\/documentation\/gnusto\/syntaxrule","type":"topic","title":"SyntaxRule","kind":"symbol"},"doc://Gnusto/documentation/Gnusto/GameText/StubReplies/somebodyElse":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"somebodyElse","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6Gnusto8GameTextV","text":"GameText","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Line","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto8GameTextV4LineV"},{"text":"<","kind":"text"},{"text":"GameText","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto8GameTextV"},{"text":".","kind":"text"},{"text":"Noun","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto8GameTextV4NounV"},{"text":">","kind":"text"}],"url":"\/documentation\/gnusto\/gametext\/stubreplies\/somebodyelse","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/StubReplies\/somebodyElse","abstract":[{"text":"A stub verb aimed at somebody else, where the verb would otherwise","type":"text"},{"text":" ","type":"text"},{"text":"have reported a completed act on a person — “The cook is not food.”,","type":"text"},{"text":" ","type":"text"},{"text":"“You feel nothing out of the ordinary.” about a witness. Every stub","type":"text"},{"text":" ","type":"text"},{"text":"that has to ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"reach"}]},{"text":" its object goes through this, so one line covers","type":"text"},{"text":" ","type":"text"},{"text":"all of them, the way ","type":"text"},{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/StubReplies\/yourself","isActive":true},{"text":" does.","type":"text"}],"title":"somebodyElse","role":"symbol","kind":"symbol","type":"topic"},"doc://Gnusto/documentation/Gnusto/TheTurnPipeline":{"abstract":[{"text":"What happens between the player pressing Return and the next prompt.","type":"text"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TheTurnPipeline","kind":"article","type":"topic","role":"article","title":"The Turn Pipeline","url":"\/documentation\/gnusto\/theturnpipeline"},"doc://Gnusto/documentation/Gnusto/GameText/Line":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Line","kind":"identifier"}],"url":"\/documentation\/gnusto\/gametext\/line","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Line","title":"GameText.Line","abstract":[{"type":"text","text":"One stock line, in whichever shape the game wants it: a fixed sentence,"},{"type":"text","text":" "},{"type":"text","text":"a sentence assembled when it prints, or one that names the thing it is"},{"type":"text","text":" "},{"type":"text","text":"about."}],"navigatorTitle":[{"text":"Line","kind":"identifier"}],"role":"symbol","kind":"symbol","type":"topic"},"doc://Gnusto/documentation/Gnusto/refuse(_:)":{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/refuse(_:)","url":"\/documentation\/gnusto\/refuse(_:)","role":"symbol","abstract":[{"text":"Blocks the current action with a complaint. The default action and any","type":"text"},{"text":" ","type":"text"},{"text":"remaining ","type":"text"},{"code":"before","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"after","type":"codeVoice"},{"text":" rules are skipped; world time still passes.","type":"text"}],"type":"topic","kind":"symbol","title":"refuse(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"refuse","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Never","preciseIdentifier":"s:s5NeverO","kind":"typeIdentifier"}]},"doc://Gnusto/documentation/Gnusto/AddingCustomVerbs":{"abstract":[{"text":"Teach the parser words the built-in table doesn’t know.","type":"text"}],"kind":"article","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/AddingCustomVerbs","type":"topic","role":"article","title":"Adding Custom Verbs","url":"\/documentation\/gnusto\/addingcustomverbs"},"doc://Gnusto/documentation/Gnusto/verb(_:_:)":{"fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"verb","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", [","kind":"text"},{"text":"SyntaxElement","preciseIdentifier":"s:6Gnusto13SyntaxElementO","kind":"typeIdentifier"},{"text":"]...)","kind":"text"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/verb(_:_:)","role":"symbol","abstract":[{"text":"Declares a custom player-typeable verb in one place: a typed intent","type":"text"},{"text":" ","type":"text"},{"text":"constant plus the verb rows that produce it.","type":"text"}],"title":"verb(_:_:)","url":"\/documentation\/gnusto\/verb(_:_:)","type":"topic","kind":"symbol"},"doc://Gnusto/documentation/Gnusto/WritingRules":{"kind":"article","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/WritingRules","type":"topic","abstract":[{"type":"text","text":"Attach game logic to items, locations, and the world."}],"title":"Writing Rules","role":"article","url":"\/documentation\/gnusto\/writingrules"},"doc://Gnusto/documentation/Gnusto":{"url":"\/documentation\/gnusto","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto","title":"Gnusto","abstract":[{"text":"A Swift engine for writing parser-driven interactive fiction — text adventures in the tradition of Zork and Infocom’s ZIL.","type":"text"}],"role":"collection","kind":"symbol","type":"topic"},"doc://Gnusto/documentation/Gnusto/GameText/StubReplies/yourself":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"yourself"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto8GameTextV","text":"GameText"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto8GameTextV4LineV","text":"Line"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto8GameTextV","text":"GameText"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto8GameTextV7NothingV","text":"Nothing"},{"kind":"text","text":">"}],"url":"\/documentation\/gnusto\/gametext\/stubreplies\/yourself","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/StubReplies\/yourself","abstract":[{"type":"text","text":"A stub verb aimed at yourself, where the verb’s own line would have"},{"type":"text","text":" "},{"type":"text","text":"named its object. The player item is called “yourself”, so those"},{"type":"text","text":" "},{"type":"text","text":"lines would read “The yourself is not food.” — one line covers all of"},{"type":"text","text":" "},{"type":"text","text":"them rather than fifteen self-specific variants."}],"title":"yourself","role":"symbol","kind":"symbol","type":"topic"},"doc://Gnusto/documentation/Gnusto/TextAndRandomness":{"url":"\/documentation\/gnusto\/textandrandomness","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextAndRandomness","role":"article","abstract":[{"type":"text","text":"Re-skin the engine’s stock lines, and roll dice that replay."}],"type":"topic","kind":"article","title":"Text and Randomness"},"doc://Gnusto/documentation/Gnusto/GameText/cantReach":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cantReach","kind":"identifier"},{"text":": ","kind":"text"},{"text":"GameText","preciseIdentifier":"s:6Gnusto8GameTextV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Line","preciseIdentifier":"s:6Gnusto8GameTextV4LineV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"GameText","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto8GameTextV"},{"text":".","kind":"text"},{"kind":"typeIdentifier","text":"Noun","preciseIdentifier":"s:6Gnusto8GameTextV4NounV"},{"kind":"text","text":">"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/cantReach","title":"cantReach","url":"\/documentation\/gnusto\/gametext\/cantreach","abstract":[{"text":"The item resolved (it was visible to the parser), but a reachability","type":"text"},{"text":" ","type":"text"},{"text":"guard failed — you can see it, you just can’t touch it (e.g. through a","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"shut glass jar). Distinct from "},{"code":"cantSeeAnySuchThing","type":"codeVoice"},{"type":"text","text":", which is for a"},{"type":"text","text":" "},{"type":"text","text":"noun that isn’t in scope at all."}],"type":"topic"},"doc://Gnusto/documentation/Gnusto/SyntaxElement":{"navigatorTitle":[{"text":"SyntaxElement","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SyntaxElement","kind":"identifier"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/SyntaxElement","role":"symbol","abstract":[{"text":"One element of a verb pattern: a literal word the player must type, or a","type":"text"},{"text":" ","type":"text"},{"text":"slot the parser fills from the rest of the sentence. String literals in a","type":"text"},{"text":" ","type":"text"},{"text":"pattern are ","type":"text"},{"code":".word","type":"codeVoice"},{"text":"s, so rows read the way they’re typed:","type":"text"}],"title":"SyntaxElement","type":"topic","url":"\/documentation\/gnusto\/syntaxelement","kind":"symbol"},"doc://Gnusto/documentation/Gnusto/reply(_:)":{"kind":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/reply(_:)","type":"topic","abstract":[{"type":"text","text":"Fully handles the current action with a response, skipping the default"},{"type":"text","text":" "},{"type":"text","text":"behavior. Mechanically identical to "},{"type":"codeVoice","code":"refuse(_:)"},{"type":"text","text":" — two names exist so"},{"type":"text","text":" "},{"type":"text","text":"game code reads correctly: "},{"type":"codeVoice","code":"refuse"},{"type":"text","text":" for “no, you can’t”, "},{"type":"codeVoice","code":"reply"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"“here’s what happens instead”."}],"title":"reply(_:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reply","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:s5NeverO","text":"Never","kind":"typeIdentifier"}],"url":"\/documentation\/gnusto\/reply(_:)"}}}