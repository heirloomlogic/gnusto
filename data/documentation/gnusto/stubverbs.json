{"kind":"article","sections":[],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"inlineContent":[{"text":"A player five minutes into their first room will type ","type":"text"},{"type":"codeVoice","code":"attack the chair"},{"text":", ","type":"text"},{"type":"codeVoice","code":"smell"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"listen","type":"codeVoice"},{"text":", ","type":"text"},{"code":"climb the ladder","type":"codeVoice"},{"text":", ","type":"text"},{"code":"jump","type":"codeVoice"},{"text":", ","type":"text"},{"code":"dig","type":"codeVoice"},{"text":", ","type":"text"},{"code":"buy lamp","type":"codeVoice"},{"text":". None of those is a verb","type":"text"},{"text":" ","type":"text"},{"text":"most games implement. All of them are verbs every player tries.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"I don't know the word \"attack\"","type":"codeVoice"},{"text":" answers the wrong question. It says the","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"program"}],"type":"emphasis"},{"text":" is unfinished. ","type":"text"},{"code":"Attacking the chair rarely improves matters.","type":"codeVoice"},{"text":" says the","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"world"}],"type":"emphasis"},{"text":" is — and the player learns something from the second answer and nothing","type":"text"},{"text":" ","type":"text"},{"text":"from the first.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"So the engine ships about fifty of these words with a line of stock prose each.","type":"text"},{"text":" ","type":"text"},{"text":"Nothing about them is a special case in the parser. A stub verb is an ordinary","type":"text"},{"text":" ","type":"text"},{"text":"row in the standard table whose intent happens to have no mechanic behind it,","type":"text"},{"text":" ","type":"text"},{"text":"which means it:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Is in the vocabulary"}]},{"type":"text","text":", so it is never "},{"type":"codeVoice","code":"I don't know the word"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Resolves its objects through normal scope."}]},{"type":"text","text":" "},{"type":"codeVoice","code":"attack the grue"},{"type":"text","text":" where there"},{"type":"text","text":" "},{"type":"text","text":"is no grue still answers "},{"type":"emphasis","inlineContent":[{"type":"text","text":"“You can’t see any such thing.”"}]},{"type":"text","text":" A stub doesn’t buy"},{"type":"text","text":" "},{"type":"text","text":"politeness by weakening scope honesty."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Scope is the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"visible"}]},{"type":"text","text":" set, which admits what can be seen through the glass"},{"type":"text","text":" "},{"type":"text","text":"of a shut jar or in somebody else’s hands — so the physical stubs re-check"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"reach"}],"type":"strong"},{"type":"text","text":" and refuse with "},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/cantReach","isActive":true,"type":"reference"},{"text":", exactly as ","type":"text"},{"type":"codeVoice","code":"push"},{"text":" does.","type":"text"},{"type":"text","text":" "},{"text":"Through the shut bottle in Zork’s kitchen, ","type":"text"},{"type":"codeVoice","code":"push water"},{"text":", ","type":"text"},{"type":"codeVoice","code":"squeeze water"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"burn water"},{"type":"text","text":" now all answer "},{"inlineContent":[{"text":"“You can’t reach the quantity of water.”","type":"text"}],"type":"emphasis"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"opening the bottle lets all three through."}],"type":"paragraph"},{"inlineContent":[{"text":"Which verbs check is a call made per verb, because a blanket guard would be","type":"text"},{"text":" ","type":"text"},{"text":"wrong: ","type":"text"},{"type":"codeVoice","code":"smell"},{"type":"text","text":", "},{"code":"listen to","type":"codeVoice"},{"type":"text","text":", "},{"code":"point at","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"count"},{"text":", ","type":"text"},{"code":"buy","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"sell"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"wake"},{"text":" ","type":"text"},{"text":"are fine at a distance — you can smell a fire across a room, count coins","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"behind glass, and shout somebody awake. "},{"code":"throw … at …","type":"codeVoice"},{"type":"text","text":" checks the projectile"},{"type":"text","text":" "},{"type":"text","text":"and deliberately not the target, and "},{"code":"give … to …","type":"codeVoice"},{"type":"text","text":" is the one stub that"},{"type":"text","text":" "},{"type":"text","text":"checks both slots, since handing something over is contact with the gift and"},{"type":"text","text":" "},{"type":"text","text":"with whoever takes it."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Costs a turn.","type":"text"}],"type":"strong"},{"type":"text","text":" Flailing at the chair takes time; fuses and daemons tick."},{"type":"text","text":" "},{"type":"text","text":"This is the substantive difference from the parse error it replaces, which was"},{"type":"text","text":" "},{"type":"text","text":"free."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Is overridable at every layer, with no warning","type":"text"}],"type":"strong"},{"type":"text","text":" — because overriding is"},{"type":"text","text":" "},{"type":"text","text":"the expected end state, not a mistake."}],"type":"paragraph"}]}]},{"text":"What’s in the set","type":"heading","level":2,"anchor":"Whats-in-the-set"},{"inlineContent":[{"type":"text","text":"Violence and force: "},{"code":"attack","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"kill","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"hit","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"fight","type":"codeVoice"},{"type":"text","text":" (bare or "},{"code":"with","type":"codeVoice"},{"type":"text","text":" a weapon),"},{"type":"text","text":" "},{"code":"break","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"smash","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"destroy","type":"codeVoice"},{"text":", ","type":"text"},{"code":"burn","type":"codeVoice"},{"text":", ","type":"text"},{"code":"cut","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"slice","type":"codeVoice"},{"text":", ","type":"text"},{"code":"dig","type":"codeVoice"},{"text":", ","type":"text"},{"code":"pull","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"drag","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"turn","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"rotate","type":"codeVoice"},{"text":", ","type":"text"},{"code":"squeeze","type":"codeVoice"},{"text":", ","type":"text"},{"code":"shake","type":"codeVoice"},{"type":"text","text":", "},{"code":"knock (on)","type":"codeVoice"},{"type":"text","text":", "},{"code":"throw … at …","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"Senses: ","type":"text"},{"code":"touch","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"feel","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"rub","type":"codeVoice"},{"type":"text","text":", "},{"code":"smell","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"sniff","type":"codeVoice"},{"type":"text","text":", "},{"code":"listen (to)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"taste","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"lick","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Body: "},{"code":"eat","type":"codeVoice"},{"type":"text","text":", "},{"code":"drink","type":"codeVoice"},{"type":"text","text":", "},{"code":"sleep","type":"codeVoice"},{"type":"text","text":", "},{"code":"wake (up)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Social: "},{"code":"kiss","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"hug","type":"codeVoice"},{"type":"text","text":", "},{"code":"give","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"hand … to …","type":"codeVoice"},{"type":"text","text":", "},{"code":"yell","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"shout","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"scream","type":"codeVoice"},{"type":"text","text":", "},{"code":"wave","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"point at","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Motion: "},{"code":"climb (up\/down\/on)","type":"codeVoice"},{"type":"text","text":", "},{"code":"jump (over)","type":"codeVoice"},{"type":"text","text":", "},{"code":"swim","type":"codeVoice"},{"type":"text","text":", "},{"code":"dive","type":"codeVoice"},{"type":"text","text":", "},{"code":"stand (up)","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"sit (down\/on)","type":"codeVoice"},{"type":"text","text":", "},{"code":"lie (down)","type":"codeVoice"},{"type":"text","text":", "},{"code":"kneel","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Liquids and containers: "},{"code":"fill","type":"codeVoice"},{"text":", ","type":"text"},{"code":"pour","type":"codeVoice"},{"text":", ","type":"text"},{"code":"empty","type":"codeVoice"},{"text":", ","type":"text"},{"code":"tie","type":"codeVoice"},{"text":", ","type":"text"},{"code":"untie","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Ritual and flavor: "},{"code":"pray","type":"codeVoice"},{"type":"text","text":", "},{"code":"sing","type":"codeVoice"},{"type":"text","text":", "},{"code":"curse","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"swear","type":"codeVoice"},{"type":"text","text":", "},{"code":"xyzzy","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"plugh","type":"codeVoice"},{"type":"text","text":", "},{"code":"count","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"think","type":"codeVoice"},{"type":"text","text":", "},{"code":"wish","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Commerce: "},{"code":"buy","type":"codeVoice"},{"type":"text","text":", "},{"code":"sell","type":"codeVoice"},{"type":"text","text":". Fixtures: "},{"code":"blow","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Deliberately "},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"type":"text","text":" stubs: "},{"code":"again","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"oops","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"verbose","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"brief","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"notify","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"script","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"are missing "},{"inlineContent":[{"text":"features","type":"text"}],"type":"emphasis"},{"type":"text","text":", and a canned refusal would be a worse answer than the"},{"type":"text","text":" "},{"type":"text","text":"error. "},{"code":"ask","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"tell","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"show","type":"codeVoice"},{"type":"text","text":" belong to "},{"code":"GnustoConversation","type":"codeVoice"},{"type":"text","text":", which has a topic slot"},{"type":"text","text":" "},{"type":"text","text":"and somebody to ask. Bare "},{"code":"hello","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"hi","type":"codeVoice"},{"type":"text","text":", "},{"code":"ring","type":"codeVoice"},{"type":"text","text":" and "},{"code":"wind","type":"codeVoice"},{"type":"text","text":" are left free for games"},{"type":"text","text":" "},{"type":"text","text":"that want to own them outright."}],"type":"paragraph"},{"text":"Aimed at yourself","type":"heading","level":2,"anchor":"Aimed-at-yourself"},{"inlineContent":[{"type":"text","text":"The player is an entity, and it is called “yourself” — so a stub line that names"},{"type":"text","text":" "},{"type":"text","text":"its object would read "},{"inlineContent":[{"text":"“The yourself is not food.”","type":"text"}],"type":"emphasis"},{"type":"text","text":" Every name-carrying stub"},{"type":"text","text":" "},{"type":"text","text":"checks for the player and answers "},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/StubReplies\/yourself","isActive":true,"type":"reference"},{"type":"text","text":" instead."},{"type":"text","text":" "},{"type":"text","text":"Stubs whose lines name nothing keep their own answer, because it already reads"},{"type":"text","text":" "},{"type":"text","text":"correctly: "},{"code":"taste me","type":"codeVoice"},{"type":"text","text":" still says "},{"inlineContent":[{"text":"“You’d rather not.”","type":"text"}],"type":"emphasis"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Eighteen of them are handed an "},{"inlineContent":[{"text":"optional","type":"text"}],"type":"strong"},{"type":"text","text":" name, and either of two things puts"},{"type":"text","text":" "},{"type":"text","text":"a verb there. Some have rows that carry no object at all — "},{"code":"smell","type":"codeVoice"},{"type":"text","text":" and "},{"code":"smell the troll","type":"codeVoice"},{"type":"text","text":" are one intent — so one sentence has to read both ways. The rest fill the"},{"type":"text","text":" "},{"type":"text","text":"slot on every row but read perfectly well with the name left out: "},{"code":"knock","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"taste","type":"codeVoice"},{"type":"text","text":", "},{"code":"kiss","type":"codeVoice"},{"type":"text","text":", "},{"code":"count","type":"codeVoice"},{"type":"text","text":", "},{"code":"buy","type":"codeVoice"},{"type":"text","text":" and "},{"code":"sell","type":"codeVoice"},{"type":"text","text":" are about the player as much as the"},{"type":"text","text":" "},{"type":"text","text":"thing, so the name is offered rather than required."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The player takes the nameless half rather than the "},{"type":"codeVoice","code":"yourself"},{"text":" deferral, which is","type":"text"},{"text":" ","type":"text"},{"text":"the same answer by a different road: ","type":"text"},{"type":"codeVoice","code":"smell me"},{"text":" still says ","type":"text"},{"inlineContent":[{"type":"text","text":"“You smell nothing"},{"type":"text","text":" "},{"type":"text","text":"out of the ordinary.”"}],"type":"emphasis"},{"text":" Seventeen of the eighteen also skip the ","type":"text"},{"type":"codeVoice","code":"somebodyElse"},{"text":" ","type":"text"},{"type":"text","text":"guard, and that follows from the shape rather than being a convenience — a line"},{"type":"text","text":" "},{"type":"text","text":"with a nameless half is a line that can be said about anybody. "},{"code":"touch","type":"codeVoice"},{"type":"text","text":" is the"},{"type":"text","text":" "},{"text":"one that keeps it, because laying hands on somebody is not the same as listening","type":"text"},{"text":" ","type":"text"},{"text":"to them; ","type":"text"},{"type":"codeVoice","code":"kiss"},{"text":" is the one that shows why the call is per verb, since kissing","type":"text"},{"text":" ","type":"text"},{"text":"somebody is what the verb is ","type":"text"},{"inlineContent":[{"type":"text","text":"for"}],"type":"emphasis"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Re-skinning a line","type":"heading","level":2,"anchor":"Re-skinning-a-line"},{"inlineContent":[{"text":"Every stub line lives on ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/stubs","type":"reference","isActive":true},{"text":", one property per intent. Override","type":"text"},{"text":" ","type":"text"},{"text":"the ones that clash with your voice and leave the rest:","type":"text"}],"type":"paragraph"},{"code":["var text: GameText {","    var text = GameText()","    text.stubs.attack = .naming { \"The Institute frowns on assaulting \\($0).\" }","    text.stubs.pray = \"No one is listening. You checked.\"","    return text","}"],"type":"codeListing","syntax":"swift"},{"text":"Promoting a stub to real behavior","type":"heading","level":2,"anchor":"Promoting-a-stub-to-real-behavior"},{"inlineContent":[{"text":"This is the part that makes the whole design worth it: the parser already knows","type":"text"},{"text":" ","type":"text"},{"text":"the word, so a game only has to add a rule. No ","type":"text"},{"type":"codeVoice","code":"#verb"},{"text":", no ","type":"text"},{"type":"codeVoice","code":"verbs"},{"text":" entry, no","type":"text"},{"text":" ","type":"text"},{"text":"warning. Zork’s climbable tree is one line:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["tree.before(.climb) {","    try reply(Prose.treeClimb)","}"]},{"inlineContent":[{"type":"text","text":"For behavior that spans every object rather than one, use an "},{"code":"actions","type":"codeVoice"},{"type":"text","text":" row —"},{"type":"text","text":" "},{"code":"GnustoMeleeCombat","type":"codeVoice"},{"type":"text","text":" turns the whole "},{"code":"attack","type":"codeVoice"},{"type":"text","text":" family into real combat that way:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["public var actions: [IntentAction] {","    action(.attack) {","        try reply(","            text.attackFutile(command.directObject?.indefiniteNoun ?? GameText.Noun(\"that\")))","    }","}"]},{"text":"To change only the words, assign the line","type":"heading","level":3,"anchor":"To-change-only-the-words-assign-the-line"},{"inlineContent":[{"type":"text","text":"An "},{"code":"actions","type":"codeVoice"},{"type":"text","text":" row replaces the stub’s "},{"inlineContent":[{"text":"whole","type":"text"}],"type":"strong"},{"type":"text","text":" default, and the reach guard is"},{"type":"text","text":" "},{"type":"text","text":"part of that default: "},{"code":"DefaultActions.run","type":"codeVoice"},{"type":"text","text":" returns from an override before it"},{"type":"text","text":" "},{"type":"text","text":"calls "},{"code":"requireReach","type":"codeVoice"},{"type":"text","text":", because a game that claims the verb is saying it will"},{"text":" ","type":"text"},{"text":"decide for itself what “close enough to touch” means. ","type":"text"},{"code":"GnustoMeleeCombat","type":"codeVoice"},{"type":"text","text":" wants"},{"type":"text","text":" "},{"type":"text","text":"exactly that."}],"type":"paragraph"},{"inlineContent":[{"text":"A game that only wants a different sentence does not, and gets it anyway. So","type":"text"},{"text":" ","type":"text"},{"text":"re-voicing is an assignment, not a row — and the assignment is a sentence:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var text: GameText {","    var text = GameText()","    text.stubs.climb = \"That is not something you could climb.\"","    return text","}"]},{"inlineContent":[{"type":"text","text":"A line that "},{"inlineContent":[{"text":"does","type":"text"}],"type":"emphasis"},{"text":" want to name what the player pointed at says so, in the same","type":"text"},{"text":" ","type":"text"},{"text":"slot:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["text.stubs.climb = .naming(orBare: \"There's nothing here worth climbing.\") {","    \"You can't climb onto \\($0).\"","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both halves, because a line that owns a nameless half has two things to say and"},{"type":"text","text":" "},{"type":"text","text":"writing only one leaves the engine’s narrator answering the other. See"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Line","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"The assignment keeps the reach guard, the object’s rendered name, its number","type":"text"},{"text":" ","type":"text"},{"text":"agreement, and the ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/StubReplies\/yourself","type":"reference","isActive":true},{"text":" and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/StubReplies\/somebodyElse","type":"reference","isActive":true},{"text":" guards — and, since wanting the name is","type":"text"},{"text":" ","type":"text"},{"text":"now something an assignment can do, it has stopped being a reason to reach for a","type":"text"},{"text":" ","type":"text"},{"text":"row at all. The row keeps none of them, and","type":"text"},{"text":" ","type":"text"},{"text":"nothing warns — a row and an assignment look equally reasonable at the call site.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Sources\/Dungeon\/"},{"text":" re-skinned seventeen stubs with rows and had given all four","type":"text"},{"text":" ","type":"text"},{"text":"away without noticing.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"The rule of thumb:"}],"type":"strong"},{"text":" an ","type":"text"},{"type":"codeVoice","code":"actions"},{"text":" row means ","type":"text"},{"inlineContent":[{"type":"text","text":"this game has behavior here"}],"type":"emphasis"},{"text":". If","type":"text"},{"text":" ","type":"text"},{"text":"all it has is a sentence, assign the sentence.","type":"text"}]},{"level":3,"text":"Use `reply`, not `say`","type":"heading","anchor":"Use-reply-not-say"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The stage-4 default "},{"inlineContent":[{"text":"says","type":"text"}],"type":"emphasis"},{"type":"text","text":" its line rather than refusing, so world time passes on"},{"type":"text","text":" "},{"type":"text","text":"a stub turn. That means a "},{"code":"before","type":"codeVoice"},{"type":"text","text":" rule which only "},{"code":"say","type":"codeVoice"},{"type":"text","text":"s does "},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"type":"text","text":" suppress"},{"type":"text","text":" "},{"type":"text","text":"the stock line — the player gets both. Promote a stub with "},{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/reply(_:)","isActive":true},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/refuse(_:)","isActive":true},{"type":"text","text":", which end the turn."}]},{"level":3,"text":"Precedence","type":"heading","anchor":"Precedence"},{"type":"paragraph","inlineContent":[{"text":"Not “item beats room”. ","type":"text"},{"type":"codeVoice","code":"before"},{"text":" rules run outside-in, so whoever ","type":"text"},{"type":"codeVoice","code":"reply"},{"type":"text","text":"s or"},{"type":"text","text":" "},{"code":"refuse","type":"codeVoice"},{"type":"text","text":"s "},{"inlineContent":[{"text":"first","type":"text"}],"type":"strong"},{"text":" wins:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"World "},{"code":"before","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Location ","type":"text"},{"type":"codeVoice","code":"beforeEachTurn"},{"text":", then location ","type":"text"},{"type":"codeVoice","code":"before"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Item "},{"code":"before","type":"codeVoice"},{"type":"text","text":" — indirect object, then direct object"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The game’s ","type":"text"},{"type":"codeVoice","code":"actions"},{"text":" row for that intent","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The engine’s stub line","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"So a "},{"code":"world.before(.dig)","type":"codeVoice"},{"type":"text","text":" pre-empts a "},{"code":"sand.before(.dig)","type":"codeVoice"},{"type":"text","text":". See"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TheTurnPipeline","isActive":true},{"type":"text","text":"."}]},{"level":2,"text":"Reclaiming the word entirely","type":"heading","anchor":"Reclaiming-the-word-entirely"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you want the "},{"inlineContent":[{"text":"word","type":"text"}],"type":"emphasis"},{"type":"text","text":" to mean something else, claim its row. Reclaiming a stub"},{"type":"text","text":" "},{"type":"text","text":"row is silent, unlike reclaiming a core row:"}]},{"type":"codeListing","code":["var verbs: [SyntaxRule] {","    SyntaxRule(\"attack\", .directObject, intent: Intent(\"brawl\"))","}"],"syntax":"swift"},{"level":2,"text":"Notes for engine work","type":"heading","anchor":"Notes-for-engine-work"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The table is split: "},{"code":"coreTable","type":"codeVoice"},{"type":"text","text":" is the rows with real behavior,"},{"type":"text","text":" "},{"type":"codeVoice","code":"stubTable"},{"type":"text","text":" is these, and "},{"code":"standardTable","type":"codeVoice"},{"type":"text","text":" is both. Bootstrap keys"},{"type":"text","text":" "},{"type":"text","text":"its override warning off "},{"code":"coreTable","type":"codeVoice"},{"type":"text","text":", and that split "},{"inlineContent":[{"type":"text","text":"is"}],"type":"emphasis"},{"type":"text","text":" the stub flag."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"A stub’s intent, rows and line are one "},{"code":"StubVerb","type":"codeVoice"},{"type":"text","text":" value, so a stub can’t be"},{"type":"text","text":" "},{"type":"text","text":"half-declared — rows with no line would fall through to stage 4’s last resort,"},{"type":"text","text":" "},{"type":"text","text":"so a word the engine advertises would answer “You can’t do that.” Core verbs"},{"type":"text","text":" "},{"type":"text","text":"have the same shape for the same reason: a "},{"code":"CoreVerb","type":"codeVoice"},{"type":"text","text":" is an intent, its rows"},{"type":"text","text":" "},{"type":"text","text":"and its handler, and both tables and both intent sets are derived from those"},{"type":"text","text":" "},{"type":"text","text":"two arrays rather than restated."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Stub intents are deliberately "},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"type":"text","text":" in "},{"code":"DefaultActions.builtInIntents","type":"codeVoice"},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"is what keeps "},{"code":"action(.dig)","type":"codeVoice"},{"type":"text","text":" from warning. "},{"code":"handledIntents","type":"codeVoice"},{"type":"text","text":" is the union, used"},{"type":"text","text":" "},{"type":"text","text":"for the dead-intent check. "},{"code":"engineIntents","type":"codeVoice"},{"type":"text","text":" is the third set — UNDO, RESTART,"},{"type":"text","text":" "},{"type":"text","text":"SAVE and RESTORE, which "},{"code":"GameWorld.run","type":"codeVoice"},{"type":"text","text":" answers before the pipeline — and an"},{"type":"text","text":" "},{"code":"actions","type":"codeVoice"},{"type":"text","text":" row for one of those warns that it can never run."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"No stub row uses a "},{"code":".topic","type":"codeVoice"},{"text":" slot, and none should. A topic never fails to","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"match, so a low-specificity topic row silently absorbs the scope failures of"},{"type":"text","text":" "},{"type":"text","text":"every more specific row sharing its verb word — "},{"code":"say hello to butler","type":"codeVoice"},{"type":"text","text":" with no"},{"type":"text","text":" "},{"type":"text","text":"butler present would answer a canned line instead of “You can’t see any such"},{"type":"text","text":" "},{"type":"text","text":"thing.”"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"A bare "},{"code":"verb <object>","type":"codeVoice"},{"type":"text","text":" row suppresses the "},{"code":"missingIndirect","type":"codeVoice"},{"type":"text","text":" prompt from any"},{"type":"text","text":" "},{"code":"verb <object> PREP <second object>","type":"codeVoice"},{"type":"text","text":" row on the same verb word, because the"},{"type":"text","text":" "},{"type":"text","text":"parser returns on the first row that "},{"inlineContent":[{"text":"matches","type":"text"}],"type":"emphasis"},{"type":"text","text":" and only falls back to a"},{"type":"text","text":" "},{"type":"text","text":"near-miss when nothing matched. That is why "},{"code":"give","type":"codeVoice"},{"type":"text","text":" and "},{"code":"throw","type":"codeVoice"},{"type":"text","text":" ship"},{"type":"text","text":" "},{"type":"text","text":"second-object-only: "},{"code":"give lamp","type":"codeVoice"},{"type":"text","text":" asking "},{"inlineContent":[{"text":"“What do you want to give the lamp","type":"text"},{"text":" ","type":"text"},{"text":"to?”","type":"text"}],"type":"emphasis"},{"type":"text","text":" beats a canned line."}],"type":"paragraph"}]}]},{"level":2,"text":"See also","type":"heading","anchor":"See-also"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/AddingCustomVerbs","type":"reference","isActive":true}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/WritingRules","type":"reference","isActive":true}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TheTurnPipeline","isActive":true,"type":"reference"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextAndRandomness","isActive":true,"type":"reference"}],"type":"paragraph"}]}]}]}],"abstract":[{"text":"The verbs the parser knows as words even where your game has no mechanic.","type":"text"}],"metadata":{"roleHeading":"Article","role":"article","title":"Stub Verbs","modules":[{"name":"Gnusto"}]},"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto"],["doc:\/\/Gnusto\/documentation\/Gnusto","doc:\/\/Gnusto\/documentation\/Gnusto\/BootstrapDiagnostics"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"seeAlsoSections":[{"title":"Verbs and Intents","identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/AddingCustomVerbs","doc:\/\/Gnusto\/documentation\/Gnusto\/verb(_:_:)","doc:\/\/Gnusto\/documentation\/Gnusto\/SyntaxRule","doc:\/\/Gnusto\/documentation\/Gnusto\/SyntaxElement","doc:\/\/Gnusto\/documentation\/Gnusto\/IntentAction","doc:\/\/Gnusto\/documentation\/Gnusto\/Topic"],"generated":true,"anchor":"Verbs-and-Intents"}],"identifier":{"url":"doc:\/\/Gnusto\/documentation\/Gnusto\/StubVerbs","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnusto\/stubverbs"]}],"references":{"doc://Gnusto/documentation/Gnusto/GameText/stubs":{"kind":"symbol","url":"\/documentation\/gnusto\/gametext\/stubs","abstract":[{"type":"text","text":"The stock replies for the verbs the parser knows as words but the engine"},{"type":"text","text":" "},{"type":"text","text":"gives no mechanic. Re-skin one with "},{"type":"codeVoice","code":"text.stubs.dig = \"…\""},{"type":"text","text":"; give one real"},{"type":"text","text":" "},{"type":"text","text":"behavior with a rule or an "},{"type":"codeVoice","code":"actions"},{"type":"text","text":" row."}],"role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stubs","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6Gnusto8GameTextV","text":"GameText","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:6Gnusto8GameTextV11StubRepliesV","text":"StubReplies","kind":"typeIdentifier"}],"title":"stubs","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/stubs","type":"topic"},"doc://Gnusto/documentation/Gnusto/GameText/StubReplies/yourself":{"title":"yourself","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/StubReplies\/yourself","kind":"symbol","url":"\/documentation\/gnusto\/gametext\/stubreplies\/yourself","role":"symbol","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"yourself","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6Gnusto8GameTextV","text":"GameText","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:6Gnusto8GameTextV4LineV","text":"Line","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:6Gnusto8GameTextV","text":"GameText","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:6Gnusto8GameTextV7NothingV","text":"Nothing","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"type":"text","text":"A stub verb aimed at yourself, where the verb’s own line would have"},{"type":"text","text":" "},{"type":"text","text":"named its object. The player item is called “yourself”, so those"},{"type":"text","text":" "},{"type":"text","text":"lines would read “The yourself is not food.” — one line covers all of"},{"type":"text","text":" "},{"type":"text","text":"them rather than fifteen self-specific variants."}]},"doc://Gnusto/documentation/Gnusto/AddingCustomVerbs":{"kind":"article","url":"\/documentation\/gnusto\/addingcustomverbs","abstract":[{"text":"Teach the parser words the built-in table doesn’t know.","type":"text"}],"role":"article","title":"Adding Custom Verbs","type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/AddingCustomVerbs"},"doc://Gnusto/documentation/Gnusto/GameText/Line":{"role":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Line","abstract":[{"type":"text","text":"One stock line, in whichever shape the game wants it: a fixed sentence,"},{"type":"text","text":" "},{"type":"text","text":"a sentence assembled when it prints, or one that names the thing it is"},{"type":"text","text":" "},{"type":"text","text":"about."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Line","kind":"identifier"}],"navigatorTitle":[{"text":"Line","kind":"identifier"}],"kind":"symbol","type":"topic","title":"GameText.Line","url":"\/documentation\/gnusto\/gametext\/line"},"doc://Gnusto/documentation/Gnusto/BootstrapDiagnostics":{"kind":"article","url":"\/documentation\/gnusto\/bootstrapdiagnostics","abstract":[{"type":"text","text":"Every message the bootstrap can print, and what to change."}],"role":"collectionGroup","title":"Bootstrap Diagnostics","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/BootstrapDiagnostics","type":"topic"},"doc://Gnusto/documentation/Gnusto/refuse(_:)":{"role":"symbol","type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/refuse(_:)","title":"refuse(_:)","abstract":[{"type":"text","text":"Blocks the current action with a complaint. The default action and any"},{"type":"text","text":" "},{"type":"text","text":"remaining "},{"type":"codeVoice","code":"before"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"after"},{"type":"text","text":" rules are skipped; world time still passes."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"refuse","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Never","kind":"typeIdentifier","preciseIdentifier":"s:s5NeverO"}],"kind":"symbol","url":"\/documentation\/gnusto\/refuse(_:)"},"doc://Gnusto/documentation/Gnusto/reply(_:)":{"role":"symbol","type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/reply(_:)","title":"reply(_:)","abstract":[{"type":"text","text":"Fully handles the current action with a response, skipping the default"},{"type":"text","text":" "},{"type":"text","text":"behavior. Mechanically identical to "},{"type":"codeVoice","code":"refuse(_:)"},{"type":"text","text":" — two names exist so"},{"type":"text","text":" "},{"type":"text","text":"game code reads correctly: "},{"type":"codeVoice","code":"refuse"},{"type":"text","text":" for “no, you can’t”, "},{"type":"codeVoice","code":"reply"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"“here’s what happens instead”."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reply","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Never","kind":"typeIdentifier","preciseIdentifier":"s:s5NeverO"}],"kind":"symbol","url":"\/documentation\/gnusto\/reply(_:)"},"doc://Gnusto/documentation/Gnusto/IntentAction":{"kind":"symbol","url":"\/documentation\/gnusto\/intentaction","abstract":[{"type":"text","text":"A replacement or new stage-4 default action for one intent — the seam"},{"type":"text","text":" "},{"type":"text","text":"that lets a game or plugin give a custom verb real behavior instead of"},{"type":"text","text":" "},{"type":"text","text":"“I didn’t understand”, or replace a built-in’s default entirely."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"IntentAction"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IntentAction"}],"title":"IntentAction","type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/IntentAction"},"doc://Gnusto/documentation/Gnusto/WritingRules":{"role":"article","type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/WritingRules","title":"Writing Rules","abstract":[{"type":"text","text":"Attach game logic to items, locations, and the world."}],"kind":"article","url":"\/documentation\/gnusto\/writingrules"},"doc://Gnusto/documentation/Gnusto/SyntaxElement":{"title":"SyntaxElement","abstract":[{"text":"One element of a verb pattern: a literal word the player must type, or a","type":"text"},{"text":" ","type":"text"},{"text":"slot the parser fills from the rest of the sentence. String literals in a","type":"text"},{"text":" ","type":"text"},{"text":"pattern are ","type":"text"},{"code":".word","type":"codeVoice"},{"text":"s, so rows read the way they’re typed:","type":"text"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"SyntaxElement"}],"role":"symbol","url":"\/documentation\/gnusto\/syntaxelement","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"SyntaxElement"}],"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/SyntaxElement"},"doc://Gnusto/documentation/Gnusto/GameText/StubReplies/somebodyElse":{"title":"somebodyElse","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/StubReplies\/somebodyElse","kind":"symbol","url":"\/documentation\/gnusto\/gametext\/stubreplies\/somebodyelse","role":"symbol","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"somebodyElse","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6Gnusto8GameTextV","text":"GameText","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:6Gnusto8GameTextV4LineV","text":"Line","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:6Gnusto8GameTextV","text":"GameText","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:6Gnusto8GameTextV4NounV","text":"Noun","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"type":"text","text":"A stub verb aimed at somebody else, where the verb would otherwise"},{"type":"text","text":" "},{"type":"text","text":"have reported a completed act on a person — “The cook is not food.”,"},{"type":"text","text":" "},{"type":"text","text":"“You feel nothing out of the ordinary.” about a witness. Every stub"},{"type":"text","text":" "},{"type":"text","text":"that has to "},{"type":"emphasis","inlineContent":[{"text":"reach","type":"text"}]},{"type":"text","text":" its object goes through this, so one line covers"},{"type":"text","text":" "},{"type":"text","text":"all of them, the way "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/StubReplies\/yourself"},{"type":"text","text":" does."}]},"doc://Gnusto/documentation/Gnusto/TextAndRandomness":{"abstract":[{"text":"Re-skin the engine’s stock lines, and roll dice that replay.","type":"text"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextAndRandomness","type":"topic","title":"Text and Randomness","kind":"article","url":"\/documentation\/gnusto\/textandrandomness","role":"article"},"doc://Gnusto/documentation/Gnusto/Topic":{"url":"\/documentation\/gnusto\/topic","type":"topic","title":"Topic","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Topic"}],"abstract":[{"text":"What the player wants to talk about: the words after “about”, normalized","type":"text"},{"text":" ","type":"text"},{"text":"the way the parser normalizes everything else — lowercased, punctuation","type":"text"},{"text":" ","type":"text"},{"text":"dropped, filler stripped.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"Topic","kind":"identifier"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Topic"},"doc://Gnusto/documentation/Gnusto/GameText/cantReach":{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/cantReach","title":"cantReach","abstract":[{"text":"The item resolved (it was visible to the parser), but a reachability","type":"text"},{"text":" ","type":"text"},{"text":"guard failed — you can see it, you just can’t touch it (e.g. through a","type":"text"},{"text":" ","type":"text"},{"text":"shut glass jar). Distinct from ","type":"text"},{"code":"cantSeeAnySuchThing","type":"codeVoice"},{"text":", which is for a","type":"text"},{"text":" ","type":"text"},{"text":"noun that isn’t in scope at all.","type":"text"}],"role":"symbol","url":"\/documentation\/gnusto\/gametext\/cantreach","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cantReach","kind":"identifier"},{"text":": ","kind":"text"},{"text":"GameText","preciseIdentifier":"s:6Gnusto8GameTextV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Line","preciseIdentifier":"s:6Gnusto8GameTextV4LineV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"GameText","preciseIdentifier":"s:6Gnusto8GameTextV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Noun","preciseIdentifier":"s:6Gnusto8GameTextV4NounV","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol","type":"topic"},"doc://Gnusto/documentation/Gnusto":{"role":"collection","abstract":[{"type":"text","text":"An engine for writing interactive fiction in Swift."}],"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto","kind":"symbol","title":"Gnusto","url":"\/documentation\/gnusto"},"doc://Gnusto/documentation/Gnusto/TheTurnPipeline":{"abstract":[{"text":"What happens between the player pressing Return and the next prompt.","type":"text"}],"title":"The Turn Pipeline","kind":"article","type":"topic","role":"article","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TheTurnPipeline","url":"\/documentation\/gnusto\/theturnpipeline"},"doc://Gnusto/documentation/Gnusto/SyntaxRule":{"role":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/SyntaxRule","abstract":[{"type":"text","text":"One row of the verb table: a pattern of literal words and slots, and the"},{"type":"text","text":" "},{"type":"text","text":"intent a match produces. Data, not code — games can add rows through their"},{"type":"text","text":" "},{"type":"codeVoice","code":"verbs"},{"type":"text","text":" block to teach the parser new player-typeable verbs."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SyntaxRule","kind":"identifier"}],"navigatorTitle":[{"text":"SyntaxRule","kind":"identifier"}],"kind":"symbol","type":"topic","title":"SyntaxRule","url":"\/documentation\/gnusto\/syntaxrule"},"doc://Gnusto/documentation/Gnusto/verb(_:_:)":{"url":"\/documentation\/gnusto\/verb(_:_:)","type":"topic","title":"verb(_:_:)","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Declares a custom player-typeable verb in one place: a typed intent"},{"type":"text","text":" "},{"type":"text","text":"constant plus the verb rows that produce it."}],"fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"verb"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", ["},{"kind":"typeIdentifier","text":"SyntaxElement","preciseIdentifier":"s:6Gnusto13SyntaxElementO"},{"kind":"text","text":"]...)"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/verb(_:_:)"}}}