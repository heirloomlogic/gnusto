{"kind":"symbol","abstract":[{"text":"True if this item is a door — the front door, the trap door, the grating.","type":"text"}],"metadata":{"roleHeading":"Instance Property","role":"symbol","modules":[{"name":"Gnusto"}],"externalID":"s:6Gnusto4ItemV6isDoorSbvp","symbolKind":"property","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isDoor"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"title":"isDoor"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isDoor"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"platforms":["macOS"]}],"kind":"declarations"},{"mentions":["doc:\/\/Gnusto\/documentation\/Gnusto\/ContainersDoorsAndLocks"],"kind":"mentions"},{"content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Either the map says so, by hanging a way through on the thing"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"hall.north(garden, via: frontDoor)"},{"type":"text","text":"), or the item declares "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/door"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The first covers every door a player can walk through, which is why most"},{"type":"text","text":" "},{"type":"text","text":"games never declare the second."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It answers the same for every room, which is deliberate. A rule that"},{"type":"text","text":" "},{"type":"text","text":"wants “a door "},{"type":"emphasis","inlineContent":[{"text":"here","type":"text"}]},{"text":"” — the one the player could walk through from where","type":"text"},{"text":" ","type":"text"},{"text":"they stand — wants the room’s exits, not this. What this is for is the","type":"text"},{"text":" ","type":"text"},{"text":"question a verb asks about the thing in front of it: knocking on a door","type":"text"},{"text":" ","type":"text"},{"text":"is a different act from knocking on a bench, wherever either is standing.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"variants":[{"paths":["\/documentation\/gnusto\/item\/isdoor"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto","doc:\/\/Gnusto\/documentation\/Gnusto\/Item"]]},"identifier":{"url":"doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/isDoor","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://Gnusto/documentation/Gnusto/door":{"url":"\/documentation\/gnusto\/door","type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/door","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"door"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ItemTrait","preciseIdentifier":"s:6Gnusto9ItemTraitV"}],"kind":"symbol","title":"door","abstract":[{"text":"The item is a door — something a verb may reasonably treat as a way through","type":"text"},{"text":" ","type":"text"},{"text":"rather than as a thing.","type":"text"}]},"doc://Gnusto/documentation/Gnusto/Item/isDoor":{"kind":"symbol","abstract":[{"text":"True if this item is a door — the front door, the trap door, the grating.","type":"text"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/isDoor","type":"topic","title":"isDoor","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isDoor"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"role":"symbol","url":"\/documentation\/g