{"abstract":[{"type":"text","text":"True if this item is a door — the front door, the trap door, the grating."}],"identifier":{"url":"doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/isDoor","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnusto\/item\/isdoor"]}],"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto","doc:\/\/Gnusto\/documentation\/Gnusto\/Item"]]},"metadata":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isDoor","kind":"identifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"externalID":"s:6Gnusto4ItemV6isDoorSbvp","roleHeading":"Instance Property","modules":[{"name":"Gnusto"}],"symbolKind":"property","role":"symbol","title":"isDoor"},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isDoor","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"mentions":["doc:\/\/Gnusto\/documentation\/Gnusto\/ContainersDoorsAndLocks"],"kind":"mentions"},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Either the map says so, by hanging a way through on the thing"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"hall.north(garden, via: frontDoor)"},{"type":"text","text":"), or the item declares "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/door"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The first covers every door a player can walk through, which is why most"},{"type":"text","text":" "},{"type":"text","text":"games never declare the second."}],"type":"paragraph"},{"inlineContent":[{"text":"It answers the same for every room, which is deliberate. A rule that","type":"text"},{"text":" ","type":"text"},{"text":"wants “a door ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"here"}]},{"type":"text","text":"” — the one the player could walk through from where"},{"type":"text","text":" "},{"type":"text","text":"they stand — wants the room’s exits, not this. What this is for is the"},{"type":"text","text":" "},{"type":"text","text":"question a verb asks about the thing in front of it: knocking on a door"},{"type":"text","text":" "},{"type":"text","text":"is a different act from knocking on a bench, wherever either is standing."}],"type":"paragraph"}]}],"references":{"doc://Gnusto/documentation/Gnusto/Item/isDoor":{"role":"symbol","abstract":[{"text":"True if this item is a door — the front door, the trap door, the grating.","type":"text"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/isDoor","type":"topic","kind":"symbol","url":"\/documentation\/gnusto\/item\/isdoor","title":"isDoor","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isDoor","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}]},"doc://Gnusto/documentation/Gnusto/ContainersDoorsAndLocks":{"abstract":[{"type":"text","text":"Hold things, open and close, lock with keys, and gate the map."}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/ContainersDoorsAndLocks","role":"article","kind":"article","url":"\/documentation\/gnusto\/containersdoorsandlocks","title":"Containers, Doors, and Locks","type":"topic"},"doc://Gnusto/documentation/Gnusto/Item":{"title":"Item","type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Item","abstract":[{"text":"A thing in the world.","type":"text"}],"url":"\/documentation\/gnusto\/item","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Item","kind":"identifier"}],"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"Item","kind":"identifier"}]},"doc://Gnusto/documentation/Gnusto":{"url":"\/documentation\/gnusto","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto","title":"Gnusto","abstract":[{"text":"A Swift engine for writing parser-driven interactive fiction — text adventures in the tradition of Zork and Infocom’s ZIL.","type":"text"}],"role":"collection","kind":"symbol","type":"topic"},"doc://Gnusto/documentation/Gnusto/door":{"type":"topic","title":"door","kind":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/door","url":"\/documentation\/gnusto\/door","abstract":[{"type":"text","text":"The item is a door — something a verb may reasonably treat as a way through"},{"type":"text","text":" "},{"type":"text","text":"rather than as a thing."}],"role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"door"},{"kind":"text","text":": "},{"preciseIdentifier":"s:6Gnusto9ItemTraitV","kind":"typeIdentifier","text":"ItemTrait"}]}}}