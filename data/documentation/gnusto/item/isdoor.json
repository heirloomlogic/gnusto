{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnusto\/item\/isdoor"]}],"metadata":{"title":"isDoor","role":"symbol","externalID":"s:6Gnusto4ItemV6isDoorSbvp","symbolKind":"property","modules":[{"name":"Gnusto"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isDoor","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"roleHeading":"Instance Property"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/isDoor"},"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto","doc:\/\/Gnusto\/documentation\/Gnusto\/Item"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"True if this item is a door — the front door, the trap door, the grating.","type":"text"}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isDoor","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}]}]},{"mentions":["doc:\/\/Gnusto\/documentation\/Gnusto\/ContainersDoorsAndLocks"],"kind":"mentions"},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Either the map says so, by hanging a way through on the thing"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"hall.north(garden, via: frontDoor)","type":"codeVoice"},{"type":"text","text":"), or the item declares "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/door"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The first covers every door a player can walk through, which is why most"},{"type":"text","text":" "},{"type":"text","text":"games never declare the second."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It answers the same for every room, which is deliberate. A rule that"},{"type":"text","text":" "},{"type":"text","text":"wants “a door "},{"type":"emphasis","inlineContent":[{"text":"here","type":"text"}]},{"text":"” — the one the player could walk through from where","type":"text"},{"type":"text","text":" "},{"type":"text","text":"they stand — wants the room’s exits, not this. What this is for is the"},{"type":"text","text":" "},{"type":"text","text":"question a verb asks about the thing in front of it: knocking on a door"},{"type":"text","text":" "},{"type":"text","text":"is a different act from knocking on a bench, wherever either is standing."}]}]}],"sections":[],"references":{"doc://Gnusto/documentation/Gnusto/ContainersDoorsAndLocks":{"role":"article","abstract":[{"text":"Hold things, open and close, lock with keys, and gate the map.","type":"text"}],"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/ContainersDoorsAndLocks","url":"\/documentation\/gnusto\/containersdoorsandlocks","title":"Containers, Doors, and Locks","kind":"article"},"doc://Gnusto/documentation/Gnusto/door":{"type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"door","kind":"identifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto9ItemTraitV","text":"ItemTrait"}],"title":"door","kind":"symbol","abstract":[{"type":"text","text":"The item is a door — something a verb may reasonably treat as a way through"},{"type":"text","text":" "},{"type":"text","text":"rather than as a thing."}],"role":"symbol","url":"\/documentation\/gnusto\/door","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/door"},"doc://Gnusto/documentation/Gnusto/Item/isDoor":{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/isDoor","title":"isDoor","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isDoor","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"url":"\/documentation\/gnusto\/item\/isdoor","abstract":[{"text":"True if this item is a door — the front door, the trap door, the grating.","type":"text"}],"role":"symbol","type":"topic"},"doc://Gnusto/documentation/Gnusto/Item":{"role":"symbol","navigatorTitle":[{"text":"Item","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Item","title":"Item","abstract":[{"type":"text","text":"A thing in the world."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Item","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/gnusto\/item"},"doc://Gnusto/documentation/Gnusto":{"role":"collection","abstract":[{"type":"text","text":"An engine for writing interactive fiction in Swift."}],"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto","kind":"symbol","title":"Gnusto","url":"\/documentation\/gnusto"}}}