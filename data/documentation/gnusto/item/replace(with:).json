{"metadata":{"roleHeading":"Instance Method","role":"symbol","modules":[{"name":"Gnusto"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"replace","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"with"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Item","preciseIdentifier":"s:6Gnusto4ItemV"},{"text":")","kind":"text"}],"symbolKind":"method","title":"replace(with:)","externalID":"s:6Gnusto4ItemV7replace4withyAC_tF"},"variants":[{"paths":["\/documentation\/gnusto\/item\/replace(with:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto","doc:\/\/Gnusto\/documentation\/Gnusto\/Item"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"replace","kind":"identifier"},{"text":"(","kind":"text"},{"text":"with","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"other","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Item","kind":"typeIdentifier","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Item","preciseIdentifier":"s:6Gnusto4ItemV"},{"text":")","kind":"text"}],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The item to put in this one’s place.","type":"text"}]}],"name":"other"}]},{"kind":"mentions","mentions":["doc:\/\/Gnusto\/documentation\/Gnusto\/WritingRules"]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Prefer it over "},{"type":"codeVoice","code":"vanish()"},{"text":" plus a ","type":"text"},{"type":"codeVoice","code":"move"},{"text":", which cannot do the same job.","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/location"},{"text":" answers the ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"room","type":"text"}]},{"text":" an item is in, which is all a ","type":"text"},{"type":"codeVoice","code":"move(to:)"},{"text":" ","type":"text"},{"text":"can aim at — so a hand-rolled swap drops the replacement on the floor","type":"text"},{"text":" ","type":"text"},{"text":"when the original was sitting in a sack. The placement itself is what","type":"text"},{"text":" ","type":"text"},{"text":"carries across here, hands and containers included.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"other"},{"text":" inherits the placement and nothing else. It does not inherit","type":"text"},{"text":" ","type":"text"},{"text":"worn state, so replacing something you are wearing leaves you holding","type":"text"},{"text":" ","type":"text"},{"text":"the replacement rather than wearing it. Contents do not come across","type":"text"},{"text":" ","type":"text"},{"text":"either: whatever was inside this item leaves play with it, so a caller","type":"text"},{"text":" ","type":"text"},{"text":"meaning to salvage cargo moves it out first.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Like ","type":"text"},{"type":"codeVoice","code":"vanish()"},{"text":", and unlike ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/move(to:)","type":"reference","isActive":true},{"text":", this does not carry a","type":"text"},{"text":" ","type":"text"},{"text":"boarded player — a vehicle swapped out from under its passenger leaves","type":"text"},{"text":" ","type":"text"},{"text":"them standing where they were.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Replacing an item with itself does nothing.","type":"text"}],"type":"paragraph"}]}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/replace(with:)","interfaceLanguage":"swift"},"kind":"symbol","abstra