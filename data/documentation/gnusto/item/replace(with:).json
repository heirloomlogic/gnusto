:", this does not carry a"},{"type":"text","text":" "},{"type":"text","text":"boarded player — a vehicle swapped out from under its passenger leaves"},{"type":"text","text":" "},{"type":"text","text":"them standing where they were."}],"type":"paragraph"},{"inlineContent":[{"text":"Replacing an item with itself does nothing.","type":"text"}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/gnusto\/item\/replace(with:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Gnusto/documentation/Gnusto/Item/replace(with:)":{"role":"symbol","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"replace","kind":"identifier"},{"text":"(","kind":"text"},{"text":"with","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto4ItemV","text":"Item"},{"kind":"text","text":")"}],"type":"topic","title":"replace(with:)","abstract":[{"type":"text","text":"Puts "},{"code":"other","type":"codeVoice"},{"type":"text","text":" exactly where this item is — the same room, hands,"},{"type":"text","text":" "},{"type":"text","text":"container or surface — and takes this one out of play. One thing"},{"type":"text","text":" "},{"type":"text","text":"becoming another: the boat for the punctured boat, the coal for the"},{"type":"text","text":" "},{"type":"text","text":"diamond, the gnome for the hole he left."}],"url":"\/documentation\/gnusto\/item\/replace(with:)","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/replace(with:)"},"doc://Gnusto/documentation/Gnusto/WritingRules":{"url":"\/documentation\/gnusto\/writingrules","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/WritingRules","abstract":[{"text":"Attach game logic to items, locations, and the world.","type":"text"}],"title":"Writing Rules","type":"topic","kind":"article","role":"article"},"doc://Gnusto/documentation/Gnusto/Item/move(to:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text"