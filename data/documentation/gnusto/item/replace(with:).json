nd the sack a placement under itself, and a containment","type":"text"},{"text":" ","type":"text"},{"text":"cycle shows itself far from the line that built it.","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnusto\/item\/replace(with:)"]}],"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto","doc:\/\/Gnusto\/documentation\/Gnusto\/Item"]]},"abstract":[{"type":"text","text":"Puts "},{"code":"other","type":"codeVoice"},{"type":"text","text":" exactly where this item is — the same room, hands,"},{"type":"text","text":" "},{"type":"text","text":"container or surface — and takes this one out of play. One thing"},{"type":"text","text":" "},{"type":"text","text":"becoming another: the boat for the punctured boat, the coal for the"},{"type":"text","text":" "},{"type":"text","text":"diamond, the gnome for the hole he left."}],"sections":[],"kind":"symbol","references":{"doc://Gnusto/documentation/Gnusto/Item/replace(with:)":{"abstract":[{"text":"Puts ","type":"text"},{"code":"other","type":"codeVoice"},{"text":" exactly where this item is — the same room, hands,","type":"text"},{"text":" ","type":"text"},{"text":"container or surface — and takes this one out of play. One thing","type":"text"},{"text":" ","type":"text"},{"text":"becoming another: the boat for the punctured boat, the coal for the","type":"text"},{"text":" ","type":"text"},{"text":"diamond, the gnome for the hole he left.","type":"text"}],"title":"replace(with:)","kind":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/replace(with:)","url":"\/documentation\/gnusto\/item\/replace(with:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"replace","kind":"identifier"},{"text":"(","kind":"text"},{"text":"with","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Item","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto4ItemV"},{"text":")","kind":"text"}],"r