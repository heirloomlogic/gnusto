ifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/move(to:)","isActive":true},{"type":"text","text":", this does not carry a"},{"type":"text","text":" "},{"text":"boarded player — a vehicle swapped out from under its passenger leaves","type":"text"},{"type":"text","text":" "},{"type":"text","text":"them standing where they were."}]},{"inlineContent":[{"type":"text","text":"Replacing an item with itself does nothing."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"references":{"doc://Gnusto/documentation/Gnusto/Item/move(to:)":{"type":"topic","title":"move(to:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"move","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Location","preciseIdentifier":"s:6Gnusto8LocationV","kind":"typeIdentifier"},{"text":")","kind":"text"}],"url":"\/documentation\/gnusto\/item\/move(to:)","abstract":[{"text":"Moves the item directly to a location, bypassing the usual actions.","type":"text"}],"role":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/move(to:)"},"doc://Gnusto/documentation/Gnusto/WritingRules":{"role":"article","type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/WritingRules","title":"Writing Rules","abstract":[{"type":"text","text":"Attach game logic to items, locations, and the world."}],"kind":"article","url":"\/documentation\/gnusto\/writingrules"},"doc://Gnusto/documentation/Gnusto/Item":{"role":"symbol","navigatorTitle":[{"text":"Item","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Item","title":"Item","abstract":[{"type":"text","text":"A thing in the world."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Item","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/gnusto\/item"},"doc://Gnusto/documentation/Gnusto/Item/replace(with:)":{"fragments":[{"text":"func","ki