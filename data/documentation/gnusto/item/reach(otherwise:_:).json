{"identifier":{"url":"doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/reach(otherwise:_:)","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reach"},{"kind":"text","text":"("},{"kind":"externalParam","text":"otherwise"},{"kind":"text","text":" "},{"kind":"internalParam","text":"refusal"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"body"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () -> "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:6Gnusto4RuleV","kind":"typeIdentifier","text":"Rule","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Rule"}],"platforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The line shown when the closure says no. Defaults to the"},{"type":"text","text":" "},{"type":"text","text":"stock "},{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/cantReach","isActive":true},{"type":"text","text":"."}]}],"name":"refusal"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The closure answering “can they touch it from here”."}]}],"name":"body"}],"kind":"parameters"},{"content":[{"level":2,"text":"Return Value","anchor":"return-value","type":"heading"},{"inlineContent":[{"type":"text","text":"The assembled reach rule."}],"type":"paragraph"}],"kind":"content"},{"mentions":["doc:\/\/Gnusto\/documentation\/Gnusto\/ContainersDoorsAndLocks","doc:\/\/Gnusto\/documentation\/Gnusto\/TheTurnPipeline","doc:\/\/Gnusto\/documentation\/Gnusto\/WritingRules"],"kind":"mentions"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"syntax":"swift","code":["card.reach(otherwise: \"The card is squares away from you, across the sand.\") {","    grid.playerSquare == grid.cardSquare","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Containment is room-granular: a thing lying in one square of a floor the"},{"type":"text","text":" "},{"type":"text","text":"map models as a single room is “in the room” from every square, and so"},{"type":"text","text":" "},{"type":"text","text":"reachable from every square. This is where a game says otherwise, once,"},{"type":"text","text":" "},{"type":"text","text":"instead of guarding "},{"type":"codeVoice","code":"take"},{"type":"text","text":", "},{"type":"codeVoice","code":"open"},{"type":"text","text":" and "},{"type":"codeVoice","code":"put in"},{"type":"text","text":" one verb at a time."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It narrows reach and nothing else. The item stays "},{"type":"strong","inlineContent":[{"type":"text","text":"visible"}]},{"type":"text","text":" — the"},{"type":"text","text":" "},{"type":"text","text":"player can still name it, examine it and read about it in the room"},{"type":"text","text":" "},{"type":"text","text":"description — which is what makes "},{"type":"codeVoice","code":"take"},{"type":"text","text":" answer “it’s across the sand”"},{"type":"text","text":" "},{"type":"text","text":"rather than “you can’t see any such thing”."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Two things the engine settles so the closure doesn’t have to. What the"},{"type":"text","text":" "},{"type":"text","text":"asker is "},{"type":"strong","inlineContent":[{"type":"text","text":"holding"}]},{"type":"text","text":" always passes, so a rule keyed to a square can’t"},{"type":"text","text":" "},{"type":"text","text":"stop the player opening a box they are carrying. And the rule is"},{"type":"text","text":" "},{"type":"text","text":"consulted "},{"type":"strong","inlineContent":[{"type":"text","text":"before any "},{"type":"codeVoice","code":"before"},{"type":"text","text":" rule runs"}]},{"type":"text","text":", so an item’s own rules never"},{"type":"text","text":" "},{"type":"text","text":"fire for something out of reach."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Declared in a "},{"type":"codeVoice","code":"rules"},{"type":"text","text":" block; a second "},{"type":"codeVoice","code":"reach"},{"type":"text","text":" rule for the same entity is"},{"type":"text","text":" "},{"type":"text","text":"a fatal bootstrap diagnostic. Locations don’t take one."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto","doc:\/\/Gnusto\/documentation\/Gnusto\/Item"]]},"metadata":{"title":"reach(otherwise:_:)","modules":[{"name":"Gnusto"}],"externalID":"s:6Gnusto4ItemV5reach9otherwise_AA4RuleVSSSg_SbyYbctF","symbolKind":"method","roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reach"},{"kind":"text","text":"("},{"kind":"externalParam","text":"otherwise"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?, () -> "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:6Gnusto4RuleV","kind":"typeIdentifier","text":"Rule"}],"role":"symbol"},"abstract":[{"text":"Whether the player can put a hand on this from where they are standing —","type":"text"},{"text":" ","type":"text"},{"text":"asked by the engine on top of containment, wherever a verb needs to","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"touch"}],"type":"emphasis"},{"text":" the thing:","type":"text"}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/Gnusto\/docu