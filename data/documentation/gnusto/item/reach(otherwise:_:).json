{"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto","doc:\/\/Gnusto\/documentation\/Gnusto\/Item"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reach","kind":"identifier"},{"text":"(","kind":"text"},{"text":"otherwise","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"refusal","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"body","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"@escaping ","kind":"attribute"},{"text":"@Sendable","kind":"attribute"},{"text":" () -> ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Rule","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Rule","preciseIdentifier":"s:6Gnusto4RuleV","kind":"typeIdentifier"}],"languages":["swift"]}]},{"parameters":[{"content":[{"inlineContent":[{"text":"The line shown when the closure says no. Defaults to the","type":"text"},{"text":" ","type":"text"},{"text":"stock ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/cantReach","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"refusal"},{"content":[{"inlineContent":[{"type":"text","text":"The closure answering “can they touch it from here”."}],"type":"paragraph"}],"name":"body"}],"kind":"parameters"},{"kind":"content","content":[{"text":"Return Value","type":"heading","level":2,"anchor":"return-value"},{"inlineContent":[{"text":"The assembled reach rule.","type":"text"}],"type":"paragraph"}]},{"kind":"mentions","mentions":["doc:\/\/Gnusto\/documentation\/Gnusto\/ContainersDoorsAndLocks","doc:\/\/Gnusto\/documentation\/Gnusto\/TheTurnPipeline","doc:\/\/Gnusto\/documentation\/Gnusto\/WritingRules"]},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"syntax":"swift","code":["card.reach(otherwise: \"The card is squares away from you, across the sand.\") {","    grid.playerSquare == grid.cardSquare","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Containment is room-granular: a thing lying in one square of a floor the"},{"type":"text","text":" "},{"type":"text","text":"map models as a single room is “in the room” from every square, and so"},{"type":"text","text":" "},{"type":"text","text":"reachable from every square. This is where a game says otherwise, once,"},{"type":"text","text":" "},{"type":"text","text":"instead of guarding "},{"type":"codeVoice","code":"take"},{"type":"text","text":", "},{"type":"codeVoice","code":"open"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"put in"},{"text":" one verb at a time.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It narrows reach and nothing else. The item stays "},{"type":"strong","inlineContent":[{"text":"visible","type":"text"}]},{"type":"text","text":" — the"},{"type":"text","text":" "},{"type":"text","text":"player can still name it, examine it and read about it in the room"},{"type":"text","text":" "},{"type":"text","text":"description — which is what makes "},{"code":"take","type":"codeVoice"},{"type":"text","text":" answer “it’s across the sand”"},{"type":"text","text":" "},{"type":"text","text":"rather than “you can’t see any such thing”."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two things the engine settles so the closure doesn’t have to. What the"},{"type":"text","text":" "},{"type":"text","text":"asker "},{"type":"strong","inlineContent":[{"type":"text","text":"carries"}]},{"type":"text","text":" passes without the closure being asked — in their"},{"type":"text","text":" "},{"type":"text","text":"hands, or on or inside something they are carrying, to any depth — so a"},{"type":"text","text":" "},{"type":"text","text":"rule keyed to a square can’t stop the player opening a box they are"},{"type":"text","text":" "},{"type":"text","text":"carrying, or taking the card out of it. And the rule is"},{"type":"text","text":" "},{"type":"text","text":"consulted "},{"type":"strong","inlineContent":[{"text":"before any ","type":"text"},{"code":"before","type":"codeVoice"},{"text":" rule runs","type":"text"}]},{"type":"text","text":", so an item’s own rules never"},{"type":"text","text":" "},{"text":"fire for something out of reach.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Declared in a "},{"type":"codeVoice","code":"rules"},{"type":"text","text":" block; a second "},{"type":"codeVoice","code":"reach"},{"type":"text","text":" rule for the same entity is"},{"type":"text","text":" "},{"type":"text","text":"a fatal bootstrap diagnostic. Locations don’t take one."}]}]}],"seeAlsoSections":[{"title":"Containers, Doors, and Locks","identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/ContainersDoorsAndLocks","doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/lockedBy(_:)","doc:\/\/Gnusto\/documentation\/Gnusto\/startsUnlocked","doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/isOpen","doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/isLocked","doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/isReachable","doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/isReachable(from:)","doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/isVisible","doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/reveal()","doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/isRevealed"],"anchor":"Containers-Doors-and-Locks","generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnusto\/item\/reach(otherwise:_:)"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"metadata":{"role":"symbol","title":"reach(otherwise:_:)","symbolKind":"method","externalID":"s:6Gnusto4ItemV5reach9otherw