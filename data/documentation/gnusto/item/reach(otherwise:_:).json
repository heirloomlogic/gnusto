{"sections":[],"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto","doc:\/\/Gnusto\/documentation\/Gnusto\/Item"]]},"kind":"symbol","identifier":{"url":"doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/reach(otherwise:_:)","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reach","kind":"identifier"},{"text":"(","kind":"text"},{"text":"otherwise","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"refusal","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"? = nil, ","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"body","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"@escaping ","kind":"attribute"},{"text":"@Sendable","kind":"attribute"},{"text":" () -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Rule","text":"Rule","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto4RuleV"}]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"The line shown when the closure says no. Defaults to the","type":"text"},{"text":" ","type":"text"},{"text":"stock ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/cantReach","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"refusal"},{"content":[{"inlineContent":[{"text":"The closure answering “can they touch it from here”.","type":"text"}],"type":"paragraph"}],"name":"body"}]},{"kind":"content","content":[{"type":"heading","text":"Return Value","level":2,"anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"The assembled reach rule.","type":"text"}]}]},{"kind":"mentions","mentions":["doc:\/\/Gnusto\/documentation\/Gnusto\/ContainersDoorsAndLocks","doc:\/\/Gnusto\/documentation\/Gnusto\/TheTurnPipeline","doc:\/\/Gnusto\/documentation\/Gnusto\/WritingRules"]},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"codeListing","syntax":"swift","code":["card.reach(otherwise: \"The card is squares away from you, across the sand.\") {","    grid.playerSquare == grid.cardSquare","}"]},{"type":"paragraph","inlineContent":[{"text":"Containment is room-granular: a thing lying in one square of a floor the","type":"text"},{"text":" ","type":"text"},{"text":"map models as a single room is “in the room” from every square, and so","type":"text"},{"text":" ","type":"text"},{"text":"reachable from every square. This is where a game says otherwise, once,","type":"text"},{"text":" ","type":"text"},{"text":"instead of guarding ","type":"text"},{"type":"codeVoice","code":"take"},{"text":", ","type":"text"},{"type":"codeVoice","code":"open"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"put in"},{"text":" one verb at a time.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"It narrows reach and nothing else. The item stays ","type":"text"},{"inlineContent":[{"text":"visible","type":"text"}],"type":"strong"},{"text":" — the","type":"text"},{"text":" ","type":"text"},{"text":"player can still name it, examine it and read about it in the room","type":"text"},{"text":" ","type":"text"},{"text":"description — which is what makes ","type":"text"},{"type":"codeVoice","code":"take"},{"text":" answer “it’s across the sand”","type":"text"},{"text":" ","type":"text"},{"text":"rather than “you can’t see any such thing”.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Two things the engine settles so the closure doesn’t have to. What the","type":"text"},{"text":" ","type":"text"},{"text":"asker ","type":"text"},{"inlineContent":[{"text":"carries","type":"text"}],"type":"strong"},{"text":" passes without the closure being asked — in their","type":"text"},{"text":" ","type":"text"},{"text":"hands, or on or inside something they are carrying, to any depth — so a","type":"text"},{"text":" ","type":"text"},{"text":"rule keyed to a square can’t stop the player opening a box they are","type":"text"},{"text":" ","type":"text"},{"text":"carrying, or taking the card out of it. And the rule is","type":"text"},{"text":" ","type":"text"},{"text":"consulted ","type":"text"},{"inlineContent":[{"text":"before any ","type":"text"},{"code":"before","type":"codeVoice"},{"text":" rule runs","type":"text"}],"type":"strong"},{"text":", so an item’s own rules never","type":"text"},{"text":" ","type":"text"},{"text":"fire for something out of reach.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Declared in a ","type":"text"},{"code":"rules","type":"codeVoice"},{"text":" block; a second ","type":"text"},{"code":"reach","type":"codeVoice"},{"text":" rule for the same entity is","type":"text"},{"text":" ","type":"text"},{"text":"a fatal bootstrap diagnostic. Locations don’t take one.","type":"text"}]}]}],"metadata":{"modules":[{"name":"Gnusto"}],"title":"reach(otherwise:_:)","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reach","kind":"identifier"},{"text":"(","kind":"text"},{"text":"otherwise","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, () -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":") -> ","kind":"text"},{"text":"Rule","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto4RuleV"}],"role":"symbol","roleHeading":"Instance Method","externalID":"s:6Gnusto4ItemV5reach9otherwise_AA4RuleVSSSg_SbyYbctF"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnusto\/item\/reach(otherwise:_:)"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstra