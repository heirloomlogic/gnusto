ctive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TerminalIOHandler","type":"reference"},{"type":"text","text":" says"},{"type":"text","text":" "},{"code":"true","type":"codeVoice"},{"type":"text","text":"."}],"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler\/wantsCompletions","kind":"symbol"},"doc://Gnusto/documentation/Gnusto":{"kind":"symbol","abstract":[{"type":"text","text":"An engine for writing interactive fiction in Swift."}],"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto","url":"\/documentation\/gnusto","title":"Gnusto","role":"collection"},"doc://Gnusto/documentation/Gnusto/REPL":{"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"REPL"}],"navigatorTitle":[{"kind":"identifier","text":"REPL"}],"kind":"symbol","url":"\/documentation\/gnusto\/repl","title":"REPL","abstract":[{"type":"text","text":"The outer loop: prompt → parse → perform → print, until the game ends or"},{"type":"text","text":" "},{"type":"text","text":"input runs out. Holds the only "},{"type":"codeVoice","code":"await"},{"type":"text","text":" in a Gnusto game."}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/REPL"},"doc://Gnusto/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/Gnusto\/s16SendableMetatypeP"}}}