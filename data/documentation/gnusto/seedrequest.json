d","type":"codeVoice"},{"text":" falls back to for a ","type":"text"},{"type":"codeVoice","code":"play"},{"type":"text","text":" "},{"type":"text","text":"call that pins no seed, which is what makes "},{"type":"codeVoice","code":"GNUSTO_SEED=7 swift test"},{"type":"text","text":" "},{"text":"reproducible and a sweep across seeds able to find tests that only pass by","type":"text"},{"text":" ","type":"text"},{"text":"luck. See ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TestingYourGame","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"A bad value is reported rather than ignored. The variable exists for","type":"text"},{"text":" ","type":"text"},{"text":"reproducibility, so silently handing back a random stream after a typo","type":"text"},{"text":" ","type":"text"},{"text":"would defeat the one thing it is for.","type":"text"}]}],"kind":"content"}],"kind":"symbol","variants":[{"paths":["\/documentation\/gnusto\/seedrequest"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Gnusto/documentation/Gnusto/ScriptedIOHandler":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScriptedIOHandler","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"ScriptedIOHandler","kind":"identifier"}],"url":"\/documentation\/gnusto\/scriptediohandler","abstract":[{"type":"text","text":"Feeds a fixed list of commands and records everything into a transcript —"},{"type":"text","text":" "},{"type":"text","text":"for tests and automated playthroughs. Ships in the library because game"},{"type":"text","text":" "},{"type":"text","text":"authors want transcript tests too."}],"title":"ScriptedIOHandler","role":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/ScriptedIOHandler","kind":"symbol"},"doc://Gnusto/documentation/Gnusto/IOHandler/showStatus(_:)":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"ki