ype":"codeVoice","code":"cachedWorld"},{"type":"text","text":" falls back to for a "},{"type":"codeVoice","code":"play"},{"type":"text","text":" "},{"type":"text","text":"call that pins no seed, which is what makes "},{"type":"codeVoice","code":"GNUSTO_SEED=7 swift test"},{"type":"text","text":" "},{"type":"text","text":"reproducible and a sweep across seeds able to find tests that only pass by"},{"type":"text","text":" "},{"type":"text","text":"luck. See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TestingYourGame"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A bad value is reported rather than ignored. The variable exists for"},{"type":"text","text":" "},{"type":"text","text":"reproducibility, so silently handing back a random stream after a typo"},{"type":"text","text":" "},{"type":"text","text":"would defeat the one thing it is for."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnusto\/seedrequest"]}],"references":{"doc://Gnusto/SQ":{"title":"Swift.Equatable","identifier":"doc:\/\/Gnusto\/SQ","type":"unresolvable"},"doc://Gnusto/documentation/Gnusto/TestingYourGame":{"kind":"article","type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TestingYourGame","url":"\/documentation\/gnusto\/testingyourgame","role":"article","abstract":[{"text":"Play scripted sessions in your test suite and assert on the transcript.","type":"text"}],"title":"Testing Your Game"},"doc://Gnusto/documentation/Gnusto/SeedRequest/unset":{"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/SeedRequest\/unset","role":"symbol","title":"SeedRequest.unset","abstract":[{"code":"GNUSTO_SEED","type":"codeVoice"},{"text":" was unset, empty, or whitespace: seed randomly, as ever.","type":"text"}],"url":"\/documentation\/gnusto\/seedrequest\/unset","kind":"symbol","fragments":[{"kind":"keyword","text":"cas