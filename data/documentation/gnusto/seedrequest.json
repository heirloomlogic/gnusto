xt":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SeedRequest","kind":"identifier"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A game draws every random value — combat rolls, roaming actors, "},{"type":"codeVoice","code":"oneOf"},{"type":"text","text":" "},{"type":"text","text":"prose — from one seeded stream ("},{"type":"codeVoice","code":"WorldState\/rngState"},{"type":"text","text":"), so pinning the seed"},{"type":"text","text":" "},{"type":"text","text":"makes a whole session replay identically. "},{"type":"codeVoice","code":"play(_:_:seed:)"},{"type":"text","text":" already does"},{"type":"text","text":" "},{"type":"text","text":"that in the test suite; this is the same knob for a built binary, so a"},{"type":"text","text":" "},{"type":"text","text":"transcript a tester records by hand becomes a reproducer someone else can"},{"type":"text","text":" "},{"type":"text","text":"replay."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is also what the suite’s own "},{"code":"cachedWorld","type":"codeVoice"},{"type":"text","text":" falls back to for a "},{"code":"play","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"call that pins no seed, which is what makes "},{"code":"GNUSTO_SEED=7 swift test","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"reproducible and a sweep across seeds able to find tests that only pass by"},{"type":"text","text":" "},{"type":"text","text":"luck. See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TestingYourGame"},{"type":"text","text":"."}]},{"inlineContent":[{"type":"text","text":"A bad value is reported rather than ignored. The variable exists for"},{"type":"text","text":" "},{"type":"text","text":"reproducibility, so silently handing back a random stream after a typo"},{"type":"text","text":" "},{"type":"text","text":"would defeat the one thing it is for."}],"type":"paragraph"}]}],"references":{"doc://Gnusto/documentation/Gnusto/SeedRequest/init(environment:)":{"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"environment"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"])","kind":"text"}],"abstract":[{"text":"Reads ","type":"text"},{"code":"GNUSTO_SEED","type":"codeVoice"},{"text":", tolerating the stray whitespace a shell wrapper or","type":"text"},{"text":" ","type":"text"},{"text":"a copied-and-pasted value tends to bring with it.","type":"text"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/SeedRequest\/init(environment:)","role":"symbol","kind":"symbol","url":"\/documentation\/gnusto\/seedrequest\/init(environment:)","type":"topic","title":"init(environment:)"},"doc://Gnusto/documentation/Gnusto/SeedRequest/invalid(_:)":{"kind":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/SeedRequest\/invalid(_:)","type":"topic","abstract":[{"type":"text","text":"A value that isn’t a "},{"code":"UInt64","type":"codeVoice"},{"type":"text","text":", kept verbatim so the complaint can quote"},{"type":"text","text":" "},{"type":"text","text":"what the operator actually typed."}],"title":"SeedRequest.invalid(_:)","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"invalid"},{"kind":"text","text":"("},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":")"}],"url":"\/documentation\/gnusto\/seedrequest\/invalid(_:)"},"doc://Gnusto/documentation/Gnusto/SeedRequest/Equatable-Implementations":{"role":"collectionGroup","abstract":[],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/SeedRequest\/Equatable-Implementation