:"text","text":" to believe (“the candles are shorter now”), pass the"},{"type":"text","text":" "},{"type":"text","text":"thing instead of the room: the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Item"},{"type":"text","text":" overload asks "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/isVisible"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which the dark does gate."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://Gnusto/documentation/Gnusto/say(_:)":{"type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/say(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"say","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":")","kind":"text"}],"abstract":[{"type":"text","text":"Prints a message as part of the turn’s output."}],"url":"\/documentation\/gnusto\/say(_:)","title":"say(_:)"},"doc://Gnusto/documentation/Gnusto/Earshot":{"type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Earshot","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Earshot","kind":"identifier"}],"navigatorTitle":[{"text":"Earshot","kind":"identifier"}],"abstract":[{"type":"text","text":"The neighbourhood a sound carries to: the rooms a sentence about something"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"heard","type":"text"}]},{"type":"text","text":" is true in, named once and used wherever that sound is reported."}],"url":"\/documentation\/gnusto\/earshot","title":"Earshot"},"doc://Gnusto/documentation/Gnusto/sayOnceThisTurn(_:)":{"type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/sayOnceThisTurn(_:)","fragments":[{"text":"func","kind":"keyword"