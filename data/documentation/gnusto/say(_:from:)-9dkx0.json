{"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"say"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"message"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"from"},{"kind":"text","text":" "},{"kind":"internalParam","text":"sources"},{"text":": ","kind":"text"},{"text":"Location","preciseIdentifier":"s:6Gnusto8LocationV","kind":"typeIdentifier","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Location"},{"text":"...)","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"name":"message","content":[{"inlineContent":[{"type":"text","text":"The text to print."}],"type":"paragraph"}]},{"name":"sources","content":[{"type":"paragraph","inlineContent":[{"text":"The rooms the message is true in.","type":"text"}]}]}],"kind":"parameters"},{"mentions":["doc:\/\/Gnusto\/documentation\/Gnusto\/DarknessTimeAndDeath","doc:\/\/Gnusto\/documentation\/Gnusto\/WritingRules"],"kind":"mentions"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The line a "},{"type":"strong","inlineContent":[{"text":"timer","type":"text"}]},{"type":"text","text":" wants. A fuse or a daemon fires on a schedule, not on a"},{"type":"text","text":" "},{"type":"text","text":"place, so the room the player is in when the body runs is whatever room they"},{"type":"text","text":" "},{"type":"text","text":"walked to — and a sentence that narrates something happening "},{"type":"emphasis","inlineContent":[{"type":"text","text":"here"}]},{"type":"text","text":" is a"},{"type":"text","text":" "},{"type":"text","text":"claim about a frame the body never read. This is that read, written once:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["fuse(\"exorcismLapse\", after: 6) {","    exorcismStage = 0                        \/\/ the world moves regardless…","    say(Prose.exorcismLapses, from: gate)    \/\/ …the telling does not","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Dropping the line changes nothing else, exactly as "},{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/sayOnceThisTurn(_:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"does: put the state change above the "},{"type":"codeVoice","code":"say"},{"type":"text","text":" and it happens either way."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Variadic, because a noise carries.","type":"text"}]},{"type":"text","text":" A sentence about a reservoir emptying"},{"type":"text","text":" "},{"type":"text","text":"is true from either bank and from the bed between them, so name all three;"},{"type":"text","text":" "},{"type":"text","text":"the line prints from any of them and nowhere else. There is no earshot"},{"type":"text","text":" "},{"type":"text","text":"radius in the engine and this is deliberately not one — it is the author"},{"type":"text","text":" "},{"type":"text","text":"enumerating the frames their sentence is true in. When the same list of"},{"type":"text","text":" "},{"type":"text","text":"frames answers for more than one sentence, hoist it: see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Earshot"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Standing in the room, not seeing it.","type":"text"}]},{"type":"text","text":" Darkness does not gate this one — a"},{"type":"text","text":" "},{"text":"bell rung in an unlit room is still heard from inside it. For a sentence the","type":"text"},{"text":" ","type":"text"},{"text":"player has to ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"see"}]},{"type":"text","text":" to believe (“the candles are shorter now”), pass the"},{"text":" ","type":"text"},{"text":"thing instead of the room: the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Item"},{"type":"text","text":" overload asks "},{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/isVisible","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which the dark does gate."}]}],"kind":"content"}],"metadata":{"modules":[{"name":"Gnusto"}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"say"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto8LocationV","text":"Location"},{"kind":"text","text":"...)"}],"externalID":"s:6Gnusto3say_4fromySS_AA8LocationVdtF","title":"say(_:from:)","roleHeading":"Function","symbolKind":"func"},"identifier":{"url":"doc:\/\/Gnusto\/documentation\/Gnusto\/say(_:from:)-9dkx0","interfaceLanguage":"swift"},"seeAlsoSections":[{"identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/WritingRules","doc:\/\/Gnusto\/documentation\/Gnusto\/Rule","doc:\/\/Gnusto\/documentation\/Gnusto\/Rules","doc:\/\/Gnusto\/documentation\/Gnusto\/Intent","doc:\/\/Gnusto\/documentation\/Gnusto\/Command","doc:\/\/Gnusto\/documentation\/Gnusto\/say(_:)","doc:\/\/Gnusto\/documentation\/Gnusto\/sayOnceThisTurn(_:)","doc:\/\/Gnusto\/documentation\/Gnusto\/say(_:from:)-29lpm","doc:\/\/Gnusto\/documentation\/Gnusto\/say(_:from:)-9dafx","doc:\/\/Gnusto\/documentation\/Gnusto\/say(_:from:)-1kn0c","doc:\/\/Gnusto\/documentation\/Gnusto\/Earshot","doc:\/\/Gnusto\/documentation\/Gnusto\/refuse(_:)","d