{"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin\/statusFields"},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Extra ","type":"text"},{"code":"name=value","type":"codeVoice"},{"text":" pairs for the play-test status footer — what this","type":"text"},{"text":" ","type":"text"},{"text":"system knows that the three-field ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/StatusLine","isActive":true,"type":"reference"},{"text":" (room, score, moves)","type":"text"},{"text":" ","type":"text"},{"text":"does not. Defaults to empty, and costs nothing unless a footer is in","type":"text"},{"text":" ","type":"text"},{"text":"force.","type":"text"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto","doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin"]]},"metadata":{"modules":[{"name":"Gnusto"}],"symbolKind":"property","title":"statusFields","roleHeading":"Instance Property","required":true,"role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"statusFields"},{"kind":"text","text":": [("},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":")]","kind":"text"}],"externalID":"s:6Gnusto10GamePluginP12statusFieldsSaySS_SStGvp"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnusto\/gameplugin\/statusfields"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"statusFields"},{"kind":"text","text":": [("},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":")] { "},{"kind":"keyword","text":