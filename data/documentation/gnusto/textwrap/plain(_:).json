{"abstract":[{"type":"text","text":"Renders game text for a plain, non-reflowing channel: folds the"},{"type":"text","text":" "},{"type":"text","text":"paragraph’s soft breaks, then turns the hard-break marker into a real"},{"type":"text","text":" "},{"type":"text","text":"newline."}],"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto","doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"plain","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"text","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}]}],"kind":"declarations"},{"parameters":[{"name":"text","content":[{"inlineContent":[{"type":"text","text":"The game text to render."}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"type":"heading","anchor":"return-value","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"text":"The text folded, with every ","type":"text"},{"code":"<br>","type":"codeVoice"},{"text":" replaced by a newline.","type":"text"}]}],"kind":"content"},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"The fold runs ","type":"text"},{"inlineContent":[{"type":"text","text":"first"}],"type":"strong"},{"text":". The other order would turn ","type":"text"},{"code":"<br>","type":"codeVoice"},{"text":" into a newline","type":"text"},{"text":" ","type":"text"},{"text":"that the fold then eats, silently downgrading a hard break to a space.","type":"text"}]},{"type":"paragraph","