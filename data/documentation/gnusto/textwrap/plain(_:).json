{"abstract":[{"text":"Renders game text for a plain, non-reflowing channel: folds the","type":"text"},{"text":" ","type":"text"},{"text":"paragraph’s soft breaks, then turns the hard-break marker into a real","type":"text"},{"text":" ","type":"text"},{"text":"newline.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto","doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap"]]},"sections":[],"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"plain"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"text"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"text","content":[{"inlineContent":[{"type":"text","text":"The game text to render."}],"type":"paragraph"}]}],"kind":"parameters"},{"kind":"content","content":[{"text":"Return Value","level":2,"type":"heading","anchor":"return-value"},{"inlineContent":[{"text":"The text folded, with every ","type":"text"},{"type":"codeVoice","code":"<br>"},{"text":" replaced by a newline.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"The fold runs ","type":"text"},{"inlineContent":[{"type":"text","text":"first"}],"type":"strong"},{"text":". The other order would turn ","type":"text"},{"type":"codeVoice","code":"<br>"},{"text":" into a newline","type":"text"},{"text":" ","type":"text"},{"text":"that the fold then eats, silently downgrading a hard break to a space.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A paragraph therefore arrives as one line, however the author happened to","type":"text"},{"text":" ","type":"text"},{"text":"wrap the literal. That is the whole point: a plain channel has no column","type":"text"},{"text":" ","type":"text"},{"text":"to reflow to, so the alternative is printing at whatever width the source","type":"text"},{"text":" ","type":"text"},{"text":"was typed at — and printing at ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"two","type":"text"}]},{"type":"text","text":" widths the moment a clause is"},{"type":"text","text":" "},{"text":"interpolated onto a wrapped literal. The terminal the output lands in","type":"text"},{"type":"text","text":" "},{"text":"wraps a long line; it cannot un-wrap a short one.","type":"text"}],"type":"paragraph"}]}],"metadata":{"symbolKind":"method","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"plain"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"externalID":"s:6Gnusto8TextWrapO5plainyS2SFZ","modules":[{"name":"Gnusto"}],"roleHeading":"Type Method","role":"symbol","title":"plain(_:)"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/plain(_:)"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnusto\/textwrap\/plain(_:)"]}],"references":{"doc://Gnusto/documentation/Gnusto":{"abstract":[{"text":"An engine for writing interactive fiction in Swift.","type":"text"}],"title":"Gnusto","kind":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto","type":"topic","url":"\/documentation\/gnusto","role":"collection"},"doc://Gnusto/documentation/Gnusto/TextWrap":{"url":"\/documentation\/gnusto\/textwrap",