{"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","identifier":{"url":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/plain(_:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Renders game text for a plain, non-reflowing channel: folds the"},{"type":"text","text":" "},{"type":"text","text":"paragraph’s soft breaks, then turns the hard-break marker into a real"},{"type":"text","text":" "},{"type":"text","text":"newline."}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto","doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap"]]},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"plain","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"text","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"text","content":[{"inlineContent":[{"text":"The game text to render.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"return-value","text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The text folded, with every "},{"type":"codeVoice","code":"<br>"},{"type":"text","text":" replaced by a newline."}]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The fold runs "},{"inlineContent":[{"text":"first","type":"text"}],"type":"strong"},{"type":"text","text":". The other order would turn "},{"type":"codeVoice","code":"<br>"},{"type":"text","text":" into a newline"},{"type":"text","text":" "},{"type":"text","text":"that the fold then eats, silently downgrading a hard break to a space."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A paragraph therefore arrives as one line, however the author happened to"},{"type":"text","text":" "},{"type":"text","text":"wrap the literal. That is the whole point: a plain channel has no column"},{"type":"text","text":" "},{"type":"text","text":"to reflow to, so the alternative is printing at whatever width the source"},{"type":"text","text":" "},{"type":"text","text":"was typed at — and printing at "},{"inlineContent":[{"text":"two","type":"text"}],"type":"emphasis"},{"type":"text","text":" widths the moment a clause is"},{"type":"text","text":" "},{"type":"text","text":"interpolated onto a wrapped literal. The terminal the output lands in"},{"type":"text","text":" "},{"type":"text","text":"wraps a long line; it cannot un-wrap a short one."}]}]}],"metadata":{"title":"plain(_:)","symbolKind":"method","externalID":"s:6Gnusto8TextWrapO5plainyS2SFZ","modules":[{"name":"Gnusto"}],"role":"symbol","roleHeading":"Type Method","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"plain","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnusto\/textwrap\/plain(_:)"]}],"references":{"doc://Gnusto/documentation/Gnusto/TextWrap":{"title":"TextWrap","kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TextWrap","kind":"identifier"}],"navigatorTitle":[{"text":"TextWrap","kind":"identifier"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap","abstract":[{"text":"Renders game prose for a channel: reflowed to a column width for the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"full-screen terminal, folded for every plain one. Pure and side-effect-free"},{"type":"text","text":" "},{"type":"text","text":"so it can be unit-tested without a live terminal."}],"url":"\/documentation\/gnusto\/textwrap","type":"topic"},"doc://Gnusto/documentation/Gnusto":{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto","kind":"symbol","abstract":[{"type":"text","text":"An engine for writing interactive fiction in Swift."}],"title":"Gnusto","role":"collection","url":"\/documentation\/gnusto","type":"topic"},"doc://Gnusto/documentation/Gnusto/TextWrap/plain(_:)":{"abstract":[{"text":"Renders game text for a plain, non-reflowing channel: folds the","type":"text"},{"text":" ","type":"text"},{"text":"paragraph’s soft breaks, then turns the hard-break marker into a real","type":"text"},{"text":" ","type":"text"},{"text":"newline.","type":"text"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/plain(_:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"plain","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"title":"plain(_:)","url":"\/documentation\/gnusto\/textwrap\/plain(_:)","kind":"symbol","type":"topic","role":"symbol"}}}