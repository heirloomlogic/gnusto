{"metadata":{"modules":[{"name":"Gnusto"}],"role":"symbol","externalID":"s:6Gnusto8TextWrapO5plainyS2SFZ","symbolKind":"method","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"plain","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"}],"roleHeading":"Type Method","title":"plain(_:)"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnusto\/textwrap\/plain(_:)"]}],"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto","doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"plain"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"text"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The game text to render.","type":"text"}]}],"name":"text"}]},{"kind":"content","content":[{"type":"heading","anchor":"return-value","text":"Return Value","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The text folded, with every "},{"type":"codeVoice","code":"<br>"},{"type":"text","text":" replaced by a newline."}]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The fold runs "},{"type":"strong","inlineContent":[{"type":"text","text":"first"}]},{"type":"text","text":". The other order would turn "},{"type":"codeVoice","code":"<br>"},{"type":"text","text":" into a newline"},{"type":"text","text":" "},{"type":"text","text":"that the fold then eats, silently downgrading a hard break to a space."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A paragraph therefore arrives as one line, however the author happened to"},{"type":"text","text":" "},{"type":"text","text":"wrap the literal. That is the whole point: a plain channel has no column"},{"type":"text","text":" "},{"type":"text","text":"to reflow to, so the alternative is printing at whatever width the source"},{"text":" ","type":"text"},{"type":"text","text":"was typed at — and printing at "},{"type":"emphasis","inlineContent":[{"text":"two","type":"text"}]},{"type":"text","text":" widths the moment a clause is"},{"type":"text","text":" "},{"type":"text","text":"interpolated onto a wrapped literal. The terminal the output lands in"},{"type":"text","text":" "},{"type":"text","text":"wraps a long line; it cannot un-wrap a short one."}]}]}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/plain(_:)"},"sections":[],"abstract":[{"type":"text","text":"Renders game text for a plain, non-reflowing channel: folds the"},{"type":"text","text":" "},{"type":"text","text":"paragraph’s soft breaks, then turns the hard-break marker into a real"},{"type":"text","text":" "},{"type":"text","text":"newline."}],"references":{"doc://Gnusto/documentation/Gnusto":{"kind":"symbol","abstract":[{"type":"text","text":"An engine for writing interactive fiction in Swift."}],"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto","url":"\/documentation\/gnusto","title":"Gnusto","role":"collection"},"doc://Gnusto/documentation/Gnusto/TextWrap":{"role":"symbol","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TextWrap","kind":"identifier"}],"navigatorTitle":[{"text":"TextWrap","kind":"identifier"}],"url":"\/documentation\/gnusto\/textwrap","kind":"symbol","title":"TextWrap","abstract":[{"type":"text","text":"Renders game prose for a channel: reflowed to a column width for the"},{"type":"text","text":" "},{"type":"text","text":"full-screen terminal, folded for every plain one. Pure and side-effect-free"},{"type":"text","text":" "},{"type":"text","text":"so it can be unit-tested without a live terminal."}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap"},"doc://Gnusto/documentation/Gnusto/TextWrap/plain(_:)":{"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"plain"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"kind":"symbol","url":"\/documentation\/gnusto\/textwrap\/plain(_:)","title":"plain(_:)","abstract":[{"type":"text","text":"Renders game text for a plain, non-reflowing channel: folds the"},{"type":"text","text":" "},{"type":"text","text":"paragraph’s soft breaks, then turns the hard-break marker into a real"},{"type":"text","text":" "},{"type":"text","text":"newline."}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/plain(_:)"}}}