"},{"type":"text","text":" "},{"type":"text","text":"full-screen terminal, folded for every plain one. Pure and side-effect-free"},{"type":"text","text":" "},{"type":"text","text":"so it can be unit-tested without a live terminal."}],"title":"TextWrap","url":"\/documentation\/gnusto\/textwrap","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap"},"doc://Gnusto/documentation/Gnusto":{"type":"topic","title":"Gnusto","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto","kind":"symbol","abstract":[{"text":"An engine for writing interactive fiction in Swift.","type":"text"}],"role":"collection","url":"\/documentation\/gnusto"},"doc://Gnusto/documentation/Gnusto/TextWrap/plain(_:)":{"role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"plain","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"abstract":[{"text":"Renders game text for a plain, non-reflowing channel: folds the","type":"text"},{"text":" ","type":"text"},{"text":"paragraph’s soft breaks, then turns the hard-break marker into a real","type":"text"},{"text":" ","type":"text"},{"text":"newline.","type":"text"}],"title":"plain(_:)","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/plain(_:)","url":"\/documentation\/gnusto\/textwrap\/plain(_:)","kind":"symbol","type":"topic"}}}