{"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto"]]},"kind":"symbol","sections":[],"variants":[{"paths":["\/documentation\/gnusto\/verb(_:_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@freestanding"},{"kind":"text","text":"(declaration, names: arbitrary) "},{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"verb"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"intentName"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"text":"patterns","kind":"internalParam"},{"text":": [","kind":"text"},{"text":"SyntaxElement","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto13SyntaxElementO","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/SyntaxElement"},{"text":"]...)","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use it inside an "},{"code":"extension Intent","type":"codeVoice"},{"type":"text","text":" — that’s what makes the leading-dot"},{"type":"text","text":" "},{"type":"text","text":"spelling work everywhere an "},{"code":"Intent","type":"codeVoice"},{"type":"text","text":" is expected:"}]},{"syntax":"swift","code":["extension Intent {","    #verb(\"ring\", [\"ring\", .directObject])","    #verb(\"barter\",","          [\"barter\", .directObject],","          [\"barter\", .directObject, \"for\", .indirectObject],","          [\"haggle\", \"over\", .directObject])","    #verb(\"chime\")                           \/\/ pattern defaults to [\"chime\"]","    #verb(\"steal\", [\"take\", .directObject])  \/\/ reclaim a built-in verb","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Pick a name the engine doesn’t already ship. The macro mints","type":"text"},{"text":" ","type":"text"},{"code":"Intent.<name>","type":"codeVoice"},{"text":", so a second declaration of a name the engine owns — a core","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"verb, or a stub verb like "},{"type":"codeVoice","code":"dig"},{"type":"text","text":", "},{"type":"codeVoice","code":"attack"},{"type":"text","text":" or "},{"type":"codeVoice","code":"sing"},{"type":"text","text":" — makes "},{"type":"codeVoice","code":".<name>"},{"type":"text","text":" "},{"type":"text","text":"ambiguous in every file that imports both modules. Reclaiming the "},{"type":"emphasis","inlineContent":[{"text":"word","type":"text"}]},{"type":"text","text":" "},{"type":"text","text":"under a name of your own is always safe:"},{"text":" ","type":"text"},{"code":"#verb(\"excavate\", [\"dig\", .directObject])","type":"codeVoice"},{"text":".","type":"text"}]},{"inlineContent":[{"text":"Each pattern is a complete row: literal words the player types plus","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".directObject"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":".indirectObject"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":".direction"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":".topic"},{"text":" slots. Patterns are","type":"text"},{"text":" ","type":"text"},{"text":"validated at compile time with the same rules the bootstrap applies to","type":"text"},{"text":" ","type":"text"},{"text":"hand-built rows.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The rows still need to reach the parser: list the intents in a ","type":"text"},{"type":"codeVoice","code":"verbs"},{"text":" ","type":"text"},{"text":"block, which splices everything they carry. (List several as one array —","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"bare "},{"type":"codeVoice","code":".ring"},{"text":" statements on consecutive lines would parse as a single","type":"text"},{"text":" ","type":"text"},{"text":"chained member access.)","type":"text"}]},{"type":"codeListing","code":["var verbs: [SyntaxRule] { [.ring, .barter] }","var rules: Rules {","    bell.before(.ring) { try reply(\"The bell chimes sweetly.\") }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The first argument is the intent’s identifier — the generated constant’s"},{"type":"text","text":" "},{"type":"text","text":"name and its "},{"type":"codeVoice","code":"raw"},{"text":" value — so it must be a plain string literal that is a","type":"text"},{"text":" ","type":"text"},{"text":"valid Swift identifier. It doesn’t have to match the typed verb word:","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"#verb(\"steal\", [\"take\", .directObject])"},{"type":"text","text":" reclaims the built-in "},{"type":"codeVoice","code":"take"},{"type":"text","text":" "},{"type":"text","text":"row under a new intent."}]}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"seeAlsoSections":[{"anchor":"Verbs-and-Intents","generated":true,"identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/AddingCustomVerbs","doc:\/\/Gnusto\/documentation\/Gnusto\/StubVerbs","doc:\/\/Gnusto\/documentation\/Gnusto\/SyntaxRule","doc:\/\/Gnusto\/documentation\/Gnusto\/SyntaxElement","doc:\/\/Gnusto\/documentation\/Gnusto\/IntentAction","doc:\/\/Gnusto\/documentation\/Gnusto\/Topic"],"title":"Verbs and Intents"}],"abstract":[{"type":"text","text":"Declares a custom player-typeable verb in one place: a typed intent"},{"type":"text","text":" "},{"type":"text","text":"constant plus the verb rows that produce it."}],"metadata":{"roleHeading":"Macro","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"verb","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", [","kind":"text"},{"preciseIdentifier":"s:6Gnusto13SyntaxElementO","text":"SyntaxElement","kind":"typeIdentifier"},{"kind":"text","text":"]...)"}],"modules":[{"name":"Gnusto"}],"symbolKind":"macro","externalID":"s:6Gnusto4verbyySS_SayAA13SyntaxElementOGdtcfm","title":"verb(_:_:)","role":"symbol"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Gnusto\/documentation\/Gnusto\/verb(_:_:)"},"references":{"doc://Gnusto/documentation/Gnusto/verb(_:_:)":{"fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"verb","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", [","kind":"text"},{"preciseIdentifier":"s:6Gnusto13SyntaxElementO","text":"SyntaxElement","kind":"typeIdentifier"},{"text":"]...)","kind":"text"}],"type":"topic","url":"\/documentation\/gnusto\/verb(_:_:)","abstract":[{"text":"Declares a custom player-typeable verb in one place: a typed intent","type":"text"},{"text":" ","type":"text"},{"text":"constant plus the verb rows that produce it.","type":"text"}],"title":"verb(_:_:)","role":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/verb(_:_:)","kind":"symbol"},"doc://Gnusto/documentation/Gnusto/SyntaxRule":{"type":"topic","abstract":[{"type":"text","text":"One row of the verb table: a pattern of literal words and slots, and the"},{"type":"text","text":" "},{"type":"text","text":"intent a match produces. Data, not code — games can add rows through their"},{"type":"text","text":" "},{"code":"verbs","type":"codeVoice"},{"type":"text","text":" block to teach the parser new player-typeable verbs."}],"kind":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/SyntaxRule","title":"SyntaxRule","role":"symbol","navigatorTitle":[{"text":"SyntaxRule","kind":"identifier"}],"url":"\/documentation\/gnusto\/syntaxrule","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":