t","text":"pattern are "},{"type":"codeVoice","code":".word"},{"type":"text","text":"s, so rows read the way they’re typed:"}],"title":"SyntaxElement","role":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/SyntaxElement","kind":"symbol"},"doc://Gnusto/documentation/Gnusto/IntentAction":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"IntentAction","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"IntentAction"}],"title":"IntentAction","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/IntentAction","abstract":[{"text":"A replacement or new stage-4 default action for one intent — the seam","type":"text"},{"text":" ","type":"text"},{"text":"that lets a game or plugin give a custom verb real behavior instead of","type":"text"},{"text":" ","type":"text"},{"text":"“I didn’t understand”, or replace a built-in’s default entirely.","type":"text"}],"kind":"symbol","url":"\/documentation\/gnusto\/intentaction","type":"topic"},"doc://Gnusto/documentation/Gnusto":{"type":"topic","title":"Gnusto","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto","kind":"symbol","abstract":[{"text":"An engine for writing interactive fiction in Swift.","type":"text"}],"role":"collection","url":"\/documentation\/gnusto"}}}