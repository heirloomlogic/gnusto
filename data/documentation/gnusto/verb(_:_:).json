{"metadata":{"roleHeading":"Macro","modules":[{"name":"Gnusto"}],"role":"symbol","title":"verb(_:_:)","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"verb"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", ["},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto13SyntaxElementO","text":"SyntaxElement"},{"kind":"text","text":"]...)"}],"externalID":"s:6Gnusto4verbyySS_SayAA13SyntaxElementOGdtcfm","symbolKind":"macro"},"sections":[],"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto"]]},"kind":"symbol","seeAlsoSections":[{"generated":true,"title":"Adding Vocabulary","anchor":"Adding-Vocabulary","identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/AddingCustomVerbs","doc:\/\/Gnusto\/documentation\/Gnusto\/StubVerbs","doc:\/\/Gnusto\/documentation\/Gnusto\/SyntaxRule","doc:\/\/Gnusto\/documentation\/Gnusto\/SyntaxElement"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@freestanding"},{"kind":"text","text":"(declaration, names: arbitrary) "},{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"verb"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"intentName"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"patterns","kind":"internalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:6Gnusto13SyntaxElementO","text":"SyntaxElement","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/SyntaxElement","kind":"typeIdentifier"},{"text":"]...)","kind":"text"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Use it inside an ","type":"text"},{"type":"codeVoice","code":"extension Intent"},{"text":" — that’s what makes the leading-dot","type":"text"},{"text":" ","type":"text"},{"text":"spelling work everywhere an ","type":"text"},{"type":"codeVoice","code":"Intent"},{"text":" is expected:","type":"text"}]},{"type":"codeListing","code":["extension Intent {","    #verb(\"ring\", [\"ring\", .directObject])","    #verb(\"barter\",","          [\"barter\", .directObject],","          [\"barter\", .directObject, \"for\", .indirectObject],","          [\"haggle\", \"over\", .directObject])","    #verb(\"chime\")                           \/\/ pattern defaults to [\"chime\"]","    #verb(\"steal\", [\"take\", .directObject])  \/\/ reclaim a built-in verb","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pick a name the engine doesn’t already ship. The macro mints"},{"type":"text","text":" "},{"type":"codeVoice","code":"Intent.<name>"},{"type":"text","text":", so a second declaration of a name the engine owns — a core"},{"type":"text","text":" "},{"type":"text","text":"verb, or a stub verb like "},{"type":"codeVoice","code":"dig"},{"type":"text","text":", "},{"type":"codeVoice","code":"attack"},{"type":"text","text":" or "},{"type":"codeVoice","code":"sing"},{"type":"text","text":" — makes "},{"type":"codeVoice","code":".<name>"},{"type":"text","text":" "},{"type":"text","text":"ambiguous in every file that imports both modules. Reclaiming the "},{"type":"emphasis","inlineContent":[{"text":"word","type":"text"}]},{"text":" ","type":"text"},{"text":"under a name of your own is always safe:","type":"text"},{"text":" ","type":"text"},{"code":"#verb(\"excavate\", [\"dig\", .directObject])","type":"codeVoice"},{"text":".","type":"text"}]},{"inlineContent":[{"text":"Each pattern is a complete row: literal words the player types plus","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".directObject"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":".indirectObject"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":".direction"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":".topic"},{"type":"text","text":" slots. Patterns are"},{"text":" ","type":"text"},{"text":"validated at compile time with the same rules the bootstrap applies to","type":"text"},{"text":" ","type":"text"},{"text":"hand-built rows.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The rows still need to reach the parser: list the intents in a "},{"type":"codeVoice","code":"verbs"},{"text":" ","type":"text"},{"text":"block, which splices everything they carry. (List several as one array —","type":"text"},{"text":" ","type":"text"},{"text":"bare ","type":"text"},{"type":"codeVoice","code":".ring"},{"text":" statements on consecutive lines would parse as a single","type":"text"},{"text":" ","type":"text"},{"text":"chained member access.)","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var verbs: [SyntaxRule] { [.ring, .barter] }","var rules: Rules {","    bell.before(.ring) { try reply(\"The bell chimes sweetly.\") }","}"]},{"inlineContent":[{"type":"text","text":"The first argument is the intent’s identifier — the generated constant’s"},{"type":"text","text":" "},{"text":"name and its ","type":"text"},{"code":"raw","type":"codeVoice"},{"text":" value — so it must be a plain string literal that is a","type":"text"},{"text":" ","type":"text"},{"text":"valid Swift identifier. It doesn’t have to match the typed verb word:","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"#verb(\"steal\", [\"take\", .directObject])"},{"text":" reclaims the built-in ","type":"text"},{"type":"codeVoice","code":"take"},{"text":" ","type":"text"},{"text":"row under a new intent.","type":"text"}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/gnusto\/v