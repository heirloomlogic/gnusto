{"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Gnusto\/documentation\/Gnusto\/verb(_:_:)"},"abstract":[{"type":"text","text":"Declares a custom player-typeable verb in one place: a typed intent"},{"type":"text","text":" "},{"type":"text","text":"constant plus the verb rows that produce it."}],"seeAlsoSections":[{"title":"Verbs and Intents","generated":true,"identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/AddingCustomVerbs","doc:\/\/Gnusto\/documentation\/Gnusto\/StubVerbs","doc:\/\/Gnusto\/documentation\/Gnusto\/SyntaxRule","doc:\/\/Gnusto\/documentation\/Gnusto\/SyntaxElement","doc:\/\/Gnusto\/documentation\/Gnusto\/IntentAction","doc:\/\/Gnusto\/documentation\/Gnusto\/Topic"],"anchor":"Verbs-and-Intents"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@freestanding","kind":"attribute"},{"text":"(declaration, names: arbitrary) ","kind":"text"},{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"verb","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"intentName","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"patterns","kind":"internalParam"},{"text":": [","kind":"text"},{"text":"SyntaxElement","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/SyntaxElement","preciseIdentifier":"s:6Gnusto13SyntaxElementO","kind":"typeIdentifier"},{"text":"]...)","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"Use it inside an "},{"type":"codeVoice","code":"extension Intent"},{"type":"text","text":" — that’s what makes the leading-dot"},{"type":"text","text":" "},{"type":"text","text":"spelling work everywhere an "},{"type":"codeVoice","code":"Intent"},{"type":"text","text":" is expected:"}],"type":"paragraph"},{"code":["extension Intent {","    #verb(\"ring\", [\"ring\", .directObject])","    #verb(\"barter\",","          [\"barter\", .directObject],","          [\"barter\", .directObject, \"for\", .indirectObject],","          [\"haggle\", \"over\", .directObject])","    #verb(\"chime\")                           \/\/ pattern defaults to [\"chime\"]","    #verb(\"steal\", [\"take\", .directObject])  \/\/ reclaim a built-in verb","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Pick a name the engine doesn’t already ship. The macro mints"},{"type":"text","text":" "},{"type":"codeVoice","code":"Intent.<name>"},{"type":"text","text":", so a second declaration of a name the engine owns — a core"},{"type":"text","text":" "},{"type":"text","text":"verb, or a stub verb like "},{"type":"codeVoice","code":"dig"},{"type":"text","text":", "},{"type":"codeVoice","code":"attack"},{"type":"text","text":" or "},{"type":"codeVoice","code":"sing"},{"type":"text","text":" — makes "},{"type":"codeVoice","code":".<name>"},{"type":"text","text":" "},{"type":"text","text":"ambiguous in every file that imports both modules. Reclaiming the "},{"type":"emphasis","inlineContent":[{"text":"word","type":"text"}]},{"type":"text","text":" "},{"type":"text","text":"under a name of your own is always safe:"},{"type":"text","text":" "},{"type":"codeVoice","code":"#verb(\"excavate\", [\"dig\", .directObject])"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each pattern is a complete row: literal words the player types plus"},{"type":"text","text":" "},{"type":"codeVoice","code":".directObject"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":".indirectObject"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":".direction"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":".topic"},{"type":"text","text":" slots. Patterns are"},{"type":"text","text":" "},{"type":"text","text":"validated at compile time with the same rules the bootstrap applies to"},{"type":"text","text":" "},{"type":"text","text":"hand-built rows."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The rows still need to reach the parser: list the intents in a "},{"type":"codeVoice","code":"verbs"},{"type":"text","text":" "},{"type":"text","text":"block, which splices everything they carry. (List several as one array —"},{"type":"text","text":" "},{"type":"text","text":"bare "},{"type":"codeVoice","code":".ring"},{"type":"text","text":" statements on consecutive lines would parse as a single"},{"type":"text","text":" "},{"type":"text","text":"chained member access.)"}],"type":"paragraph"},{"code":["var verbs: [SyntaxRule] { [.ring, .barter] }","var rules: Rules {","    bell.before(.ring) { try reply(\"The bell chimes sweetly.\") }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The first argument is the intent’s identifier — the generated constant’s"},{"type":"text","text":" "},{"type":"text","text":"name and its "},{"type":"codeVoice","code":"raw"},{"type":"text","text":" value — so it must be a plain string literal that is a"},{"type":"text","text":" "},{"type":"text","text":"valid Swift identifier. It doesn’t have to match the typed verb word:"},{"type":"text","text":" "},{"type":"codeVoice","code":"#verb(\"steal\", [\"take\", .directObject])"},{"type":"text","text":" reclaims the built-in "},{"type":"codeVoice","code":"take"},{"type":"text","text":" "},{"type":"text","text":"row under a new intent."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto"]]},"metadata":{"title":"verb(_:_:)","externalID":"s:6Gnusto4verbyySS_SayAA13SyntaxElementOGdtcfm","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"verb","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", [","kind":"text"},{"text":"SyntaxElement","preciseIdentifier":"s:6Gnusto13SyntaxElementO","kind":"typeIdentifier"},{"text":"]...)","kind":"text"}],"modules":[{"name":"Gnusto"}],"roleHeading":"Macro","role":"symbol","symbolKind":"macro"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnusto\/verb(_:_:)"]}],"references":{"doc://Gnusto/documentation/Gnusto/SyntaxElement":{"title":"SyntaxElement","abstract":[{"text":"One element of a verb pattern: a literal word the player must type, or a","type":"text"},{"text":" ","type":"text"},{"text":"slot the parser fills from the rest of the sentence. String literals in a","type":"text"},{"text":" ","type":"text"},{"text":"pattern are ","type":"text"},{"code":".word","type":"codeVoice"},{"text":"s, so rows read the way they’re typed:","type":"text"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"SyntaxElement"}],"role":"symbol","url":"\/documentation\/gnusto\/syntaxelement","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"SyntaxElement"}],"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/SyntaxElement"},"doc://Gnusto/documentation/Gnusto/Topic":{"url":"\/documentation\/gnusto\/topic","type":"topic","title":"Topic","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Topic"}],"abstract":[{"text":"What the player wants to talk about: the words after “about”, normalized","type":"text"},{"text":" ","type":"text"},{"text":"the way the parser normalizes everything else — lowercased, punctuation","type":"text"},{"text":" ","type":"text"},{"text":"dropped, filler stripped.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"Topic","kind":"identifier"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Topic"},"doc://Gnusto/d