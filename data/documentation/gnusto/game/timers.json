. The body is registered at bootstrap and never","type":"text"},{"text":" ","type":"text"},{"text":"serialized; only the schedule — name → turns remaining, or the active","type":"text"},{"text":" ","type":"text"},{"text":"flag — lives in ","type":"text"},{"code":"WorldState","type":"codeVoice"},{"text":", so it saves and restores like any other","type":"text"},{"text":" ","type":"text"},{"text":"state and a restore re-binds it to the declared body by name.","type":"text"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TimedEvent","title":"TimedEvent","navigatorTitle":[{"text":"TimedEvent","kind":"identifier"}],"url":"\/documentation\/gnusto\/timedevent","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TimedEvent","kind":"identifier"}]},"doc://Gnusto/documentation/Gnusto":{"role":"collection","abstract":[{"type":"text","text":"An engine for writing interactive fiction in Swift."}],"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto","kind":"symbol","title":"Gnusto","url":"\/documentation\/gnusto"},"doc://Gnusto/documentation/Gnusto/lightSource":{"role":"symbol","abstract":[{"text":"The item can hold light. It ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"starts unlit"}]},{"text":" unless it also declares","type":"text"},{"text":" ","type":"text"},{"code":"startsLit","type":"codeVoice"},{"text":"; the player operates it with ","type":"text"},{"code":"turn on","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"turn off","type":"codeVoice"},{"text":" (and","type":"text"},{"text":" ","type":"text"},{"code":"light","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"extinguish","type":"codeVoice"},{"text":"), and rules can flip ","type":"text"},{"code":"item.isLit","type":"codeVoice"},{"text":" directly. While lit,","type":"text"},{"text":" ","type":"text"},{"text":"it lights the room it is in — carried by the player, lying in the room, on","type":"text"},{"text":" ","type":"text"},{"text":"a surface, or inside an open or ","type":"text"},{"code":"transparent","type":"codeVoice"},{"text":" container. There is no","type":"text"},{"text":" ","type":"text"},{"text":"separate “always burning” trait: refuse ","type":"text"},{"code":".turnOff","type":"codeVoice"},{"text":" in a rule to make a","type":"text"},{"text":" ","type":"text"},{"text":"torch inextinguishable.","type":"text"}],"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/lightSource","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"lightSource"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ItemTrait","preciseIdentifier":"s:6Gnusto9ItemTraitV"}],"url":"\/documentation\/gnusto\/lightsource","title":"lightSource","kind":"symbol"},"doc://Gnusto/documentation/Gnusto/GameContent/namespace":{"role":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameContent\/namespace","abstract":[{"type":"text","text":"Prefixes this bundle’s entity IDs so its rooms\/items\/"},{"type":"codeVoice","code":"@Global"},{"type":"text","text":"s can’t"},{"type":"text","text":" "},{"type":"text","text":"collide with the host game’s or another bundle’s. A bundle entity stored"},{"type":"text","text":" "},{"type":"text","text":"as "},{"type":"codeVoice","code":"let hall = Location { … }"},{"type":"text","text":" becomes "},{"type":"codeVoice","code":"EntityID(\"\\(namespace).hall\")"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"while the game’s own entities stay bare. This is what lets a reusable"},{"type":"text","text":" "},{"type":"text","text":"content-bearing plugin be dropped into any host without name clashes."}],"required":true,"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"namespace","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"}],"kind":"symbol","type":"topi