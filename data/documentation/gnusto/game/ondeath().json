ter belongings, bump a death-count ","type":"text"},{"code":"@Global","type":"codeVoice"},{"type":"text","text":". What it"},{"type":"text","text":" "},{"type":"text","text":"returns decides the death’s fate:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/DeathOutcome\/consumed","type":"reference"},{"type":"text","text":" revives the player — the world stays"},{"type":"text","text":" "},{"type":"codeVoice","code":".playing"},{"type":"text","text":", the turn finishes normally (fuses and daemons still"},{"type":"text","text":" "},{"type":"text","text":"tick), no banner or prompt appears."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/DeathOutcome\/fallThrough","type":"reference"},{"text":" (the default) runs the standard death","type":"text"},{"text":" ","type":"text"},{"text":"path unchanged.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Defaults to ","type":"text"},{"type":"codeVoice","code":".fallThrough"},{"text":", so a game that doesn’t implement it dies","type":"text"},{"text":" ","type":"text"},{"text":"exactly as before. ","type":"text"},{"type":"codeVoice","code":"UNDO"},{"text":" after a consumed death rewinds the whole","type":"text"},{"text":" ","type":"text"},{"text":"fatal turn — the death, the resurrection, and everything the handler","type":"text"},{"text":" ","type":"text"},{"text":"did — back to where the player stood before it, which is the coherent","type":"text"},{"text":" ","type":"text"},{"text":"thing to undo.","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnusto\/game\/ondeath()"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Gnusto\/documentation\/Gnusto\/Game\/onDeath()"},"abstract":[{"text":"Called the instant the player dies — after the ","type":"text"},{"code":"die(_:)","type":"codeVoice"},{"text":" message","type":"text"},{"text":" ","type":"text"},{"text":"prints, but ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"before","type":"text"}]},{"text":" the death banner and the RESTART \/ RESTORE \/","type":"text"},{"text":" ","type":"text"},{"text":"UNDO \/ QUIT prompt.","type":"text"}],"references":{"doc://Gnusto/documentation/Gnusto/Game/onDeath()-8o798":{"title":"onDeath()","type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Game\/onDeath()-8o798","abstract":[{"type":"text","text":"Games without a resurrection story die the standard way."}],"url":"\/documentation\/gnusto\/game\/ondeath()-8o798","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onDeath","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"DeathOutcome","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto12DeathOutcomeO"}],"role":"symbol","kind":"symbol"},"doc://Gnusto/documentation/Gnusto":{"url":"\/documentation\/gnusto","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto","title":"Gnusto","abstract":[{"text":"A Swift engine for writing parser-driven interactive fiction — text adventures in the tradition of Zork and Infocom’s ZIL.","type":"text"}],"role":"collection","kind":"symbol","type":"topic"},"doc://Gnusto/documentation/Gnusto/DeathOutcome/consumed":{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/DeathOutcome\/consumed","url":"\/documentation\/gnusto\/deathoutcome\/consumed","role":"symbol","abstract":[{"type":"text","text":"Swallow the death: the world stays "},{"code":".playing","type":"codeVoice"},{"text":", the turn ends normally","type":"text"},{"text":" ","type":"text"},{"text":"(its fuses and daemons still tick), and no death banner or prompt is","type":"text"},{"text":" ","type":"text"},{"text":"shown. The handler is responsible for making the continuation sensible","type":"text"},{"text":" ","type":"text"},{"text":"— teleporting the player somewhere alive, scatteri