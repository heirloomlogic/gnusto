{"abstract":[{"text":"Called the instant the player dies — after the ","type":"text"},{"code":"die(_:)","type":"codeVoice"},{"text":" message","type":"text"},{"text":" ","type":"text"},{"text":"prints, but ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"before"}]},{"text":" the death banner and the RESTART \/ RESTORE \/","type":"text"},{"text":" ","type":"text"},{"text":"UNDO \/ QUIT prompt.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"onDeath"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto12DeathOutcomeO","text":"DeathOutcome","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/DeathOutcome"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"text":"Return Value","type":"heading","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Whether the death is consumed or falls through."}]}]},{"kind":"mentions","mentions":["doc:\/\/Gnusto\/documentation\/Gnusto\/DarknessTimeAndDeath"]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The handler runs inside the live turn, so it can do anything a rule"},{"type":"text","text":" "},{"type":"text","text":"can: print prose, move the player ("},{"type":"codeVoice","code":"player.location = forest"},{"type":"text","text":"), dock"},{"type":"text","text":" "},{"type":"text","text":"the score, scatter belongings, bump a death-count "},{"type":"codeVoice","code":"@Global"},{"type":"text","text":". What it"},{"type":"text","text":" "},{"type":"text","text":"returns decides the death’s fate:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/DeathOutcome\/consumed"},{"type":"text","text":" revives the player — the world stays"},{"type":"text","text":" "},{"type":"codeVoice","code":".playing"},{"type":"text","text":", the turn finishes normally (fuses and daemons still"},{"type":"text","text":" "},{"type":"text","text":"tick), no banner or prompt appears."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/DeathOutcome\/fallThrough"},{"type":"text","text":" (the default) runs the standard death"},{"type":"text","text":" "},{"type":"text","text":"path unchanged."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Defaults to "},{"type":"codeVoice","code":".fallThrough"},{"type":"text","text":", so a game that doesn’t implement it dies"},{"type":"text","text":" "},{"type":"text","text":"exactly as before. "},{"type":"codeVoice","code":"UNDO"},{"type":"text","text":" after a consumed death rewinds the whole"},{"type":"text","text":" "},{"type":"text","text":"fatal turn — the death, the resurrection, and everything the handler"},{"type":"text","text":" "},{"type":"text","text":"did — back to where the player stood before it, which is the coherent"},{"type":"text","text":" "},{"type":"text","text":"thing to undo."}]}]}],"identifier":{"url":"doc:\/\/Gnusto\/documentation\/Gnusto\/Game\/onDeath()","interfaceLanguage":"swift"},"sections":[],"variants":[{"paths":["\/documentation\/gnusto\/game\/ondeath()"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"externalID":"s:6Gnusto4GameP7onDeathAA0D7OutcomeOyF","required":true,"role":"symbol","title":"onDeath()","roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onDeath","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:6Gnusto12DeathOutcomeO","text":"DeathOutcome","kind":"typeIdentifier"}],"modules":[{"name":"Gnusto"}],"symbolKind":"method"},"defaultImple