,{"type":"text","text":"thing to undo."}]}],"kind":"content"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/gnusto\/game\/ondeath()"],"traits":[{"interfaceLanguage":"swift"}]}],"defaultImplementationsSections":[{"anchor":"Game-Implementations","title":"Game Implementations","identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/Game\/onDeath()-8o798"]}],"references":{"doc://Gnusto/documentation/Gnusto/Game/onDeath()-8o798":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onDeath","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"DeathOutcome","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto12DeathOutcomeO"}],"url":"\/documentation\/gnusto\/game\/ondeath()-8o798","type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Game\/onDeath()-8o798","abstract":[{"text":"Games without a resurrection story die the standard way.","type":"text"}],"title":"onDeath()"},"doc://Gnusto/documentation/Gnusto/DarknessTimeAndDeath":{"role":"article","type":"topic","kind":"article","url":"\/documentation\/gnusto\/darknesstimeanddeath","title":"Darkness, Time, and Death","abstract":[{"type":"text","text":"Light sources that carry into dark rooms, fuses and daemons that tick the world’s clock, saving and undoing, and killing the player without ending the program."}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/DarknessTimeAndDeath"},"doc://Gnusto/documentation/Gnusto/DeathOutcome":{"url":"\/documentation\/gnusto\/deathoutcome","navigatorTitle":[{"kind":"identifier","text":"DeathOutcome"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/DeathOutcome","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"DeathOutcome"}],"kind":"symbol","title":"DeathOutcome","abstract":[{"type":"text","text":"What a game’s "},{"isActive":true,"type":"reference","identifier":"doc:\/\/