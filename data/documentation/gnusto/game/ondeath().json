{"abstract":[{"text":"Called the instant the player dies — after the ","type":"text"},{"code":"die(_:)","type":"codeVoice"},{"text":" message","type":"text"},{"text":" ","type":"text"},{"text":"prints, but ","type":"text"},{"inlineContent":[{"text":"before","type":"text"}],"type":"emphasis"},{"text":" the death banner and the RESTART \/ RESTORE \/","type":"text"},{"text":" ","type":"text"},{"text":"UNDO \/ QUIT prompt.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto","doc:\/\/Gnusto\/documentation\/Gnusto\/Game"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"onDeath"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"DeathOutcome","preciseIdentifier":"s:6Gnusto12DeathOutcomeO","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/DeathOutcome"}],"platforms":["macOS"]}]},{"content":[{"text":"Return Value","anchor":"return-value","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Whether the death is consumed or falls through."}],"type":"paragraph"}],"kind":"content"},{"mentions":["doc:\/\/Gnusto\/documentation\/Gnusto\/DarknessTimeAndDeath"],"kind":"mentions"},{"content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The handler runs inside the live turn, so it can do anything a rule"},{"type":"text","text":" "},{"type":"text","text":"can: print prose, move the player ("},{"type":"codeVoice","code":"player.location = forest"},{"type":"text","text":"), dock"},{"type":"text","text":" "},{"type":"text","text":"the score, scatter belongings, bump a death-count "},{"type":"codeVoice","code":"@Global"},{"type":"text","text":". What it"},{"type":"text","text":" "},{"type":"text","text":"returns decides the death’s fate:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/DeathOutcome\/consumed","isActive":true,"type":"reference"},{"text":" revives the player — the world stays","type":"text"},{"text":" ","type":"text"},{"code":".playing","type":"codeVoice"},{"text":", the turn finishes normally (fuses and daemons still","type":"text"},{"text":" ","type":"text"},{"text":"tick), no banner or prompt appears.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/DeathOutcome\/fallThrough","isActive":true,"type":"reference"},{"text":" (the default) runs the standard death","type":"text"},{"text":" ","type":"text"},{"text":"path unchanged.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Defaults to "},{"type":"codeVoice","code":".fallThrough"},{"type":"text","text":", so a game that doesn’t implement it dies"},{"type":"text","text":" "},{"type":"text","text":"exactly as before. "},{"type":"codeVoice","code":"UNDO"},{"type":"text","text":" after a consumed death rewinds the whole"},{"type":"text","text":" "},{"type":"text","text":"fatal turn — the death, the resurrection, and everything the handler"},{"type":"text","text":" "},{"type":"text","text":"did — back to where the player stood before it, which is the coherent"},{"type":"text","text":" "},{"type":"text","text":"thing to undo."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"title":"onDeath()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"onDeath"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:6Gnusto12DeathOutcomeO","kind":"typeIdentifier","text":"DeathOutcome"}],"externalID":"s:6Gnusto4GameP7onDeathAA0D7OutcomeOyF","roleHeading":"Instance Method","modules":[{"name":"Gnusto"}],"role":"symbol","required":true,"symbolKind":"method"},"variants":[{"paths":["\/documentation\/gnusto\/game\/ondeath()"],"traits":[{"inte