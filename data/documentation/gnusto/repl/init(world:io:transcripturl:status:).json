tation/Gnusto/IOHandler":{"abstract":[{"text":"Where the game’s text goes and player input comes from. Synchronous by","type":"text"},{"text":" ","type":"text"},{"text":"design: a blocking console read is fine for a CLI; an async variant can","type":"text"},{"text":" ","type":"text"},{"text":"be added later without breaking this protocol’s clients.","type":"text"}],"title":"IOHandler","url":"\/documentation\/gnusto\/iohandler","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"text":"IOHandler","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"IOHandler","kind":"identifier"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler","role":"symbol","type":"topic"},"doc://Gnusto/documentation/Gnusto/GameStatus":{"abstract":[{"type":"text","text":"Whether the game is in progress or how it ended."}],"url":"\/documentation\/gnusto\/gamestatus","title":"GameStatus","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"GameStatus"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"GameStatus"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameStatus","role":"symbol","type":"topic"},"doc://Gnusto/documentation/Gnusto/REPL":{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/REPL","navigatorTitle":[{"kind":"identifier","text":"REPL"}],"title":"REPL","abstract":[{"text":"The outer loop: prompt → parse → perform → print, until the game ends or","type":"text"},{"text":" ","type":"text"},{"text":"input runs out. Holds the only ","type":"text"},{"code":"await","type":"codeVoice"},{"text":" in a Gnusto game.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"REPL"}],"kind":"symbol","role":"symbol","url":"\/documentation\/gnusto\/repl","type":"topic"},"doc://Gnusto/documentation/Gnusto/IOHandler/updateCompletions(_:)":{"abstract":[{"text":"Receives the words Tab-completion may offer for the next input line.","type":"text"},{"text":" ","type":"text"},{"text":"A handler with a line editor uses them; the plain console ignores them.","type":"text"},{"text":" ","type":"text"},{"text":"Called only when ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler\/wantsCompletions","isActive":true,"type":"reference"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":".","type":"text"}],"url":"\/documentation\/gnusto\/iohandler\/updatecompletions(_:)","title":"updateCompletions(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"updateCompletions"},{"kind":"text","text":"("},{"preciseIdentifier":"s:6Gnusto20CompletionCandidatesV","kind":"typeIdentifier","text":"CompletionCandidates"},{"kind":"text","text":")"}],"kind":"symbol","defaultImplementations":1,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler\/updateCompletions(_:)","required":true,"role":"symbol","type":"topic"},"doc://Gnusto/documentation/Gnusto/ScriptedIOHandler":{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/ScriptedIOHandler","navigatorTitle":[{"kind":"identifier","text":"ScriptedIOHandler"}],"title":"ScriptedIOHandler","abstract":[{"type":"text","text":"Feeds a fixed list of commands and records everything into a transcript —"},{"type":"text","text":" "},{"type":"text","text":"for tests and automated playthroughs. Ships in the library because game"},{"type":"text","text":" "},{"type":"text","text":"authors want transcript tests too."}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScriptedIOHandler"}],"kind":"symbol","role":"symbol","url":"\/documentation\/gnusto\/scriptediohandler","type":"topic"},"doc://Gnusto/documentation/Gnusto/IOHandler/wantsCompletions":{"abstract":[{"type":"text","text":"Whether this handler will use the words "},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler\/updateCompletions(_:)","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"delivers. Computing them costs a scope walk and a read of the save"},{"type":"text","text":" "},{"type":"text","text":"directory after every turn, so the REPL asks first and a handler with"},{"type":"text","text":" "},{"type":"text","text":"no line editor — the console, a script, a test — never pays for a set"},{"type":"text","text":" "},{"type":"text","text":"it would throw away. Defaults to "},{"type":"codeVoice","code":"false"},{"type":"text","text":"; "},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TerminalIOHandler","type":"reference","isActive":true},{"type":"text","text":" says"},{"text":" ","type":"text"},{"code":"true","type":"codeVoice"},{"text":".","type":"text"}],"url":"\/documentation\/gnusto\/iohandler\/wantscompletions","title":"wantsCompletions","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"wantsCompletions"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"kind":"symbol","defaultImplementations":1,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler\/wantsCompletions","required":true,"role":"symbol","type":"topic"},"doc://Gnusto/documentation/Gnusto/IOHandler/readLine(prompt:)":{"abstract":[{"type":"text","text":"Prompts for and returns one unit of input; "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" means end of input."}],"url":"\/documentation\/gnusto\/iohandler\/readline(prompt:)","title":"readLine(prompt:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"readLine"},{"kind":"text","text":"("},{"kind":"externalParam","text":"prompt"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:6Gnusto5InputO","kind":"typeIdentifier","text":"Input"},{"kind":"text","text":"?"}],"kind":"sy