","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/CompletionCandidates\/Context-swift.enum"},"doc://Gnusto/documentation/Gnusto/Input":{"role":"symbol","abstract":[{"text":"One unit of player input from an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler"},{"text":": a line for the engine to","type":"text"},{"text":" ","type":"text"},{"text":"run, or a front-end quit request (e.g. Ctrl-C) that ends the game ","type":"text"},{"inlineContent":[{"text":"without","type":"text"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"being parsed as a command — so it can’t be swallowed by an open save\/restore","type":"text"},{"text":" ","type":"text"},{"text":"prompt or clash with a game that has redefined the ","type":"text"},{"code":"quit","type":"codeVoice"},{"text":" verb. The REPL","type":"text"},{"text":" ","type":"text"},{"text":"maps ","type":"text"},{"code":".quit","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"GameWorld.requestQuit()","type":"codeVoice"},{"text":", which is keyed to ","type":"text"},{"code":"Intent.quit","type":"codeVoice"},{"text":" ","type":"text"},{"text":"rather than the editable verb word.","type":"text"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Input","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Input","kind":"identifier"}],"navigatorTitle":[{"text":"Input","kind":"identifier"}],"kind":"symbol","type":"topic","title":"Input","url":"\/documentation\/gnusto\/input"},"doc://Gnusto/documentation/Gnusto/GameStatus":{"role":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameStatus","abstract":[{"text":"Whether the game is in progress or how it ended.","type":"text"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GameStatus","kind":"identifier"}],"navigatorTitle":[{"text":"GameStatus","kind":"identifier"}],"kind":"symbol","type":"topic","title":"GameStatus","url":"\/documentation\/gnusto\/gamestatus"},"doc://Gnusto/documentation/Gnusto/IOHandler/finish(_:)":{"role":"symbol","abstract":[{"text":"Called once when the game reaches an ending (won, lost, or quit),","type":"text"},{"text":" ","type":"text"},{"text":"after the final output has been written. A full-screen handler holds","type":"text"},{"text":" ","type":"text"},{"text":"its last frame for the player and leaves the ending visible on the","type":"text"},{"text":" ","type":"text"},{"text":"primary screen; the default does nothing.","type":"text"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler\/finish(_:)","required":true,"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"finish","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":")","kind":"text"}],"kind":"symbol","type":"topic","title":"finish(_:)","defaultImplementations":1,"url":"\/documentation\/gnusto\/iohandler\/finish(_:)"},"doc://Gnusto/documentation/Gnusto/ScriptedIOHandler":{"navigatorTitle":[{"text":"ScriptedIOHandler","kind":"identifier"}],"abstract":[{"text":"Feeds a fixed list of commands and records everything into a transcript —","type":"text"},{"text":" ","type":"text"},{"text":"for tests and automated playthroughs. Ships in the library because game","type":"text"},{"text":" ","type":"text"},{"text":"authors want transcript tests too.","type":"text"}],"title":"ScriptedIOHandler","kind":"symbol","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScriptedIOHandler","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/ScriptedIOHandler","url":"\/documentation\/gnusto\/scriptediohandler"},"doc://Gnusto/documentation/Gnusto/CompletionCandidates":{"url":"\/documentation\/gnusto\/completioncandidates","type":"topic","title":"CompletionCandidates","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"CompletionCandidates","kind":"identifier"}],"abstract":[{"text":"A snapshot of what Tab-completion can offer for the upcoming input line: the","type":"text"},{"text":" ","type":"text"},{"text":"game’s verbs, the nouns and adjectives currently in scope, the movement","type":"text"},{"text":" ","type":"text"},{"text":"directions, and the save slot names on disk. The engine assembles it after","type":"text"},{"text":" ","type":"text"},{"text":"each turn and pushes it to the IO handler, because the synchronous line","type":"text"},{"text":" ","type":"text"},{"text":"editor can’t reach back into the ","type":"text"},{"type":"codeVoice","code":"GameWorld"},{"text":" actor mid-read.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CompletionCandidates","kind":"identifier"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/CompletionCandidates"},"doc://Gnusto/documentation/Gnusto/GameWorld":{"kind":"symbol","type":"topic","abstract":[{"text":"The game world: owns all state, serializes all mutation, and runs the","type":"text"},{"text":" ","type":"text"},{"text":"turn pipeline. The single ","type":"text"},{"code":"await","type":"codeVoice"},{"text":" in a game sits between the REPL and","type":"text"},{"text":" ","type":"text"},{"text":"this actor.","type":"text"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameWorld","title":"GameWorld","navigatorTitle":[{"text":"GameWorld","kind":"identifier"}],"url":"\/documentation\/gnusto\/gameworld","role":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GameWorld","kind":"identifier"}]},"doc://Gnusto/documentation/Gnusto":{"role":"collection","abstract":[{"type":"text","text":"An engine for writing interactive fiction in Swift."}],"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto","kind":"symbol","title":"Gnusto","url":"\/documentation\/gnusto"},"doc://Gnusto/documentation/