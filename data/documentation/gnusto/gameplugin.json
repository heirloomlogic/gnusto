ier":"s:Si","text":"Int","kind":"typeIdentifier"}],"kind":"symbol","type":"topic","title":"maxScore","defaultImplementations":1,"url":"\/documentation\/gnusto\/game\/maxscore"},"doc://Gnusto/documentation/Gnusto/GamePlugin/actions":{"url":"\/documentation\/gnusto\/gameplugin\/actions","type":"topic","title":"actions","kind":"symbol","required":true,"role":"symbol","abstract":[{"type":"text","text":"Stage-4 default actions the plugin contributes, in the same form as a"},{"type":"text","text":" "},{"type":"text","text":"game’s "},{"type":"codeVoice","code":"actions"},{"type":"text","text":". Defaults to empty. Precedence runs built-ins <"},{"type":"text","text":" "},{"type":"text","text":"bundles\/plugins < host game, so a host action for the same intent beats"},{"type":"text","text":" "},{"type":"text","text":"this one — and this is what lets a plugin’s verbs (like Phase 8’s"},{"type":"text","text":" "},{"type":"text","text":"combat "},{"type":"codeVoice","code":"attack"},{"type":"text","text":") actually do something by default, not just parse."}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"actions"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto12IntentActionV","text":"IntentAction"},{"kind":"text","text":"]"}],"defaultImplementations":1,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin\/actions"},"doc://Gnusto/documentation/Gnusto/GamePlugin/rules":{"role":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin\/rules","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"rules"},{"kind":"text","text":": "},{"preciseIdentifier":"s:6Gnusto5RulesV","kind":"typeIdentifier","text":"Rules"}],"defaultImplementations":1,"url":"\/documentation\/gnusto\/gameplugin\/rules","title":"rules","abstract":[{"type":"text","text":"Self-contained, world-scoped rules the plugin adds without needing"},{"type":"text","text":" "},{"type":"text","text":"anything from the host. Defaults to empty. Rules that must reference the"},{"type":"text","text":" "},{"type":"text","text":"host’s own entities are exposed as parameterized methods instead."}],"type":"topic","kind":"symbol","required":true},"doc://Gnusto/documentation/Gnusto":{"role":"collection","abstract":[{"type":"text","text":"An engine for writing interactive fiction in Swift."}],"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto","kind":"symbol","title":"Gnusto","url":"\/documentation\/gnusto"},"doc://Gnusto/documentation/Gnusto/Plugins":{"kind":"article","type":"topic","abstract":[{"text":"Package a reusable game system as an importable unit of verbs and rules.","type":"text"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Plugins","title":"Plugins","url":"\/documentation\/gnusto\/plugins","role":"article"},"doc://Gnusto/documentation/Gnusto/ScoreDeclaring":{"role":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/ScoreDeclaring","abstract":[{"type":"text","text":"Content that can total the points it pays out, so the bootstrap can check a"},{"type":"text","text":" "},{"type":"text","text":"game’s "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Game\/maxScore"},{"type":"text","text":" against what the game is actually able to award."}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScoreDeclaring","kind":"identifier"}],"navigatorTitle":[{"text":"ScoreDeclaring","kind":"identifier"}],"kind":"symbol","type":"topic","title":"ScoreDeclaring","url":"\/documentation\/gnusto\/scoredeclaring"},"doc://Gnusto/documentation/Gnusto/GamePlugin/timers":{"url":"\/documentation\/gnusto\/gameplugin\/timers","type":"topic","title":"timers","kind":"symbol","required":true,"role":"symbol","abstract":[{"type":"text","text":"Fuses and daemons the plugin contributes, in the same form as a game’s"},{"type":"text","text":" "},{"typ