o/SplittingAGameAcrossFiles":{"abstract":[{"text":"Keep a large game readable by composing its map and rules from per-region helpers.","type":"text"}],"title":"Splitting a Game Across Files","kind":"article","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/SplittingAGameAcrossFiles","type":"topic","url":"\/documentation\/gnusto\/splittingagameacrossfiles","role":"article"},"doc://Gnusto/documentation/Gnusto/Game/maxScore":{"url":"\/documentation\/gnusto\/game\/maxscore","title":"maxScore","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Game\/maxScore","kind":"symbol","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maxScore","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"abstract":[{"text":"The maximum achievable score, rendered in the score line as","type":"text"},{"text":" ","type":"text"},{"text":"“…of a possible N”.","type":"text"}],"role":"symbol","required":true,"defaultImplementations":1},"doc://Gnusto/documentation/Gnusto/ScoreDeclaring":{"url":"\/documentation\/gnusto\/scoredeclaring","title":"ScoreDeclaring","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/ScoreDeclaring","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScoreDeclaring"}],"abstract":[{"text":"Content that can total the points it pays out, so the bootstrap can check a","type":"text"},{"text":" ","type":"text"},{"text":"game’s ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Game\/maxScore"},{"text":" against what the game is actually able to award.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ScoreDeclaring"}]},"doc://Gnusto/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/Gnusto\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://Gnusto/documentation/Gnusto