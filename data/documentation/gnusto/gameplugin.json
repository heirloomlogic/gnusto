this"},{"type":"text","text":" "},{"type":"text","text":"system knows that "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/StatusLine"},{"text":" (room, score, moves) does not. Defaults to empty, and costs nothing unless a footer is in","type":"text"},{"text":" ","type":"text"},{"text":"force.","type":"text"}],"title":"statusFields","url":"\/documentation\/gnusto\/gameplugin\/statusfields","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin\/statusFields"},"doc://Gnusto/documentation/Gnusto/Plugins":{"role":"article","kind":"article","type":"topic","abstract":[{"text":"Package a reusable game system as an importable unit of verbs and rules.","type":"text"}],"title":"Plugins","url":"\/documentation\/gnusto\/plugins","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Plugins"},"doc://Gnusto/documentation/Gnusto/GamePlugin/rules":{"role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"rules"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto5RulesV","text":"Rules"}],"defaultImplementations":1,"required":true,"abstract":[{"text":"Self-contained, world-scoped rules the plugin adds without needing","type":"text"},{"text":" ","type":"text"},{"text":"anything from the host. Defaults to empty. Rules that must reference the","type":"text"},{"text":" ","type":"text"},{"text":"host’s own entities are exposed as parameterized methods instead.","type":"text"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin\/rules","title":"rules","url":"\/documentation\/gnusto\/gameplugin\/rules","kind":"symbol","type":"topic"},"doc://Gnusto/documentation/Gnusto/GameContents":{"role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GameContents","kind":"identifier"}],"navigatorTitle":[{"text":"GameContents","kind":"identifier"}],"type":"topic","title":"GameContents","abstract":[{"type":"text","text":"The collected content bundles a game declares, in declaration order."}],"url":"\/documentation\/gnusto\/gamecontents","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameContents"},"doc://Gnusto/documentation/Gnusto":{"type":"topic","title":"Gnusto","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto","kind":"symbol","abstract":[{"text":"An engine for writing interactive fiction in Swift.","type":"text"}],"role":"collection","url":"\/documentation\/gnusto"},"doc://Gnusto/documentation/Gnusto/WritingRules":{"url":"\/documentation\/gnusto\/writingrules","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/WritingRules","abstract":[{"text":"Attach game logic to items, locations, and the world.","type":"text"}],"title":"Writing Rules","type":"topic","kind":"article","role":"article"}}}