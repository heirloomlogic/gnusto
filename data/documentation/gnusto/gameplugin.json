documentation\/Gnusto\/GamePlugin\/player","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"player"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto6PlayerV","text":"Player"}],"url":"\/documentation\/gnusto\/gameplugin\/player","abstract":[{"type":"text","text":"The player character — usable as a bare identifier in a plugin’s"},{"type":"text","text":" "},{"type":"text","text":"rule and timer bodies, exactly as in a "},{"code":"Game","type":"codeVoice"},{"type":"text","text":"."}],"role":"symbol","kind":"symbol"},"doc://Gnusto/documentation/Gnusto/AddingCustomVerbs":{"kind":"article","url":"\/documentation\/gnusto\/addingcustomverbs","abstract":[{"text":"Teach the parser words the built-in table doesn’t know.","type":"text"}],"role":"article","title":"Adding Custom Verbs","type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/AddingCustomVerbs"},"doc://Gnusto/documentation/Gnusto/GamePlugin/verbs":{"url":"\/documentation\/gnusto\/gameplugin\/verbs","type":"topic","title":"verbs","kind":"symbol","required":true,"role":"symbol","abstract":[{"type":"text","text":"Player-typeable verbs the plugin contributes, in the same form as a"},{"type":"text","text":" "},{"type":"text","text":"game’s "},{"type":"codeVoice","code":"verbs"},{"type":"text","text":". Defaults to empty. Precedence runs built-ins <"},{"type":"text","text":" "},{"type":"text","text":"bundles\/plugins < host game, so a host verb of the same shape beats"},{"type":"text","text":" "},{"type":"text","text":"this one."}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"verbs"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto10SyntaxRuleV","text":"SyntaxRule"},{"kind":"text","text":"]"}],"defaultImplementations":1,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin\/verbs"},"doc://Gnusto/s8SendableP":{"title":"Swift