{"schemaVersion":{"major":0,"patch":0,"minor":3},"relationshipsSections":[{"identifiers":["doc:\/\/Gnusto\/s8SendableP","doc:\/\/Gnusto\/s16SendableMetatypeP"],"kind":"relationships","title":"Inherits From","type":"inheritsFrom"}],"metadata":{"symbolKind":"protocol","navigatorTitle":[{"kind":"identifier","text":"GamePlugin"}],"title":"GamePlugin","modules":[{"name":"Gnusto"}],"externalID":"s:6Gnusto10GamePluginP","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GamePlugin","kind":"identifier"}],"roleHeading":"Protocol"},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"GamePlugin"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Sendable","preciseIdentifier":"s:s8SendableP"}],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/Gnusto\/documentation\/Gnusto\/Plugins","doc:\/\/Gnusto\/documentation\/Gnusto\/AddingCustomVerbs","doc:\/\/Gnusto\/documentation\/Gnusto\/WritingRules"]},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"A plugin bundles the player-typeable vocabulary a system needs (","type":"text"},{"code":"buy","type":"codeVoice"},{"text":",","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"attack"},{"type":"text","text":", "},{"code":"ask","type":"codeVoice"},{"type":"text","text":") with the logic that reacts to it, so the system can be"},{"type":"text","text":" "},{"type":"text","text":"shipped once and reused instead of hand-copied into every game."}]},{"syntax":"swift","code":["struct CommercePlugin: GamePlugin {","    static let buy = Intent(\"buy\")","","    var verbs: [SyntaxRule] {","        SyntaxRule(\"buy\", .directObject, intent: Self.buy)","    }","}"],"type":"codeListing"},{"level":2,"text":"Logic-only: a plugin owns no state","type":"heading","anchor":"Logic-only-a-plugin-owns-no-state"},{"inlineContent":[{"text":"Unlike a ","type":"text"},{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameContent","isActive":true},{"text":" bundle, a plugin is ","type":"text"},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"text":" reflected by the","type":"text"},{"text":" ","type":"text"},{"text":"bootstrap, so it declares no rooms, items, or ","type":"text"},{"type":"codeVoice","code":"@Global"},{"text":" state of its own. It","type":"text"},{"text":" ","type":"text"},{"text":"operates entirely over entities and globals the ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"host"}]},{"text":" declares, receiving","type":"text"},{"text":" ","type":"text"},{"text":"what it needs as parameters. That keeps a plugin portable: it makes no","type":"text"},{"text":" ","type":"text"},{"text":"assumptions about the host’s world beyond the traits and intents it agrees","type":"text"},{"text":" ","type":"text"},{"text":"on. A plugin that genuinely needs to ship its own content is a","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameContent","isActive":true},{"text":" bundle instead (list it in the game’s ","type":"text"},{"type":"codeVoice","code":"content"},{"text":").","type":"text"}],"type":"paragraph"},{"level":2,"text":"The host opts in by splicing","type":"heading","anchor":"The-host-opts-in-by-splicing"},{"inlineContent":[{"text":"The host stores the plugin as a plain property and splices its vocabulary,","type":"text"},{"text":" ","type":"text"},{"text":"default actions, and rules into its own blocks. ","type":"text"},{"code":"verbs","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"actions","type":"codeVoice"},{"text":" each","type":"text"},{"text":" ","type":"text"},{"text":"merge just like a game’s own, and the plugin’s rule factories return","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Rules","type":"reference"},{"text":" the host composes in. Together, ","type":"text"},{"code":"verbs","type":"codeVoice"},{"text":" + ","type":"text"},{"code":"actions","type":"codeVoice"},{"text":" let a plugin","type":"text"},{"text":" ","type":"text"},{"text":"ship a whole verb behavior — vocabulary and stage-4 default — without any","type":"text"},{"text":" ","type":"text"},{"text":"host rules at all; a host only needs its own rules to embellish or","type":"text"},{"text":" ","type":"text"},{"text":"override that default for specific entities.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct LampShop: Game {","    let commerce = CommercePlugin()","    @Global var purse = Purse(coins: 10)","    let lantern = Item { name(\"brass lantern\"); trait(.price, 5) }","","    var verbs: [SyntaxRule] { commerce.verbs }","    var rules: Rules {","        commerce.purchase(of: lantern,","                          balance: { purse.coins },","                          charge:  { purse.coins -= $0 })","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The protocol’s own "},{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin\/rules","isActive":true},{"type":"text","text":" requirement carries only self-contained,"},{"type":"text","text":" "},{"type":"text","text":"world-scoped rules that need nothing from the host. Rules that must reference"},{"type":"text","text":" "},{"type":"text","text":"host entities are exposed as "},{"type":"strong","inlineContent":[{"text":"parameterized methods","type":"text"}]},{"type":"text","text":" returning "},{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Rules","isActive":true},{"type":"text","text":" "},{"text":"(","type":"text"},{"code":"purchase(of:balance:charge:)","type":"codeVoice"},{"text":" above), which the host calls with its own","type":"text"},{"text":" ","type":"text"},{"text":"declarations — every line still readable in the host’s source.","type":"text"}]}]}],"topicSections":[{"identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin\/actions","doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin\/command","doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin\/gameText","doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin\/player","doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin\/rules","doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin\/statusFields","doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin\/timers","doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin\/verbs","doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin\/world"],"generated":true,"title":"Instance Properties","anchor":"Instance-Properties"}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin"},"seeAlsoSections":[{"identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/SplittingAGameAcrossFiles","doc:\/\/Gnusto\/documentation\/Gnusto\/ContentBundles","doc:\/\/Gnusto\/documentation\/Gnusto\/Plugins","doc:\/\/Gnusto\/documentation\/Gnusto\/GameContent","doc:\/\/Gnusto\/documentation\/Gnusto\/GameContents"],"generated":true,"title":"Composing Large Games","anchor":"Composing-Large-Games"}],"abstract":[{"type":"text","text":"A reusable game system — commerce, combat, dialog, magic — packaged as an"},{"type":"text","text":" "},{"type":"text","text":"importable unit of "},{"type":"emphasis","inlineContent":[{"text":"verbs","type":"text"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"rules"}]},{"type":"text","text":", that a host game opts into."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnusto\/gameplugin"]}],"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto"]]},"references":{"doc://Gnusto/documentation/Gnusto/GamePlugin/rules":{"