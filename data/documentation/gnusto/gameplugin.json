{"sections":[],"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto"]]},"topicSections":[{"anchor":"Instance-Properties","identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin\/actions","doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin\/command","doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin\/gameText","doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin\/player","doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin\/rules","doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin\/statusFields","doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin\/timers","doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin\/verbs","doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin\/world"],"title":"Instance Properties","generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnusto\/gameplugin"]}],"relationshipsSections":[{"type":"inheritsFrom","identifiers":["doc:\/\/Gnusto\/s8SendableP","doc:\/\/Gnusto\/s16SendableMetatypeP"],"kind":"relationships","title":"Inherits From"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin"},"metadata":{"navigatorTitle":[{"kind":"identifier","text":"GamePlugin"}],"symbolKind":"protocol","modules":[{"name":"Gnusto"}],"fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"text":"GamePlugin","kind":"identifier"}],"roleHeading":"Protocol","externalID":"s:6Gnusto10GamePluginP","title":"GamePlugin","role":"symbol"},"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"A reusable game system — commerce, combat, dialog, magic — packaged as an","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"importable unit of "},{"inlineContent":[{"text":"verbs","type":"text"}],"type":"emphasis"},{"text":" and ","type":"text"},{"inlineContent":[{"text":"rules","type":"text"}],"type":"emphasis"},{"type":"text","text":", that a host game opts into."}],"kind":"symbol","seeAlsoSections":[{"anchor":"Composing-Large-Games","identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/SplittingAGameAcrossFiles","doc:\/\/Gnusto\/documentation\/Gnusto\/ContentBundles","doc:\/\/Gnusto\/documentation\/Gnusto\/Plugins","doc:\/\/Gnusto\/documentation\/Gnusto\/GameContent","doc:\/\/Gnusto\/documentation\/Gnusto\/GameContents","doc:\/\/Gnusto\/documentation\/Gnusto\/ScoreDeclaring"],"title":"Composing Large Games","generated":true}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GamePlugin","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Sendable","preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/Gnusto\/documentation\/Gnusto\/Plugins","doc:\/\/Gnusto\/documentation\/Gnusto\/AddingCustomVerbs","doc:\/\/Gnusto\/documentation\/Gnusto\/WritingRules"]},{"content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"A plugin bundles the player-typeable vocabulary a system needs ("},{"type":"codeVoice","code":"buy"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"attack"},{"type":"text","text":", "},{"type":"codeVoice","code":"ask"},{"type":"text","text":") with the logic that reacts to it, so the system can be"},{"type":"text","text":" "},{"type":"text","text":"shipped once and reused instead of hand-copied into every game."}],"type":"paragraph"},{"syntax":"swift","code":["struct CommercePlugin: GamePlugin {","    static let buy = Intent(\"buy\")","","    var verbs: [SyntaxRule] {","        SyntaxRule(\"buy\", .directObject, intent: Self.buy)","    }","}"],"type":"codeListing"},{"anchor":"Logic-only-a-plugin-owns-no-state","text":"Logic-only: a plugin owns no state","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Unlike a "},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameContent","type":"reference","isActive":true},{"type":"text","text":" bundle, a plugin is "},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" reflected by the"},{"type":"text","text":" "},{"type":"text","text":"bootstrap, so it declares no rooms, items, or "},{"type":"codeVoice","code":"@Global"},{"type":"text","text":" state of its own. It"},{"type":"text","text":" "},{"type":"text","text":"operates entirely over entities and globals the "},{"type":"strong","inlineContent":[{"text":"host","type":"text"}]},{"type":"text","text":" declares, receiving"},{"type":"text","text":" "},{"type":"text","text":"what it needs as parameters. That keeps a plugin portable: it makes no"},{"type":"text","text":" "},{"type":"text","text":"assumptions about the host’s world beyond the traits and intents it agrees"},{"type":"text","text":" "},{"type":"text","text":"on. A plugin that genuinely needs to ship its own content is a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameContent","isActive":true},{"type":"text","text":" bundle instead (list it in the game’s "},{"type":"codeVoice","code":"content"},{"type":"text","text":")."}],"type":"paragraph"},{"anchor":"The-host-opts-in-by-splicing","text":"The host opts in by splicing","type":"heading","level":2},{"inlineContent":[{"text":"The host stores the plugin as a plain property and splices its vocabulary,","type":"text"},{"text":" ","type":"text"},{"text":"default actions, and rules into its own blocks. ","type":"text"},{"code":"verbs","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"actions","type":"codeVoice"},{"text":" each","type":"text"},{"text":" ","type":"text"},{"text":"merge just like a game’s own, and the plugin’s rule factories return","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Rules","isActive":true,"type":"reference"},{"text":" the host composes in. Together, ","type":"text"},{"code":"verbs","type":"codeVoice"},{"type":"text","text":" + "},{"code":"actions","type":"codeVoice"},{"type":"text","text":" let a plugin"},{"type":"text","text":" "},{"type":"text","text":"ship a whole verb behavior — vocabulary and stage-4 default — without any"},{"type":"text","text":" "},{"type":"text","text":"host rules at all; a host only needs its own rules to embellish or"},{"type":"text","text":" "},{"text":"override that default for specific entities.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct LampShop: Game {","    let commerce = CommercePlugin()","    @Global var purse = Purse(coins: 10)","    let lantern = Item { name(\"brass lantern\"); trait(.price, 5) }","","    var verbs: [SyntaxRule] { commerce.verbs }","    var rules: Rules {","        commerce.purchase(of: lantern,","                          balance: { purse.coins },","                          charge:  { purse.coins -= $0 })","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The protocol’s own "},{"isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin\/rules","type":"reference"},{"type":"text","text":" requirement carries only self-contained,"},{"type":"text","text":" "},{"type":"text","text":"world-scoped rules that need nothing from the host. Rules that must reference"},{"type":"text","text":" "},{"type":"text","text":"host entities are exposed as "},{"type":"strong","inlineContent":[{"type":"text","text":"parameterized methods"}]},{"type":"text","text":" returning "},{"isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Rules","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"purchase(of:balance:charge:)"},{"text":" above), which the host calls with its own","type":"text"},{"text":" ","type":"text"},{"text":"declarations — every line still readable in the host’s source.","type":"text"}]}],"kind":"content"}],"references":{"doc://Gnusto/s16SendableMetatypeP":{"identifier":"doc:\/\/Gnusto\/s16SendableMetatypeP","title":"Swift.SendableMetatype","type":"unresolvable"},"doc://Gnusto/documentation/Gnusto/GamePlugin/world":{"type":"topic","title":"world","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin\/world","abstract":[{"type":"text","text":"The whole world — for plugin rules that apply everywhere."}],"kind":"symbol","role":"symbol","url":"\/documentation\/gnusto\/gameplugin\/world","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"world"},{"kind":"text","text":": "},{"preciseIdentifier":"s:6Gnusto5WorldV","kind":"typeIdentifier","text":"World"}]},"doc://Gnusto/documentation/Gnusto/GamePlugin/actions":{"kind":"symbol","required":true,"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"actions"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto12IntentActionV","text":"IntentAction"},{"kind":"text","text":"]"}],"type":"topic","url":"\/documentation\/gnusto\/gameplugin\/actions","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin\/actions","role":"symbol","defaultImplementations":1,"abstract":[{"text":"Stage-4 default actions the plugin contributes, in the same form as a","type":"text"},{"text":" ","type":"text"},{"text":"game’s ","type":"text"},{"code":"actions","type":"codeVoice"},{"type":"text","text":". Defaults to empty. Precedence runs built-ins <"},{"type":"text","text":" "},{"type":"text","text":"bundles\/plugins < host game, so a host action for the same intent beats"},{"type":"text","text":" "},{"type":"text","text":"this one — and this is what lets a plugin’s verbs (like Phase 8’s"},{"type":"text","text":" "},{"type":"text","text":"combat "},{"type":"codeVoice","code":"attack"},{"type":"text","text":") actually do something by default, not just parse."}],"title":"actions"},"doc://Gnusto/documentation/Gnusto/GamePlugin/c