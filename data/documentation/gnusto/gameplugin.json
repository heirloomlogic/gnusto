ons the plugin contributes, in the same form as a"},{"type":"text","text":" "},{"type":"text","text":"game’s "},{"type":"codeVoice","code":"actions"},{"type":"text","text":". Defaults to empty. Precedence runs built-ins <"},{"type":"text","text":" "},{"type":"text","text":"bundles\/plugins < host game, so a host action for the same intent beats"},{"type":"text","text":" "},{"type":"text","text":"this one — and this is what lets a plugin’s verbs (like Phase 8’s"},{"type":"text","text":" "},{"type":"text","text":"combat "},{"type":"codeVoice","code":"attack"},{"type":"text","text":") actually do something by default, not just parse."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin\/actions","required":true,"role":"symbol"},"doc://Gnusto/documentation/Gnusto/ScoreDeclaring":{"type":"topic","url":"\/documentation\/gnusto\/scoredeclaring","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScoreDeclaring","kind":"identifier"}],"kind":"symbol","title":"ScoreDeclaring","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/ScoreDeclaring","navigatorTitle":[{"kind":"identifier","text":"ScoreDeclaring"}],"abstract":[{"text":"Content that can total the points it pays out, so the bootstrap can check a","type":"text"},{"text":" ","type":"text"},{"text":"game’s ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Game\/maxScore","type":"reference"},{"text":" against what the game is actually able to award.","type":"text"}],"role":"symbol"},"doc://Gnusto/s8SendableP":{"title":"Swift.Sendable","identifier":"doc:\/\/Gnusto\/s8SendableP","type":"unresolvable"},"doc://Gnusto/documentation/Gnusto/GamePlugin":{"type":"topic","url":"\/documentation\/gnusto\/gameplugin","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GamePlugin","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin","title":"GamePlugin","navigatorTitle":[{"text":"GamePlugin","kind":"identifier"}],"abstract":[{"text":"A reusable game system — commerce, combat, dialog, magic — packaged as an","type":"text"},{"text":" ","type":"text"},{"text":"importable unit of ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"verbs","type":"text"}]},{"text":" and ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"rules","type":"text"}]},{"text":", that a host game opts into.","type":"text"}],"role":"symbol"},"doc://Gnusto/documentation/Gnusto/GamePlugin/rules":{"defaultImplementations":1,"abstract":[{"text":"Self-contained, world-scoped rules the plugin adds without needing","type":"text"},{"text":" ","type":"text"},{"text":"anything from the host. Defaults to empty. Rules that must reference the","type":"text"},{"text":" ","type":"text"},{"text":"host’s own entities are exposed as parameterized methods instead.","type":"text"}],"kind":"symbol","type":"topic","required":true,"role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rules","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Rules","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto5RulesV"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin\/rules","url":"\/documentation\/gnusto\/gameplugin\/rules","title":"rules"},"doc://Gnusto/documentation/Gnusto/GamePlugin/player":{"role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"player","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Player","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto6PlayerV"}],"type":"topic","kind":"symbol","abstract":[{"text":"The player character — usable as a bare identifier in a plugin’s","type":"text"},{"text":" ","type":"text"},{"text":"rule and timer bodies, exactly as in a ","type":"text"},{"type":"codeVoice","code":"Game"},{"text":".","type":"text"}],"title":"player","url":"\/documentation\/gnusto\/gameplugin\/player","