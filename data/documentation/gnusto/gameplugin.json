","kind":"symbol","title":"verbs","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"verbs"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:6Gnusto10SyntaxRuleV","kind":"typeIdentifier","text":"SyntaxRule"},{"text":"]","kind":"text"}]},"doc://Gnusto/documentation/Gnusto/GamePlugin/actions":{"url":"\/documentation\/gnusto\/gameplugin\/actions","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin\/actions","required":true,"role":"symbol","abstract":[{"text":"Stage-4 default actions the plugin contributes, in the same form as a","type":"text"},{"text":" ","type":"text"},{"text":"game’s ","type":"text"},{"code":"actions","type":"codeVoice"},{"text":". Defaults to empty. Precedence runs built-ins <","type":"text"},{"text":" ","type":"text"},{"text":"bundles\/plugins < host game, so a host action for the same intent beats","type":"text"},{"text":" ","type":"text"},{"text":"this one — and this is what lets a plugin’s verbs (like Phase 8’s","type":"text"},{"text":" ","type":"text"},{"text":"combat ","type":"text"},{"code":"attack","type":"codeVoice"},{"text":") actually do something by default, not just parse.","type":"text"}],"defaultImplementations":1,"type":"topic","kind":"symbol","title":"actions","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"actions","kind":"identifier"},{"text":": [","kind":"text"},{"text":"IntentAction","preciseIdentifier":"s:6Gnusto12IntentActionV","kind":"typeIdentifier"},{"text":"]","kind":"text"}]},"doc://Gnusto/documentation/Gnusto/WritingRules":{"kind":"article","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/WritingRules","type":"topic","abstract":[{"type":"text","text":"Attach game logic to items, locations, and the world."}],"title":"Writing Rules","role":"article","url":"\/documentation\/gnusto\/writingrules"},"doc://Gnusto/documentation/Gnusto/Plugins":{"url":"\/documentation\/gnusto\/plugins","identifier":"doc:\/\/Gnusto\/documentati