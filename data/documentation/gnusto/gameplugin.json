{"relationshipsSections":[{"title":"Inherits From","identifiers":["doc:\/\/Gnusto\/s8SendableP","doc:\/\/Gnusto\/s16SendableMetatypeP"],"type":"inheritsFrom","kind":"relationships"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"GamePlugin"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP","text":"Sendable"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"mentions":["doc:\/\/Gnusto\/documentation\/Gnusto\/AddingCustomVerbs","doc:\/\/Gnusto\/documentation\/Gnusto\/Plugins","doc:\/\/Gnusto\/documentation\/Gnusto\/WritingRules"],"kind":"mentions"},{"content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"inlineContent":[{"text":"A plugin bundles the player-typeable vocabulary a system needs (","type":"text"},{"code":"buy","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"attack","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ask","type":"codeVoice"},{"text":") with the logic that reacts to it, so the system can be","type":"text"},{"text":" ","type":"text"},{"text":"shipped once and reused instead of hand-copied into every game.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct CommercePlugin: GamePlugin {","    static let buy = Intent(\"buy\")","","    var verbs: [SyntaxRule] {","        SyntaxRule(\"buy\", .directObject, intent: Self.buy)","    }","}"]},{"level":2,"type":"heading","anchor":"Logic-only-a-plugin-owns-no-state","text":"Logic-only: a plugin owns no state"},{"inlineContent":[{"text":"Unlike a ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameContent","isActive":true,"type":"reference"},{"text":" bundle, a plugin’s stored children are not","type":"text"},{"text":" ","type":"text"},{"text":"registered or namespaced by the bootstrap, so it declares no rooms, items,","type":"text"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"code":"@Global","type":"codeVoice"},{"text":" state of its own. It operates entirely over entities and globals","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"inlineContent":[{"text":"host","type":"text"}],"type":"strong"},{"text":" declares, receiving what it needs as parameters. That keeps a","type":"text"},{"text":" ","type":"text"},{"text":"plugin portable: it makes no","type":"text"},{"text":" ","type":"text"},{"text":"assumptions about the host’s world beyond the traits and intents it agrees","type":"text"},{"text":" ","type":"text"},{"text":"on. A plugin that genuinely needs to ship its own content is a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameContent","isActive":true,"type":"reference"},{"text":" bundle instead (list it in the game’s ","type":"text"},{"code":"content","type":"codeVoice"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"The bootstrap enforces that boundary: a stored plugin containing a","type":"text"},{"text":" ","type":"text"},{"code":"Location","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Item","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Actor","type":"codeVoice"},{"text":", ","type":"text"},{"code":"@Global","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"@Latch","type":"codeVoice"},{"text":" is rejected before play.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"The-host-opts-in-by-splicing","text":"The host opts in by splicing"},{"inlineContent":[{"text":"The host stores the plugin as a plain property and splices its vocabulary,","type":"text"},{"text":" ","type":"text"},{"text":"default actions, and rules into its own blocks. ","type":"text"},{"code":"verbs","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"actions","type":"codeVoice"},{"text":" each","type":"text"},{"text":" ","type":"text"},{"text":"merge just like a game’s own, and the plugin’s rule factories return","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Rules","isActive":true,"type":"reference"},{"text":" the host composes in. Together, ","type":"text"},{"code":"verbs","type":"codeVoice"},{"text":" + ","type":"text"},{"code":"actions","type":"codeVoice"},{"text":" let a plugin","type":"text"},{"text":" ","type":"text"},{"text":"ship a whole verb behavior — vocabulary and stage-4 default — without any","type":"text"},{"text":" ","type":"text"},{"text":"host rules at all; a host only needs its own rules to embellish or","type":"text"},{"text":" ","type":"text"},{"text":"override that default for specific entities.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct LampShop: Game {","    let commerce = CommercePlugin()","    @Global var purse = Purse(coins: 10)","    let lantern = Item { name(\"brass lantern\"); trait(.price, 5) }","","    var verbs: [SyntaxRule] { commerce.verbs }","    var rules: Rules {","        commerce.purchase(of: lantern,","                          balance: { purse.coins },","                          charge:  { purse.coins -= $0 })","    }","}"]},{"inlineContent":[{"text":"The protocol’s own ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin\/rules","isActive":true,"type":"reference"},{"text":" requirement carries only self-contained,","type":"text"},{"text":" ","type":"text"},{"text":"world-scoped rules that need nothing from the host. Rules that must reference","type":"text"},{"text":" ","type":"text"},{"text":"host entities are exposed as ","type":"text"},{"inlineContent":[{"text":"parameterized methods","type":"text"}],"type":"strong"},{"text":" returning ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Rules","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"purchase(of:balance:charge:)","type":"codeVoice"},{"text":" above), which the host calls with its own","type":"text"},{"text":" ","type":"text"},{"text":"declarations — every line still readable in the host’s source.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"A reusable game system — commerce, combat, dialog, magic — packaged as an","type":"text"},{"text":" ","type":"text"},{"text":"importable unit of ","type":"text"},{"inlineContent":[{"type":"text","text":"verbs"}],"type":"emphasis"},{"text":" and ","type":"text"},{"inlineContent":[{"text":"rules","type":"text"}],"type":"emphasis"},{"text":", that a host game opts into.","type":"text"}],"kind":"symbol","sections":[],"topicSections":[{"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin\/actions","doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin\/command","doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin\/gameText","doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin\/player","doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin\/rules","doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin\/statusFields","doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin\/timers","doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin\/verbs","doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin\/world"],"generated":true}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/Gnusto\/documentation\/Gnusto\/GamePlugin","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/gnusto\/gameplugin"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"GamePlugin","navigatorTitle":[{"text":"GamePlugin","kind":"identifier"}],"modules":[{"name":"Gnusto"}],"symbolKind":"protocol","role":"symbol","externalID":"s:6Gnusto10GamePluginP","roleHeading":"Protocol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"GamePlugin"}]},"seeAlsoSections":[{"title":"Composing 