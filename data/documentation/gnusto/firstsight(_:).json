 goes no deeper, so this trait on"},{"type":"text","text":" "},{"type":"text","text":"something the map buries two levels down has nowhere to print — the"},{"type":"text","text":" "},{"type":"text","text":"bootstrap warns rather than leaving the line to read as live."}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"inlineContent":[{"text":"room listing","type":"text"}],"type":"emphasis"},{"text":" is the whole of its scope. OPEN, SEARCH and INVENTORY","type":"text"},{"text":" ","type":"text"},{"text":"enumerate contents into one sentence — “Opening the box reveals a violin.” —","type":"text"},{"text":" ","type":"text"},{"text":"where a room description composes paragraphs, so those name the thing rather","type":"text"},{"text":" ","type":"text"},{"text":"than describing it and this line does not reach them.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"On an ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Actor","isActive":true,"type":"reference"},{"text":" the same trait is the ","type":"text"},{"inlineContent":[{"type":"text","text":"standing presence line"}],"type":"emphasis"},{"text":" (ZIL’s","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"LDESC role): printed on every look, never worn off by handling — people"},{"type":"text","text":" "},{"type":"text","text":"aren’t props."}],"type":"paragraph"}]}],"kind":"symbol","sections":[],"references":{"doc://Gnusto/documentation/Gnusto/surface":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"surface","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ItemTrait","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto9ItemTraitV"}],"abstract":[{"type":"text","text":"Other items can be put on this item."}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/surface","role":"symbol","kind":"symbol","url":"\/documentation\/gnusto\/surface","type":"topic","title":"surface"},"doc://Gnusto/documentation/Gnusto/WritingRules":{"kind":"article","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/WritingRules","type":"topic","abstract":[{"type":"text","text":"Attach game logic to items, locations, and the world."}],"title":"Writing Rules","role":"article","url":"\/documentation\/gnusto\/writingrules"},"doc://Gnusto/documentation/Gnusto/startsOpen":{"fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"startsOpen"},{"kind":"text","text":": "},{"preciseIdentifier":"s:6Gnusto9ItemTraitV","text":"ItemTrait","kind":"typeIdentifier"}],"url":"\/documentation\/gnusto\/startsopen","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/startsOpen","title":"startsOpen","abstract":[{"type":"text","text":"An "},{"code":"openable","type":"codeVoice"},{"type":"text","text":" item begins the game open rather than closed."}],"role":"symbol","kind":"symbol","type":"topic"},"doc://Gnusto/documentation/Gnusto/synonyms(_:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"synonyms"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"...) -> "},{"preciseIdentifier":"s:6Gnusto9ItemTraitV","kind":"typeIdentifier","text":"ItemTrait"}],"abstract":[{"type":"text","text":"Alternative nouns the parser accepts for the item."}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/synonyms(_:)","role":"symbol","kind":"symbol","url":"\/documentation\/gnusto\/synonyms(_:)","type":"topic","title":"synonyms(_:)"},"doc://Gnusto/documentation/Gnusto/LocationTrait":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LocationTrait","kind":"identifier"}],"url":"\/documentation\/gnusto\/locationtrait","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/LocationTrait","title":"LocationTrait","abstract":[{"text":"A single fact about a location, stated inside a ","type":"text"},{"code":"Location { … }","type":"codeVo