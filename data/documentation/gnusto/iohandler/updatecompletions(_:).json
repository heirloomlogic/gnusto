er":"s:SS","text":"String"},{"kind":"text","text":")"}],"role":"symbol","title":"write(_:)","required":true,"url":"\/documentation\/gnusto\/iohandler\/write(_:)","abstract":[{"text":"Writes pre-formatted text (no trailing-newline policy is implied).","type":"text"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler\/write(_:)","type":"topic","kind":"symbol"},"doc://Gnusto/documentation/Gnusto/IOHandler/readLine(prompt:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"readLine","kind":"identifier"},{"text":"(","kind":"text"},{"text":"prompt","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:6Gnusto5InputO","text":"Input","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"required":true,"type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/gnusto\/iohandler\/readline(prompt:)","title":"readLine(prompt:)","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler\/readLine(prompt:)","abstract":[{"type":"text","text":"Prompts for and returns one unit of input; "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" means end of input."}]},"doc://Gnusto/documentation/Gnusto/ScriptedIOHandler":{"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScriptedIOHandler"}],"navigatorTitle":[{"kind":"identifier","text":"ScriptedIOHandler"}],"kind":"symbol","url":"\/documentation\/gnusto\/scriptediohandler","title":"ScriptedIOHandler","abstract":[{"type":"text","text":"Feeds a fixed list of commands and records everything into a transcript —"},{"type":"text","text":" "},{"type":"text","text":"for tests and automated playthroughs. Ships in the library because game"},{"type":"text","text":" "},{"type":"text","text":"authors want transcript tests too."}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/ScriptedIOHandler"},"doc://Gnusto/documentation/Gnusto/IOHandler/finish(_:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"finish","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":")","kind":"text"}],"role":"symbol","title":"finish(_:)","defaultImplementations":1,"required":true,"url":"\/documentation\/gnusto\/iohandler\/finish(_:)","abstract":[{"type":"text","text":"Called once when the game reaches an ending (won, lost, or quit),"},{"type":"text","text":" "},{"type":"text","text":"after the final output has been written. A full-screen handler holds"},{"type":"text","text":" "},{"type":"text","text":"its last frame for the player and leaves the ending visible on the"},{"type":"text","text":" "},{"type":"text","text":"primary screen; the default does nothing."}],"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler\/finish(_:)","kind":"symbol"},"doc://Gnusto/documentation/Gnusto/GameStatus":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GameStatus","kind":"identifier"}],"navigatorTitle":[{"text":"GameStatus","kind":"identifier"}],"type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/gnusto\/gamestatus","title":"GameStatus","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameStatus","abstract":[{"type":"text","text":"Whether the game is in progress or how it ended."}]},"doc://Gnusto/documentation/Gnusto/StatusLine":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"StatusLine","kind":"identifier"}],"navigatorTitle":[{"text":"StatusLine","kind":"identifier"}],"type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/gnusto\/statusline","title":"StatusLine","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/StatusLine","abstract":[{"type":"text","text":"The status line a handler can display: location, score, and turn count."}]},"doc://Gnusto/documentation/Gnusto/Input":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Input","kind":"identifier"}],"navigatorTitle":[{"text":"Input","kind":"identifier"}],"type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/gnusto\/input","title":"Input","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Input","abstract":[{"type":"text","text":"One unit of player input from an "},{"isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler","type":"reference"},{"type":"text","text":": a line for the engine to"},{"type":"text","text":" "},{"type":"text","text":"run, or a front-end quit request (e.g. Ctrl-C) that ends the game "},{"type":"emphasis","inlineContent":[{"type":"text","text":"without"}]},{"type":"text","text":" "},{"type":"text","text":"being parsed as a command — so it can’t be swallowed by an open save\/restore"},{"type":"text","text":" "},{"type":"text","text":"prompt or clash with a game that has redefined the "},{"code":"quit","type":"codeVoice"},{"type":"text","text":" verb. The REPL"},{"type":"text","text":" "},{"type":"text","text":"maps "},{"code":".quit","type":"codeVoice"},{"type":"text","text":" to "},{"code":"GameWorld.requestQuit()","type":"codeVoice"},{"type":"text","text":", which is keyed to "},{"code":"Intent.quit","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"rather than the editable verb word."}]},"doc://Gnusto/documentation/Gnusto/TerminalIOHandler":{"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"TerminalIOHandler","kind":"identifier"}],"navigatorTitle":[{"text":"TerminalIOHandler","kind":"identifier"}],"url":"\/documentation\/gnusto\/terminaliohandler","kind":"symbol","title":"TerminalIOHandler","abstract":[{"type":"text","text":"A full-screen, Infocom-style terminal front end: a fixed status bar (room,"},{"type":"text","text":" "},{"type":"text","text":"score, turns) above a story window that re-wraps its entire transcript to"},{"type":"text","text":" "},{"type":"text","text":"the window width — so resizing the terminal reflows the text — with its own"},{"type":"text","text":" "},{"type":"text","text":"line editor (arrow keys, history) and PageUp\/PageDown scrollback."}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TerminalIOHandler"},"doc://Gnusto/documentation/Gnusto/IOHandler/wantsCompletions":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"wantsCompletions","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"role":"symbol","title":"wantsCompletions","defaultImplementations":1,"required":true,"url":"\/documentation\/gnusto\/iohandler\/wantscompletions","abstract":[{"type":"text","text":"Whether this handler will use the words "},{"isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler\/updateCompletions(_:)","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"delivers. Computing them costs a scope walk and a read of the save"},{"type":"text","text":" "},{"type":"text","text":"directory after every turn, so the REPL asks first and a handler with"},{"type":"text","text":" "},{"type":"text","text":"no line editor — the console, a script, a test — never pays for a set"},{"type":"text","text":" "},{"type":"text","text":"it would throw away. Defaults to "},{"code":"false","type":"codeVoice"},{"type":"text","text":"; "},{"isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TerminalIOHandler","type":"reference"},{"type":"text","text":" says"},{"type":"text","text":" "},{"code":"true","type":"codeVoice"},{"type":"text","text":"."}],"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler\/wantsCompletions","kind":"symbol"},"doc://Gnusto/documentation/Gnusto/CompletionCandidates":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CompletionCandidates","kind":"identifier"}],"role":"symbol","title":"CompletionCandidates","url":"\/documentation\/gnusto\/completioncandidates","navigatorTitle":[{"text":"CompletionCandidates","kind":"identifier"}],"abstract":[{"text":"A snapshot of what Tab-completion can offer for the upcoming input line: the","type":"text"},{"text":" ","type":"text"},{"text":"game’s verbs, the nouns and adjectives currently in scope, the movement","type":"text"},{"text":" ","type":"text"},{"text":"directions, and the save slot names on disk. The engine assembles it after","type":"text"},{"text":" ","type":"text"},{"text":"each turn and pushes it to the IO handler, because the synchronous line","type":"text"},{"text":" ","type":"text"},{"text":"editor can’t reach back into the ","type":"text"},{"type":"codeVoice","code":"GameWorld"},{"text":" actor mid-read.","type":"text"}],"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/CompletionCandidates","kind":"symbol"},"doc://Gnusto/documentation/Gnusto/CompletionCandidates/Context-swift.enum":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Context","kind":"identifier"}],"navigatorTitle":[{"text":"Context","kind":"identifier"}],"type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/gnusto\/completioncandidates\/context-swift.enum","title":"CompletionCandidates.Context","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/CompletionCandidates\/Context-swift.enum","abstract":[{"type":"text","text":"What the next input line will be read as, which decides the pool: a"},{"type":"text","text":" "},{"type":"text","text":"normal command, or a save\/restore filename."}]},"doc://Gnusto/documentation/Gnusto/IOHandler":{"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"IOHandler"}],"navigatorTitle":[{"kind":"identifier","text":"IOHandler"}],"kind":"symbol","url":"\/documentation\/gnusto\/iohandler","title":"IOHandler","abstract":[{"type":"text","text":"Where the game’s text goes and player input comes from. Synchronous by"},{"type":"text","text":" "},{"type":"text","text":"design: a blocking console read is fine for a CLI; an async variant can"},{"type":"text","text":" "},{"type":"text","text":"be added later without breaking this protocol’s clients."}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler"},"doc://Gnusto/documentation/Gnusto/IOHandler/showStatus(_:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"showStatus","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:6Gnusto10StatusLineV","text":"StatusLine","kind":"typeIdentifier"},{"text":")","kind":"text"}],"required":true,"type":"topic","defaultImplementations":1,"role":"symbol","kind":"symbol","url":"\/documentation\/gnusto\/iohandler\/showstatus(_:)","title":"showStatus(_:)","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler\/showStatus(_:)","abstract":[{"type":"text","text":"Optionally displays a status line (location, score, turns)."}]},"doc://Gnusto/documentation/Gnusto/ConsoleIOHandler":{"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ConsoleIOHandler"}],"navigatorTitle":[{"kind":"identifier","text":"ConsoleIOHandler"}],"kind":"symbol","url":"\/documentation\/gnusto\/consoleiohandler","title":"ConsoleIOHandler","abstract":[{"type":"text","text":"Plain terminal IO."}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/ConsoleIOHandler"},"doc://Gnusto/documentation/Gnusto/IOHandler/updateCompletions(_:)-2xm49":{"url":"\/documentation\/gnusto\/iohandler\/updatecompletions(_:)-2xm49","abstract":[{"type":"text","text":"Defaults to ignoring completion candidates."}],"kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"updateCompletions","kind":"identifier