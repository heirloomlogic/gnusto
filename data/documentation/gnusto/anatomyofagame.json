ind":"typeIdentifier","text":"ItemTrait"}],"kind":"symbol","title":"scenery","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/scenery","abstract":[{"text":"The item is part of the scenery: it cannot be taken, and it never earns a","type":"text"},{"text":" ","type":"text"},{"text":"stock listing sentence — on the floor, on a surface, or inside a container","type":"text"},{"text":" ","type":"text"},{"text":"alike. Its ","type":"text"},{"code":"firstSight","type":"codeVoice"},{"text":" text, if any, still appears; ","type":"text"},{"code":"scenery","type":"codeVoice"},{"text":" withholds the","type":"text"},{"text":" ","type":"text"},{"text":"engine’s line, never the author’s.","type":"text"}],"role":"symbol"},"doc://Gnusto/documentation/Gnusto/Item/name":{"title":"name","role":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/name","kind":"symbol","abstract":[{"text":"The item’s display name.","type":"text"}],"url":"\/documentation\/gnusto\/item\/name","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"name","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}]},"doc://Gnusto/documentation/Gnusto/BootstrapDiagnostics":{"kind":"article","title":"Bootstrap Diagnostics","role":"collectionGroup","type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/BootstrapDiagnostics","abstract":[{"type":"text","text":"Every message the bootstrap can print, and what to change."}],"url":"\/documentation\/gnusto\/bootstrapdiagnostics"},"doc://Gnusto/documentation/Gnusto/Item/isHeld":{"title":"isHeld","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isHeld","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"role":"symbol","type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/isHeld","abstract":[{"type":"text","tex