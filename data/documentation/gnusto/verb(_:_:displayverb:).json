{"metadata":{"title":"verb(_:_:displayVerb:)","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"verb"},{"kind":"text","text":"("},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", ["},{"preciseIdentifier":"s:6Gnusto13SyntaxElementO","kind":"typeIdentifier","text":"SyntaxElement"},{"kind":"text","text":"]..., "},{"kind":"externalParam","text":"displayVerb"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?)"}],"externalID":"s:6Gnusto4verb__11displayVerbySS_SayAA13SyntaxElementOGdSSSgtcfm","roleHeading":"Macro","modules":[{"name":"Gnusto"}],"role":"symbol","symbolKind":"macro"},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Declares a custom player-typeable verb in one place: a typed intent"},{"type":"text","text":" "},{"type":"text","text":"constant plus the verb rows that produce it."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnusto\/verb(_:_:displayverb:)"]}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@freestanding"},{"kind":"text","text":"(declaration, names: arbitrary) "},{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"verb"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"intentName"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"patterns"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:6Gnusto13SyntaxElementO","kind":"typeIdentifier","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/SyntaxElement","text":"SyntaxElement"},{"kind":"text","text":"]..., "},{"kind":"externalParam","text":"displayVerb"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"? = nil)"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Use it inside an ","type":"text"},{"code":"extension Intent","type":"codeVoice"},{"text":" — that’s what makes the leading-dot","type":"text"},{"text":" ","type":"text"},{"text":"spelling work everywhere an ","type":"text"},{"code":"Intent","type":"codeVoice"},{"text":" is expected:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["extension Intent {","    #verb(\"ring\", [\"ring\", .directObject])","    #verb(\"barter\",","          [\"barter\", .directObject],","          [\"barter\", .directObject, \"for\", .indirectObject],","          [\"haggle\", \"over\", .directObject])","    #verb(\"chime\")                           \/\/ pattern defaults to [\"chime\"]","    #verb(\"steal\", [\"take\", .directObject])  \/\/ reclaim a built-in verb","}"]},{"type":"paragraph","inlineContent":[{"text":"Pick a name the engine doesn’t already ship. The macro mints","type":"text"},{"text":" ","type":"text"},{"code":"Intent.<name>","type":"codeVoice"},{"text":", so a second declaration of a name the engine owns — a core","type":"text"},{"text":" ","type":"text"},{"text":"verb, or a stub verb like ","type":"text"},{"code":"dig","type":"codeVoice"},{"text":", ","type":"text"},{"code":"attack","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"sing","type":"codeVoice"},{"text":" — makes ","type":"text"},{"code":".<name>","type":"codeVoice"},{"text":" ","type":"text"},{"text":"ambiguous in every file that imports both modules. Reclaiming the ","type":"text"},{"inlineContent":[{"text":"word","type":"text"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"under a name of your own is always safe:","type":"text"},{"text":" ","type":"text"},{"code":"#verb(\"excavate\", [\"dig\", .directObject])","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Each pattern is a complete row: literal words the player types plus","type":"text"},{"text":" ","type":"text"},{"code":".directObject","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":".indirectObject","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":".direction","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":".topic","type":"codeVoice"},{"text":" slots. Patterns are","type":"text"},{"text":" ","type":"text"},{"text":"validated at compile time with the same rules the bootstrap applies to","type":"text"},{"text":" ","type":"text"},{"text":"hand-built rows. Each literal is one lowercase alphanumeric token; write","type":"text"},{"text":" ","type":"text"},{"text":"multiword phrases as separate literals (","type":"text"},{"code":"[\"look\", \"under\", .directObject]","type":"codeVoice"},{"text":").","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The rows still need to reach the parser: list the intents in a ","type":"text"},{"code":"verbs","type":"codeVoice"},{"text":" ","type":"text"},{"text":"block, which splices everything they carry. (List several as one array —","type":"text"},{"text":" ","type":"text"},{"text":"bare ","type":"text"},{"code":".ring","type":"codeVoice"},{"text":" statements on consecutive lines would parse as a single","type":"text"},{"text":" ","type":"text"},{"text":"chained member access.)","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var verbs: [SyntaxRule] { [.ring, .barter] }","var rules: Rules {","    bell.before(.ring) { try reply(\"The bell chimes sweetly.\") }","}"]},{"type":"paragraph","inlineContent":[{"text":"The first argument is the intent’s identifier — the generated constant’s","type":"text"},{"text":" ","type":"text"},{"text":"name and its ","type":"text"},{"code":"raw","type":"codeVoice"},{"text":" value — so it must be a plain string literal that is a","type":"text"},{"text":" ","type":"text"},{"text":"valid Swift identifier. It doesn’t have to match the typed verb word:","type":"text"},{"text":" ","type":"text"},{"code":"#verb(\"steal\", [\"take\", .directObject])","type":"codeVoice"},{"text":" reclaims the built-in ","type":"text"},{"code":"take","type":"codeVoice"},{"text":" ","type":"text"},{"text":"row under a new intent.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"displayVerb:","type":"codeVoice"},{"text":" is what a prompt calls the verb — “What do you want to","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"wind","type":"text"}],"type":"strong"},{"text":"?” — and is needed by one shape only: a row that leads with an","type":"text"},{"text":" ","type":"text"},{"text":"abbreviation, where the row’s own words are not a word.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["#verb(\"wind\", [\"wind\", .directObject], [\"w\", .directObject], displayVerb: \"wind\")"]},{"type":"paragraph","inlineContent":[{"text":"Left off, each row asks in its own leading words, which is right wherever","type":"text"},{"text":" ","type":"text"},{"text":"they are words: ","type":"text"},{"code":"[\"haggle\", \"over\", .directObject]","type":"codeVoice"},{"text":" asks what you want to","type":"text"},{"text":" ","type":"text"},{"text":"haggle over. See ","type":"text"},{"code":"SyntaxRule.displayVerb","type":"codeVoice"},{"text":".","type":"text"}]}],"kind":"content"}],"sections":[],"identifier":{"url":"doc:\/\/Gnusto\/documentation\/Gnusto\/verb(_:_:displayVerb:)","interfaceLanguage":"swift"},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/AddingCustomVerbs","doc:\/\/Gnusto\/documentation\/Gnusto\/StubVerbs","doc:\/\/Gnusto\/documentation\/Gnusto\/SyntaxRule","doc:\/\/Gnusto\/documentation\/Gnusto\/SyntaxElement","doc:\/\/Gnusto\/documentation\/Gnusto\/IntentAction","doc:\/\/Gnusto\/documentation\/Gnusto\/Topic"],"title":"Verbs and Intents","anchor":"Verbs-and-Intents"}],"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto"]]},"references":{"doc://Gnusto/documentation/Gnusto/Topic":{"fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"Topic","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Topic","title":"Topic","url":"\/documentation\/gnusto\/topic","navigatorTitle":[{"kind":"identifier","text":"Topic"}],"abstract":[{"type":"text","text":"What the player wants to talk about: the words after “about”, normalized"},{"type":"text","text":" "},{"type":"text","text":"the way the parser normalizes everything else — lowercased, punctuation"},{"type":"text","text":" "},{"type":"text","text":"dropped, filler stripped."}],"role":"symbol","kind":"symbol"},"doc://Gnusto/documentation/Gnusto/IntentAction":{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/IntentAction","navigatorTitle":[{"kind":"identifier","text":"IntentAction"}],"title":"IntentAction","abstract":[{"text":"A replacement or new stage-4 default action for one intent — the seam","type":"text"},{"text":" ","type":"text"},{"text":"that lets a game or plugin give a custom verb real behavior instead of","type":"text"},{"text":" ","type":"text"},{"text":"“I didn’t understand”, or replace a built-in’s default entirely.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IntentAction"}],"kind":"symbol","role":"symbol","url":"\/documentation\/gnusto\/intentaction","type":"topic"},"doc://Gnusto/documentation/Gnusto/StubVerbs":{"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/StubVerbs","title":"Stub Verbs","url":"\/documentation\/gnusto\/stubverbs","abstract":[{"type":"text","text":"The verbs the parser knows as words even where your game has no mechanic."}],"role":"article","kind":"article"},"doc://Gnusto/documentation/Gnusto":{"title":"Gnusto","url":"\/documentation\/gnusto","abstract":[{"text":"An engine for writing interactive fiction in Swift.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto","role":"collection","type":"topic"},"doc://Gnusto/documentation/Gnusto/verb(_:_:displayVerb:)":{"fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"verb","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", [","kind":"text"},{"preciseIdentifier":"s:6Gnusto13SyntaxElementO","text":"SyntaxElement","kind":"typeIdentifier"},{"text":"]..., ","kind":"text"},{"text":"displayVerb","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/verb(_:_:displayVerb:)","title":"verb(_:_:displayVerb:)","url":"\/documentation\/gnusto\/verb(_:_:displayverb:)","abstract":[{"text":"Declares a custom player-typeable verb in one place: a typed intent","type":"text"},{"text":" ","type":"text"},{"text":"constant plus the verb rows that produce it.","type":"text"}],"role":"symbol","kind":"symbol"},"doc://Gnusto/documentation/Gnusto/SyntaxElement":{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/SyntaxElement","navigatorTitle":[{"text":"SyntaxElement","kind":"identifier"}],"title":"SyntaxElement","abstract":[{"text":"One element of a verb pattern: a literal word the player must type, or a","type":"text"},{"text":" ","type":"text"},{"text":"slot the parser fills from the rest of the sentence. String literals in a","type":"text"},{"text":" ","type":"text"},{"text":"pattern are ","type":"text"},{"code":".word","type":"codeVoice"},{"text":"s, so rows read the way they’re typed:","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"SyntaxElement"}],"kind":"symbol","role":"symbol","url":"\/documentation\/gnusto\/syntaxelement","type":"topic"},"doc://Gnusto/documentation/Gnusto/SyntaxRule":{"abstract":[{"text":"One row of the verb table: a pattern of literal words and slots, and the","type":"text"},{"text":" ","type":"text"},{"text":"intent a match produces. Data, not code — games can add rows through their","type":"text"},{"text":" ","type":"text"},{"code":"verbs","type":"codeVoice"},{"text":" block to teach the parser new player-typeable verbs.","type":"text"}],"url":"\/documentation\/gnusto\/syntaxrule","title":"SyntaxRule","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SyntaxRule"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"SyntaxRule"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/SyntaxRule","role":"symbol","type":"topic"},"doc://Gnusto/documentation/Gnusto/AddingCustomVerbs":{"url":"\/documentation\/gnusto\/addingcustomverbs","abstract":[{"type":"text","text":"Teach the parser words the built-in table doesn’t know."}],"title":"Adding Custom Verbs","kind":"article","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/AddingCustomVerbs","role":"article","type":"topic"}}}