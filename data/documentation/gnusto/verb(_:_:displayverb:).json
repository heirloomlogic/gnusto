{"schemaVersion":{"patch":0,"minor":3,"major":0},"seeAlsoSections":[{"anchor":"Verbs-and-Intents","generated":true,"title":"Verbs and Intents","identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/AddingCustomVerbs","doc:\/\/Gnusto\/documentation\/Gnusto\/StubVerbs","doc:\/\/Gnusto\/documentation\/Gnusto\/SyntaxRule","doc:\/\/Gnusto\/documentation\/Gnusto\/SyntaxElement","doc:\/\/Gnusto\/documentation\/Gnusto\/IntentAction","doc:\/\/Gnusto\/documentation\/Gnusto\/Topic"]}],"abstract":[{"text":"Declares a custom player-typeable verb in one place: a typed intent","type":"text"},{"type":"text","text":" "},{"text":"constant plus the verb rows that produce it.","type":"text"}],"metadata":{"externalID":"s:6Gnusto4verb__11displayVerbySS_SayAA13SyntaxElementOGdSSSgtcfm","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"verb"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", ["},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto13SyntaxElementO","text":"SyntaxElement"},{"kind":"text","text":"]..., "},{"kind":"externalParam","text":"displayVerb"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?)"}],"symbolKind":"macro","title":"verb(_:_:displayVerb:)","role":"symbol","roleHeading":"Macro","modules":[{"name":"Gnusto"}]},"sections":[],"kind":"symbol","identifier":{"url":"doc:\/\/Gnusto\/documentation\/Gnusto\/verb(_:_:displayVerb:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@freestanding"},{"kind":"text","text":"(declaration, names: arbitrary) "},{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"verb"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"intentName"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"patterns"},{"text":": [","kind":"text"},{"text":"SyntaxElement","preciseIdentifier":"s:6Gnusto13SyntaxElementO","kind":"typeIdentifier","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/SyntaxElement"},{"kind":"text","text":"]..., "},{"kind":"externalParam","text":"displayVerb"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"text":"? = nil)","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Use it inside an ","type":"text"},{"code":"extension Intent","type":"codeVoice"},{"type":"text","text":" — that’s what makes the leading-dot"},{"type":"text","text":" "},{"type":"text","text":"spelling work everywhere an "},{"code":"Intent","type":"codeVoice"},{"type":"text","text":" is expected:"}]},{"syntax":"swift","type":"codeListing","code":["extension Intent {","    #verb(\"ring\", [\"ring\", .directObject])","    #verb(\"barter\",","          [\"barter\", .directObject],","          [\"barter\", .directObject, \"for\", .indirectObject],","          [\"haggle\", \"over\", .directObject])","    #verb(\"chime\")                           \/\/ pattern defaults to [\"chime\"]","    #verb(\"steal\", [\"take\", .directObject])  \/\/ reclaim a built-in verb","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pick a name the engine doesn’t already ship. The macro mints"},{"type":"text","text":" "},{"code":"Intent.<name>","type":"codeVoice"},{"type":"text","text":", so a second declaration of a name the engine owns — a core"},{"type":"text","text":" "},{"type":"text","text":"verb, or a stub verb like "},{"code":"dig","type":"codeVoice"},{"type":"text","text":", "},{"code":"attack","type":"codeVoice"},{"type":"text","text":" or "},{"code":"sing","type":"codeVoice"},{"type":"text","text":" — makes "},{"code":".<name>","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"ambiguous in every file that imports both modules. Reclaiming the "},{"inlineContent":[{"text":"word","type":"text"}],"type":"emphasis"},{"type":"text","text":" "},{"type":"text","text":"under a name of your own is always safe:"},{"type":"text","text":" "},{"code":"#verb(\"excavate\", [\"dig\", .directObject])","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each pattern is a complete row: literal words the player types plus"},{"type":"text","text":" "},{"code":".directObject","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":".indirectObject","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":".direction","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":".topic","type":"codeVoice"},{"type":"text","text":" slots. Patterns are"},{"type":"text","text":" "},{"type":"text","text":"validated at compile time with the same rules the bootstrap applies to"},{"type":"text","text":" "},{"type":"text","text":"hand-built rows. Each literal is one lowercase alphanumeric token; write"},{"type":"text","text":" "},{"type":"text","text":"multiword phrases as separate literals ("},{"code":"[\"look\", \"under\", .directObject]","type":"codeVoice"},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The rows still need to reach the parser: list the intents in a "},{"code":"verbs","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"block, which splices everything they carry. (List several as one array —"},{"type":"text","text":" "},{"type":"text","text":"bare "},{"code":".ring","type":"codeVoice"},{"type":"text","text":" statements on consecutive lines would parse as a single"},{"type":"text","text":" "},{"type":"text","text":"chained member access.)"}]},{"syntax":"swift","type":"codeListing","code":["var verbs: [SyntaxRule] { [.ring, .barter] }","var rules: Rules {","    bell.before(.ring) { try reply(\"The bell chimes sweetly.\") }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The first argument is the intent’s identifier — the generated constant’s"},{"type":"text","text":" "},{"type":"text","text":"name and its "},{"code":"raw","type":"codeVoice"},{"type":"text","text":" value — so it must be a plain string literal that is a"},{"type":"text","text":" "},{"type":"text","text":"valid Swift identifier. It doesn’t have to match the typed verb word:"},{"type":"text","text":" "},{"code":"#verb(\"steal\", [\"take\", .directObject])","type":"codeVoice"},{"type":"text","text":" reclaims the built-in "},{"code":"take","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"row under a new intent."}]},{"type":"paragraph","inlineContent":[{"code":"displayVerb:","type":"codeVoice"},{"type":"text","text":" is what a prompt calls the verb — “What do you want to"},{"type":"text","text":" "},{"inlineContent":[{"text":"wind","type":"text"}],"type":"strong"},{"type":"text","text":"?” — and is needed by one shape only: a row that leads with an"},{"type":"text","text":" "},{"type":"text","text":"abbreviation, where the row’s own words are not a word."}]},{"syntax":"swift","type":"codeListing","code":["#verb(\"wind\", [\"wind\", .directObject], [\"w\", .directObject], displayVerb: \"wind\")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Left off, each row asks in its own leading words, which is right wherever"},{"type":"text","text":" "},{"type":"text","text":"they are words: "},{"code":"[\"haggle\", \"over\", .directObject]","type":"codeVoice"},{"type":"text","text":" asks what you want to"},{"type":"text","text":" "},{"type":"text","text":"haggle over. See "},{"code":"SyntaxRule.displayVerb","type":"codeVoice"},{"type":"text","text":"."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnusto\/verb(_:_:displayverb:)"]}],"references":{"doc://Gnusto/documentation/Gnusto/verb(_:_:displayVerb:)":{"url":"\/documentation\/gnusto\/verb(_:_:displayverb:)","type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/verb(_:_:displayVerb:)","role":"symbol","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"verb","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", [","kind":"text"},{"preciseIdentifier":"s:6Gnusto13SyntaxElementO","text":"SyntaxElement","kind":"typeIdentifier"},{"text":"]..., ","kind":"text"},{"text":"displayVerb","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"kind":"symbol","title":"verb(_:_:displayVerb:)","abstract":[{"type":"text","text":"Declares a custom player-typeable verb in one place: a typed intent"},{"type":"text","text":" "},{"type":"text","text":"constant plus the verb rows that produce it."}]},"doc://Gnusto/documentation/Gnusto/SyntaxRule":{"url":"\/documentation\/gnusto\/syntaxrule","navigatorTitle":[{"kind":"identifier","text":"SyntaxRule"}],"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/SyntaxRule","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SyntaxRule"}],"kind":"symbol","title":"SyntaxRule","abstract":[{"type":"text","text":"One row of the verb table: a pattern of literal words and slots, and the"},{"type":"text","text":" "},{"type":"text","text":"intent a match produces. Data, not code — games can add rows through their"},{"type":"text","text":" "},{"code":"verbs","type":"codeVoice"},{"type":"text","text":" block to teach the parser new player-typeable verbs."}]},"doc://Gnusto/documentation/Gnusto/Topic":{"url":"\/documentation\/gnusto\/topic","navigatorTitle":[{"kind":"identifier","text":"Topic"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Topic","type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Topic","kind":"identifier"}],"kind":"symbol","title":"Topic","abstract":[{"text":"What the player wants to talk about: the words after “about”, normalized","type":"text"},{"text":" ","type":"text"},{"text":"the way the parser normalizes everything else — lowercased, punctuation","type":"text"},{"text":" ","type":"text"},{"text":"dropped, filler stripped.","type":"text"}]},"doc://Gnusto/documentation/Gnusto/SyntaxElement":{"abstract":[{"text":"One element of a verb pattern: a literal word the player must type, or a","type":"text"},{"type":"text","text":" "},{"type":"text","text":"slot the parser fills from the rest of the sentence. String literals in a"},{"type":"text","text":" "},{"type":"text","text":"pattern are "},{"type":"codeVoice","code":".word"},{"type":"text","text":"s, so rows read the way they’re typed:"}],"navigatorTitle":[{"text":"SyntaxElement","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/SyntaxElement","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SyntaxElement","kind":"identifier"}],"kind":"symbol","title":"SyntaxElement","url":"\/documentation\/gnusto\/syntaxelement"},"doc://Gnusto/documentation/Gnusto/StubVerbs":{"role":"article","type":"topic","kind":"article","url":"\/documentation\/gnusto\/stubverbs","title":"Stub Verbs","abstract":[{"type":"text","text":"The verbs the parser knows as words even where your game has no mechanic."}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/StubVerbs"},"doc://Gnusto/documentation/Gnusto":{"kind":"symbol","abstract":[{"type":"text","text":"An engine for writing interactive fiction in Swift."}],"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto","url":"\/documentation\/gnusto","title":"Gnusto","role":"collection"},"doc://Gnusto/documentation/Gnusto/IntentAction":{"abstract":[{"type":"text","text":"A replacement or new stage-4 default action for one intent — the seam"},{"type":"text","text":" "},{"type":"text","text":"that lets a game or plugin give a custom verb real behavior instead of"},{"type":"text","text":" "},{"type":"text","text":"“I didn’t understand”, or replace a built-in’s default entirely."}],"type":"topic","kind":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/IntentAction","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"IntentAction"}],"role":"symbol","url":"\/documentation\/gnusto\/intentaction","title":"IntentAction","navigatorTitle":[{"text":"IntentAction","kind":"identifier"}]},"doc://Gnusto/documentation/Gnusto/AddingCustomVerbs":{"url":"\/documentation\/gnusto\/addingcustomverbs","type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/AddingCustomVerbs","role":"article","kind":"article","title":"Adding Custom Verbs","abstract":[{"type":"text","text":"Teach the parser words the built-in table doesn’t know."}]}}}