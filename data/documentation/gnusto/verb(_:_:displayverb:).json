{"abstract":[{"text":"Declares a custom player-typeable verb in one place: a typed intent","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"constant plus the verb rows that produce it."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto"]]},"sections":[],"kind":"symbol","seeAlsoSections":[{"anchor":"Verbs-and-Intents","identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/AddingCustomVerbs","doc:\/\/Gnusto\/documentation\/Gnusto\/StubVerbs","doc:\/\/Gnusto\/documentation\/Gnusto\/SyntaxRule","doc:\/\/Gnusto\/documentation\/Gnusto\/SyntaxElement","doc:\/\/Gnusto\/documentation\/Gnusto\/IntentAction","doc:\/\/Gnusto\/documentation\/Gnusto\/Topic"],"generated":true,"title":"Verbs and Intents"}],"identifier":{"url":"doc:\/\/Gnusto\/documentation\/Gnusto\/verb(_:_:displayVerb:)","interfaceLanguage":"swift"},"metadata":{"symbolKind":"macro","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"verb"},{"text":"(","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", [","kind":"text"},{"text":"SyntaxElement","preciseIdentifier":"s:6Gnusto13SyntaxElementO","kind":"typeIdentifier"},{"kind":"text","text":"]..., "},{"kind":"externalParam","text":"displayVerb"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"kind":"text","text":"?)"}],"externalID":"s:6Gnusto4verb__11displayVerbySS_SayAA13SyntaxElementOGdSSSgtcfm","roleHeading":"Macro","title":"verb(_:_:displayVerb:)","role":"symbol","modules":[{"name":"Gnusto"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@freestanding"},{"text":"(declaration, names: arbitrary) ","kind":"text"},{"kind":"keyword","text":"macro"},{"text":" ","kind":"text"},{"text":"verb","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"kind":"text","text":" "},{"text":"intentName","kind":"internalParam"},{"kind":"text","text":": "},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"patterns","kind":"internalParam"},{"kind":"text","text":": ["},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/SyntaxElement","kind":"typeIdentifier","text":"SyntaxElement","preciseIdentifier":"s:6Gnusto13SyntaxElementO"},{"kind":"text","text":"]..., "},{"kind":"externalParam","text":"displayVerb"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"? = nil)"}]}]},{"kind":"content","content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use it inside an "},{"type":"codeVoice","code":"extension Intent"},{"type":"text","text":" — that’s what makes the leading-dot"},{"type":"text","text":" "},{"text":"spelling work everywhere an ","type":"text"},{"code":"Intent","type":"codeVoice"},{"type":"text","text":" is expected:"}]},{"syntax":"swift","type":"codeListing","code":["extension Intent {","    #verb(\"ring\", [\"ring\", .directObject])","    #verb(\"barter\",","          [\"barter\", .directObject],","          [\"barter\", .directObject, \"for\", .indirectObject],","          [\"haggle\", \"over\", .directObject])","    #verb(\"chime\")                           \/\/ pattern defaults to [\"chime\"]","    #verb(\"steal\", [\"take\", .directObject])  \/\/ reclaim a built-in verb","}"]},{"inlineContent":[{"text":"Pick a name the engine doesn’t already ship. The macro mints","type":"text"},{"text":" ","type":"text"},{"code":"Intent.<name>","type":"codeVoice"},{"text":", so a second declaration of a name the engine owns — a core","type":"text"},{"text":" ","type":"text"},{"text":"verb, or a stub verb like ","type":"text"},{"code":"dig","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"attack"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"sing"},{"text":" — makes ","type":"text"},{"code":".<name>","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"ambiguous in every file that imports both modules. Reclaiming the "},{"inlineContent":[{"type":"text","text":"word"}],"type":"emphasis"},{"text":" ","type":"text"},{"type":"text","text":"under a name of your own is always safe:"},{"text":" ","type":"text"},{"code":"#verb(\"excavate\", [\"dig\", .directObject])","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each pattern is a complete row: literal words the player types plus"},{"text":" ","type":"text"},{"type":"codeVoice","code":".directObject"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":".indirectObject"},{"type":"text","text":" \/ "},{"code":".direction","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":".topic","type":"codeVoice"},{"type":"text","text":" slots. Patterns are"},{"text":" ","type":"text"},{"type":"text","text":"validated at compile time with the same rules the bootstrap applies to"},{"text":" ","type":"text"},{"type":"text","text":"hand-built rows. Each literal is one lowercase alphanumeric token; write"},{"type":"text","text":" "},{"type":"text","text":"multiword phrases as separate literals ("},{"code":"[\"look\", \"under\", .directObject]","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The rows still need to reach the parser: list the intents in a ","type":"text"},{"type":"codeVoice","code":"verbs"},{"type":"text","text":" "},{"text":"block, which splices everything they carry. (List several as one array —","type":"text"},{"text":" ","type":"text"},{"text":"bare ","type":"text"},{"code":".ring","type":"codeVoice"},{"text":" statements on consecutive lines would parse as a single","type":"text"},{"text":" ","type":"text"},{"text":"chained member access.)","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["var verbs: [SyntaxRule] { [.ring, .barter] }","var rules: Rules {","    bell.before(.ring) { try reply(\"The bell chimes sweetly.\") }","}"]},{"type":"paragraph","inlineContent":[{"text":"The first argument is the intent’s identifier — the generated constant’s","type":"text"},{"text":" ","type":"text"},{"text":"name and its ","type":"text"},{"code":"raw","type":"codeVoice"},{"text":" value — so it must be a plain string literal that is a","type":"text"},{"text":" ","type":"text"},{"text":"valid Swift identifier. It doesn’t have to match the typed verb word:","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"#verb(\"steal\", [\"take\", .directObject])"},{"text":" reclaims the built-in ","type":"text"},{"type":"codeVoice","code":"take"},{"type":"text","text":" "},{"type":"text","text":"row under a new intent."}]},{"inlineContent":[{"code":"displayVerb:","type":"codeVoice"},{"type":"text","text":" is what a prompt calls the verb — “What do you want to"},{"text":" ","type":"text"},{"type":"strong","inlineContent":[{"text":"wind","type":"text"}]},{"text":"?” — and is needed by one shape only: a row that leads with an","type":"text"},{"text":" ","type":"text"},{"text":"abbreviation, where the row’s own words are not a word.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["#verb(\"wind\", [\"wind\", .directObject], [\"w\", .directObject], displayVerb: \"wind\")"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Left off, each row asks in its own leading words, which is right wherever"},{"type":"text","text":" "},{"type":"text","text":"they are words: "},{"type":"codeVoice","code":"[\"haggle\", \"over\", .directObject]"},{"type":"text","text":" asks what you want to"},{"type":"text","text":" "},{"type":"text","text":"haggle over. See "},{"type":"codeVoice","code":"SyntaxRule.displayVerb"},{"type":"text","text":"."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnusto\/verb(_:_:displayverb:)"]}],"references":{"doc://Gnusto/documentation/Gnusto/SyntaxElement":{"url":"\/documentation\/gnusto\/syntaxelement","title":"SyntaxElement","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/SyntaxElement","kind":"symbol","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SyntaxElement","kind":"identifier"}],"abstract":[{"text":"One element of a verb pattern: a literal word the player must type, or a","type":"text"},{"text":" ","type":"text"},{"text":"slot the parser fills from the rest of the sentence. String literals in a","type":"text"},{"text":" ","type":"text"},{"text":"pattern are ","type":"text"},{"code":".word","type":"codeVoice"},{"text":"s, so rows read the way they’re typed:","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"SyntaxElement","kind":"identifier"}]},"doc://Gnusto/documentation/Gnusto":{"abstract":[{"text":"An engine for writing interactive fiction in Swift.","type":"text"}],"title":"Gnusto","kind":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto","type":"topic","url":"\/documentation\/gnusto","role":"collection"},"doc://Gnusto/documentation/Gnusto/AddingCustomVerbs":{"url":"\/documentation\/gnusto\/addingcustomverbs","title":"Adding Custom Verbs","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/AddingCustomVerbs","kind":"article","type":"topic","abstract":[{"text":"Teach the parser words the built-in table doesn’t know.","type":"text"}],"role":"article"},"doc://Gnusto/documentation/Gnusto/verb(_:_:displayVerb:)":{"url":"\/documentation\/gnusto\/verb(_:_:displayverb:)","title":"verb(_:_:displayVerb:)","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/verb(_:_:displayVerb:)","kind":"symbol","type":"topic","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"verb","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", [","kind":"text"},{"preciseIdentifier":"s:6Gnusto13SyntaxElementO","text":"SyntaxElement","kind":"typeIdentifier"},{"text":"]..., ","kind":"text"},{"text":"displayVerb","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"abstract":[{"text":"Declares a custom player-typeable verb in one place: a typed intent","type":"text"},{"text":" ","type":"text"},{"text":"constant plus the verb rows that produce it.","type":"text"}],"role":"symbol"},"doc://Gnusto/documentation/Gnusto/StubVerbs":{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/StubVerbs","url":"\/documentation\/gnusto\/stubverbs","type":"topic","title":"Stub Verbs","abstract":[{"type":"text","text":"The verbs the parser knows as words even where your game has no mechanic."}],"role":"article","kind":"article"},"doc://Gnusto/documentation/Gnusto/IntentAction":{"url":"\/documentation\/gnusto\/intentaction","title":"IntentAction","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/IntentAction","kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IntentAction","kind":"identifier"}],"abstract":[{"text":"A replacement or new stage-4 default action for one intent — the seam","type":"text"},{"text":" ","type":"text"},{"text":"that lets a game or plugin give a custom verb real behavior instead of","type":"text"},{"text":" ","type":"text"},{"text":"“I didn’t understand”, or replace a built-in’s default entirely.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"IntentAction"}]},"doc://Gnusto/documentation/Gnusto/SyntaxRule":{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/SyntaxRule","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SyntaxRule","kind":"identifier"}],"url":"\/documentation\/gnusto\/syntaxrule","type":"topic","title":"SyntaxRule","abstract":[{"type":"text","text":"One row of the verb table: a pattern of literal words and slots, and the"},{"type":"text","text":" "},{"type":"text","text":"intent a match produces. Data, not code — games can add rows through their"},{"type":"text","text":" "},{"code":"verbs","type":"codeVoice"},{"type":"text","text":" block to teach the parser new player-typeable verbs."}],"role":"symbol","navigatorTitle":[{"text":"SyntaxRule","kind":"identifier"}],"kind":"symbol"},"doc://Gnusto/documentation/Gnusto/Topic":{"url":"\/documentation\/gnusto\/topic","kind":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Topic","title":"Topic","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Topic","kind":"identifier"}],"abstract":[{"text":"What the player wants to talk about: the words after “about”, normalized","type":"text"},{"text":" ","type":"text"},{"text":"the way the parser normalizes everything else — lowercased, punctuation","type":"text"},{"text":" ","type":"text"},{"text":"dropped, filler stripped.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"Topic","kind":"identifier"}]}}}