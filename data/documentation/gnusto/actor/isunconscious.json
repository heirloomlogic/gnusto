{"variants":[{"paths":["\/documentation\/gnusto\/actor\/isunconscious"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto","doc:\/\/Gnusto\/documentation\/Gnusto\/Actor"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Gnusto\/documentation\/Gnusto\/Actor\/isUnconscious"},"abstract":[{"type":"text","text":"True while the actor is out cold — set by whatever knocked them down"},{"type":"text","text":" "},{"type":"text","text":"and cleared when they come round."}],"sections":[],"metadata":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isUnconscious"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"externalID":"s:6Gnusto5ActorV13isUnconsciousSbvp","role":"symbol","title":"isUnconscious","modules":[{"name":"Gnusto"}],"symbolKind":"property","roleHeading":"Instance Property"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isUnconscious","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nonmutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"set","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"type":"text","text":"The engine reads it nowhere. It exists so that two plugins with no"},{"type":"text","text":" "},{"type":"text","text":"knowledge of each other can agree on one fact about a person: a villain"},{"type":"text","text":" "},{"code":"GnustoMeleeCombat","type":"codeVoice"},{"type":"text","text":" has just battered into unconsciousness stops taking"},{"type":"text","text":" "},{"type":"text","text":"his own turn under "},{"code":"GnustoActors","type":"codeVoice"},{"type":"text","text":" — no roaming, no picking pockets —"},{"type":"text","text":" "},{"type":"text","text":"until he wakes. A game that knocks an actor down by its own means"},{"type":"text","text":" "},{"type":"text","text":"should set and clear it too; anything consulting the flag will then"},{"type":"text","text":" "},{"text":"behave.","type":"text"}],"type":"paragraph"}]}],"kind":"symbol","references":{"doc://Gnusto/documentation/Gnusto/Actor":{"url":"\/documentation\/gnusto\/actor","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Actor","role":"symbol","abstract":[{"text":"A character in the world — a troll, a thief, a parrot.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"Actor","kind":"identifier"}],"kind":"symbol","title":"Actor","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Actor","kind":"identifier"}]},"doc://Gnusto/documentation/Gnusto":{"url":"\/documentation\/gnusto","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto","title":"Gnusto","abstract":[{"text":"A Swift engine for writing parser-driven interactive fiction — text adventures in the tradition of Zork and Infocom’s ZIL.","type":"text"}],"role":"collection","kind":"symbol","type":"topic"},"doc://Gnusto/documentation/Gnusto/Actor/isUnconscious":{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Actor\/isUnconscious","url":"\/documentation\/gnusto\/actor\/isunconscious","role":"symbol","abstract":[{"text":"True while the actor is out cold — set by whatever knocked them down","type":"text"},{"text":" ","type":"text"},{"text":"and cleared when they come round.","type":"text"}],"type":"topic","kind":"symbol","title":"isUnconscious","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isUnconscious"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"