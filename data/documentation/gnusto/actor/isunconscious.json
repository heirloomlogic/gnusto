{"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnusto\/actor\/isunconscious"]}],"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto","doc:\/\/Gnusto\/documentation\/Gnusto\/Actor"]]},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Gnusto\/documentation\/Gnusto\/Actor\/isUnconscious"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isUnconscious","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nonmutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"set","kind":"keyword"},{"text":" }","kind":"text"}]}],"kind":"declarations"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"The engine reads it nowhere. It exists so that two plugins with no","type":"text"},{"text":" ","type":"text"},{"text":"knowledge of each other can agree on one fact about a person: a villain","type":"text"},{"text":" ","type":"text"},{"code":"GnustoMeleeCombat","type":"codeVoice"},{"text":" has just battered into unconsciousness stops taking","type":"text"},{"text":" ","type":"text"},{"text":"his own turn under ","type":"text"},{"code":"GnustoActors","type":"codeVoice"},{"text":" — no roaming, no picking pockets —","type":"text"},{"text":" ","type":"text"},{"text":"until he wakes. A game that knocks an actor down by its own means","type":"text"},{"text":" ","type":"text"},{"text":"should set and clear it too; anything consulting the flag will then","type":"text"},{"text":" ","type":"text"},{"text":"behave.","type":"text"}]}],"kind":"content"}],"abstract":[{"text":"True while the actor is out cold — set by whatever knocked them down","type":"text"},{"text":" ","type":"text"},{"text":"and cleared when they come round.","type":"text"}],"sections":[],"metadata":{"modules":[{"name":"Gnusto"}],"role":"symbol","externalID":"s:6Gnusto5ActorV13isUnconsciousSbvp","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isUnconscious","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"title":"isUnconscious","roleHeading":"Instance Property","symbolKind":"property"},"references":{"doc://Gnusto/documentation/Gnusto/Actor":{"abstract":[{"text":"A character in the world — a troll, a thief, a parrot.","type":"text"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Actor","type":"topic","navigatorTitle":[{"text":"Actor","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Actor","kind":"identifier"}],"title":"Actor","url":"\/documentation\/gnusto\/actor","kind":"symbol","role":"symbol"},"doc://Gnusto/documentation/Gnusto/Actor/isUnconscious":{"abstract":[{"type":"text","text":"True while the actor is out cold — set by whatever knocked them down"},{"type":"text","text":" "},{"type":"text","text":"and cleared when they come round."}],"role":"symbol","type":"topic","title":"isUnconscious","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isUnconscious","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Actor\/isUnconscious","url":"\/documentation\/gnusto\/actor\/isunconscious","kind":"symbol"},"doc://Gnusto/documentation/Gnusto":{"role":"collection","abstract":[{"type":"text","text":"An engine for writing interactive fiction in Swift."}],"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto","kind":"symbol","title":"Gnusto","url":"\/documentation\/gnusto"}}}