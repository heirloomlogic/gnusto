h the full validation and bootstrap pipeline.","type":"text"}],"kind":"symbol","role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto4GameP","text":"Game"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}],"title":"init(_:)","type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/PreparedGame\/init(_:)"},"doc://Gnusto/documentation/Gnusto/ConsoleIOHandler":{"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ConsoleIOHandler"}],"navigatorTitle":[{"kind":"identifier","text":"ConsoleIOHandler"}],"kind":"symbol","url":"\/documentation\/gnusto\/consoleiohandler","title":"ConsoleIOHandler","abstract":[{"type":"text","text":"Plain terminal IO."}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/ConsoleIOHandler"},"doc://Gnusto/documentation/Gnusto/IOHandler":{"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"IOHandler"}],"navigatorTitle":[{"kind":"identifier","text":"IOHandler"}],"kind":"symbol","url":"\/documentation\/gnusto\/iohandler","title":"IOHandler","abstract":[{"type":"text","text":"Where the game’s text goes and player input comes from. Synchronous by"},{"type":"text","text":" "},{"type":"text","text":"design: a blocking console read is fine for a CLI; an async variant can"},{"type":"text","text":" "},{"type":"text","text":"be added later without breaking this protocol’s clients."}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler"},"doc://Gnusto/documentation/Gnusto/IOHandler/write(_:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"write","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"te