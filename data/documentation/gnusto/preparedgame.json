. Its dominant cost is "},{"type":"codeVoice","code":"Mirror"},{"type":"text","text":" reflection over the game and"},{"type":"text","text":" "},{"type":"text","text":"every content bundle. Preparing a game once and seeding many worlds from it"},{"text":" ","type":"text"},{"type":"text","text":"therefore pays that cost a single time; each world copies the value-type"},{"type":"text","text":" "},{"text":"definition and state and applies its own seed. ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":", so a prepared","type":"text"},{"text":" ","type":"text"},{"text":"game is safe to share across concurrently-running worlds.","type":"text"}]}]}],"variants":[{"paths":["\/documentation\/gnusto\/preparedgame"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Gnusto\/documentation\/Gnusto\/PreparedGame","interfaceLanguage":"swift"},"metadata":{"symbolKind":"struct","modules":[{"name":"Gnusto"}],"externalID":"s:6Gnusto12PreparedGameV","navigatorTitle":[{"kind":"identifier","text":"PreparedGame"}],"title":"PreparedGame","roleHeading":"Structure","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PreparedGame","kind":"identifier"}]},"kind":"symbol","relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/Gnusto\/s8SendableP","doc:\/\/Gnusto\/s16SendableMetatypeP"]}],"topicSections":[{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/PreparedGame\/init(_:)"]}],"abstract":[{"type":"text","text":"A game booted once — the immutable "},{"type":"codeVoice","code":"GameDefinition"},{"type":"text","text":" and its pristine initial"},{"type":"text","text":" "},{"type":"codeVoice","code":"WorldState"},{"type":"text","text":" — ready to spin up any number of "},{"type":"codeVoice","code":"GameWorld"},{"text":"s without re-running","type":"text"},{"text":" ","type":"text"},{"ty