{"abstract":[{"type":"text","text":"The one-line out-of-fiction note a play-test session can have appended to"},{"type":"text","text":" "},{"type":"text","text":"every turn:"}],"topicSections":[{"title":"Initializers","anchor":"Initializers","generated":true,"identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/StatusFooter\/init(environment:)"]},{"title":"Instance Properties","anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/StatusFooter\/complaint","doc:\/\/Gnusto\/documentation\/Gnusto\/StatusFooter\/inForce"]}],"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/Gnusto\/s8SendableP","doc:\/\/Gnusto\/s16SendableMetatypeP"]}],"identifier":{"url":"doc:\/\/Gnusto\/documentation\/Gnusto\/StatusFooter","interfaceLanguage":"swift"},"sections":[],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler","doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler\/write(_:)","doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler\/readLine(prompt:)","doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler\/showStatus(_:)","doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler\/updateCompletions(_:)","doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler\/finish(_:)","doc:\/\/Gnusto\/documentation\/Gnusto\/Input","doc:\/\/Gnusto\/documentation\/Gnusto\/StatusLine","doc:\/\/Gnusto\/documentation\/Gnusto\/GameStatus","doc:\/\/Gnusto\/documentation\/Gnusto\/CompletionCandidates","doc:\/\/Gnusto\/documentation\/Gnusto\/CompletionCandidates\/Context-swift.enum","doc:\/\/Gnusto\/documentation\/Gnusto\/TerminalIOHandler","doc:\/\/Gnusto\/documentation\/Gnusto\/ConsoleIOHandler","doc:\/\/Gnusto\/documentation\/Gnusto\/ScriptedIOHandler","doc:\/\/Gnusto\/documentation\/Gnusto\/ScriptedIOHandler\/transcript"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"StatusFooter","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"codeListing","syntax":null,"code":["[status] room=Front Hall | moves=12 | score=0 | turn=cost | time=5:46 pm"]},{"inlineContent":[{"text":"A transcript is prose, and prose does not say where you are standing or","type":"text"},{"text":" ","type":"text"},{"text":"what the last command cost. A tester reading one back has to reconstruct","type":"text"},{"text":" ","type":"text"},{"text":"both, and the reconstruction is where the mistakes come from: counting","type":"text"},{"text":" ","type":"text"},{"text":"commands as turns is wrong the moment one of them fails to parse or turns","type":"text"},{"text":" ","type":"text"},{"text":"out to be a meta verb, and “which room was that?” is a scroll upwards.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"moves="},{"text":" and ","type":"text"},{"type":"codeVoice","code":"turn="},{"text":" answer the first; ","type":"text"},{"type":"codeVoice","code":"room="},{"text":" answers the second.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A contributed field like "},{"code":"time=","type":"codeVoice"},{"type":"text","text":" answers a third — "},{"inlineContent":[{"text":"when","type":"text"}],"type":"emphasis"},{"type":"text","text":" — and is sampled"},{"type":"text","text":" "},{"type":"text","text":"at the turn’s close rather than after its counter advanced, so that it"},{"type":"text","text":" "},{"type":"text","text":"names the minute the turn’s own words were written in. See"},{"type":"text","text":" "},{"code":"statusFields","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Off unless asked for. "},{"code":"GNUSTO_STATUS","type":"codeVoice"},{"type":"text","text":" is read by "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameMain"},{"type":"text","text":" — the"},{"type":"text","text":" "},{"type":"text","text":"composition root — and the value handed to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/REPL\/init(world:io:transcriptURL:status:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which defaults to "},{"code":"nil","type":"codeVoice"},{"type":"text","text":". The test suite constructs its REPLs without the"},{"type":"text","text":" "},{"type":"text","text":"argument, so "},{"code":"GNUSTO_STATUS=1 swift test","type":"codeVoice"},{"type":"text","text":" changes nothing: the footer is"},{"type":"text","text":" "},{"type":"text","text":"opt-in "},{"inlineContent":[{"text":"by construction","type":"text"}],"type":"emphasis"},{"type":"text","text":" rather than by an environment variable happening"},{"type":"text","text":" "},{"type":"text","text":"to be unset."}],"type":"paragraph"},{"inlineContent":[{"text":"Modelled on ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/SeedRequest","type":"reference","isActive":true},{"text":": a value type that reads one variable, hands","type":"text"},{"text":" ","type":"text"},{"text":"back what it found, and complains about a value it could not read instead","type":"text"},{"text":" ","type":"text"},{"text":"of quietly doing something else.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnusto\/statusfooter"]}],"metadata":{"externalID":"s:6Gnusto12StatusFooterV","title":"StatusFooter","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"StatusFooter","kind":"identifier"}],"roleHeading":"Structure","navigatorTitle":[{"text":"StatusFooter","kind":"identifier"}],"modules":[{"name":"Gnusto"}],"symbolKind":"struct"},"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","references":{"doc://Gnusto/documentation/Gnusto/StatusFooter/inForce":{"type":"topic","url":"\/documentation\/gnusto\/statusfooter\/inforce","abstract":[{"type":"text","text":"The footer to hand the "},{"code":"REPL","type":"codeVoice"},{"type":"text","text":", or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" when none was asked for — an"},{"type":"text","text":" "},{"type":"text","text":"unreadable value included, since off is the default and doing the"},{"type":"text","text":" "},{"type":"text","text":"default after complaining is what "},{"code":"SeedRequest","type":"codeVoice"},{"type":"text","text":" does too."}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/StatusFooter\/inForce","title":"inForce","kind":"symbol","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"inForce","kind":"identifier"},{"text":": ","kind":"text"},{"text":"StatusFooter","preciseIdentifier":"s:6Gnusto12StatusFooterV","kind":"typeIdentifier"},{"text":"?","kind":"text"}]},"doc://Gnusto/documentation/Gnusto/IOHandler/showStatus(_:)":{"title":"showStatus(_:)","defaultImplementations":1,"url":"\/documentation\/gnusto\/iohandler\/showstatus(_:)","abstract":[{"text":"Optionally displays a status line (location, score, turns).","type":"text"}],"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler\/showStatus(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"showStatus","kind":"identifier"},{"text":"(","kind":"text"},{"text":"StatusLine","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto10StatusLineV"},{"text":")","kind":"text"}],"required":true},"doc://Gnusto/documentation/Gnusto/StatusFooter/init(environment:)":{"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/StatusFooter\/init(environment:)","url":"\/documentation\/gnusto\/statusfooter\/init(environment:)","abstract":[{"type":"text","text":"Reads "},{"type":"codeVoice","code":"GNUSTO_STATUS"},{"type":"text","text":", tolerating the stray whitespace a shell wrapper"},{"type":"text","text":" "},{"type":"text","text":"or a copied-and-pasted value tends to bring with it."}],"title":"init(environment:)","kind":"symbol","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"environment","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"])","kind":"text"}]},"doc://Gnusto/documentation/Gnusto/GameStatus":{"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameStatus","title":"GameStatus","url":"\/documentation\/gnusto\/gamestatus","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GameStatus","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"GameStatus","kind":"identifier"}],"abstract":[{"type":"text","text":"Whether the game is in progress or how it ended."}],"kind":"symbol"},"doc://Gnusto/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/Gnusto\/s8SendableP"},"doc://Gnusto/documentation/Gnusto/IOHandler/finish(_:)":{"defaultImplementations":1,"abstract":[{"text":"Called once when the game reaches an ending (won, lost, or quit),","type":"text"},{"text":" ","type":"text"},{"text":"after the final output has been written. A full-screen handler holds","type":"text"},{"text":" ","type":"text"},{"text":"its last frame for the player and leaves the ending visible on the","type":"text"},{"text":" ","type":"text"},{"text":"primary screen; the default does nothing.","type":"text"}],"kind":"symbol","type":"topic","required":true,"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"finish","kind":"identifier"},{"text":"(","kin