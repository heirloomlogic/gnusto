/gnusto\/completioncandidates\/context-swift.enum","title":"CompletionCandidates.Context"},"doc://Gnusto/documentation/Gnusto/IOHandler/write(_:)":{"title":"write(_:)","url":"\/documentation\/gnusto\/iohandler\/write(_:)","abstract":[{"text":"Writes pre-formatted text (no trailing-newline policy is implied).","type":"text"}],"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler\/write(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"write","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":")","kind":"text"}],"required":true},"doc://Gnusto/documentation/Gnusto/ScriptedIOHandler":{"type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/ScriptedIOHandler","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScriptedIOHandler"}],"navigatorTitle":[{"kind":"identifier","text":"ScriptedIOHandler"}],"abstract":[{"text":"Feeds a fixed list of commands and records everything into a transcript —","type":"text"},{"text":" ","type":"text"},{"text":"for tests and automated playthroughs. Ships in the library because game","type":"text"},{"text":" ","type":"text"},{"text":"authors want transcript tests too.","type":"text"}],"url":"\/documentation\/gnusto\/scriptediohandler","title":"ScriptedIOHandler"},"doc://Gnusto/documentation/Gnusto/ConsoleIOHandler":{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/ConsoleIOHandler","kind":"symbol","type":"topic","url":"\/documentation\/gnusto\/consoleiohandler","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ConsoleIOHandler"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ConsoleIOHandler"}],"abstract":[{"text":"Plain terminal IO.","type":"text"}],"title":"ConsoleIOHandler"},"doc://Gnusto/documentation/Gnusto/Input":{"abstract":[{"type":"text","text":"One unit of player input from an "},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler","isActive":true,"type":"reference"},{"type":"text","text":": a line for the engine to"},{"type":"text","text":" "},{"type":"text","text":"run, or a front-end quit request (e.g. Ctrl-C) that ends the game "},{"inlineContent":[{"text":"without","type":"text"}],"type":"emphasis"},{"type":"text","text":" "},{"type":"text","text":"being parsed as a command — so it can’t be swallowed by an open save\/restore"},{"type":"text","text":" "},{"type":"text","text":"prompt or clash with a game that has redefined the "},{"code":"quit","type":"codeVoice"},{"type":"text","text":" verb. The REPL"},{"type":"text","text":" "},{"type":"text","text":"maps "},{"code":".quit","type":"codeVoice"},{"type":"text","text":" to "},{"code":"GameWorld.requestQuit()","type":"codeVoice"},{"type":"text","text":", which is keyed to "},{"code":"Intent.quit","type":"codeVoice"},{"type":"text","text":" "},{"text":"rather than the editable verb word.","type":"text"}],"title":"Input","url":"\/documentation\/gnusto\/input","type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Input","navigatorTitle":[{"text":"Input","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Input","kind":"identifier"}]},"doc://Gnusto/documentation/Gnusto/ScriptedIOHandler/transcript":{"title":"transcript","url":"\/documentation\/gnusto\/scriptediohandler\/transcript","abstract":[{"text":"Everything written so far, with input lines interleaved as","type":"text"},{"text":" ","type":"text"},{"code":"> command","type":"codeVoice"},{"text":" the way a player would see them.","type":"text"}],"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/ScriptedIOHandler\/transcript","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"tex