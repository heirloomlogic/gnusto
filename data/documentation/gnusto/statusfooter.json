{"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/StatusFooter\/init(environment:)"],"title":"Initializers","anchor":"Initializers","generated":true},{"identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/StatusFooter\/complaint","doc:\/\/Gnusto\/documentation\/Gnusto\/StatusFooter\/inForce"],"title":"Instance Properties","anchor":"Instance-Properties","generated":true}],"abstract":[{"type":"text","text":"The one-line out-of-fiction note a play-test session can have appended to"},{"type":"text","text":" "},{"type":"text","text":"every turn:"}],"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"StatusFooter"}],"navigatorTitle":[{"text":"StatusFooter","kind":"identifier"}],"title":"StatusFooter","roleHeading":"Structure","externalID":"s:6Gnusto12StatusFooterV","role":"symbol","symbolKind":"struct","modules":[{"name":"Gnusto"}]},"sections":[],"identifier":{"url":"doc:\/\/Gnusto\/documentation\/Gnusto\/StatusFooter","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto"]]},"relationshipsSections":[{"identifiers":["doc:\/\/Gnusto\/s8SendableP","doc:\/\/Gnusto\/s16SendableMetatypeP"],"title":"Conforms To","type":"conformsTo","kind":"relationships"}],"seeAlsoSections":[{"identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler","doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler\/write(_:)","doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler\/readLine(prompt:)","doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler\/showStatus(_:)","doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler\/wantsCompletions","doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler\/updateCompletions(_:)","doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler\/finish(_:)","doc:\/\/Gnusto\/documentation\/Gnusto\/Input","doc:\/\/Gnusto\/documentation\/Gnusto\/StatusLine","doc:\/\/Gnusto\/documentation\/Gnusto\/GameStatus","doc:\/\/Gnusto\/documentation\/Gnusto\/CompletionCandidates","doc:\/\/Gnusto\/documentation\/Gnusto\/CompletionCandidates\/Context-swift.enum","doc:\/\/Gnusto\/documentation\/Gnusto\/TerminalIOHandler","doc:\/\/Gnusto\/documentation\/Gnusto\/ConsoleIOHandler","doc:\/\/Gnusto\/documentation\/Gnusto\/ScriptedIOHandler"],"generated":true}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"StatusFooter"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"codeListing","code":["[status] room=Front Hall | moves=12 | score=0 | turn=cost | time=5:46 pm"],"syntax":null},{"type":"paragraph","inlineContent":[{"text":"A transcript is prose, and prose does not say where you are standing or","type":"text"},{"text":" ","type":"text"},{"text":"what the last command cost. A tester reading one back has to reconstruct","type":"text"},{"text":" ","type":"text"},{"text":"both, and the reconstruction is where the mistakes come from: counting","type":"text"},{"text":" ","type":"text"},{"text":"commands as turns is wrong the moment one of them fails to parse or turns","type":"text"},{"text":" ","type":"text"},{"text":"out to be a meta verb, and “which room was that?” is a scroll upwards.","type":"text"},{"text":" ","type":"text"},{"code":"moves=","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"turn=","type":"codeVoice"},{"text":" answer the first; ","type":"text"},{"code":"room=","type":"codeVoice"},{"text":" answers the second.","type":"text"}]},{"inlineContent":[{"type":"text","text":"A contributed field like "},{"type":"codeVoice","code":"time="},{"type":"text","text":" answers a third — "},{"type":"emphasis","inlineContent":[{"type":"text","text":"when"}]},{"type":"text","text":" — and is sampled"},{"type":"text","text":" "},{"type":"text","text":"at the turn’s close rather than after its counter advanced, so that it"},{"type":"text","text":" "},{"type":"text","text":"names the minute the turn’s own words were written in. See"},{"type":"text","text":" "},{"type":"codeVoice","code":"statusFields"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Off unless asked for. "},{"type":"codeVoice","code":"GNUSTO_STATUS"},{"type":"text","text":" is read by "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameMain"},{"type":"text","text":" — the"},{"type":"text","text":" "},{"type":"text","text":"composition root — and the value handed to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/REPL\/init(world:io:transcriptURL:status:environment:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which defaults to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":". The test suite constructs its REPLs without the"},{"type":"text","text":" "},{"type":"text","text":"argument, so "},{"type":"codeVoice","code":"GNUSTO_STATUS=1 swift test"},{"type":"text","text":" changes nothing: the footer is"},{"type":"text","text":" "},{"type":"text","text":"opt-in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"by construction"}]},{"type":"text","text":" rather than by an environment variable happening"},{"type":"text","text":" "},{"type":"text","text":"to be unset."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Modelled on "},{"isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/SeedRequest","type":"reference"},{"type":"text","text":": a value type that reads one variable, hands"},{"type":"text","text":" "},{"type":"text","text":"back what it found, and complains about a value it could not read instead"},{"type":"text","text":" "},{"type":"text","text":"of quietly doing something else."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/gnusto\/statusfooter"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Gnusto/documentation/Gnusto/Input":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Input","kind":"identifier"}],"navigatorTitle":[{"text":"Input","kind":"identifier"}],"type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/gnusto\/input","title":"Input","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Input","abstract":[{"type":"text","text":"One unit of player input from an "},{"isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler","type":"reference"},{"type":"text","text":": a line for the engine to"},{"type":"text","text":" "},{"type":"text","text":"run, or a front-end quit request (e.g. Ctrl-C) that ends the game "},{"type":"emphasis","inlineContent":[{"type":"text","text":"without"}]},{"type":"text","text":" "},{"type":"text","text":"being parsed as a command — so it can’t be swallowed by an open save\/restore"},{"type":"text","text":" "},{"type":"text","text":"prompt or clash with a game that has redefined the "},{"code":"quit","type":"codeVoice"},{"type":"text","text":" verb. The REPL"},{"type":"text","text":" "},{"type":"text","text":"maps "},{"code":".quit","type":"codeVoice"},{"type":"text","text":" to "},{"code":"GameWorld.requestQuit()","type":"codeVoice"},{"type":"text","text":", which is keyed to "},{"code":"Intent.quit","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"rather than the editable verb word."}]},"doc://Gnusto/documentation/Gnusto/IOHandler/readLine(prompt:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"readLine","kind":"identifier"},{"text":"(","kind":"text"},{"text":"prompt","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:6Gnusto5InputO","text":"Input","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"required":true,"type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/gnusto\/iohandler\/readline(prompt:)","title":"readLine(prompt:)","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler\/readLine(prompt:)","abstract":[{"type":"text","text":"Prompts for and returns one unit of input; "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" means end of input."}]},"doc://Gnusto/documentation/Gnusto/GameMain":{"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"GameMain"}],"navigatorTitle":[{"kind":"identifier","text":"GameMain"}],"kind":"symbol","url":"\/documentation\/gnusto\/gamemain","title":"GameMain","abstract":[{"type":"text","text":"Boots a "},{"type":"codeVoice","code":"Game"},{"type":"text","text":" type as a runnable program: "},{"type":"codeVoice","code":"@main struct Zork1: Game, GameMain {}"},{"type":"text","text":" is a complete executable, no "},{"type":"codeVoice","code":"main.swift"},{"type":"text","text":" required."}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameMain"},"doc://Gnusto/documentation/Gnusto/ScriptedIOHandler":{"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScriptedIOHandler"}],"navigatorTitle":[{"kind":"identifier","text":"ScriptedIOHandler"}],"kind":"symbol","url":"\/documentation\/gnusto\/scriptediohandler","title":"ScriptedIOHandler","abstract":[{"type":"text","text":"Feeds a fixed list of commands and records everything into a transcript —"},{"type":"text","text":" "},{"type":"text","text":"for tests and automated playthroughs. Ships in the library because game"},{"type":"text","text":" "},{"type":"text","text":"authors want transcript tests too."}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/ScriptedIOHandler"},"doc://Gnusto/documentation/Gnusto/CompletionCandidates":{"fragments":[{"text":"struc