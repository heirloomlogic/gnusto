sto","url":"\/documentation\/gnusto","title":"Gnusto","role":"collection"},"doc://Gnusto/documentation/Gnusto/IOHandler/wantsCompletions":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"wantsCompletions","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"role":"symbol","title":"wantsCompletions","defaultImplementations":1,"required":true,"url":"\/documentation\/gnusto\/iohandler\/wantscompletions","abstract":[{"type":"text","text":"Whether this handler will use the words "},{"isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler\/updateCompletions(_:)","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"delivers. Computing them costs a scope walk and a read of the save"},{"type":"text","text":" "},{"type":"text","text":"directory after every turn, so the REPL asks first and a handler with"},{"type":"text","text":" "},{"type":"text","text":"no line editor — the console, a script, a test — never pays for a set"},{"type":"text","text":" "},{"type":"text","text":"it would throw away. Defaults to "},{"code":"false","type":"codeVoice"},{"type":"text","text":"; "},{"isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TerminalIOHandler","type":"reference"},{"type":"text","text":" says"},{"type":"text","text":" "},{"code":"true","type":"codeVoice"},{"type":"text","text":"."}],"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler\/wantsCompletions","kind":"symbol"},"doc://Gnusto/documentation/Gnusto/ConsoleIOHandler":{"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ConsoleIOHandler"}],"navigatorTitle":[{"kind":"identifier","text":"ConsoleIOHandler"}],"kind":"symbol","url":"\/documentation\/gnusto\/consoleiohandler","title":"ConsoleIOHandler","abstract":[{"type":"text","text":"Plain terminal IO."}],"identifier":