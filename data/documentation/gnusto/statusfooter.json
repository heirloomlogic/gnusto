{"abstract":[{"type":"text","text":"The one-line out-of-fiction note a play-test session can have appended to"},{"type":"text","text":" "},{"type":"text","text":"every turn:"}],"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"seeAlsoSections":[{"identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler","doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler\/write(_:)","doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler\/readLine(prompt:)","doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler\/showStatus(_:)","doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler\/wantsCompletions","doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler\/updateCompletions(_:)","doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler\/finish(_:)","doc:\/\/Gnusto\/documentation\/Gnusto\/Input","doc:\/\/Gnusto\/documentation\/Gnusto\/StatusLine","doc:\/\/Gnusto\/documentation\/Gnusto\/GameStatus","doc:\/\/Gnusto\/documentation\/Gnusto\/CompletionCandidates","doc:\/\/Gnusto\/documentation\/Gnusto\/CompletionCandidates\/Context-swift.enum","doc:\/\/Gnusto\/documentation\/Gnusto\/TerminalIOHandler","doc:\/\/Gnusto\/documentation\/Gnusto\/ConsoleIOHandler","doc:\/\/Gnusto\/documentation\/Gnusto\/ScriptedIOHandler"],"generated":true}],"metadata":{"symbolKind":"struct","role":"symbol","modules":[{"name":"Gnusto"}],"externalID":"s:6Gnusto12StatusFooterV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"StatusFooter"}],"roleHeading":"Structure","title":"StatusFooter","navigatorTitle":[{"kind":"identifier","text":"StatusFooter"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"StatusFooter"}],"languages":["swift"]}]},{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"codeListing","code":["[status] room=Front Hall | moves=12 | score=0 | turn=cost | time=5:46 pm"],"syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"A transcript is prose, and prose does not say where you are standing or"},{"type":"text","text":" "},{"type":"text","text":"what the last command cost. A tester reading one back has to reconstruct"},{"type":"text","text":" "},{"type":"text","text":"both, and the reconstruction is where the mistakes come from: counting"},{"type":"text","text":" "},{"type":"text","text":"commands as turns is wrong the moment one of them fails to parse or turns"},{"type":"text","text":" "},{"type":"text","text":"out to be a meta verb, and “which room was that?” is a scroll upwards."},{"type":"text","text":" "},{"type":"codeVoice","code":"moves="},{"type":"text","text":" and "},{"type":"codeVoice","code":"turn="},{"type":"text","text":" answer the first; "},{"type":"codeVoice","code":"room="},{"type":"text","text":" answers the second."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A contributed field like "},{"type":"codeVoice","code":"time="},{"type":"text","text":" answers a third — "},{"type":"emphasis","inlineContent":[{"type":"text","text":"when"}]},{"type":"text","text":" — and is sampled"},{"type":"text","text":" "},{"type":"text","text":"at the turn’s close rather than after its counter advanced, so that it"},{"type":"text","text":" "},{"type":"text","text":"names the minute the turn’s own words were written in. See"},{"type":"text","text":" "},{"type":"codeVoice","code":"statusFields"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Off unless asked for. "},{"type":"codeVoice","code":"GNUSTO_STATUS"},{"type":"text","text":" is read by "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameMain"},{"type":"text","text":" — the"},{"type":"text","text":" "},{"type":"text","text":"composition root — and the value handed to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/REPL\/init(world:io:transcriptURL:status:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which defaults to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":". The test suite constructs its REPLs without the"},{"type":"text","text":" "},{"type":"text","text":"argument, so "},{"type":"codeVoice","code":"GNUSTO_STATUS=1 swift test"},{"type":"text","text":" changes nothing: the footer is"},{"type":"text","text":" "},{"type":"text","text":"opt-in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"by construction"}]},{"type":"text","text":" rather than by an environment variable happening"},{"type":"text","text":" "},{"type":"text","text":"to be unset."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Modelled on "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/SeedRequest"},{"type":"text","text":": a value type that reads one variable, hands"},{"type":"text","text":" "},{"type":"text","text":"back what it found, and complains about a value it could not read instead"},{"type":"text","text":" "},{"type":"text","text":"of quietly doing something else."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/gnusto\/statusfooter"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/StatusFooter\/init(environment:)"],"generated":true},{"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/StatusFooter\/complaint","doc:\/\/Gnusto\/documentation\/Gnusto\/StatusFooter\/inForce"],"generated":true}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Gnusto\/documentation\/Gnusto\/StatusFooter"},"kind":"symbol","relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/Gnusto\/s8SendableP","doc:\/\