{"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"paths":["\/documentation\/gnusto\/statusfooter"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto"]]},"identifier":{"url":"doc:\/\/Gnusto\/documentation\/Gnusto\/StatusFooter","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"StatusFooter","kind":"identifier"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"codeListing","code":["[status] room=Front Hall | moves=12 | score=0 | turn=cost | time=5:46 pm"],"syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"A transcript is prose, and prose does not say where you are standing or"},{"type":"text","text":" "},{"type":"text","text":"what the last command cost. A tester reading one back has to reconstruct"},{"type":"text","text":" "},{"type":"text","text":"both, and the reconstruction is where the mistakes come from: counting"},{"type":"text","text":" "},{"type":"text","text":"commands as turns is wrong the moment one of them fails to parse or turns"},{"type":"text","text":" "},{"type":"text","text":"out to be a meta verb, and “which room was that?” is a scroll upwards."},{"type":"text","text":" "},{"type":"codeVoice","code":"moves="},{"type":"text","text":" and "},{"type":"codeVoice","code":"turn="},{"type":"text","text":" answer the first; "},{"type":"codeVoice","code":"room="},{"type":"text","text":" answers the second."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A contributed field like "},{"type":"codeVoice","code":"time="},{"type":"text","text":" answers a third — "},{"type":"emphasis","inlineContent":[{"text":"when","type":"text"}]},{"type":"text","text":" — and is sampled"},{"type":"text","text":" "},{"type":"text","text":"at the turn’s close rather than after its counter advanced, so that it"},{"type":"text","text":" "},{"type":"text","text":"names the minute the turn’s own words were written in. See"},{"type":"text","text":" "},{"type":"codeVoice","code":"statusFields"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Off unless asked for. "},{"type":"codeVoice","code":"GNUSTO_STATUS"},{"type":"text","text":" is read by "},{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameMain","isActive":true},{"type":"text","text":" — the"},{"type":"text","text":" "},{"type":"text","text":"composition root — and the value handed to "},{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/REPL\/init(world:io:transcriptURL:status:)","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which defaults to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":". The test suite constructs its REPLs without the"},{"type":"text","text":" "},{"type":"text","text":"argument, so "},{"type":"codeVoice","code":"GNUSTO_STATUS=1 swift test"},{"type":"text","text":" changes nothing: the footer is"},{"type":"text","text":" "},{"type":"text","text":"opt-in "},{"type":"emphasis","inlineContent":[{"text":"by construction","type":"text"}]},{"type":"text","text":" rather than by an environment variable happening"},{"type":"text","text":" "},{"type":"text","text":"to be unset."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Modelled on "},{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/SeedRequest","isActive":true},{"type":"text","text":": a value type that reads one variable, hands"},{"type":"text","text":" "},{"type":"text","text":"back what it found, and complains about a value it could not read instead"},{"type":"text","text":" "},{"type":"text","text":"of quietly doing something else."}]}],"kind":"content"}],"topicSections":[{"generated":true,"anchor":"In