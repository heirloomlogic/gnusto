{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap"},"sections":[],"topicSections":[{"anchor":"Type-Properties","generated":true,"identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/lineBreak"],"title":"Type Properties"},{"anchor":"Type-Methods","generated":true,"identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/plain(_:)"],"title":"Type Methods"}],"metadata":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TextWrap","kind":"identifier"}],"navigatorTitle":[{"text":"TextWrap","kind":"identifier"}],"externalID":"s:6Gnusto8TextWrapO","symbolKind":"enum","roleHeading":"Enumeration","role":"symbol","title":"TextWrap","modules":[{"name":"Gnusto"}]},"abstract":[{"text":"Renders game prose for a channel: reflowed to a column width for the","type":"text"},{"text":" ","type":"text"},{"text":"full-screen terminal, folded for every plain one. Pure and side-effect-free","type":"text"},{"text":" ","type":"text"},{"text":"so it can be unit-tested without a live terminal.","type":"text"}],"variants":[{"paths":["\/documentation\/gnusto\/textwrap"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TextWrap","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"inlineContent":[{"text":"The whole transcript is re-wrapped at the current width on every render, so","type":"text"},{"text":" ","type":"text"},{"text":"this is the one place the “smart reflow on resize” behavior actually lives.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Text is treated by Markdown’s paragraph rule: a ","type":"text"},{"inlineContent":[{"text":"single","type":"text"}],"type":"strong"},{"text":" newline inside a","type":"text"},{"text":" ","type":"text"},{"text":"paragraph is a soft break that folds to a space, and only a ","type":"text"},{"inlineContent":[{"text":"blank line","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"text":"starts a new paragraph. Game prose is authored as multi-line ","type":"text"},{"code":"\"\"\"","type":"codeVoice"},{"text":" literals","type":"text"},{"text":" ","type":"text"},{"text":"wrapped for source readability, so honoring those incidental newlines as","type":"text"},{"text":" ","type":"text"},{"text":"hard breaks would shatter the layout whenever the window is narrower than","type":"text"},{"text":" ","type":"text"},{"text":"the width the author happened to wrap at (dangling “This”, “and”, …).","type":"text"},{"text":" ","type":"text"},{"text":"Folding them makes the layout depend on the channel and never on the column","type":"text"},{"text":" ","type":"text"},{"text":"the author happened to type at.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Both","type":"text"}],"type":"strong"},{"text":" channels apply that rule, which is the whole point of this type.","type":"text"},{"text":" ","type":"text"},{"text":"They used to disagree: the reflowing one folded and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/plain(_:)","type":"reference"},{"text":" did not,","type":"text"},{"text":" ","type":"text"},{"text":"so a literal printed at the source’s wrap column on the one channel that","type":"text"},{"text":" ","type":"text"},{"text":"transcripts, CI and every play-test artifact are read in — and at ","type":"text"},{"inlineContent":[{"text":"two","type":"text"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"columns the moment a clause was concatenated onto it. That is what made a","type":"text"},{"text":" ","type":"text"},{"text":"trailing ","type":"text"},{"code":"\\","type":"codeVoice"},{"text":" on every prose line look like a convention. It never was one;","type":"text"},{"text":" ","type":"text"},{"text":"it was a workaround for this, and there is nothing left for it to work","type":"text"},{"text":" ","type":"text"},{"text":"around.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Three ways to say something other than “this is running prose”:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"A "},{"type":"strong","inlineContent":[{"type":"text","text":"blank line"}]},{"type":"text","text":" starts a new paragraph."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/lineBreak","type":"reference"},{"text":" marker ","type":"text"},{"code":"<br>","type":"codeVoice"},{"text":" is a hard break ","type":"text"},{"inlineContent":[{"text":"within","type":"text"}],"type":"emphasis"},{"text":" a paragraph, for","type":"text"},{"text":" ","type":"text"},{"text":"a banner’s title over its tagline. Non-whitespace, so unlike a trailing","type":"text"},{"text":" ","type":"text"},{"text":"double space it survives editors and formatters that trim line endings.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Indentation"}]},{"type":"text","text":" makes a "},{"type":"strong","inlineContent":[{"type":"text","text":"form"}]},{"type":"text","text":": an inscription, a map legend, a ring of"},{"type":"text","text":" "},{"type":"text","text":"letters cut round a shaft, a scrap of verse. Both channels read it as"},{"type":"text","text":" "},{"type":"text","text":"Markdown reads it — a literal block, never folded and never"},{"type":"text","text":" "},{"type":"text","text":"re-packed. That is a description of what this package’s authors already"},{"type":"text","text":" "},{"type":"text","text":"did, not a rule imposed on them: every such block in every game target is"},{"type":"text","text":" "},{"type":"text","text":"indented, and nothing else in a game target is."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"One internal "},{"code":"fold","type":"codeVoice"},{"type":"text","text":" is the single implementation of all of that, and both"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/plain(_:)","isActive":true},{"type":"text","text":" and the reflowing renderer are built on it, so the two channels"},{"type":"text","text":" "},{"type":"text","text":"cannot drift apart again about what a paragraph is."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Only "},{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/plain(_:)","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/lineBreak","isActive":true},{"type":"text","text":" are public: a front end that prints text"},{"type":"text","text":" "},{"type":"text","text":"needs to render the marker and the fold, and the terminal-column machinery"},{"type":"text","text":" "},{"type":"text","text":"behind the full-screen handler is the engine’s own."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto"]]},"kind":"symbol","references":{"doc://Gnusto/documentation/Gnusto/TextWrap/lineBreak":{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/lineBreak","abstract":[{"text":"The in-band hard line-break marker (as in Markdown\/HTML): a break within","type":"text"},{"text":" ","type":"text"},{"text":"a paragraph, no blank line, formatter-proof. The full-screen renderer","type":"text"},{"text":" ","type":"text"},{"text":"honors it through the fold; plain output turns it into a newline via","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/plain(_:)","type":"reference","isActive":true},{"text":" so it never shows literally.","type":"text"}],"type":"topic","title":"lineBreak","url":"\/documentation\/gnusto\/textwrap\/linebreak","role":"symbol","kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lineBreak","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"}]},"doc://Gnusto/documentation/Gnusto/TextWrap":{"role":"symbol","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TextWrap","kind":"identifier"}],"navigatorTitle":[{"text":"TextWrap","kind":"identifier"}],"url":"\/documentation\/gnusto\/textwrap","kind":"symbol","title":"TextWrap","abstract":[{"type":"text","text":"Renders game prose for a channel: reflowed to a column width for the"},{"type":"text","text":" "},{"type":"text","text":"full-screen terminal, folded for every plain one. Pure and side-effect-free"},{"type":"text","text":" "},{"type":"text","text":"so it can be unit-tested without a live terminal."}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap"},"doc://Gnusto/documentation/Gnusto/TextWrap/plain(_:)":{"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"plain"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"kind":"symbol","url":"\/documentation\/gnusto\/textwrap\/plain(_:)","title":"plain(_:)","abstract":[{"type":"text","text":"Renders game text for a plain, non-reflowing channel: folds the"},{"type":"text","text":" "},{"type":"text","text":"paragraph’s soft breaks, then turns the hard-break marker into a real"},{"type":"text","text":" "},{"type":"text","text":"newline."}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/plain(_:)"},"doc://Gnusto/documentation/Gnusto":{"kind":"symbol","abstract":[{"type":"text","text":"An engine for writing interactive fiction in Swift."}],"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto","url":"\/documentation\/gnusto","title":"Gnusto","role":"collection"}}}