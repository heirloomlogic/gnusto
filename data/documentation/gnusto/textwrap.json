{"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap"},"topicSections":[{"generated":true,"anchor":"Type-Properties","title":"Type Properties","identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/lineBreak"]},{"generated":true,"anchor":"Type-Methods","title":"Type Methods","identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/plain(_:)"]}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnusto\/textwrap"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TextWrap","kind":"identifier"}],"platforms":["macOS"]}]},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"The whole transcript is re-wrapped at the current width on every render, so"},{"type":"text","text":" "},{"type":"text","text":"this is the one place the “smart reflow on resize” behavior actually lives."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Text is treated by Markdown’s paragraph rule: a "},{"type":"strong","inlineContent":[{"type":"text","text":"single"}]},{"type":"text","text":" newline inside a"},{"type":"text","text":" "},{"type":"text","text":"paragraph is a soft break that folds to a space, and only a "},{"type":"strong","inlineContent":[{"type":"text","text":"blank line"}]},{"type":"text","text":" "},{"type":"text","text":"starts a new paragraph. Game prose is authored as multi-line "},{"type":"codeVoice","code":"\"\"\""},{"type":"text","text":" literals"},{"type":"text","text":" "},{"type":"text","text":"wrapped for source readability, so honoring those incidental newlines as"},{"type":"text","text":" "},{"type":"text","text":"hard breaks would shatter the layout whenever the window is narrower than"},{"type":"text","text":" "},{"type":"text","text":"the width the author happened to wrap at (dangling “This”, “and”, …)."},{"type":"text","text":" "},{"type":"text","text":"Folding them makes the layout depend on the channel and never on the column"},{"type":"text","text":" "},{"type":"text","text":"the author happened to type at."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Both"}]},{"type":"text","text":" channels apply that rule, which is the whole point of this type."},{"type":"text","text":" "},{"type":"text","text":"They used to disagree: the reflowing one folded and "},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/plain(_:)","isActive":true,"type":"reference"},{"type":"text","text":" did not,"},{"type":"text","text":" "},{"type":"text","text":"so a literal printed at the source’s wrap column on the one channel that"},{"type":"text","text":" "},{"type":"text","text":"transcripts, CI and every play-test artifact are read in — and at "},{"type":"emphasis","inlineContent":[{"type":"text","text":"two"}]},{"type":"text","text":" "},{"type":"text","text":"columns the moment a clause was concatenated onto it. That is what made a"},{"type":"text","text":" "},{"type":"text","text":"trailing "},{"type":"codeVoice","code":"\\"},{"type":"text","text":" on every prose line look like a convention. It never was one;"},{"type":"text","text":" "},{"type":"text","text":"it was a workaround for this, and there is nothing left for it to work"},{"type":"text","text":" "},{"type":"text","text":"around."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Three ways to say something other than “this is running prose”:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"A ","type":"text"},{"type":"strong","inlineContent":[{"text":"blank line","type":"text"}]},{"text":" starts a new paragraph.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/lineBreak"},{"text":" marker ","type":"text"},{"code":"<br>","type":"codeVoice"},{"text":" is a hard break ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"within","type":"text"}]},{"text":" a paragraph, for","type":"text"},{"text":" ","type":"text"},{"text":"a banner’s title over its tagline. Non-whitespace, so unlike a trailing","type":"text"},{"text":" ","type":"text"},{"text":"double space it survives editors and formatters that trim line endings.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Indentation","type":"text"}]},{"text":" makes a ","type":"text"},{"type":"strong","inlineContent":[{"text":"form","type":"text"}]},{"text":": an inscription, a map legend, a ring of","type":"text"},{"text":" ","type":"text"},{"text":"letters cut round a shaft, a scrap of verse. Both channels read it as","type":"text"},{"text":" ","type":"text"},{"text":"Markdown reads it — a literal block, never folded and never","type":"text"},{"text":" ","type":"text"},{"text":"re-packed. That is a description of what this package’s authors already","type":"text"},{"text":" ","type":"text"},{"text":"did, not a rule imposed on them: every such block in every game target is","type":"text"},{"text":" ","type":"text"},{"text":"indented, and nothing else in a game target is.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"One internal "},{"type":"codeVoice","code":"fold"},{"type":"text","text":" is the single implementation of all of that, and both"},{"type":"text","text":" "},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/plain(_:)","isActive":true,"type":"reference"},{"type":"text","text":" and the reflowing renderer are built on it, so the two channels"},{"type":"text","text":" "},{"type":"text","text":"cannot drift apart again about what a paragraph is."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Only "},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/plain(_:)","isActive":true,"type":"reference"},{"type":"text","text":" and "},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/lineBreak","isActive":true,"type":"reference"},{"type":"text","text":" are public: a front end that prints text"},{"type":"text","text":" "},{"type":"text","text":"needs to render the marker and the fold, and the terminal-column machinery"},{"type":"text","text":" "},{"type":"text","text":"behind the full-screen handler is the engine’s own."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"Renders game prose for a channel: reflowed to a column width for the","type":"text"},{"text":" ","type":"text"},{"text":"full-screen terminal, folded for every plain one. Pure and side-effect-free","type":"text"},{"text":" ","type":"text"},{"text":"so it can be unit-tested without a live terminal.","type":"text"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","metadata":{"modules":[{"name":"Gnusto"}],"externalID":"s:6Gnusto8TextWrapO","roleHeading":"Enumeration","title":"TextWrap","symbolKind":"enum","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"TextWrap"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TextWrap","kind":"identifier"}]},"references":{"doc://Gnusto/documentation/Gnusto/TextWrap/lineBreak":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lineBreak","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/lineBreak","url":"\/documentation\/gnusto\/textwrap\/linebreak","type":"topic","abstract":[{"text":"The in-band hard line-break marker (as in Markdown\/HTML): a break within","type":"text"},{"text":" ","type":"text"},{"text":"a paragraph, no blank line, formatter-proof. The full-screen renderer","type":"text"},{"text":" ","type":"text"},{"text":"honors it through the fold; plain output turns it into a newline via","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/plain(_:)","isActive":true,"type":"reference"},{"text":" so it never shows literally.","type":"text"}],"title":"lineBreak","kind":"symbol","role":"symbol"},"doc://Gnusto/documentation/Gnusto":{"role":"collection","abstract":[{"type":"text","text":"An engine for writing interactive fiction in Swift."}],"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto","kind":"symbol","title":"Gnusto","url":"\/documentation\/gnusto"},"doc://Gnusto/documentation/Gnusto/TextWrap/plain(_:)":{"fragments":[{"text":"static","kind":"keyword"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"plain"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":") -> "},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/plain(_:)","url":"\/documentation\/gnusto\/textwrap\/plain(_:)","type":"topic","abstract":[{"type":"text","text":"Renders game text for a plain, non-reflowing channel: folds the"},{"type":"text","text":" "},{"type":"text","text":"paragraph’s soft breaks, then turns the hard-break marker into a real"},{"type":"text","text":" "},{"type":"text","text":"newline."}],"title":"plain(_:)","kind":"symbol","role":"symbol"},"doc://Gnusto/documentation/Gnusto/TextWrap":{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap","abstract":[{"type":"text","text":"Renders game prose for a channel: reflowed to a column width for the"},{"type":"text","text":" "},{"type":"text","text":"full-screen terminal, folded for every plain one. Pure and side-effect-free"},{"type":"text","text":" "},{"type":"text","text":"so it can be unit-tested without a live terminal."}],"title":"TextWrap","navigatorTitle":[{"kind":"identifier","text":"TextWrap"}],"role":"symbol","url":"\/documentation\/gnusto\/textwrap","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"TextWrap"}],"type":"topic","kind":"symbol"}}}