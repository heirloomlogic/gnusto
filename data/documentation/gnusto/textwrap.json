{"abstract":[{"text":"Renders game prose for a channel: reflowed to a column width for the","type":"text"},{"text":" ","type":"text"},{"text":"full-screen terminal, folded for every plain one. Pure and side-effect-free","type":"text"},{"text":" ","type":"text"},{"text":"so it can be unit-tested without a live terminal.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto"]]},"metadata":{"symbolKind":"enum","roleHeading":"Enumeration","modules":[{"name":"Gnusto"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TextWrap","kind":"identifier"}],"title":"TextWrap","navigatorTitle":[{"kind":"identifier","text":"TextWrap"}],"externalID":"s:6Gnusto8TextWrapO","role":"symbol"},"topicSections":[{"generated":true,"title":"Type Properties","anchor":"Type-Properties","identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/lineBreak"]},{"generated":true,"title":"Type Methods","anchor":"Type-Methods","identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/plain(_:)"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TextWrap","kind":"identifier"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"The whole transcript is re-wrapped at the current width on every render, so","type":"text"},{"text":" ","type":"text"},{"text":"this is the one place the “smart reflow on resize” behavior actually lives.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Text is treated by Markdown’s paragraph rule: a ","type":"text"},{"inlineContent":[{"text":"single","type":"text"}],"type":"strong"},{"text":" newline inside a","type":"text"},{"text":" ","type":"text"},{"text":"paragraph is a soft break that folds to a space, and only a ","type":"text"},{"inlineContent":[{"text":"blank line","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"text":"starts a new paragraph. Game prose is authored as multi-line ","type":"text"},{"code":"\"\"\"","type":"codeVoice"},{"text":" literals","type":"text"},{"text":" ","type":"text"},{"text":"wrapped for source readability, so honoring those incidental newlines as","type":"text"},{"text":" ","type":"text"},{"text":"hard breaks would shatter the layout whenever the window is narrower than","type":"text"},{"text":" ","type":"text"},{"text":"the width the author happened to wrap at (dangling “This”, “and”, …).","type":"text"},{"text":" ","type":"text"},{"text":"Folding them makes the layout depend on the channel and never on the column","type":"text"},{"text":" ","type":"text"},{"text":"the author happened to type at.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Both","type":"text"}],"type":"strong"},{"text":" channels apply that rule, which is the whole point of this type.","type":"text"},{"text":" ","type":"text"},{"text":"They used to disagree: the reflowing one folded and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/plain(_:)","type":"reference"},{"text":" did not,","type":"text"},{"text":" ","type":"text"},{"text":"so a literal printed at the source’s wrap column on the one channel that","type":"text"},{"text":" ","type":"text"},{"text":"transcripts, CI and every play-test artifact are read in — and at ","type":"text"},{"inlineContent":[{"text":"two","type":"text"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"columns the moment a clause was concatenated onto it. That is what made a","type":"text"},{"text":" ","type":"text"},{"text":"trailing ","type":"text"},{"code":"\\","type":"codeVoice"},{"text":" on every prose line look like a convention. It never was one;","type":"text"},{"text":" ","type":"text"},{"text":"it was a workaround for this, and there is nothing left for it to work","type":"text"},{"text":" ","type":"text"},{"text":"around.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Three ways to say something other than “this is running prose”:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"A "},{"type":"strong","inlineContent":[{"type":"text","text":"blank line"}]},{"type":"text","text":" starts a new paragraph."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/lineBreak","isActive":true,"type":"reference"},{"type":"text","text":" marker "},{"type":"codeVoice","code":"<br>"},{"type":"text","text":" is a hard break "},{"type":"emphasis","inlineContent":[{"type":"text","text":"within"}]},{"type":"text","text":" a paragraph, for"},{"type":"text","text":" "},{"type":"text","text":"a banner’s title over its tagline. Non-whitespace, so unlike a trailing"},{"type":"text","text":" "},{"type":"text","text":"double space it survives editors and formatters that trim line endings."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Indentation"}]},{"type":"text","text":" makes a "},{"type":"strong","inlineContent":[{"type":"text","text":"form"}]},{"type":"text","text":": an inscription, a map legend, a ring of"},{"type":"text","text":" "},{"type":"text","text":"letters cut round a shaft, a scrap of verse. Both channels read it as"},{"type":"text","text":" "},{"type":"text","text":"Markdown reads it — a literal block, never folded and never"},{"type":"text","text":" "},{"type":"text","text":"re-packed. That is a description of what this package’s authors already"},{"type":"text","text":" "},{"type":"text","text":"did, not a rule imposed on them: every such block in every game target is"},{"type":"text","text":" "},{"type":"text","text":"indented, and nothing else in a game target is."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"One internal ","type":"text"},{"code":"fold","type":"codeVoice"},{"text":" is the single implementation of all of that, and both","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/plain(_:)","type":"reference"},{"text":" and the reflowing renderer are built on it, so the two channels","type":"text"},{"text":" ","type":"text"},{"text":"cannot drift apart again about what a paragraph is.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Only ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/plain(_:)","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/lineBreak","type":"reference"},{"text":" are public: a front end that prints text","type":"text"},{"text":" ","type":"text"},{"text":"needs to render the marker and the fold, and the terminal-column machinery","type":"text"},{"text":" ","type":"text"},{"text":"behind the full-screen handler is the engine’s own.","type":"text"}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap"},"variants":[{"paths":["\/documentation\/gnusto\/textwrap"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","sections":[],"references":{"doc://Gnusto/documentation/Gnusto":{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto","kind":"symbol","abstract":[{"type":"text","text":"An engine for writing interactive fiction in Swift."}],"title":"Gnusto","role":"collection","url":"\/documentation\/gnusto","type":"topic"},"doc://Gnusto/documentation/Gnusto/TextWrap/plain(_:)":{"abstract":[{"text":"Renders game text for a plain, non-reflowing channel: folds the","type":"text"},{"text":" ","type":"text"},{"text":"paragraph’s soft breaks, then turns the hard-break marker into a real","type":"text"},{"text":" ","type":"text"},{"text":"newline.","type":"text"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/plain(_:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"plain","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"title":"plain(_:)","url":"\/documentation\/gnusto\/textwrap\/plain(_:)","kind":"symbol","type":"topic","role":"symbol"},"doc://Gnusto/documentation/Gnusto/TextWrap/lineBreak":{"abstract":[{"text":"The in-band hard line-break marker (as in Markdown\/HTML): a break within","type":"text"},{"text":" ","type":"text"},{"text":"a paragraph, no blank line, formatter-proof. The full-screen renderer","type":"text"},{"text":" ","type":"text"},{"text":"honors it through the fold; plain output turns it into a newline via","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/plain(_:)"},{"text":" so it never shows literally.","type":"text"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/lineBreak","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"lineBreak"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}],"title":"lineBreak","url":"\/documentation\/gnusto\/textwrap\/linebreak","kind":"symbol","type":"topic","role":"symbol"},"doc://Gnusto/documentation/Gnusto/TextWrap":{"title":"TextWrap","kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TextWrap","kind":"identifier"}],"navigatorTitle":[{"text":"TextWrap","kind":"identifier"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap","abstract":[{"text":"Renders game prose for a channel: reflowed to a column width for the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"full-screen terminal, folded for every plain one. Pure and side-effect-free"},{"type":"text","text":" "},{"type":"text","text":"so it can be unit-tested without a live terminal."}],"url":"\/documentation\/gnusto\/textwrap","type":"topic"}}}