{"sections":[],"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto"]]},"kind":"symbol","identifier":{"url":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TextWrap","kind":"identifier"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The whole transcript is re-wrapped at the current width on every render, so","type":"text"},{"text":" ","type":"text"},{"text":"this is the one place the “smart reflow on resize” behavior actually lives.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Text is treated by Markdown’s paragraph rule: a ","type":"text"},{"inlineContent":[{"type":"text","text":"single"}],"type":"strong"},{"text":" newline inside a","type":"text"},{"text":" ","type":"text"},{"text":"paragraph is a soft break that folds to a space, and only a ","type":"text"},{"inlineContent":[{"type":"text","text":"blank line"}],"type":"strong"},{"text":" ","type":"text"},{"text":"starts a new paragraph. Game prose is authored as multi-line ","type":"text"},{"code":"\"\"\"","type":"codeVoice"},{"text":" literals","type":"text"},{"text":" ","type":"text"},{"text":"wrapped for source readability, so honoring those incidental newlines as","type":"text"},{"text":" ","type":"text"},{"text":"hard breaks would shatter the layout whenever the window is narrower than","type":"text"},{"text":" ","type":"text"},{"text":"the width the author happened to wrap at (dangling “This”, “and”, …).","type":"text"},{"text":" ","type":"text"},{"text":"Folding them makes the layout depend on the channel and never on the column","type":"text"},{"text":" ","type":"text"},{"text":"the author happened to type at.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Both"}],"type":"strong"},{"text":" channels apply that rule, which is the whole point of this type.","type":"text"},{"text":" ","type":"text"},{"text":"They used to disagree: the reflowing one folded and ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/plain(_:)","isActive":true,"type":"reference"},{"text":" did not,","type":"text"},{"text":" ","type":"text"},{"text":"so a literal printed at the source’s wrap column on the one channel that","type":"text"},{"text":" ","type":"text"},{"text":"transcripts, CI and every play-test artifact are read in — and at ","type":"text"},{"inlineContent":[{"type":"text","text":"two"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"columns the moment a clause was concatenated onto it. That is what made a","type":"text"},{"text":" ","type":"text"},{"text":"trailing ","type":"text"},{"code":"\\","type":"codeVoice"},{"text":" on every prose line look like a convention. It never was one;","type":"text"},{"text":" ","type":"text"},{"text":"it was a workaround for this, and there is nothing left for it to work","type":"text"},{"text":" ","type":"text"},{"text":"around.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Three ways to say something other than “this is running prose”:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"inlineContent":[{"text":"blank line","type":"text"}],"type":"strong"},{"text":" starts a new paragraph.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/lineBreak","isActive":true,"type":"reference"},{"text":" marker ","type":"text"},{"type":"codeVoice","code":"<br>"},{"text":" is a hard break ","type":"text"},{"inlineContent":[{"text":"within","type":"text"}],"type":"emphasis"},{"text":" a paragraph, for","type":"text"},{"text":" ","type":"text"},{"text":"a banner’s title over its tagline. Non-whitespace, so unlike a trailing","type":"text"},{"text":" ","type":"text"},{"text":"double space it survives editors and formatters that trim line endings.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Indentation","type":"text"}],"type":"strong"},{"text":" makes a ","type":"text"},{"inlineContent":[{"text":"form","type":"text"}],"type":"strong"},{"text":": an inscription, a map legend, a ring of","type":"text"},{"text":" ","type":"text"},{"text":"letters cut round a shaft, a scrap of verse. Both channels read it as","type":"text"},{"text":" ","type":"text"},{"text":"Markdown reads it — a literal block, never folded and never","type":"text"},{"text":" ","type":"text"},{"text":"re-packed. That is a description of what this package’s authors already","type":"text"},{"text":" ","type":"text"},{"text":"did, not a rule imposed on them: every such block in every game target is","type":"text"},{"text":" ","type":"text"},{"text":"indented, and nothing else in a game target is.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"One internal ","type":"text"},{"code":"fold","type":"codeVoice"},{"text":" is the single implementation of all of that, and both","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/plain(_:)","isActive":true,"type":"reference"},{"text":" and the reflowing renderer are built on it, so the two channels","type":"text"},{"text":" ","type":"text"},{"text":"cannot drift apart again about what a paragraph is.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Only ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/plain(_:)","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/lineBreak","isActive":true,"type":"reference"},{"text":" are public: a front end that prints text","type":"text"},{"text":" ","type":"text"},{"text":"needs to render the marker and the fold, and the terminal-column machinery","type":"text"},{"text":" ","type":"text"},{"text":"behind the full-screen handler is the engine’s own.","type":"text"}]}]}],"metadata":{"modules":[{"name":"Gnusto"}],"title":"TextWrap","symbolKind":"enum","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TextWrap","kind":"identifier"}],"roleHeading":"Enumeration","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"TextWrap"}],"externalID":"s:6Gnusto8TextWrapO"},"topicSections":[{"anchor":"Type-Properties","identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/lineBreak"],"generated":true,"title":"Type Properties"},{"anchor":"Type-Methods","identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/plain(_:)"],"generated":true,"title":"Type Methods"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"Renders game prose for a channel: reflowed to a column width for the","type":"text"},{"text":" ","type":"text"},{"text":"full-screen terminal, folded for every plain one. Pure and side-effect-free","type":"text"},{"text":" ","type":"text"},{"text":"so it can be unit-tested without a live terminal.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnusto\/textwrap"]}],"references":{"doc://Gnusto/documentation/Gnusto":{"abstract":[{"text":"An engine for writing interactive fiction in Swift.","type":"text"}],"title":"Gnusto","kind":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto","type":"topic","url":"\/documentation\/gnusto","role":"collection"},"doc://Gnusto/documentation/Gnusto/TextWrap":{"url":"\/documentation\/gnusto\/textwrap","title":"TextWrap","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap","kind":"symbol","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TextWrap","kind":"identifier"}],"abstract":[{"text":"Renders game prose for a channel: reflowed to a column width for the","type":"text"},{"text":" ","type":"text"},{"text":"full-screen terminal, folded for every plain one. Pure and side-effect-free","type":"text"},{"text":" ","type":"text"},{"text":"so it can be unit-tested without a live terminal.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"TextWrap","kind":"identifier"}]},"doc://Gnusto/documentation/Gnusto/TextWrap/plain(_:)":{"url":"\/documentation\/gnusto\/textwrap\/plain(_:)","title":"plain(_:)","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/plain(_:)","kind":"symbol","type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"plain","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"abstract":[{"text":"Renders game text for a plain, non-reflowing channel: folds the","type":"text"},{"text":" ","type":"text"},{"text":"paragraph’s soft breaks, then turns the hard-break marker into a real","type":"text"},{"text":" ","type":"text"},{"text":"newline.","type":"text"}],"role":"symbol"},"doc://Gnusto/documentation/Gnusto/TextWrap/lineBreak":{"type":"topic","title":"lineBreak","kind":"symbol","role":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/lineBreak","fragments":[{"text":"static","kind":"keyword"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"lineBreak"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"abstract":[{"text":"The in-band hard line-break marker (as in Markdown\/HTML): a break within","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"a paragraph, no blank line, formatter-proof. The full-screen renderer"},{"text":" ","type":"text"},{"text":"honors it through the fold; plain output turns it into a newline via","type":"text"},{"type":"text","text":" "},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/plain(_:)","isActive":true,"type":"reference"},{"text":" so it never shows literally.","type":"text"}],"url":"\/documentation\/gnusto\/textwrap\/linebreak"}}}