{"metadata":{"title":"TextWrap","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"TextWrap"}],"externalID":"s:6Gnusto8TextWrapO","roleHeading":"Enumeration","modules":[{"name":"Gnusto"}],"navigatorTitle":[{"text":"TextWrap","kind":"identifier"}],"role":"symbol","symbolKind":"enum"},"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"Renders game prose for a channel: reflowed to a column width for the","type":"text"},{"text":" ","type":"text"},{"text":"full-screen terminal, folded for every plain one. Pure and side-effect-free","type":"text"},{"text":" ","type":"text"},{"text":"so it can be unit-tested without a live terminal.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnusto\/textwrap"]}],"kind":"symbol","topicSections":[{"title":"Type Properties","generated":true,"anchor":"Type-Properties","identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/lineBreak"]},{"title":"Type Methods","generated":true,"anchor":"Type-Methods","identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/plain(_:)"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"TextWrap"}],"languages":["swift"]}]},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The whole transcript is re-wrapped at the current width on every render, so"},{"type":"text","text":" "},{"type":"text","text":"this is the one place the “smart reflow on resize” behavior actually lives."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Text is treated by Markdown’s paragraph rule: a "},{"type":"strong","inlineContent":[{"type":"text","text":"single"}]},{"type":"text","text":" newline inside a"},{"type":"text","text":" "},{"type":"text","text":"paragraph is a soft break that folds to a space, and only a "},{"type":"strong","inlineContent":[{"type":"text","text":"blank line"}]},{"type":"text","text":" "},{"type":"text","text":"starts a new paragraph. Game prose is authored as multi-line "},{"type":"codeVoice","code":"\"\"\""},{"type":"text","text":" literals"},{"type":"text","text":" "},{"type":"text","text":"wrapped for source readability, so honoring those incidental newlines as"},{"type":"text","text":" "},{"type":"text","text":"hard breaks would shatter the layout whenever the window is narrower than"},{"type":"text","text":" "},{"type":"text","text":"the width the author happened to wrap at (dangling “This”, “and”, …)."},{"type":"text","text":" "},{"type":"text","text":"Folding them makes the layout depend on the channel and never on the column"},{"type":"text","text":" "},{"type":"text","text":"the author happened to type at."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Both"}]},{"type":"text","text":" channels apply that rule, which is the whole point of this type."},{"type":"text","text":" "},{"type":"text","text":"They used to disagree: the reflowing one folded and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/plain(_:)"},{"type":"text","text":" did not,"},{"type":"text","text":" "},{"type":"text","text":"so a literal printed at the source’s wrap column on the one channel that"},{"type":"text","text":" "},{"type":"text","text":"transcripts, CI and every play-test artifact are read in — and at "},{"type":"emphasis","inlineContent":[{"type":"text","text":"two"}]},{"type":"text","text":" "},{"type":"text","text":"columns the moment a clause was concatenated onto it. That is what made a"},{"type":"text","text":" "},{"type":"text","text":"trailing "},{"type":"codeVoice","code":"\\"},{"type":"text","text":" on every prose line look like a convention. It never was one;"},{"type":"text","text":" "},{"type":"text","text":"it was a workaround for this, and there is nothing left for it to work"},{"type":"text","text":" "},{"type":"text","text":"around."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Three ways to say something other than “this is running prose”:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"inlineContent":[{"type":"text","text":"blank line"}],"type":"strong"},{"text":" starts a new paragraph.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/lineBreak","isActive":true,"type":"reference"},{"text":" marker ","type":"text"},{"code":"<br>","type":"codeVoice"},{"text":" is a hard break ","type":"text"},{"inlineContent":[{"type":"text","text":"within"}],"type":"emphasis"},{"text":" a paragraph, for","type":"text"},{"text":" ","type":"text"},{"text":"a banner’s title over its tagline. Non-whitespace, so unlike a trailing","type":"text"},{"text":" ","type":"text"},{"text":"double space it survives editors and formatters that trim line endings.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Indentation"}],"type":"strong"},{"text":" makes a ","type":"text"},{"inlineContent":[{"type":"text","text":"form"}],"type":"strong"},{"text":": an inscription, a map legend, a ring of","type":"text"},{"text":" ","type":"text"},{"text":"letters cut round a shaft, a scrap of verse. Both channels read it as","type":"text"},{"text":" ","type":"text"},{"text":"Markdown reads it — a literal block, never folded and never","type":"text"},{"text":" ","type":"text"},{"text":"re-packed. That is a description of what this package’s authors already","type":"text"},{"text":" ","type":"text"},{"text":"did, not a rule imposed on them: every such block in every game target is","type":"text"},{"text":" ","type":"text"},{"text":"indented, and nothing else in a game target is.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"One internal "},{"type":"codeVoice","code":"fold"},{"type":"text","text":" is the single implementation of all of that, and both"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/plain(_:)"},{"type":"text","text":" and the reflowing renderer are built on it, so the two channels"},{"type":"text","text":" "},{"type":"text","text":"cannot drift apart again about what a paragraph is."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Only "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/plain(_:)"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/lineBreak"},{"type":"text","text":" are public: a front end that prints text"},{"type":"text","text":" "},{"type":"text","text":"needs to render the marker and the fold, and the terminal-column machinery"},{"type":"text","text":" "},{"type":"text","text":"behind the full-screen handler is the engine’s own."}]}],"kind":"content"}],"sections":[],"identifier":{"url":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto"]]},"references":{"doc://Gnusto/documentation/Gnusto":{"title":"Gnusto","url":"\/documentation\/gnusto","abstract":[{"text":"An engine for writing interactive fiction in Swift.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto","role":"collection","type":"topic"},"doc://Gnusto/documentation/Gnusto/TextWrap/plain(_:)":{"abstract":[{"text":"Renders game text for a plain, non-reflowing channel: folds the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"paragraph’s soft breaks, then turns the hard-break marker into a real"},{"type":"text","text":" "},{"type":"text","text":"newline."}],"url":"\/documentation\/gnusto\/textwrap\/plain(_:)","title":"plain(_:)","fragments":[{"text":"static","kind":"keyword"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"plain"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"}],"kind":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/plain(_:)","role":"symbol","type":"topic"},"doc://Gnusto/documentation/Gnusto/TextWrap/lineBreak":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lineBreak","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"}],"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/lineBreak","title":"lineBreak","url":"\/documentation\/gnusto\/textwrap\/linebreak","abstract":[{"type":"text","text":"The in-band hard line-break marker (as in Markdown\/HTML): a break within"},{"type":"text","text":" "},{"type":"text","text":"a paragraph, no blank line, formatter-proof. The full-screen renderer"},{"type":"text","text":" "},{"type":"text","text":"honors it through the fold; plain output turns it into a newline via"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap\/plain(_:)"},{"type":"text","text":" so it never shows literally."}],"role":"symbol","kind":"symbol"},"doc://Gnusto/documentation/Gnusto/TextWrap":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TextWrap","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextWrap","title":"TextWrap","url":"\/documentation\/gnusto\/textwrap","navigatorTitle":[{"text":"TextWrap","kind":"identifier"}],"abstract":[{"type":"text","text":"Renders game prose for a channel: reflowed to a column width for the"},{"type":"text","text":" "},{"type":"text","text":"full-screen terminal, folded for every plain one. Pure and side-effect-free"},{"type":"text","text":" "},{"type":"text","text":"so it can be unit-tested without a live terminal."}],"role":"symbol","kind":"symbol"}}}