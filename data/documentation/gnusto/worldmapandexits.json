{"variants":[{"paths":["\/documentation\/gnusto\/worldmapandexits"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"topicSections":[{"identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/Location\/exit(_:to:)","doc:\/\/Gnusto\/documentation\/Gnusto\/Location\/exit(_:blocked:)","doc:\/\/Gnusto\/documentation\/Gnusto\/Location\/exit(_:to:via:)","doc:\/\/Gnusto\/documentation\/Gnusto\/Location\/exit(_:to:when:otherwise:)","doc:\/\/Gnusto\/documentation\/Gnusto\/Location\/exit(_:toward:)","doc:\/\/Gnusto\/documentation\/Gnusto\/Direction"],"title":"Declaring exits","anchor":"Declaring-exits"},{"title":"Placing the player, the cast, and the props","identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/Player\/starts(in:)","doc:\/\/Gnusto\/documentation\/Gnusto\/Actor\/starts(in:)","doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/starts(in:)","doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/starts(on:)","doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/starts(inside:)","doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/startsHeld","doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/startsWorn","doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/starts(heldBy:)"],"anchor":"Placing-the-player-the-cast-and-the-props"},{"title":"The map itself","identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/WorldMap","doc:\/\/Gnusto\/documentation\/Gnusto\/MapEntry","doc:\/\/Gnusto\/documentation\/Gnusto\/AnatomyOfAGame","doc:\/\/Gnusto\/documentation\/Gnusto\/ContainersDoorsAndLocks","doc:\/\/Gnusto\/documentation\/Gnusto\/SplittingAGameAcrossFiles","doc:\/\/Gnusto\/documentation\/Gnusto\/ActorsAndVehicles"],"anchor":"The-map-itself"}],"identifier":{"url":"doc:\/\/Gnusto\/documentation\/Gnusto\/WorldMapAndExits","interfaceLanguage":"swift"},"seeAlsoSections":[{"title":"The World Map","identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/WorldMap","doc:\/\/Gnusto\/documentation\/Gnusto\/MapEntry","doc:\/\/Gnusto\/documentation\/Gnusto\/Direction","doc:\/\/Gnusto\/documentation\/Gnusto\/Location\/exit(_:to:)","doc:\/\/Gnusto\/documentation\/Gnusto\/Location\/exit(_:to:via:)","doc:\/\/Gnusto\/documentation\/Gnusto\/Location\/exit(_:to:when:otherwise:)","doc:\/\/Gnusto\/documentation\/Gnusto\/Location\/exit(_:toward:)"],"generated":true,"anchor":"The-World-Map"}],"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"code":"foyer.south(bar)","type":"codeVoice"},{"type":"text","text":" puts an exit on the foyer. It puts nothing on the bar. Walking"},{"type":"text","text":" "},{"type":"text","text":"south out of the foyer and walking north out of the bar are two facts about two"},{"type":"text","text":" "},{"type":"text","text":"rooms, and the "},{"code":"map","type":"codeVoice"},{"type":"text","text":" block states each one:"}]},{"type":"codeListing","code":["var map: WorldMap {","    foyer.south(bar)","    bar.north(foyer)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Inferring the reverse would be right most of the time and quietly wrong for a","type":"text"},{"text":" ","type":"text"},{"text":"chute, a trap door that latches behind you, or a crawl that comes out somewhere","type":"text"},{"text":" ","type":"text"},{"text":"other than where it went in. One line per direction means an asymmetric map needs","type":"text"},{"text":" ","type":"text"},{"text":"no special case, and a one-way passage is written the same way as a two-way one:","type":"text"},{"text":" ","type":"text"},{"text":"by leaving the second line out.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"map"},{"text":" is a result-builder property yielding a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/WorldMap"},{"text":" — a flat list of","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/MapEntry"},{"type":"text","text":" statements covering exits, initial placements, the player’s start,"},{"type":"text","text":" "},{"type":"text","text":"and lock\/key pairs. Every reference in it is ordinary property access, so"},{"type":"text","text":" "},{"type":"text","text":"renaming a room breaks its exits at compile time. Because it is a builder, a"},{"type":"text","text":" "},{"type":"text","text":"large map splits into per-region helper properties across files; see"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/SplittingAGameAcrossFiles","isActive":true},{"type":"text","text":"."}]},{"text":"Directions","type":"heading","anchor":"Directions","level":2},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Direction","isActive":true},{"text":" has twelve cases: the eight compass points, ","type":"text"},{"code":"up","type":"codeVoice"},{"text":", ","type":"text"},{"code":"down","type":"codeVoice"},{"text":", ","type":"text"},{"code":"in","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"code":"out","type":"codeVoice"},{"text":". The parser accepts each by name and by its abbreviation — ","type":"text"},{"code":"n","type":"codeVoice"},{"text":", ","type":"text"},{"code":"sw","type":"codeVoice"},{"text":", ","type":"text"},{"code":"u","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"d","type":"codeVoice"},{"text":" — plus ","type":"text"},{"code":"inside","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"outside","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"in"},{"type":"text","text":" and "},{"type":"codeVoice","code":"out"},{"type":"text","text":" are directions like any other, and unrelated to "},{"type":"codeVoice","code":"enter <thing>"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which is a verb that takes a noun. See "},{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/ContainersDoorsAndLocks","isActive":true},{"type":"text","text":"."}]},{"type":"heading","level":2,"anchor":"The-five-kinds-of-exit","text":"The five kinds of exit"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each kind is one general form on "},{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Location","isActive":true},{"type":"text","text":" taking a "},{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Direction","isActive":true},{"type":"text","text":", plus twelve"},{"type":"text","text":" "},{"type":"text","text":"one-line spellings that name the direction instead. Maps are written in the"},{"type":"text","text":" "},{"type":"text","text":"spellings; the general form is for a direction held in a variable."}]},{"type":"heading","level":3,"anchor":"Plain","text":"Plain"},{"type":"paragraph","inlineContent":[{"text":"A way through, with nothing gating it.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["jetty.north(base)","base.south(jetty)","base.up(tower.lampRoom)"]},{"type":"paragraph","inlineContent":[{"text":"The general form is ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Location\/exit(_:to:)","type":"reference","isActive":true},{"text":". The third line above is","type":"text"},{"text":" ","type":"text"},{"code":"Sources\/Lighthouse\/","type":"codeVoice"},{"text":", whose stairs lead into a room declared by a separate","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameContent","type":"reference","isActive":true},{"text":" bundle — an exit crosses that boundary like any other.","type":"text"}]},{"type":"heading","text":"Blocked","level":3,"anchor":"Blocked"},{"inlineContent":[{"type":"text","text":"A direction the player can try and never take. It exists so the refusal is the"},{"type":"text","text":" "},{"type":"text","text":"game’s own rather than the stock "},{"inlineContent":[{"type":"text","text":"“You can’t go that way.”"}],"type":"emphasis"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["foyer.north(","    blocked: \"\"\"","        You've only just arrived, and besides, the weather outside","        seems to be getting worse.","        \"\"\")"]},{"inlineContent":[{"type":"text","text":"The general form is "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Location\/exit(_:blocked:)"},{"type":"text","text":". A blocked exit names no"},{"type":"text","text":" "},{"type":"text","text":"destination, which has one consequence noted below."}],"type":"paragraph"},{"type":"heading","text":"Through a door","level":3,"anchor":"Through-a-door"},{"inlineContent":[{"text":"One ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/openable"},{"text":" item, named on the exit from both sides:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["storeroomDoor.lockedBy(brassKey)","base.east(storeroom, via: storeroomDoor)","storeroom.west(base, via: storeroomDoor)"]},{"inlineContent":[{"text":"The two entries share a single item with a single open state, so opening the door","type":"text"},{"text":" ","type":"text"},{"text":"in the base opens it in the storeroom. While it is shut, ","type":"text"},{"code":"go east","type":"codeVoice"},{"text":" refuses by","type":"text"},{"text":" ","type":"text"},{"text":"naming it. While it is ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/hidden","type":"reference","isActive":true},{"text":" and unrevealed the exit answers ","type":"text"},{"inlineContent":[{"text":"“You can’t go","type":"text"},{"text":" ","type":"text"},{"text":"that way”","type":"text"}],"type":"emphasis"},{"text":", because a door the player has not found is not a door they can be","type":"text"},{"text":" ","type":"text"},{"text":"told is closed.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The general form is ","type":"text"},{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Location\/exit(_:to:via:)","isActive":true},{"text":". Bootstrap sets ","type":"text"},{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/isDoor","isActive":true},{"text":" ","type":"text"},{"text":"from the exit, so a door that hangs on one declares nothing; a ","type":"text"},{"type":"codeVoice","code":"via:"},{"text":" item that","type":"text"},{"text":" ","type":"text"},{"text":"is not ","type":"text"},{"type":"codeVoice","code":"openable"},{"text":" is a fatal diagnostic, since ","type":"text"},{"type":"codeVoice","code":"go"},{"text":" would have no open state to","type":"text"},{"text":" ","type":"text"},{"text":"gate on. Locks, keys, and what ","type":"text"},{"type":"codeVoice","code":"enter <door>"},{"text":" does are","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/ContainersDoorsAndLocks","isActive":true},{"text":"’s subject.","type":"text"}],"type":"paragraph"},{"anchor":"Conditional","text":"Conditional","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"A gate evaluated at "},{"type":"codeVoice","code":"go"},{"text":" time, carrying the refusal to print while it is shut:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["domeRoom.down(torchRoom, when: { ropeTiedToRailing }, otherwise: Prose.domeNoRope)"],"type":"codeListing"},{"inlineContent":[{"text":"The closure runs inside the live turn frame, so it reads globals, item state and","type":"text"},{"text":" ","type":"text"},{"text":"the clock as of the turn the player tried the exit. Reach for it where the thing","type":"text"},{"text":" ","type":"text"},{"text":"gating the passage is not an item you can hang a door on — a rope tied off","type":"text"},{"text":" ","type":"text"},{"text":"upstairs, an undefeated troll, a mule with an opinion:","type":"text"}],"type":"paragraph"},{"code":["forks.exit(","    .north,","    to: oldWorks,","    when: { !biscuit.isIn(forks) },","    otherwise: \"\"\"","        Biscuit puts himself across the mouth of the old works like a bolted gate. …","        \"\"\")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The general form is ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Location\/exit(_:to:when:otherwise:)"},{"text":". A conditional exit","type":"text"},{"text":" ","type":"text"},{"text":"decides ","type":"text"},{"inlineContent":[{"text":"whether","type":"text"}],"type":"emphasis"},{"text":" the player moves, never ","type":"text"},{"inlineContent":[{"type":"text","text":"where"}],"type":"emphasis"},{"text":" they arrive.","type":"text"}]},{"text":"Toward a destination chosen at `go` time","type":"heading","level":3,"anchor":"Toward-a-destination-chosen-at-go-time"},{"type":"paragraph","inlineContent":[{"text":"Here the destination is the closure, and the exit is always passable:","type":"text"}]},{"syntax":"swift","code":["mirrors.slideRoom.exit(","    .down,","    toward: { palantirWing.chuteRopeRigged ? palantirWing.slideOne : house.cellar })"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"That is Dungeon’s chute: it always takes you, and what the rope decides is where"},{"type":"text","text":" "},{"type":"text","text":"you land. Nothing downstream checks that the room the closure names has anything"},{"text":" ","type":"text"},{"text":"to do with the direction, which is what makes a non-Euclidean passage possible at","type":"text"},{"text":" ","type":"text"},{"text":"all. Dungeon’s Round Room is eight headings over one turning floor:","type":"text"}]},{"code":["let exits = carouselExits","for (heading, destination) in exits {","    crossroads.roundRoom.exit(","        heading,","        toward: {","            crossroads.carouselSpinning","                ? exits[crossroads.carouselTwist % exits.count].1 : destination","        })","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Travel runs the same path as every other passable exit, so the destination’s","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Location\/onEnter(perform:)","isActive":true},{"type":"text","text":" rules fire and a boarded vehicle rides along. That"},{"type":"text","text":" "},{"type":"text","text":"is the difference between this and assigning "},{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Player\/location","isActive":true},{"type":"text","text":" from a rule,"},{"type":"text","text":" "},{"type":"text","text":"where neither happens — and it is why the Round Room’s carousel can still pay out"},{"type":"text","text":" "},{"type":"text","text":"an "},{"type":"codeVoice","code":"onEnter"},{"type":"text","text":" award."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The general form is "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Location\/exit(_:toward:)"},{"type":"text","text":". Three things come with the"},{"type":"text","text":" "},{"type":"text","text":"closure:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"It is a read.","type":"text"}]},{"type":"text","text":" It may run more than once in a turn — "},{"type":"codeVoice","code":"FOLLOW"},{"type":"text","text":" asks it which"},{"type":"text","text":" "},{"type":"text","text":"way the quarry went before travel takes it — so it must answer from state"},{"type":"text","text":" "},{"type":"text","text":"rather than change any. A die rolled here is rolled twice."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"It is not validated at bootstrap."}],"type":"strong"},{"text":" The other four kinds name a room the","type":"text"},{"text":" ","type":"text"},{"text":"bootstrap resolves at launch; this one is opaque until it runs, so a","type":"text"},{"text":" ","type":"text"},{"text":"destination that isn’t a stored property of the game surfaces on the turn the","type":"text"},{"text":" ","type":"text"},{"text":"player takes the exit.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"It contributes no destination to the reachable-room set"}],"type":"strong"},{"text":", described below.","type":"text"}]}]}]},{"type":"heading","text":"Computing the direction","anchor":"Computing-the-direction","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The general forms take a "},{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Direction","isActive":true},{"text":" value, which is what a loop needs. Dungeon’s","type":"text"},{"text":" ","type":"text"},{"text":"Low Room has nine ways out leading to two rooms:","type":"text"}]},{"syntax":"swift","code":["for direction in Self.lowRoomToMachineRoom {","    lowRoom.exit(direction, to: machineRoom)","}","for direction in Self.lowRoomToTeaRoom {","    lowRoom.exit(direction, to: teaRoom)","}"],"type":"codeListing"},{"text":"Where everything starts","level":2,"type":"heading","anchor":"Where-everything-starts"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The same block places the cast and the props. Every form returns a "},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/MapEntry","type":"reference","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"so they interleave with exits freely."}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Form"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Places"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Notes","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Player\/starts(in:)","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"the player, in a room"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Required. Declaring it twice, or not at all, is a fatal diagnostic."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Actor\/starts(in:)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"an actor, in a room","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The only placement an actor accepts."}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/starts(in:)","type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"an item, on a room’s floor"}]}],[{"type":"paragraph","inlineContent":[]}]],[[{"inlineContent":[{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/starts(on:)","type":"reference","isActive":true}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"an item, on another item","type":"text"}]}],[{"inlineContent":[{"type":"text","text":"The holder must declare "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/surface"},{"text":".","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/starts(inside:)","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"an item, in another item"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The holder must declare "},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/container","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/startsHeld","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"text":"an item, in the player’s hands","type":"text"}],"type":"paragraph"}],[{"inlineContent":[],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/startsWorn","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"an item, worn by the player"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Worn and carried both; ","type":"text"},{"code":"remove","type":"codeVoice"},{"text":" leaves it in hand.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/starts(heldBy:)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"an item, in an actor’s inventory"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Takes an "},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Actor","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"}]]]},{"code":["player.starts(in: jetty)","keeper.starts(in: base)","shelf.starts(in: base)","brassKey.starts(on: shelf)","chest.starts(in: storeroom)","oilLamp.starts(inside: chest)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An item named by no placement starts offstage, which is legal and is how a thing"},{"type":"text","text":" "},{"type":"text","text":"that appears mid-game waits its turn. Bring it on with "},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/move(to:)","isActive":true,"type":"reference"},{"type":"text","text":" or one"},{"type":"text","text":" "},{"type":"text","text":"of its siblings, and send it back with "},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/vanish()","isActive":true,"type":"reference"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two placements that close a loop — a box inside a bag inside the box — are fatal."},{"type":"text","text":" "},{"type":"text","text":"Each entry resolves on its own, since each holder passes the surface or container"},{"type":"text","text":" "},{"type":"text","text":"check, and nothing in the pair asks where the "},{"inlineContent":[{"type":"text","text":"holder"}],"type":"emphasis"},{"type":"text","text":" sits; the game would boot"},{"type":"text","text":" "},{"type":"text","text":"with both items in no room at all, listed nowhere and reachable by nobody. The"},{"type":"text","text":" "},{"type":"text","text":"bootstrap walks each placement chain and reports the loop by name."}]},{"text":"What the bootstrap makes of it","level":2,"anchor":"What-the-bootstrap-makes-of-it","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The five exit kinds become five entries in one per-room, per-direction table, and"},{"type":"text","text":" "},{"type":"text","text":"three facts about that table are worth an author’s attention."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Each direction of each room can be claimed once."}],"type":"strong"},{"text":" Every kind files its entry","type":"text"},{"text":" ","type":"text"},{"text":"through the same check, so a second claim on the same direction is one","type":"text"},{"text":" ","type":"text"},{"text":"diagnostic — ","type":"text"},{"inlineContent":[{"code":"\"cellar\" declares its north exit more than once.","type":"codeVoice"}],"type":"emphasis"},{"text":" — whichever","type":"text"},{"text":" ","type":"text"},{"text":"kinds collided.","type":"text"}]},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Four kinds name their destination at launch; the dynamic one does not.","type":"text"}]},{"text":" ","type":"text"},{"text":"References are compile-checked, so what bootstrap catches is a room that is not a","type":"text"},{"text":" ","type":"text"},{"text":"stored property of the game or any of its bundles, which is the mistake a","type":"text"},{"text":" ","type":"text"},{"text":"cross-bundle map makes.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"The reachable-room set is built from the destinations that were named."}]},{"type":"text","text":" Blocked"},{"type":"text","text":" "},{"type":"text","text":"and dynamic exits contribute none. That set is what tells the engine which rooms"},{"type":"text","text":" "},{"type":"text","text":"the map admits to, and a room reachable only through a dynamic exit reads as"},{"type":"text","text":" "},{"type":"text","text":"off-map: an actor standing there will not be named by "},{"type":"codeVoice","code":"FOLLOW"},{"type":"text","text":" or by the “you see"},{"type":"text","text":" "},{"type":"text","text":"somebody elsewhere” walk. For the room a game is deliberately hiding that is the"},{"type":"text","text":" "},{"text":"behavior you want. When it isn’t, give the room an ordinary exit as well.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"The-cost-of-a-sixth-kind","text":"The cost of a sixth kind"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The five families repeat once per direction, in "},{"type":"codeVoice","code":"LocationExits.swift"},{"type":"text","text":", as"},{"type":"text","text":" "},{"type":"text","text":"one-liners that delegate to the general form. Keeping them one-liners is what"},{"type":"text","text":" "},{"type":"text","text":"makes the compass vocabulary read uniformly. The price is stated in that file’s"},{"type":"text","text":" "},{"type":"text","text":"own header: a new exit kind costs one general form on "},{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Location","isActive":true},{"type":"text","text":" plus twelve"},{"type":"text","text":" "},{"type":"text","text":"more one-liners."}]}],"kind":"content"}],"kind":"article","sections":[],"metadata":{"role":"collectionGroup","modules":[{"name":"Gnusto"}],"roleHeading":"API Collection","title":"The World Map and Its Exits"},"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto"]]},"abstract":[{"type":"text","text":"How rooms connect, and where everything starts."}],"references":{"doc://Gnusto/documentation/Gnusto/Item/starts(on:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"starts"},{"kind":"text","text":"("},{"kind":"externalParam","text":"on"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Item","preciseIdentifier":"s:6Gnusto4ItemV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"MapEntry","preciseIdentifier":"s:6Gnusto8MapEntryV"}],"url":"\/documentation\/gnusto\/item\/starts(on:)","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/starts(on:)","type":"topic","title":"starts(on:)","abstract":[{"text":"The item starts the game on a surface.","type":"text"}],"kind":"symbol","role":"symbol"},"doc://Gnusto/documentation/Gnusto/Location":{"type":"topic","title":"Location","abstract":[{"text":"A place in the world.","type":"text"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Location","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Location"}],"url":"\/documentation\/gnusto\/location","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Location"}]},"doc://Gnusto/documentation/Gnusto/Item/startsWorn":{"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"startsWorn"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto8MapEntryV","text":"MapEntry"}],"type":"topic","abstract":[{"type":"text","text":"The