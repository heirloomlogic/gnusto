:"text","text":" "},{"kind":"identifier","text":"pronoun"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Pronoun","preciseIdentifier":"s:6Gnusto7PronounO"},{"kind":"text","text":") -> "},{"text":"ItemTrait","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto9ItemTraitV"}],"abstract":[{"text":"The gendered pronoun this person answers to: ","type":"text"},{"code":"pronoun(.she)","type":"codeVoice"},{"text":" makes ","type":"text"},{"code":"her","type":"codeVoice"},{"text":" ","type":"text"},{"text":"another way to name her, for every verb, without spending a synonym on the","type":"text"},{"text":" ","type":"text"},{"text":"word.","type":"text"}],"url":"\/documentation\/gnusto\/pronoun(_:)"},"doc://Gnusto/documentation/Gnusto/ScoreDeclaring/declaredMaxScore(items:)":{"url":"\/documentation\/gnusto\/scoredeclaring\/declaredmaxscore(items:)","kind":"symbol","title":"declaredMaxScore(items:)","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/ScoreDeclaring\/declaredMaxScore(items:)","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"declaredMaxScore"},{"kind":"text","text":"("},{"kind":"externalParam","text":"items"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"Item","preciseIdentifier":"s:6Gnusto4ItemV"},{"text":"]) -> ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"?","kind":"text"}],"abstract":[{"text":"The points this content can pay over a complete playthrough, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" ","type":"text"},{"text":"when it declares nothing and the check should be skipped.","type":"text"}],"role":"symbol","required":true},"doc://Gnusto/documentation/Gnusto/properName":{"url":"\/documentation\/gnusto\/propername","title":"properName","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/properName","kind":"symbol","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"properName","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ItemTrait","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto9ItemTraitV"}],"abstract":[{"text":"The name is a proper name, so the engine’s stock lines never put an article","type":"text"},{"text":" ","type":"text"},{"text":"in front of it: “Mrs. Vane is right here.” rather than “The Mrs. Vane is","type":"text"},{"text":" ","type":"text"},{"text":"right here.”, and “Mrs. Vane is here.” rather than “A Mrs. Vane is here.”","type":"text"}],"role":"symbol"},"doc://Gnusto/documentation/Gnusto/article(_:)":{"url":"\/documentation\/gnusto\/article(_:)","kind":"symbol","title":"article(_:)","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/article(_:)","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"article"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"ItemTrait","preciseIdentifier":"s:6Gnusto9ItemTraitV"}],"abstract":[{"text":"The indefinite article this name takes, for the names English spells one way","type":"text"},{"text":" ","type":"text"},{"text":"and says another: ","type":"text"},{"code":"article(\"an\")","type":"codeVoice"},{"text":" on an hour glass, ","type":"text"},{"code":"article(\"a\")","type":"codeVoice"},{"text":" on a","type":"text"},{"text":" ","type":"text"},{"text":"unicorn.","type":"text"}],"role":"symbol"},"doc://Gnusto/documentation/Gnusto/plural":{"abstract":[{"type":"text","text":"The name is grammatically plural, so the engine’s stock lines agree with it:"},{"text":" ","type":"text"},{"type":"text","text":"“The rails don’t budge.” rather than “The rails doesn’t budge.”, and “some"},{"text":" ","type":"text"},{"text":"rails” rather than “a rails”.","type":"text"}],"title":"plural","kind":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/plural","type":"topic",