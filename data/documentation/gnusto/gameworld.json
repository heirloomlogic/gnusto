bs","abstract":[{"type":"text","text":"Teach the parser words the built-in table doesn’t know."}]},"doc://Gnusto/documentation/Gnusto/TerminalIOHandler":{"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"TerminalIOHandler","kind":"identifier"}],"navigatorTitle":[{"text":"TerminalIOHandler","kind":"identifier"}],"url":"\/documentation\/gnusto\/terminaliohandler","kind":"symbol","title":"TerminalIOHandler","abstract":[{"type":"text","text":"A full-screen, Infocom-style terminal front end: a fixed status bar (room,"},{"type":"text","text":" "},{"type":"text","text":"score, turns) above a story window that re-wraps its entire transcript to"},{"type":"text","text":" "},{"type":"text","text":"the window width — so resizing the terminal reflows the text — with its own"},{"type":"text","text":" "},{"type":"text","text":"line editor (arrow keys, history) and PageUp\/PageDown scrollback."}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TerminalIOHandler"},"doc://Gnusto/documentation/Gnusto/GameWorld/Actor-Implementations":{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameWorld\/Actor-Implementations","title":"Actor Implementations","type":"topic","role":"collectionGroup","abstract":[],"url":"\/documentation\/gnusto\/gameworld\/actor-implementations","kind":"article"},"doc://Gnusto/documentation/Gnusto/GameWorld/perform(_:)":{"abstract":[{"text":"Parses and performs one line of player input. Parse errors are free:","type":"text"},{"text":" ","type":"text"},{"text":"no rules run and the turn counter doesn’t advance. Question-type","type":"text"},{"text":" ","type":"text"},{"text":"errors (“Which do you mean…?”) stay open: the next line is first","type":"text"},{"text":" ","type":"text"},{"text":"tried as their answer, and falls back to being a fresh command.","type":"text"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameWorld\/perform(_:)","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"perform","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"TurnResult","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto10TurnResultV"}],"kind":"symbol","title":"perform(_:)","url":"\/documentation\/gnusto\/gameworld\/perform(_:)"},"doc://Gnusto/documentation/Gnusto/GameWorld/init(game:saveDirectory:)":{"title":"init(game:saveDirectory:)","role":"symbol","url":"\/documentation\/gnusto\/gameworld\/init(game:savedirectory:)","fragments":[{"text":"convenience","kind":"keyword"},{"text":" ","kind":"text"},{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"game","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Game","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto4GameP"},{"text":", ","kind":"text"},{"text":"saveDirectory","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"URL","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation3URLV"},{"text":"?) ","kind":"text"},{"text":"throws","kind":"keyword"}],"abstract":[{"text":"Builds the world from a game definition, validating it up front.","type":"text"},{"text":" ","type":"text"},{"text":"The random stream is seeded fresh each run; use ","type":"text"},{"code":"init(game:seed:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"to replay a specific one.","type":"text"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameWorld\/init(game:saveDirectory:)","type":"topic","kind":"symbol"},"doc://Gnusto/documentation/Gnusto/TheTurnPipeline":{"role":"article","title":"The Turn Pipeline","url":"\/documentation\/gnusto\/theturnpipeline","abstract":[{"text":"What happens between the player pressing Return and the next prompt.","type":"text"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TheTurnPipeline","type":"topic","kind":"a