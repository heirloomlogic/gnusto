{"type":"text","text":", so it saves and restores like any other"},{"type":"text","text":" "},{"type":"text","text":"state and a restore re-binds it to the declared body by name."}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TimedEvent"},"doc://Gnusto/documentation/Gnusto/TraitKey/weight":{"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"weight"},{"kind":"text","text":": "},{"preciseIdentifier":"s:6Gnusto8TraitKeyV","kind":"typeIdentifier","text":"TraitKey"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":">"}],"url":"\/documentation\/gnusto\/traitkey\/weight","kind":"symbol","title":"weight","abstract":[{"type":"text","text":"How much an item counts against "},{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Burden","isActive":true},{"type":"text","text":"’s carrying cap. Defaulted to"},{"type":"text","text":" "},{"type":"text","text":"5, so an item with no declared weight still has some; a game sets the"},{"type":"text","text":" "},{"type":"text","text":"heavy ones — "},{"code":"trait(.weight, 20)","type":"codeVoice"},{"type":"text","text":" — and leaves the rest."}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TraitKey\/weight"},"doc://Gnusto/documentation/Gnusto/Burden/carryCap":{"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"carryCap"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"}],"url":"\/documentation\/gnusto\/burden\/carrycap","kind":"symbol","title":"carryCap","abstract":[{"type":"text","text":"The most weight the player can hold at once."}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Burden\/carryCap"},"doc://Gnusto/documentation/Gnusto/Burden/timers":{"url":"\/docum