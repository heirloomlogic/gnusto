{"metadata":{"symbolKind":"struct","modules":[{"name":"Gnusto"}],"roleHeading":"Structure","role":"symbol","title":"GameText.Line","navigatorTitle":[{"text":"Line","kind":"identifier"}],"extendedModule":"Gnusto","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Line","kind":"identifier"}],"externalID":"s:6Gnusto8GameTextV4LineV"},"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto","doc:\/\/Gnusto\/documentation\/Gnusto\/GameText"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Line"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Object"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Object"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto11LineSubjectP","text":"LineSubject","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/LineSubject"}],"languages":["swift"]}]},{"mentions":["doc:\/\/Gnusto\/documentation\/Gnusto\/StubVerbs","doc:\/\/Gnusto\/documentation\/Gnusto\/TextAndRandomness"],"kind":"mentions"},{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"type":"codeListing","syntax":"swift","code":["text.stubs.dig = \"You have nothing to dig with.\"","text.stubs.burn = .naming { \"You have no way to set fire to \\($0).\" }"]},{"inlineContent":[{"text":"The type exists so that those two are the ","type":"text"},{"inlineContent":[{"type":"text","text":"same slot"}],"type":"strong"},{"text":". Before it,","type":"text"},{"text":" ","type":"text"},{"text":"every line was declared as one or the other, and which one it got was","type":"text"},{"text":" ","type":"text"},{"text":"the engine’s own prose showing through the API: ","type":"text"},{"code":"dig","type":"codeVoice"},{"text":" was a ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" ","type":"text"},{"text":"because the engine’s dig line happens to name nothing, so no game could","type":"text"},{"text":" ","type":"text"},{"text":"write one that did without an engine change — and that change broke","type":"text"},{"text":" ","type":"text"},{"text":"every game which had already assigned the old shape, whether it wanted","type":"text"},{"text":" ","type":"text"},{"text":"the name or not. Widening a line is now the business of the game that","type":"text"},{"text":" ","type":"text"},{"text":"wants it, and costs the games that don’t nothing.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"Object","type":"codeVoice"},{"text":" says what the line is about. A line whose every parser row","type":"text"},{"text":" ","type":"text"},{"text":"carries a direct object takes a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Noun","type":"reference"},{"text":" and is written with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Line\/naming(_:)","type":"reference"},{"text":". One that also answers a bare command — ","type":"text"},{"code":"smell","type":"codeVoice"},{"text":", ","type":"text"},{"code":"climb","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"wake","type":"codeVoice"},{"text":" — takes ","type":"text"},{"code":"Noun?","type":"codeVoice"},{"text":" and is written with ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Line\/naming(orBare:_:)","type":"reference"},{"text":", which","type":"text"},{"text":" ","type":"text"},{"text":"asks for both halves so neither can be left in the engine’s voice by","type":"text"},{"text":" ","type":"text"},{"text":"accident. A verb with no object slot at all takes ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Nothing","type":"reference"},{"text":": there is","type":"text"},{"text":" ","type":"text"},{"text":"no name to hand it, but there is still a ","type":"text"},{"inlineContent":[{"type":"text","text":"turn"}],"type":"emphasis"},{"text":" to write it in, which is","type":"text"},{"text":" ","type":"text"},{"text":"what ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Line\/live(_:)","type":"reference"},{"text":" is for.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Which subjects exist is ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/LineSubject","type":"reference"},{"text":"; how a line about each may be","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"written"}],"type":"emphasis"},{"text":" is the two protocols refining it — ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/DroppableSubject","type":"reference"},{"text":" for a","type":"text"},{"text":" ","type":"text"},{"text":"fixed sentence, ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/NamedSubject","type":"reference"},{"text":" for a closure. All three are protocols","type":"text"},{"text":" ","type":"text"},{"text":"rather than lists in a doc comment, because a list in a doc comment is a","type":"text"},{"text":" ","type":"text"},{"text":"list somebody has to remember to edit.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The shape is therefore about what the sentence is "},{"inlineContent":[{"text":"given","type":"text"}],"type":"emphasis"},{"type":"text","text":", never about"},{"type":"text","text":" "},{"type":"text","text":"how it is "},{"inlineContent":[{"text":"built","type":"text"}],"type":"emphasis"},{"type":"text","text":". Every one of them takes a string literal, so the"},{"type":"text","text":" "},{"type":"text","text":"fixed spelling of any line is the same three tokens whatever slot it"},{"type":"text","text":" "},{"type":"text","text":"sits in."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The object arrives as a "},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Noun","type":"reference","isActive":true},{"text":" and never as a bare string,","type":"text"},{"text":" ","type":"text"},{"text":"for the reason ","type":"text"},{"code":"Noun","type":"codeVoice"},{"text":" exists: it carries its own number, so “The rails","type":"text"},{"text":" ","type":"text"},{"text":"is not food.” — a game’s honest plural made ungrammatical by a","type":"text"},{"text":" ","type":"text"},{"text":"template’s assumption — cannot be written. Interpolating one prints its","type":"text"},{"text":" ","type":"text"},{"text":"phrase, so a line with no verb to agree reads exactly as it would have","type":"text"},{"text":" ","type":"text"},{"text":"with a ","type":"text"},{"code":"String","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnusto\/gametext\/line"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"relationshipsSections":[{"identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/StockLine","doc:\/\/Gnusto\/s8CopyableP","doc:\/\/Gnusto\/s9EscapableP","doc:\/\/Gnusto\/s43ExpressibleByExtendedGraphemeClusterLiteralP","doc:\/\/Gnusto\/s32ExpressibleByStringInterpolationP","doc:\/\/Gnusto\/s26ExpressibleByStringLiteralP","doc:\/\/Gnusto\/s33ExpressibleByUnicodeScalarLiteralP","doc:\/\/Gnusto\/s8SendableP","doc:\/\/Gnusto\/s16SendableMetatypeP"],"title":"Conforms To","type":"conformsTo","kind":"relationships"}],"kind":"symbol","abstract":[{"text":"One stock line, in whichever shape the game wants it: a fixed sentence,","type":"text"},{"text":" ","type":"text"},{"text":"a sentence assembled when it prints, or one that names the thing it is","type":"text"},{"text":" ","type":"text"},{"text":"abou