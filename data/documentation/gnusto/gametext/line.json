:"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Line"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Object"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Object"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:6Gnusto11LineSubjectP","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/LineSubject","kind":"typeIdentifier","text":"LineSubject"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/Gnusto\/documentation\/Gnusto\/StubVerbs","doc:\/\/Gnusto\/documentation\/Gnusto\/TextAndRandomness"]},{"kind":"content","content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"syntax":"swift","code":["text.stubs.dig = \"You have nothing to dig with.\"","text.stubs.burn = .naming { \"You have no way to set fire to \\($0).\" }"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The type exists so that those two are the "},{"type":"strong","inlineContent":[{"text":"same slot","type":"text"}]},{"type":"text","text":". Before it,"},{"type":"text","text":" "},{"type":"text","text":"every line was declared as one or the other, and which one it got was"},{"type":"text","text":" "},{"type":"text","text":"the engine’s own prose showing through the API: "},{"type":"codeVoice","code":"dig"},{"type":"text","text":" was a "},{"type":"codeVoice","code":"String"},{"type":"text","text":" "},{"type":"text","text":"because the engine’s dig line happens to name nothing, so no game could"},{"type":"text","text":" "},{"type":"text","text":"write one that did without an engine change — and that change broke"},{"type":"text","text":" "},{"type":"text","text":"every game which had already assigned the old shape, whether it wanted"},{"type":"text","text":" "},{"type":"text","text":"the name or not. Widening a line is now the business of the game that"},{"type":"text","text":" "},{"type":"text","text":"wants it, and costs the games that don’t nothing."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"Object"},{"type":"text","text":" says what the line is about. A line whose every parser row"},{"type":"text","text":" "},{"type":"text","text":"carries a direct object takes a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Noun"},{"type":"text","text":" and is written with"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Line\/naming(_:)"},{"type":"text","text":". One that also answers a bare command — "},{"type":"codeVoice","code":"smell"},{"type":"text","text":", "},{"type":"codeVoice","code":"climb"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"wake"},{"type":"text","text":" — takes "},{"type":"codeVoice","code":"Noun?"},{"type":"text","text":" and is written with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Line\/naming(orBare:_:)"},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"asks for both halves so neither can be left in the engine’s voice by"},{"type":"text","text":" "},{"type":"text","text":"accident. A verb with no object slot at all takes "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Nothing"},{"type":"text","text":": there is"},{"type":"text","text":" "},{"type":"text","text":"no name to hand it, but there is still a "},{"type":"emphasis","inlineContent":[{"text":"turn","type":"text"}]},{"type":"text","text":" to write it in, which is"},{"type":"text","text":" "},{"type":"text","text":"what "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Line\/live(_:)"},{"type":"text","text":" is for."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Which subjects exist is "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/LineSubject"},{"type":"text","text":"; how a line about each may be"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"written","type":"text"}]},{"type":"text","text":" is the two protocols refining it — "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/DroppableSubject"},{"type":"text","text":" for a"},{"type":"text","text":" "},{"type":"text","text":"fixed sentence, "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/NamedSubject"},{"type":"text","text":" for a closure. All three are protocols"},{"type":"text","text":" "},{"type":"text","text":"rather than lists in a doc comment, because a list in a doc comment is a"},{"type":"text","text":" "},{"type":"text","text":"list somebody has to remember to edit."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The shape is therefore about what the sentence is "},{"type":"emphasis","inlineContent":[{"text":"given","type":"text"}]},{"type":"text","text":", never about"},{"type":"text","text":" "},{"type":"text","text":"how it is "},{"type":"emphasis","inlineContent":[{"text":"built","type":"text"}]},{"type":"text","text":". Every one of them takes a string literal, so the"},{"type":"text","text":" "},{"type":"text","text":"fixed spelling of any line is the same three tokens whatever slot it"},{"type":"text","text":" "},{"type":"text","text":"sits in."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The object arrives as a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Noun"},{"type":"text","text":" and never as a bare string,"},{"type":"text","text":" "},{"type":"text","text":"for the reason "},{"type":"codeVoice","code":"Noun"},{"type":"text","text":" exists: it carries its own number, so “The rails"},{"type":"text","text":" "},{"type":"text","text":"is not food.” — a game’s honest plural made ungrammatical by a"},{"type":"text","text":" "},{"type":"text","text":"template’s assumption — cannot be written. Interpolating one prints its"},{"type":"text","text":" "},{"type":"text","text":"phrase, so a line with no verb to agree reads exactly as it would have"},{"type":"text","text":" "},{"type":"text","text":"with a "},{"type":"codeVoice","code":"String"},{"type":"text","text":"."}],"type":"paragraph"}]}],"references":{"doc://Gnusto/documentation/Gnusto/GameText/Line/StockLine-Implementations":{"role":"collectionGroup","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Line\/StockLine-Implementations","kind":"article","type":"topic","abstract":[],"title":"StockLine Implementations","url":"\/documentation\/gnusto\/gametext\/line\/stockline-implementations"},"doc://Gnusto/documentation/Gnusto/chance(_:)":{"kind":"symbol","url":"\/documentation\/gnusto\/chance(_:)","abstract":[{"type":"text","text":"True "},{"type":"codeVoice","code":"percent"},{"type":"text","text":" times out of a hundred: "},{"type":"codeVoice","code":"if chance(30) { … }"},{"type":"text","text":"."}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"chance","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"title":"chance(_:)","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/chance(_:)","type":"topic"},"doc://Gnusto/s43ExpressibleByExtendedGraphemeClusterLiteralP":{"identifier":"doc:\/\/Gnusto\/s43ExpressibleByExtendedGraphemeClusterLiteralP","type":"unresolvable","title":"Swift.ExpressibleByExtendedGraphemeClusterLiteral"},"doc://Gnusto/documentation/Gnusto/GameText/Line/callAsFunction(_:_:)-7nill":{"role":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Line\/callA