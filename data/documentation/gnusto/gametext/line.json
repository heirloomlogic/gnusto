ext","text":"every game which had already assigned the old shape, whether it wanted"},{"type":"text","text":" "},{"type":"text","text":"the name or not. Widening a line is now the business of the game that"},{"type":"text","text":" "},{"type":"text","text":"wants it, and costs the games that don’t nothing."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Object"},{"type":"text","text":" says what the line is about. A line whose every parser row"},{"type":"text","text":" "},{"type":"text","text":"carries a direct object takes a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Noun"},{"type":"text","text":" and is written with"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Line\/naming(_:)"},{"type":"text","text":". One that also answers a bare command — "},{"type":"codeVoice","code":"smell"},{"type":"text","text":", "},{"type":"codeVoice","code":"climb"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"wake"},{"type":"text","text":" — takes "},{"type":"codeVoice","code":"Noun?"},{"type":"text","text":" and is written with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Line\/naming(orBare:_:)-9vpdm"},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"asks for both halves so neither can be left in the engine’s voice by"},{"type":"text","text":" "},{"type":"text","text":"accident. A verb with no object slot at all takes "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Nothing"},{"type":"text","text":": there is"},{"type":"text","text":" "},{"type":"text","text":"no name to hand it, but there is still a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"turn"}]},{"type":"text","text":" to write it in, which is"},{"type":"text","text":" "},{"type":"text","text":"what "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Line\/live(_:)"},{"type":"text","text":" is for."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Which subjects exist is "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/LineSubject"},{"type":"text","text":"; how a line about each may be"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"written"}]},{"type":"text","text":" is the two protocols refining it — "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/DroppableSubject"},{"type":"text","text":" for a"},{"type":"text","text":" "},{"type":"text","text":"fixed sentence, "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/NamedSubject"},{"type":"text","text":" for a closure. All three are protocols"},{"type":"text","text":" "},{"type":"text","text":"rather than lists in a doc comment, because a list in a doc comment is a"},{"type":"text","text":" "},{"type":"text","text":"list somebody has to remember to edit."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The shape is therefore about what the sentence is "},{"type":"emphasis","inlineContent":[{"type":"text","text":"given"}]},{"type":"text","text":", never about"},{"type":"text","text":" "},{"type":"text","text":"how it is "},{"type":"emphasis","inlineContent":[{"type":"text","text":"built"}]},{"type":"text","text":". Every one of them takes a string literal, so the"},{"type":"text","text":" "},{"type":"text","text":"fixed spelling of any line is the same three tokens whatever slot it"},{"type":"text","text":" "},{"type":"text","text":"sits in."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The object arrives as a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Noun"},{"type":"text","text":" and never as a bare string,"},{"type":"text","text":" "},{"type":"text","text":"for the reason "},{"type":"codeVoice","code":"Noun"},{"type":"text","text":" exists: it carries its own number, so “The rails"},{"type":"text","text":" "},{"type":"text","text":"is not food.” — a game’s honest plural made ungrammatical by a"},{"type":"text","text":" "},{"type":"text","text":"template’s assumption — cannot be written. Interpolating one prints its"},{"type":"text","text":" "},{"type":"text","text":"phrase, so a line with no verb to agree reads exactly as it would have"},{"type":"text","text":" "},{"type":"text","text":"with a "},{"type":"codeVoice","code":"String"},{"type":"text","text":"."}]}],"kind":"content"}],"references":{"doc://Gnusto/documentation/Gnusto/GameText/Line/callAsFunction(_:)-6akqd":{"conformance":{"constraints":[{"type":"codeVoice","code":"Object"},{"type":"text","text":" is "},{"type":"codeVoice","code":"GameText.Choices"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"kind":"symbol","abstract":[{"type":"text","text":"Renders the line for a set of candidates."}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Line\/callAsFunction(_:)-6akqd","type":"topic","title":"callAsFunction(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"callAsFunction","kind":"identifier"},{"text":"([","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"]) -> ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"role":"symbol","url":"\/documentation\/gnusto\/gametext\/line\/callasfunction(_:)-6akqd"},"doc://Gnusto/documentation/Gnusto/StubVerbs":{"role":"article","type":"topic","kind":"article","url":"\/documentation\/gnusto\/stubverbs","title":"Stub Verbs","abstract":[{"type":"text","text":"The verbs the parser knows as words even wh