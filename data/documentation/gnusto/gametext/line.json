nusto\/GameText\/Line","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Line","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Object","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Object","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:6Gnusto11LineSubjectP","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/LineSubject","text":"LineSubject","kind":"typeIdentifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/Gnusto\/documentation\/Gnusto\/StubVerbs","doc:\/\/Gnusto\/documentation\/Gnusto\/TextAndRandomness"]},{"content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"code":["text.stubs.dig = \"You have nothing to dig with.\"","text.stubs.burn = .naming { \"You have no way to set fire to \\($0.object).\" }"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The type exists so that those two are the ","type":"text"},{"inlineContent":[{"type":"text","text":"same slot"}],"type":"strong"},{"text":". Before it,","type":"text"},{"text":" ","type":"text"},{"text":"every line was declared as one or the other, and which one it got was","type":"text"},{"text":" ","type":"text"},{"text":"the engine’s own prose showing through the API: ","type":"text"},{"code":"dig","type":"codeVoice"},{"type":"text","text":" was a "},{"type":"codeVoice","code":"String"},{"type":"text","text":" "},{"type":"text","text":"because the engine’s dig line happens to name nothing, so no game could"},{"type":"text","text":" "},{"type":"text","text":"write one that did without an engine change — and that change broke"},{"type":"text","text":" "},{"type":"text","text":"every game which had already assigned the old shape, whether it wanted"},{"type":"text","text":" "},{"type":"text","text":"the name or not. Widening a line is now the business of the game that"},{"type":"text","text":" "},{"type":"text","text":"wants it, and costs the games that don’t nothing."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"Object"},{"type":"text","text":" says what the line is about. A line whose every parser row"},{"type":"text","text":" "},{"type":"text","text":"carries a direct object takes a "},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Noun","type":"reference","isActive":true},{"text":" and is written with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Line\/naming(_:)","type":"reference","isActive":true},{"type":"text","text":". One that also answers a bare command — "},{"code":"smell","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"climb"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"wake"},{"type":"text","text":" — takes "},{"type":"codeVoice","code":"Noun?"},{"type":"text","text":" and is written with "},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Line\/naming(orBare:_:)-9vpdm","isActive":true,"type":"reference"},{"text":", which","type":"text"},{"text":" ","type":"text"},{"text":"asks for both halves so neither can be left in the engine’s voice by","type":"text"},{"text":" ","type":"text"},{"text":"accident. A verb with no object slot at all takes ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Nothing","isActive":true,"type":"reference"},{"type":"text","text":": there is"},{"text":" ","type":"text"},{"text":"no name to hand it, but there is still a ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"turn"}]},{"text":" to write it in, which is","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"what "},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Line\/live(_:)","type":"reference","isActive":true},{"type":"text","text":" is for."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Which subjects exist is "},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/LineSubject","type":"reference","isActive":true},{"type":"text","text":"; how a line about each may be"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"written"}],"type":"emphasis"},{"type":"text","text":" is the two protocols refining it — "},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/DroppableSubject","type":"reference","isActive":true},{"type":"text","text":" for a"},{"type":"text","text":" "},{"type":"text","text":"fixed sentence, "},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/NamedSubject","type":"reference","isActive":true},{"type":"text","text":" for a closure. All three are protocols"},{"type":"text","text":" "},{"type":"text","text":"rather than lists in a doc comment, because a list in a doc comment is a"},{"type":"text","text":" "},{"type":"text","text":"list somebody has to remember to edit."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The shape is therefore about what the sentence is "},{"type":"emphasis","inlineContent":[{"text":"given","type":"text"}]},{"type":"text","text":", never about"},{"type":"text","text":" "},{"type":"text","text":"how it is "},{"type":"emphasis","inlineContent":[{"text":"built","type":"text"}]},{"type":"text","text":". Every one of them takes a string literal, so the"},{"type":"text","text":" "},{"type":"text","text":"fixed spelling of any line is the same three tokens whatever slot it"},{"type":"text","text":" "},{"type":"text","text":"sits in."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The object arrives as a "},{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Noun","isActive":true},{"type":"text","text":" and never as a bare string,"},{"type":"text","text":" "},{"type":"text","text":"for the reason "},{"type":"codeVoice","code":"Noun"},{"type":"text","text":" exists: it carries its own number, so “The rails"},{"type":"text","text":" "},{"type":"text","text":"is not food.” — a game’s honest plural made ungrammatical by a"},{"type":"text","text":" "},{"type":"text","text":"template’s assumption — cannot be written. Interpolating one prints its"},{"type":"text","text":" "},{"type":"text","text":"phrase, so a line with no verb to agree reads exactly as it would have"},{"type":"text","text":" "},{"type":"text","text":"with a "},{"type":"codeVoice","code":"String"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnusto\/gametext\/line"]}],"references":{"doc://Gnusto/documentation/Gnusto/GameText/Line/callAsFunction()":{"abstract":[{"type":"text","text":"Renders the line. The engine calls this; a game assigns the line and"},{"type":"text","text":" "},{"type":"text","text":"never calls it."}],"title":"callAsFunction()","kind":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Line\/callAsFunction()","type":"topic","url":"\/documentation\/gnusto\/gametext\/line\/callasfunction()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"callAsFunction"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"}],"role":"symbol","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"Object"},{"type":"text","text":" is "},{"type":"codeVoice","code":"GameText.Nothing"},{"type":"text","text":"."}]}},"doc://Gnusto/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/Gnusto\/s8SendableP","title":"Swift.Sendable"},"doc://Gnusto/documentation/Gnusto":{"abstract":[{"text":"An engine for writing interactive fiction in Swift.","type":"text"}],"title":"Gnusto","ki