", a line that owns a nameless half"},{"type":"text","text":" "},{"type":"text","text":"already has the better answer."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Line\/naming(orBare:_:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto","doc:\/\/Gnusto\/documentation\/Gnusto\/GameText","doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Line"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/gnusto\/gametext\/line\/naming(orbare:_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"A line for a verb the player may use with an object or without one:","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"smell"},{"text":" and ","type":"text"},{"code":"smell the troll","type":"codeVoice"},{"text":" are a single intent, and a single slot has","type":"text"},{"text":" ","type":"text"},{"text":"to answer both.","type":"text"}],"sections":[],"kind":"symbol","metadata":{"symbolKind":"method","conformance":{"constraints":[{"type":"codeVoice","code":"Object"},{"type":"text","text":" is "},{"type":"codeVoice","code":"GameText.Noun?"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"roleHeading":"Type Method","externalID":"s:6Gnusto8GameTextV4LineVAaC4NounVSgRszrlE6naming6orBare_AEy_AHGSS_SSAGYbctFZ","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"naming","kind":"identifier"},{"text":"(","kind":"text"},{"text":"orBare","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", (","kind":"text"},{"preciseIdentifier":"s:6Gnusto8GameTextV","text":"GameText","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s: