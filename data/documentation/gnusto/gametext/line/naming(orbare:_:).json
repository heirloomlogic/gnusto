t","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/StubReplies\/yourself"},{"type":"text","text":", a line that owns a nameless half"},{"type":"text","text":" "},{"type":"text","text":"already has the better answer."}]}]}],"variants":[{"paths":["\/documentation\/gnusto\/gametext\/line\/naming(orbare:_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"A line for a verb the player may use with an object or without one:","type":"text"},{"text":" ","type":"text"},{"code":"smell","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"smell the troll","type":"codeVoice"},{"text":" are a single intent, and a single slot has","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"to answer both."}],"metadata":{"modules":[{"name":"Gnusto"}],"symbolKind":"method","title":"naming(orBare:_:)","externalID":"s:6Gnusto8GameTextV4LineVAaC4NounVSgRszrlE6naming6orBare_AEy_AHGSS_SSAGYbctFZ","conformance":{"constraints":[{"type":"codeVoice","code":"Object"},{"type":"text","text":" is "},{"type":"codeVoice","code":"GameText.Noun?"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"extendedModule":"Gnusto","role":"symbol","roleHeading":"Type Method","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"naming"},{"kind":"text","text":"("},{"kind":"externalParam","text":"orBare"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", ("},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto8GameTextV","text":"GameText"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto8GameTextV4NounV","text":"Noun"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","te