{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/inTheContainer"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"inTheContainer","kind":"identifier"},{"text":": ","kind":"text"},{"text":"GameText","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText","preciseIdentifier":"s:6Gnusto8GameTextV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Line","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Line","preciseIdentifier":"s:6Gnusto8GameTextV4LineV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"GameText","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText","preciseIdentifier":"s:6Gnusto8GameTextV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Holding","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Holding","preciseIdentifier":"s:6Gnusto8GameTextV7HoldingV","kind":"typeIdentifier"},{"text":">","kind":"text"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"It ships the same sentence as ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/itemInContainer","isActive":true,"type":"reference"},{"text":" and is deliberately a","type":"text"},{"text":" ","type":"text"},{"text":"second slot, because the two print at different moments and from","type":"text"},{"text":" ","type":"text"},{"text":"different callers. This one answers a question the player asked, once,","type":"text"},{"text":" ","type":"text"},{"text":"about everything in the container. That one is a paragraph of the room","type":"text"},{"text":" ","type":"text"},{"text":"description, printed per item, unasked, on every look — and any single","type":"text"},{"text":" ","type":"text"},{"text":"one of them can be superseded by that item’s own ","type":"text"},{"type":"codeVoice","code":"firstSight"},{"text":". A game","type":"text"},{"text":" ","type":"text"},{"text":"that wants its room paragraphs terser than its search answers needs the","type":"text"},{"text":" ","type":"text"},{"text":"two apart; merging them would be reuse bought with an authorial choice.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The verb agrees with the ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"contents","type":"text"}]},{"text":", and ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Noun\/list(_:)","isActive":true,"type":"reference"},{"text":" is what knows","type":"text"},{"text":" ","type":"text"},{"text":"their number: plural when there are several ","type":"text"},{"type":"strong","inlineContent":[{"text":"or","type":"text"}]},{"text":" when the only one is","type":"text"},{"text":" ","type":"text"},{"text":"itself plural. That rule used to live in this line’s body, where a game","type":"text"},{"text":" ","type":"text"},{"text":"re-voicing it would have had to re-derive it — and could have got it","type":"text"},{"text":" ","type":"text"},{"text":"wrong the way the engine did, printing “In the hamper is some scales.”","type":"text"}]}]}],"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto","doc:\/\/Gnusto\/documentation\/Gnusto\/GameText"]]},"metadata":{"modules":[{"name":"Gnusto"}],"title":"inTheContainer","externalID":"s:6Gnusto8GameTextV14inTheContainerAC4LineVy_AC7HoldingVGvp","symbolKind":"property","roleHeading":"Instance Property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"inTheContainer","kind":"identifier"},{"text":": ","kind":"text"},{"text":"GameText","preciseIdentifier":"s:6Gnusto8GameTextV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Line","preciseIdentifier":"s:6Gnusto8GameTextV4LineV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":