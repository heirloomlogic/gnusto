"type":"strong","inlineContent":[{"text":"or","type":"text"}]},{"text":" when the only one is","type":"text"},{"text":" ","type":"text"},{"text":"itself plural. That rule used to live in this line’s body, where a game","type":"text"},{"text":" ","type":"text"},{"text":"re-voicing it would have had to re-derive it — and could have got it","type":"text"},{"text":" ","type":"text"},{"text":"wrong the way the engine did, printing “In the hamper is some scales.”","type":"text"}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto","doc:\/\/Gnusto\/documentation\/Gnusto\/GameText"]]},"references":{"doc://Gnusto/documentation/Gnusto/GameText/inTheContainer":{"type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"inTheContainer"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto8GameTextV","text":"GameText"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto8GameTextV4LineV","text":"Line"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto8GameTextV","text":"GameText"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto8GameTextV7HoldingV","text":"Holding"},{"kind":"text","text":">"}],"title":"inTheContainer","kind":"symbol","abstract":[{"type":"text","text":"“In the X is a Y.” \/ “In the X are a Y and a Z.” — the answer to"},{"type":"text","text":" "},{"code":"search","type":"codeVoice"},{"type":"text","text":"."}],"role":"symbol","url":"\/documentation\/gnusto\/gametext\/inthecontainer","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/inTheContainer"},"doc://Gnusto/documentation/Gnusto/GameText/Noun/list(_:)":{"kind":"symbol","url":"\/documentation\/gnusto\/gametext\/noun\/list(_:)","abstract":[{"type":"text","text":"Several nouns as one — “a sword, a lamp, and some scales” — carrying"},{"type":"text","text":" "},{"type":"