nows","type":"text"},{"text":" ","type":"text"},{"text":"their number: plural when there are several ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"or"}]},{"text":" when the only one is","type":"text"},{"text":" ","type":"text"},{"text":"itself plural. That rule used to live in this line’s body, where a game","type":"text"},{"text":" ","type":"text"},{"text":"re-voicing it would have had to re-derive it — and could have got it","type":"text"},{"text":" ","type":"text"},{"text":"wrong the way the engine did, printing “In the hamper is some scales.”","type":"text"}]}],"kind":"content"}],"kind":"symbol","references":{"doc://Gnusto/documentation/Gnusto":{"url":"\/documentation\/gnusto","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto","title":"Gnusto","abstract":[{"text":"A Swift engine for writing parser-driven interactive fiction — text adventures in the tradition of Zork and Infocom’s ZIL.","type":"text"}],"role":"collection","kind":"symbol","type":"topic"},"doc://Gnusto/documentation/Gnusto/GameText/Line":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Line","kind":"identifier"}],"url":"\/documentation\/gnusto\/gametext\/line","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Line","title":"GameText.Line","abstract":[{"type":"text","text":"One stock line, in whichever shape the game wants it: a fixed sentence,"},{"type":"text","text":" "},{"type":"text","text":"a sentence assembled when it prints, or one that names the thing it is"},{"type":"text","text":" "},{"type":"text","text":"about."}],"navigatorTitle":[{"text":"Line","kind":"identifier"}],"role":"symbol","kind":"symbol","type":"topic"},"doc://Gnusto/documentation/Gnusto/GameText":{"fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"GameText"}],"abstract":[{"text":"Every stock player-facing line the engine can say, as one overridable","type":"text"},{"text":" ","type":"text"},{"ty