{"abstract":[{"type":"text","text":"“In the X is a Y.” \/ “In the X are a Y and a Z.” — the answer to"},{"type":"text","text":" "},{"type":"codeVoice","code":"search"},{"text":".","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"text":"inTheContainer","kind":"identifier"},{"kind":"text","text":": "},{"preciseIdentifier":"s:6Gnusto8GameTextV","text":"GameText","kind":"typeIdentifier","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText"},{"kind":"text","text":"."},{"preciseIdentifier":"s:6Gnusto8GameTextV4LineV","text":"Line","kind":"typeIdentifier","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Line"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:6Gnusto8GameTextV","text":"GameText","kind":"typeIdentifier","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText"},{"text":".","kind":"text"},{"preciseIdentifier":"s:6Gnusto8GameTextV7HoldingV","text":"Holding","kind":"typeIdentifier","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Holding"},{"text":">","kind":"text"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"It ships the same sentence as ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/itemInContainer","type":"reference","isActive":true},{"text":" and is deliberately a","type":"text"},{"text":" ","type":"text"},{"text":"second slot, because the two print at different moments and from","type":"text"},{"text":" ","type":"text"},{"text":"different callers. This one answers a question the player asked, once,","type":"text"},{"text":" ","type":"text"},{"text":"about everything in the container. That one is a paragraph of the room","type":"text"},{"text":" ","type":"text"},{"text":"description, printed per item, unasked, on every look — and any single","type":"text"},{"text":" ","type":"text"},{"text":"one of them can be superseded by that item’s own ","type":"text"},{"code":"firstSight","type":"codeVoice"},{"text":". A game","type":"text"},{"text":" ","type":"text"},{"text":"that wants its room paragraphs terser than its search answers needs the","type":"text"},{"text":" ","type":"text"},{"text":"two apart; merging them would be reuse bought with an authorial choice.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The verb agrees with the "},{"type":"emphasis","inlineContent":[{"text":"contents","type":"text"}]},{"type":"text","text":", and "},{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Noun\/list(_:)","isActive":true},{"type":"text","text":" is what knows"},{"type":"text","text":" "},{"type":"text","text":"their number: plural when there are several "},{"type":"strong","inlineContent":[{"text":"or","type":"text"}]},{"type":"text","text":" when the only one is"},{"type":"text","text":" "},{"type":"text","text":"itself plural. That rule used to live in this line’s body, where a game"},{"type":"text","text":" "},{"type":"text","text":"re-voicing it would have had to re-derive it — and could have got it"},{"type":"text","text":" "},{"type":"text","text":"wrong the way the engine did, printing “In the hamper is some scales.”"}]}]}],"identifier":{"url":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/inTheContainer","interfaceLanguage":"swift"},"sections":[],"variants":[{"paths":["\/documentation\/gnusto\/gametext\/inthecontainer"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"externalID":"s:6Gnusto8GameTextV14inTheContainerAC4LineVy_AC7HoldingVGvp","title":"inTheContainer","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"inTheContainer","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6Gnusto8GameTextV","text":"GameText","kind":"typeIdentifier"},{"text":"."