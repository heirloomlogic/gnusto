{"abstract":[{"text":"The name with its indefinite article, for listings (“a velvet cloak”,","type":"text"},{"text":" ","type":"text"},{"text":"“an apple”, “some rails”), or the name alone when it is a proper name","type":"text"},{"text":" ","type":"text"},{"text":"(“Mrs. Vane”).","type":"text"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto","doc:\/\/Gnusto\/documentation\/Gnusto\/GameText"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"indefinite"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"name"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"article"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"proper"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":" = false, "},{"kind":"externalParam","text":"plural"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":" = false) -> "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"}]}]},{"parameters":[{"name":"name","content":[{"inlineContent":[{"type":"text","text":"The bare name to article."}],"type":"paragraph"}]},{"name":"article","content":[{"inlineContent":[{"type":"text","text":"The article the name was declared to take, from the"},{"type":"text","text":" "},{"code":"article(_:)","type":"codeVoice"},{"type":"text","text":" trait, or "},{"code":"nil"