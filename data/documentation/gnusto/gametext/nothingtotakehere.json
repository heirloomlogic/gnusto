ract":[{"text":"The subject of a line that has none.","type":"text"}],"type":"topic","title":"GameText.Nothing","url":"\/documentation\/gnusto\/gametext\/nothing","role":"symbol","navigatorTitle":[{"text":"Nothing","kind":"identifier"}],"kind":"symbol"},"doc://Gnusto/documentation/Gnusto/GameText":{"abstract":[{"type":"text","text":"Every stock player-facing line the engine can say, as one overridable"},{"type":"text","text":" "},{"text":"value — so a game can speak in its own voice without touching behavior.","type":"text"}],"navigatorTitle":[{"text":"GameText","kind":"identifier"}],"title":"GameText","kind":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText","type":"topic","url":"\/documentation\/gnusto\/gametext","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"GameText","kind":"identifier"}],"role":"symbol"},"doc://Gnusto/documentation/Gnusto":{"abstract":[{"text":"An engine for writing interactive fiction in Swift.","type":"text"}],"title":"Gnusto","kind":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto","type":"topic","url":"\/documentation\/gnusto","role":"collection"},"doc://Gnusto/documentation/Gnusto/GameText/Line":{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Line","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Line","kind":"identifier"}],"abstract":[{"text":"One stock line, in whichever shape the game wants it: a fixed sentence,","type":"text"},{"text":" ","type":"text"},{"text":"a sentence assembled when it prints, or one that names the thing it is","type":"text"},{"text":" ","type":"text"},{"text":"about.","type":"text"}],"type":"topic","title":"GameText.Line","url":"\/documentation\/gnusto\/gametext\/line","role":"symbol","navigatorTitle":[{"text":"Line","kind":"identifier"}],"kind":"symbol"},"doc://Gnusto/documentation/Gnusto/GameText/pitchBlack":{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/pitchBlack","fragment