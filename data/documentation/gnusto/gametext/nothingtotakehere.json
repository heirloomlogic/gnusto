,{"type":"text","text":"emitter says it through "},{"type":"codeVoice","code":"sayOnceThisTurn(_:)"},{"type":"text","text":", so a game that points a"},{"type":"text","text":" "},{"type":"text","text":"second one at these same words (Zork’s dark line is its grue’s warning)"},{"type":"text","text":" "},{"type":"text","text":"still prints them once."}],"kind":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/pitchBlack","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"pitchBlack"},{"kind":"text","text":": "},{"preciseIdentifier":"s:6Gnusto8GameTextV","kind":"typeIdentifier","text":"GameText"},{"kind":"text","text":"."},{"preciseIdentifier":"s:6Gnusto8GameTextV4LineV","kind":"typeIdentifier","text":"Line"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:6Gnusto8GameTextV","kind":"typeIdentifier","text":"GameText"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto8GameTextV7NothingV","text":"Nothing"},{"kind":"text","text":">"}],"role":"symbol","url":"\/documentation\/gnusto\/gametext\/pitchblack","title":"pitchBlack"},"doc://Gnusto/documentation/Gnusto/GameText/Line":{"kind":"symbol","abstract":[{"text":"One stock line, in whichever shape the game wants it: a fixed sentence,","type":"text"},{"text":" ","type":"text"},{"text":"a sentence assembled when it prints, or one that names the thing it is","type":"text"},{"text":" ","type":"text"},{"text":"about.","type":"text"}],"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Line","title":"GameText.Line","url":"\/documentation\/gnusto\/gametext\/line","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Line"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Line"}]},"doc://Gnusto/documentation/Gnusto/GameText/Line/live(_:)":{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Line\/live(_:)","kind":"symbol","frag