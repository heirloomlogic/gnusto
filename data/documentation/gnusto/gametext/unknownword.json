ame in ","type":"text"},{"code":"GnustoSpellcasting","type":"codeVoice"},{"text":") reuse for","type":"text"},{"text":" ","type":"text"},{"text":"short strings that were never at risk and should not be silently","type":"text"},{"text":" ","type":"text"},{"text":"truncated on a rule they don’t need. This cap applies only to the","type":"text"},{"text":" ","type":"text"},{"text":"stock line; a game’s own closure assigned here gets the raw token.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"word.count","type":"codeVoice"},{"text":" (grapheme clusters) misses a cluster that is itself","type":"text"},{"text":" ","type":"text"},{"text":"unbounded — one base character plus tens of thousands of combining","type":"text"},{"text":" ","type":"text"},{"text":"marks — so ","type":"text"},{"code":"scalarCap","type":"codeVoice"},{"text":" bounds ","type":"text"},{"code":"unicodeScalars","type":"codeVoice"},{"text":" first.","type":"text"}],"type":"paragraph"}]}],"sections":[],"abstract":[{"text":"A word outside the game’s whole vocabulary.","type":"text"}],"references":{"doc://Gnusto/documentation/Gnusto/GameText/Word":{"abstract":[{"text":"A fragment of what the player typed, quoted back at them.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Word"}],"title":"GameText.Word","kind":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Word","type":"topic","url":"\/documentation\/gnusto\/gametext\/word","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Word","kind":"identifier"}],"role":"symbol"},"doc://Gnusto/documentation/Gnusto/GameText/multipleNotAllowedWith":{"type":"topic","kind":"symbol","title":"multipleNotAllowedWith","role":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/multipleNotAllowedWith","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"multipleNotAllowedWith"},{"kind":"text","text":": "},{"kind":"typeIde