{"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"kind":"symbol","identifier":{"url":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Holding","interfaceLanguage":"swift"},"metadata":{"navigatorTitle":[{"text":"Holding","kind":"identifier"}],"modules":[{"name":"Gnusto"}],"role":"symbol","extendedModule":"Gnusto","externalID":"s:6Gnusto8GameTextV7HoldingV","title":"GameText.Holding","symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Holding","kind":"identifier"}],"roleHeading":"Structure"},"relationshipsSections":[{"identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/DroppableSubject","doc:\/\/Gnusto\/documentation\/Gnusto\/LineSubject","doc:\/\/Gnusto\/documentation\/Gnusto\/NamedSubject","doc:\/\/Gnusto\/s8SendableP","doc:\/\/Gnusto\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Holding"}]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/Gnusto\/documentation\/Gnusto\/TextAndRandomness"]},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Line","isActive":true,"type":"reference"},{"text":" is about ","type":"text"},{"inlineContent":[{"type":"text","text":"one"}],"type":"emphasis"},{"text":" object, and a sentence about two needs some way","type":"text"},{"text":" ","type":"text"},{"text":"to say which is which. The roles are a type rather than a pair, because","type":"text"},{"text":" ","type":"text"},{"text":"the pair spelling — a tuple, ","type":"text"},{"code":"$0","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"$1","type":"codeVoice"},{"text":" — leaves the API unable to","type":"text"},{"text":" ","type":"text"},{"text":"answer the only question an author actually asks at the call site: which","type":"text"},{"text":" ","type":"text"},{"text":"one is the container? ","type":"text"},{"code":"\\($0.holder)","type":"codeVoice"},{"text":" answers it; ","type":"text"},{"code":"\\($1)","type":"codeVoice"},{"text":" does not.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"One struct serves every line whose two things stand in this relation,","type":"text"},{"text":" ","type":"text"},{"text":"rather than one apiece — which is also what lets ","type":"text"},{"code":"RoomDescriber","type":"codeVoice"},{"text":" keep","type":"text"},{"text":" ","type":"text"},{"text":"handing ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/itemOnSurface","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/itemInContainer","isActive":true,"type":"reference"},{"text":" to","type":"text"},{"text":" ","type":"text"},{"text":"one helper as a value. Another such line should cost no edit here.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"code":"Line","type":"codeVoice"},{"text":" over one of these is ","type":"text"},{"code":"ExpressibleByStringLiteral","type":"codeVoice"},{"text":", so a","type":"text"},{"text":" ","type":"text"},{"text":"two-object line will take a fixed sentence — ","type":"text"},{"code":"text.putItemIn = \"Done.\"","type":"codeVoice"},{"text":" ","type":"text"},{"text":"— and print it without either name. For these that is a legitimate thing","type":"text"},{"text":" ","type":"text"},{"text":"for a game to want, and the sentence it prints is still true. It is not","type":"text"},{"text":" ","type":"text"},{"text":"legitimate for a line whose whole content is the thing it was handed,","type":"text"},{"text":" ","type":"text"},{"text":"which is why these are ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/DroppableSubject","isActive":true,"type":"reference"},{"text":"s and ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Word","isActive":true,"type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"its neighbours are not.","type":"text"}]},{"syntax":"swift","code":["text.putItemIn = .naming { \"You tuck \\($0.item) into \\($0.holder).\" }"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Both arrive as ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Noun","isActive":true,"type":"reference"},{"text":" for the reason one does — and for a second reason","type":"text"},{"text":" ","type":"text"},{"text":"a one-object line never has. A sentence about two things has two things","type":"text"},{"text":" ","type":"text"},{"text":"its verb might agree with, and it is rarely the one the sentence names","type":"text"},{"text":" ","type":"text"},{"text":"first: ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/itemOnSurface","isActive":true,"type":"reference"},{"text":" reads “On the table are the rails”,","type":"text"},{"text":" ","type":"text"},{"text":"where the verb agrees with the rails and the template names the table.","type":"text"},{"text":" ","type":"text"},{"text":"While these were a pair of strings there was no way to write that","type":"text"},{"text":" ","type":"text"},{"text":"sentence at all.","type":"text"}]}]}],"variants":[{"paths":["\/documentation\/gnusto\/gametext\/holding"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"A thing and what holds it: what the player put down, and the box, the","type":"text"},{"text":" ","type":"text"},{"text":"table or the hamper it went into.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto","doc:\/\/Gnusto\/documentation\/Gnusto\/GameText"]]},"topicSections":[{"identifiers":["doc