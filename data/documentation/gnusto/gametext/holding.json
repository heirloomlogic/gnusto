{"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Holding","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"mentions":["doc:\/\/Gnusto\/documentation\/Gnusto\/TextAndRandomness"],"kind":"mentions"},{"content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Line"},{"text":" is about ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"one"}]},{"text":" object, and a sentence about two needs some way","type":"text"},{"text":" ","type":"text"},{"text":"to say which is which. The roles are a type rather than a pair, because","type":"text"},{"text":" ","type":"text"},{"text":"the pair spelling — a tuple, ","type":"text"},{"type":"codeVoice","code":"$0"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"$1"},{"text":" — leaves the API unable to","type":"text"},{"text":" ","type":"text"},{"text":"answer the only question an author actually asks at the call site: which","type":"text"},{"text":" ","type":"text"},{"text":"one is the container? ","type":"text"},{"type":"codeVoice","code":"\\($0.holder)"},{"text":" answers it; ","type":"text"},{"type":"codeVoice","code":"\\($1)"},{"text":" does not.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"One struct serves every line whose two things stand in this relation,","type":"text"},{"text":" ","type":"text"},{"text":"rather than one apiece — which is also what lets ","type":"text"},{"type":"codeVoice","code":"RoomDescriber"},{"text":" keep","type":"text"},{"text":" ","type":"text"},{"text":"handing ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/itemOnSurface"},{"text":" and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/itemInContainer"},{"text":" to","type":"text"},{"text":" ","type":"text"},{"text":"one helper as a value. Another such line should cost no edit here.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"Line"},{"text":" over one of these is ","type":"text"},{"type":"codeVoice","code":"ExpressibleByStringLiteral"},{"text":", so a","type":"text"},{"text":" ","type":"text"},{"text":"two-object line will take a fixed sentence — ","type":"text"},{"type":"codeVoice","code":"text.putItemIn = \"Done.\""},{"text":" ","type":"text"},{"text":"— and print it without either name. For these that is a legitimate thing","type":"text"},{"text":" ","type":"text"},{"text":"for a game to want, and the sentence it prints is still true. It is not","type":"text"},{"text":" ","type":"text"},{"text":"legitimate for a line whose whole content is the thing it was handed,","type":"text"},{"text":" ","type":"text"},{"text":"which is why these are ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/DroppableSubject"},{"text":"s and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Word"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"its neighbours are not.","type":"text"}],"type":"paragraph"},{"code":["text.putItemIn = .naming { \"You tuck \\($0.item) into \\($0.holder).\" }"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Both arrive as ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Noun"},{"text":" for the reason one does — and for a second reason","type":"text"},{"text":" ","type":"text"},{"text":"a one-object line never has. A sentence about two things has two things","type":"text"},{"text":" ","type":"text"},{"text":"its verb might agree with, and it is rarely the one the sentence names","type":"text"},{"text":" ","type":"text"},{"text":"first: ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/itemOnSurface"},{"text":" reads “On the table are the rails”,","type":"text"},{"text":" ","type":"text"},{"text":"where the verb agrees with the rails and the template names the table.","type":"text"},{"text":" ","type":"text"},{"text":"While these were a pair of strings there was no way to write that","type":"text"},{"text":" ","type":"text"},{"text":"sentence at all.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto","doc:\/\/Gnusto\/documentation\/Gnusto\/GameText"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Holding"},"abstract":[{"type":"text","text":"A thing and what holds it: what the player put down, and the box, the"},{"type":"text","text":" "},{"type":"text","text":"table or the hamper it went into."}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/DroppableSubject","doc:\/\/Gnusto\/documentation\/Gnusto\/LineSubject","doc:\/\/Gnusto\/documentation\/Gnusto\/NamedSubject","doc:\/\/Gnusto\/s8SendableP","doc:\/\/Gnusto\/s16SendableMetatypeP"],"type":"conformsTo"}],"topicSections":[{"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Holding\/holder","doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Holding\/item"],"generated":true},{"anchor":"Type-Properties","title":"Type Properties","identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Holding\/samples"],"generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnusto\/gametext\/holding"]}],"sections":[],"metadata":{