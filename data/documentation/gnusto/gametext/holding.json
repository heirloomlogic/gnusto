{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Holding"},"topicSections":[{"anchor":"Instance-Properties","identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Holding\/holder","doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Holding\/item"],"title":"Instance Properties","generated":true},{"anchor":"Type-Properties","identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Holding\/samples"],"title":"Type Properties","generated":true}],"kind":"symbol","relationshipsSections":[{"kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/DroppableSubject","doc:\/\/Gnusto\/documentation\/Gnusto\/LineSubject","doc:\/\/Gnusto\/documentation\/Gnusto\/NamedSubject","doc:\/\/Gnusto\/s8SendableP","doc:\/\/Gnusto\/s16SendableMetatypeP"],"title":"Conforms To"}],"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto","doc:\/\/Gnusto\/documentation\/Gnusto\/GameText"]]},"metadata":{"roleHeading":"Structure","role":"symbol","modules":[{"name":"Gnusto"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Holding"}],"externalID":"s:6Gnusto8GameTextV7HoldingV","title":"GameText.Holding","symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"Holding"}],"extendedModule":"Gnusto"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Holding","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/Gnusto\/documentation\/Gnusto\/TextAndRandomness"]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Line","type":"reference","isActive":true},{"type":"text","text":" is about "},{"type":"emphasis","inlineContent":[{"text":"one","type":"text"}]},{"text":" object, and a sentence about two needs some way","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"to say which is which. The roles are a type rather than a pair, because"},{"type":"text","text":" "},{"type":"text","text":"the pair spelling — a tuple, "},{"code":"$0","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"$1"},{"type":"text","text":" — leaves the API unable to"},{"type":"text","text":" "},{"type":"text","text":"answer the only question an author actually asks at the call site: which"},{"type":"text","text":" "},{"type":"text","text":"one is the container? "},{"type":"codeVoice","code":"\\($0.holder)"},{"type":"text","text":" answers it; "},{"type":"codeVoice","code":"\\($1)"},{"type":"text","text":" does not."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"One struct serves every line whose two things stand in this relation,"},{"type":"text","text":" "},{"type":"text","text":"rather than one apiece — which is also what lets "},{"type":"codeVoice","code":"RoomDescriber"},{"type":"text","text":" keep"},{"type":"text","text":" "},{"type":"text","text":"handing "},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/itemOnSurface","isActive":true,"type":"reference"},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/itemInContainer","isActive":true},{"type":"text","text":" to"},{"type":"text","text":" "},{"type":"text","text":"one helper as a value. Another such line should cost no edit here."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"code":"Line","type":"codeVoice"},{"type":"text","text":" over one of these is "},{"code":"ExpressibleByStringLiteral","type":"codeVoice"},{"type":"text","text":", so a"},{"type":"text","text":" "},{"type":"text","text":"two-object line will take a fixed sentence — "},{"type":"codeVoice","code":"text.putItemIn = \"Done.\""},{"type":"text","text":" "},{"type":"text","text":"— and print it without either name. For these that is a legitimate thing"},{"type":"text","text":" "},{"type":"text","text":"for a game to want, and the sentence it prints is still true. It is not"},{"type":"text","text":" "},{"text":"legitimate for a line whose whole content is the thing it was handed,","type":"text"},{"text":" ","type":"text"},{"text":"which is why these are ","type":"text"},{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/DroppableSubject","isActive":true},{"type":"text","text":"s and "},{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Word","isActive":true},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"its neighbours are not.","type":"text"}]},{"code":["text.putItemIn = .naming { \"You tuck \\($0.item) into \\($0.holder).\" }"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Both arrive as "},{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Noun","isActive":true},{"type":"text","text":" for the reason one does — and for a second reason"},{"type":"text","text":" "},{"type":"text","text":"a one-object line never has. A sentence about two things has two things"},{"type":"text","text":" "},{"type":"text","text":"its verb might agree with, and it is rarely the one the sentence names"},{"type":"text","text":" "},{"type":"text","text":"first: "},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/itemOnSurface","type":"reference","isActive":true},{"type":"text","text":" reads “On the table are the rails”,"},{"type":"text","text":" "},{"type":"text","text":"where the verb agrees with the rails and the template names the table."},{"type":"text","text":" "},{"type":"text","text":"While these were a pair of strings there was no way to write that"},{"type":"text","text":" "},{"type":"text","text":"sentence at all."}],"type":"paragraph"}]}],"v