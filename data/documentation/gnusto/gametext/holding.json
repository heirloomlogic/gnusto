{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto","doc:\/\/Gnusto\/documentation\/Gnusto\/GameText"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"role":"symbol","title":"GameText.Holding","externalID":"s:6Gnusto8GameTextV7HoldingV","modules":[{"name":"Gnusto"}],"roleHeading":"Structure","extendedModule":"Gnusto","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Holding"}],"symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"Holding"}]},"identifier":{"url":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Holding","interfaceLanguage":"swift"},"topicSections":[{"generated":true,"title":"Instance Properties","identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Holding\/holder","doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Holding\/item"],"anchor":"Instance-Properties"},{"generated":true,"title":"Type Properties","identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Holding\/samples"],"anchor":"Type-Properties"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnusto\/gametext\/holding"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Holding","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/Gnusto\/documentation\/Gnusto\/TextAndRandomness"]},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Line","isActive":true,"type":"reference"},{"text":" is about ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"one","type":"text"}]},{"text":" object, and a sentence about two needs some way","type":"text"},{"text":" ","type":"text"},{"text":"to say which is which. The roles are a type rather than a pair, because","type":"text"},{"text":" ","type":"text"},{"text":"the pair spelling — a tuple, ","type":"text"},{"code":"$0","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"$1","type":"codeVoice"},{"text":" — leaves the API unable to","type":"text"},{"text":" ","type":"text"},{"text":"answer the only question an author actually asks at the call site: which","type":"text"},{"text":" ","type":"text"},{"text":"one is the container? ","type":"text"},{"code":"\\($0.holder)","type":"codeVoice"},{"text":" answers it; ","type":"text"},{"code":"\\($1)","type":"codeVoice"},{"text":" does not.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"One struct serves every line whose two things stand in this relation,","type":"text"},{"text":" ","type":"text"},{"text":"rather than one apiece — which is also what lets ","type":"text"},{"code":"RoomDescriber","type":"codeVoice"},{"text":" keep","type":"text"},{"text":" ","type":"text"},{"text":"handing ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/itemOnSurface","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/itemInContainer","isActive":true,"type":"reference"},{"text":" to","type":"text"},{"text":" ","type":"text"},{"text":"one helper as a value. Another such line should cost no edit here.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A ","type":"text"},{"code":"Line","type":"codeVoice"},{"text":" over one of these is ","type":"text"},{"code":"ExpressibleByStringLiteral","type":"codeVoice"},{"text":", so a","type":"text"},{"text":" ","type":"text"},{"text":"two-object line will take a fixed sentence — ","type":"text"},{"code":"text.putItemIn = \"Done.\"","type":"codeVoice"},{"text":" ","type":"text"},{"text":"— and print it without either name. For these that is a legitimate thing","type":"text"},{"text":" ","type":"text"},{"text":"for a game to want, and the sentence it prints is still true. It is not","type":"text"},{"text":" ","type":"text"},{"text":"legitimate for a line whose whole content is the thing it was handed,","type":"text"},{"text":" ","type":"text"},{"text":"which is why these are ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/DroppableSubject","isActive":true,"type":"reference"},{"text":"s and ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Word","isActive":true,"type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"its neighbours are not.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["text.putItemIn = .naming { \"You tuck \\($0.item) into \\($0.holder).\" }"]},{"inlineContent":[{"text":"Both arrive as ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Noun","isActive":true,"type":"reference"},{"text":" for the reason one does — and for a second reason","type":"text"},{"text":" ","type":"text"},{"text":"a one-object line never has. A sentence about two things has two things","type":"text"},{"text":" ","type":"text"},{"text":"its verb might agree with, and it is rarely the one the sentence names","type":"text"},{"text":" ","type":"text"},{"text":"first: ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/itemOnSurface","isActive":true,"type":"reference"},{"text":" reads “On the table are the rails”,","type":"text"},{"text":" ","type":"text"},{"text":"where the verb agrees with the rails and the template names the table.","type":"text"},{"text":" ","type":"text"},{"text":"While these were a pair of strings there was no way to write that","type":"text"},{"text":" ","type":"text"},{"text":"sentence at all.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"abstract":[{"type":"text","text":"A thing and what holds it: what the player put down, and the box, the"},{"type":"text","text":" "},{"text":"table or the hamper it went i