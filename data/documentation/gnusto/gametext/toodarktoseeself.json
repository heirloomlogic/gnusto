{"identifier":{"url":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/tooDarkToSeeSelf","interfaceLanguage":"swift"},"abstract":[{"text":"Examining yourself in the dark, where the line above would assert a","type":"text"},{"text":" ","type":"text"},{"text":"look that could not have happened.","type":"text"}],"metadata":{"roleHeading":"Instance Property","modules":[{"name":"Gnusto"}],"title":"tooDarkToSeeSelf","role":"symbol","externalID":"s:6Gnusto8GameTextV16tooDarkToSeeSelfAC4LineVy_AC7NothingVGvp","symbolKind":"property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"tooDarkToSeeSelf","kind":"identifier"},{"text":": ","kind":"text"},{"text":"GameText","preciseIdentifier":"s:6Gnusto8GameTextV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Line","preciseIdentifier":"s:6Gnusto8GameTextV4LineV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"GameText","preciseIdentifier":"s:6Gnusto8GameTextV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Nothing","preciseIdentifier":"s:6Gnusto8GameTextV7NothingV","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"sections":[],"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto","doc:\/\/Gnusto\/documentation\/Gnusto\/GameText"]]},"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"tooDarkToSeeSelf","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText","text":"GameText","preciseIdentifier":"s:6Gnusto8GameTextV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Line","text":"Line","preciseIdentifier":"s:6Gnusto8GameTextV4LineV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText","text"