{"abstract":[{"text":"Examining yourself in the dark, where the line above would assert a","type":"text"},{"text":" ","type":"text"},{"text":"look that could not have happened.","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto","doc:\/\/Gnusto\/documentation\/Gnusto\/GameText"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"tooDarkToSeeSelf"},{"kind":"text","text":": "},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText","kind":"typeIdentifier","text":"GameText","preciseIdentifier":"s:6Gnusto8GameTextV"},{"kind":"text","text":"."},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Line","kind":"typeIdentifier","text":"Line","preciseIdentifier":"s:6Gnusto8GameTextV4LineV"},{"kind":"text","text":"<"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText","kind":"typeIdentifier","text":"GameText","preciseIdentifier":"s:6Gnusto8GameTextV"},{"kind":"text","text":"."},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Nothing","kind":"typeIdentifier","text":"Nothing","preciseIdentifier":"s:6Gnusto8GameTextV7NothingV"},{"kind":"text","text":">"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"mentions","mentions":["doc:\/\/Gnusto\/documentation\/Gnusto\/WritingRules"]},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"An observer is always in their own scope, dark or light — that is the","type":"text"},{"text":" ","type":"text"},{"text":"first thing the engine’s scope walk puts in the set, and it is not a","type":"text"},{"text":" ","type":"text"},{"text":"thing the darkness gate could be moved above or below. So ","type":"text"},{"code":"x me","type":"codeVoice"},{"text":" ","type":"text"},{"text":"reached ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/selfDescription","isActive":true,"type":"reference"},{"text":" in a room where ","type":"text"},{"code":"x <anything on the floor>","type":"codeVoice"},{"text":" ","type":"text"},{"text":"answers ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/cantSeeAnySuchThing","isActive":true,"type":"reference"},{"text":", and a game that has just printed","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/pitchBlack","isActive":true,"type":"reference"},{"text":" cannot re-skin its way out of the contradiction, because","type":"text"},{"text":" ","type":"text"},{"text":"the sentence is true everywhere else. The verb answers for it instead.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Deliberately not ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/pitchBlack","isActive":true,"type":"reference"},{"text":": that line is the room’s, a game is","type":"text"},{"text":" ","type":"text"},{"text":"free to point it at a threat rather than a description, and printing it","type":"text"},{"text":" ","type":"text"},{"text":"again here would answer a question about the player with a sentence","type":"text"},{"text":" ","type":"text"},{"text":"about the dark.","type":"text"}],"type":"paragraph"}]}],"metadata":{"title":"tooDarkToSeeSelf","roleHeading":"Instance Property","modules":[{"name":"Gnusto"}],"symbolKind":"property","fragments":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"text":"tooDarkToSeeSelf","kind":"identifier"},{"kind":"text","text":": "},{"preciseIdentifier":"s:6Gnusto8GameTextV","text":"GameText","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:6Gnusto8GameTextV4LineV","text":"Line","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:6Gnusto8GameTextV","text":"GameText","kind":"typeIdentifier"},{"text":".",