, a game is"},{"type":"text","text":" "},{"type":"text","text":"free to point it at a threat rather than a description, and printing it"},{"type":"text","text":" "},{"type":"text","text":"again here would answer a question about the player with a sentence"},{"type":"text","text":" "},{"type":"text","text":"about the dark."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnusto\/gametext\/toodarktoseeself"]}],"references":{"doc://Gnusto/documentation/Gnusto/WritingRules":{"type":"topic","title":"Writing Rules","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/WritingRules","url":"\/documentation\/gnusto\/writingrules","role":"article","abstract":[{"type":"text","text":"Attach game logic to items, locations, and the world."}],"kind":"article"},"doc://Gnusto/documentation/Gnusto/GameText/Nothing":{"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Nothing","title":"GameText.Nothing","url":"\/documentation\/gnusto\/gametext\/nothing","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Nothing"}],"role":"symbol","navigatorTitle":[{"text":"Nothing","kind":"identifier"}],"abstract":[{"type":"text","text":"The subject of a line that has none."}],"kind":"symbol"},"doc://Gnusto/documentation/Gnusto/GameText/tooDarkToSeeSelf":{"title":"tooDarkToSeeSelf","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"tooDarkToSeeSelf","kind":"identifier"},{"text":": ","kind":"text"},{"text":"GameText","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto8GameTextV"},{"text":".","kind":"text"},{"text":"Line","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto8GameTextV4LineV"},{"text":"<","kind":"text"},{"text":"GameText","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto8GameTextV"},{"text":".","kind":"text"},{"text":"Nothing","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto8GameTextV7NothingV"},