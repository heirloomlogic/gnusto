{"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/tooDarkToSeeSelf"},"metadata":{"symbolKind":"property","role":"symbol","externalID":"s:6Gnusto8GameTextV16tooDarkToSeeSelfAC4LineVy_AC7NothingVGvp","title":"tooDarkToSeeSelf","modules":[{"name":"Gnusto"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"tooDarkToSeeSelf","kind":"identifier"},{"text":": ","kind":"text"},{"text":"GameText","preciseIdentifier":"s:6Gnusto8GameTextV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Line","preciseIdentifier":"s:6Gnusto8GameTextV4LineV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"GameText","preciseIdentifier":"s:6Gnusto8GameTextV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Nothing","preciseIdentifier":"s:6Gnusto8GameTextV7NothingV","kind":"typeIdentifier"},{"text":">","kind":"text"}],"roleHeading":"Instance Property"},"variants":[{"paths":["\/documentation\/gnusto\/gametext\/toodarktoseeself"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"tooDarkToSeeSelf","kind":"identifier"},{"text":": ","kind":"text"},{"text":"GameText","preciseIdentifier":"s:6Gnusto8GameTextV","kind":"typeIdentifier","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText"},{"text":".","kind":"text"},{"text":"Line","preciseIdentifier":"s:6Gnusto8GameTextV4LineV","kind":"typeIdentifier","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Line"},{"text":"<","kind":"text"},{"text":"GameText","preciseIdentifier":"s:6Gnusto8GameTextV","kind":"typeIdentifier","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText"},{"text":".","kind":"text"},{"text":"Nothing","preciseIdentifier":"s:6Gnusto8GameTextV7NothingV","kind":"typeIdentifier","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Nothing"},{"text":">","kind":"text"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/Gnusto\/documentation\/Gnusto\/WritingRules"]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"An observer is always in their own scope, dark or light — that is the"},{"type":"text","text":" "},{"type":"text","text":"first thing the engine’s scope walk puts in the set, and it is not a"},{"type":"text","text":" "},{"type":"text","text":"thing the darkness gate could be moved above or below. So "},{"type":"codeVoice","code":"x me"},{"type":"text","text":" "},{"type":"text","text":"reached "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/selfDescription"},{"type":"text","text":" in a room where "},{"type":"codeVoice","code":"x <anything on the floor>"},{"type":"text","text":" "},{"type":"text","text":"answers "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/cantSeeAnySuchThing"},{"type":"text","text":", and a game that has just printed"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/pitchBlack"},{"type":"text","text":" cannot re-skin its way out of the contradiction, because"},{"type":"text","text":" "},{"type":"text","text":"the sentence is true everywhere else. The verb answers for it instead."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Deliberately not "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/pitchBlack"},{"type":"text","text":": that line is the room’s, a game is"},{"type":"text","text":" "},{"type":"text","text":"free to point it at a threat rather than a description, and printing it"},{"type":"text","text":" "},{"type":"text","text":"again here would answer a question about the player with a sentence"},{"type":"text","text":" "},{"type":"text","text":"about the dark."}],"type":"paragraph"}]}],"abstract":[{"text":"Examining yourself in the dark, where the line above would assert a","type":"text"},{"text":" ","type":"text"},{"text":"look that could not have happened.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto","doc:\/\/Gnusto\/documentation\/Gnusto\/GameText"]]},"references":{"doc://Gnusto/documentation/Gnusto/GameText/pitchBlack":{"type":"topic","abstract":[{"type":"text","text":"A dark room, in answer to anything that would have needed the player to"},{"type":"text","text":" "},{"type":"text","text":"see it: LOOK and the room describer, or a TAKE ALL whose group came back"},{"type":"text","text":" "},{"type":"text","text":"empty because the dark had emptied it. The line most likely to want"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Line\/live(_:)"},{"type":"text","text":": it prints on every dark turn, in every dark room, and"},{"type":"text","text":" "},{"type":"text","text":"a game whose darkness has anything in it — a companion, a sound, a smell"},{"type":"text","text":" "},{"type":"text","text":"— has to check that the thing is still there before saying so. Every"},{"type":"text","text":" "},{"type":"text","text":"emitter says it through "},{"type":"codeVoice","code":"sayOnceThisTurn(_:)"},{"type":"text","text":", so a game that points a"},{"type":"text","text":" "},{"type":"text","text":"second one at these same words (Zork’s dark line is its grue’s warning)"},{"type":"text","text":" "},{"type":"text","text":"still prints them once."}],"kind":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/pitchBlack","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"pitchBlack"},{"kind":"text","text":": "},{"preciseI