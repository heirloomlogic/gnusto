{"abstract":[{"text":"Several nouns as one — “a sword, a lamp, and some scales” — carrying","type":"text"},{"text":" ","type":"text"},{"text":"the number the whole phrase has rather than the number any one of","type":"text"},{"text":" ","type":"text"},{"text":"them has.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto","doc:\/\/Gnusto\/documentation\/Gnusto\/GameText","doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Noun"]]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Noun\/list(_:)"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnusto\/gametext\/noun\/list(_:)"]}],"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"list"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"nouns"},{"text":": [","kind":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText","text":"GameText","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto8GameTextV"},{"text":".","kind":"text"},{"text":"Noun","kind":"typeIdentifier","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Noun","preciseIdentifier":"s:6Gnusto8GameTextV4NounV"},{"text":"]) -> ","kind":"text"},{"preciseIdentifier":"s:6Gnusto8GameTextV","text":"GameText","kind":"typeIdentifier","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText"},{"text":".","kind":"text"},{"preciseIdentifier":"s:6Gnusto8GameTextV4NounV","text":"Noun","kind":"typeIdentifier","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Noun"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"nouns","content":[{"type":"paragraph","inlineContent":[{"text":"The phrases to join, in the order they should","type":"text"},{"text":" ","type":"text"},{"text":"read.","type":"text"}]}]}],"kind":"parameters"},{"kind":"content","content":[{"anchor":"return-value","text":"Return Value","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"One noun standing for all of them."}],"type":"paragraph"}]},{"kind":"mentions","mentions":["doc:\/\/Gnusto\/documentation\/Gnusto\/TextAndRandomness"]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"That number is the reason this is here and not at the call site.","type":"text"},{"text":" ","type":"text"},{"text":"English agrees with the ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"list"}]},{"text":", and a list is plural two ways: when","type":"text"},{"text":" ","type":"text"},{"text":"it holds more than one thing, ","type":"text"},{"inlineContent":[{"type":"text","text":"or"}],"type":"strong"},{"text":" when the only thing it holds is","type":"text"},{"text":" ","type":"text"},{"text":"itself plural. Counting alone gets the second wrong, and the engine","type":"text"},{"text":" ","type":"text"},{"text":"got it wrong — one plural thing in a box printed “In the hamper is","type":"text"},{"text":" ","type":"text"},{"text":"some scales.” A game re-voicing that line would have had to re-derive","type":"text"},{"text":" ","type":"text"},{"text":"the rule from scratch and could have made the same mistake; this is","type":"text"},{"text":" ","type":"text"},{"text":"the rule written once, in the type that exists to own it.","type":"text"}]},{"inlineContent":[{"text":"An empty list is plural (“none of them are here”) and renders as the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"empty phrase. No stock line calls one with nothing in it — the"},{"type":"text","text":" "},{"type":"text","text":"callers all branch on empty first, with a line of their own — but a"},{"text":" ","type":"text"},{"text":"game’s might, and silently reading as singular would be the same","type":"text"},{"type":"text","text":" "},{"type":"text","text":"defect one case further out."}],"type":"paragraph"}]}],"metadata":{"title":"list(_:)","role":"symbol","roleHeading":"Type Method","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"list","kind":"identifier"},{"text":"([","kind":"text"},{"preciseIdentifier":"s:6Gnusto8GameTextV","text":"GameText","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:6Gnusto8GameTextV4NounV","text":"Noun","kind":"typeIdentifier"},{"text":"]) -> ","kind":"text"},{"preciseIdentifier":"s:6Gnusto8GameTextV","text":"GameText","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:6Gnusto8GameTextV4NounV","text":"Noun","kind":"typeIdentifier"}],"symbolKind":"method","modules":[{"name":"Gnusto"}],"externalID":"s:6Gnusto8GameTextV4NounV4listyAESayAEGFZ"},"references":{"doc://Gnusto/documentation/Gnusto/GameText":{"type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GameText","kind":"identifier"}],"navigatorTitle":[{"text":"GameText","kind":"identifier"}],"abstract":[{"type":"text","text":"Every stock player-facing line the engine can say, as one overridable"},{"type":"text","text":" "},{"type":"text","text":"value — so a game can speak in its own voice without touching behavior."}],"url":"\/documentation\/gnusto\/gametext","title":"GameText"},"doc://Gnusto/documentation/Gnusto/GameText/Noun/list(_:)":{"title":"list(_:)","kind":"symbol","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"list","kind":"identifier"},{"text":"([","kin