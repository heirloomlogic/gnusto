{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnusto\/gametext\/noun\/list(_:)"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"list","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"nouns","kind":"internalParam"},{"kind":"text","text":": ["},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText","preciseIdentifier":"s:6Gnusto8GameTextV","kind":"typeIdentifier","text":"GameText"},{"kind":"text","text":"."},{"preciseIdentifier":"s:6Gnusto8GameTextV4NounV","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Noun","kind":"typeIdentifier","text":"Noun"},{"kind":"text","text":"]) -> "},{"preciseIdentifier":"s:6Gnusto8GameTextV","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText","kind":"typeIdentifier","text":"GameText"},{"text":".","kind":"text"},{"text":"Noun","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto8GameTextV4NounV","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Noun"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"nouns","content":[{"type":"paragraph","inlineContent":[{"text":"The phrases to join, in the order they should","type":"text"},{"text":" ","type":"text"},{"text":"read.","type":"text"}]}]}]},{"kind":"content","content":[{"level":2,"text":"Return Value","type":"heading","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"One noun standing for all of them.","type":"text"}]}]},{"mentions":["doc:\/\/Gnusto\/documentation\/Gnusto\/TextAndRandomness"],"kind":"mentions"},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"That number is the reason this is here and not at the call site."},{"type":"text","text":" "},{"type":"text","text":"English agrees with the "},{"inlineContent":[{"text":"list","type":"text"}],"type":"emphasis"},{"type":"text","text":", and a list is plural two ways: when"},{"type":"text","text":" "},{"type":"text","text":"it holds more than one thing, "},{"inlineContent":[{"text":"or","type":"text"}],"type":"strong"},{"type":"text","text":" when the only thing it holds is"},{"type":"text","text":" "},{"type":"text","text":"itself plural. Counting alone gets the second wrong, and the engine"},{"type":"text","text":" "},{"type":"text","text":"got it wrong — one plural thing in a box printed “In the hamper is"},{"type":"text","text":" "},{"type":"text","text":"some scales.” A game re-voicing that line would have had to re-derive"},{"type":"text","text":" "},{"type":"text","text":"the rule from scratch and could have made the same mistake; this is"},{"type":"text","text":" "},{"type":"text","text":"the rule written once, in the type that exists to own it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"An empty list is plural (“none of them are here”) and renders as the"},{"type":"text","text":" "},{"type":"text","text":"empty phrase. No stock line calls one with nothing in it — the"},{"type":"text","text":" "},{"type":"text","text":"callers all branch on empty first, with a line of their own — but a"},{"type":"text","text":" "},{"type":"text","text":"game’s might, and silently reading as singular would be the same"},{"type":"text","text":" "},{"type":"text","text":"defect one case further out."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Noun\/list(_:)","interfaceLanguage":"swift"},"sections":[],"kind":"symbol","metadata":{"modules":[{"name":"Gnusto"}],"symbolKind":"method","title":"list(_:)","role":"symbol","externalID":"s:6Gnusto8GameTextV4NounV4listyAESayAEGFZ","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"list"},{"kind":"text","text":"(["},{"preciseIdentifier":"s:6Gnusto8GameTextV","kind":"typeIdentifier","text":"GameText"},{"kind":"text","text":"."},{"preciseIdentifier":"s:6Gnusto8GameTextV4NounV","kind":"typeIdentifier","text":"Noun"},{"kind":"text","text":"]) -> "},{"preciseIdentifier":"s:6Gnusto8GameTextV","kind":"typeIdentifier","text":"GameText"},{"kind":"text","text":"."},{"preciseIdentifier":"s:6Gnusto8GameTextV4NounV","kind":"typeIdentifier","text":"Noun"}],"roleHeading":"Type Method"},"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto","doc:\/\/Gnusto\/documentation\/Gnusto\/GameText","doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Noun"]]},"abstract":[{"type":"text","text":"Several nouns as one — “a sword, a lamp, and some scales” — carrying"},{"type":"text","text":" "},{"type":"text","text":"the number the whole phrase has rather than the number any one of"},{"type":"text","text":" "},{"type":"text","text":"them has."}],"references":{"doc://Gnusto/documentation/Gnusto":{"type":"topic","title":"Gnusto","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto","kind":"symbol","abstract":[{"text":"An engine for writing interactive fiction in Swift.","type":"text"}],"role":"collection","url":"\/documentation\/gnusto"},"doc://Gnusto/documentation/Gnusto/GameText":{"navigatorTitle":[{"kind":"identifier","text":"GameText"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GameText"}],"url":"\/documentation\/gnusto\/gametext","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText","abstract":[{"type":"text","text":"Every stock player-facing line the engine can say, as one overridable"},{"type":"text","text":" "},{"type":"text","text":"value — so a game can speak in its own voice without touching behavior."}],"title":"GameText","type":"topic","kind":"symbol","role":"symbol"},"doc://Gnusto/documentation/Gnusto/GameText/Noun":{"navigatorTitle":[{"kind":"identifier","text":"Noun"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Noun"}],"url":"\/documentation\/gnusto\/gametext\/noun","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Noun","abstract":[{"type":"text","text":"A rendered noun phrase that also knows its own number, for the lines"},{"text":" ","type":"text"},{"text":"whose verb has to agree with it.","type":"text"}],"title":"GameText.Noun","type":"topic","kind":"symbol","role":"symbol"},"doc://Gnusto/documentation/Gnusto/TextAndRandomness":{"type":"topic","kind":"article","title":"Text and Randomness","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextAndRandomness","abstract":[{"text":"Re-skin the engine’s stock lines, and roll dice that replay.","type":"text"}],"role":"article","url":"\/documentation\/gnusto\/textandrandomness"},"doc://Gnusto/documentation/Gnusto/GameText/Noun/list(_:)":{"type":"topic","kind":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Noun\/list(_:)","title":"list(_:)","abstract":[{"text":"Several nouns as one — “a sword, a lamp, and some scales” — carrying","type":"text"},{"text":" ","type":"text"},{"text":"the number the whole phrase has rather than the number any one of","type":"text"},{"text":" ","type":"text"},{"text":"them has.","type":"text"}],"role":"symbol","url":"\/documentation\/gnusto\/gametext\/noun\/list(_:)","fragments":[{"kind":"keyword","text":"static"},{"text":" ","kind":"text"},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"list","kind":"identifier"},{"text":"([","kind":"text"},{"text":"GameText","preciseIdentifier":"s:6Gnusto8GameTextV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Noun","preciseIdentifier":"s:6Gnusto8GameTextV4NounV","kind":"typeIdentifier"},{"text":"]) -> ","kind":"text"},{"text":"GameText","preciseIdentifier":"s:6Gnusto8GameTextV","kind":"typeIdentif