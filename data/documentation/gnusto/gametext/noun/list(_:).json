{"abstract":[{"text":"Several nouns as one — “a sword, a lamp, and some scales” — carrying","type":"text"},{"text":" ","type":"text"},{"text":"the number the whole phrase has rather than the number any one of","type":"text"},{"text":" ","type":"text"},{"text":"them has.","type":"text"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"list","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"nouns","kind":"internalParam"},{"text":": [","kind":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText","text":"GameText","preciseIdentifier":"s:6Gnusto8GameTextV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Noun","text":"Noun","preciseIdentifier":"s:6Gnusto8GameTextV4NounV","kind":"typeIdentifier"},{"text":"]) -> ","kind":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText","text":"GameText","preciseIdentifier":"s:6Gnusto8GameTextV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Noun","text":"Noun","preciseIdentifier":"s:6Gnusto8GameTextV4NounV","kind":"typeIdentifier"}]}],"kind":"declarations"},{"parameters":[{"name":"nouns","content":[{"inlineContent":[{"text":"The phrases to join, in the order they should","type":"text"},{"text":" ","type":"text"},{"text":"read.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"anchor":"return-value","text":"Return Value","level":2,"type":"heading"},{"inlineContent":[{"text":"One noun standing for all of them.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"mentions":["doc:\/\/Gnusto\/documentation\/Gnusto\/TextAndRandomness"],"kind":"mentions"},{"content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"That number is the reason this is here and not at the call site.","type":"text"},{"text":" ","type":"text"},{"text":"English agrees with the ","type":"text"},{"inlineContent":[{"text":"list","type":"text"}],"type":"emphasis"},{"text":", and a list is plural two ways: when","type":"text"},{"text":" ","type":"text"},{"text":"it holds more than one thing, ","type":"text"},{"inlineContent":[{"text":"or","type":"text"}],"type":"strong"},{"text":" when the only thing it holds is","type":"text"},{"text":" ","type":"text"},{"text":"itself plural. Counting alone gets the second wrong, and the engine","type":"text"},{"text":" ","type":"text"},{"text":"got it wrong — one plural thing in a box printed “In the hamper is","type":"text"},{"text":" ","type":"text"},{"text":"some scales.” A game re-voicing that line would have had to re-derive","type":"text"},{"text":" ","type":"text"},{"text":"the rule from scratch and could have made the same mistake; this is","type":"text"},{"text":" ","type":"text"},{"text":"the rule written once, in the type that exists to own it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"An empty list is plural (“none of them are here”) and renders as the","type":"text"},{"text":" ","type":"text"},{"text":"empty phrase. No stock line calls one with nothing in it — the","type":"text"},{"text":" ","type":"text"},{"text":"callers all branch on empty first, with a line of their own — but a","type":"text"},{"text":" ","type":"text"},{"text":"game’s might, and silently reading as singular would be the same","type":"text"},{"text":" ","type":"text"},{"text":"defect one case further out.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/gnusto\/gametext\/noun\/list(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"Gnusto"}],"role":"symbol","roleHeading":"Type Method","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"list","kind":"identifier"},{"text":"([","kind":"text"},{"text":"GameText","preciseIdentifier":"s:6Gnusto8GameTextV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Noun","preciseIdentifier":"s:6Gnusto8GameTextV4NounV","kind":"typeIdentifier"},{"text":"]) -> ","kind":"text"},{"text":"GameText","preciseIdentifier":"s:6Gnusto8GameTextV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Noun","preciseIdentifier":"s:6Gnusto8GameTextV4NounV","kind":"typeIdentifier"}],"title":"list(_:)","symbolKind":"method","externalID":"s:6Gnusto8GameTextV4NounV4listyAESayAEGFZ"},"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto","doc:\/\/Gnusto\/documentation\/Gnusto\/GameText","doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Noun"]]},"kind":"symbol","identifier":{"url":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Noun\/list(_:)","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"references":{"doc://Gnusto/documentation/Gnusto/TextAndRandomness":{"role":"article","type":"topic","kind":"article","url":"\/documentation\/gnusto\/textandrandomness","title":"Text and Randomness","abstract":[{"type":"text","text":"Re-skin the engine’s stock lines, and roll dice that replay."}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TextAndRandomness"},"doc://Gnusto/documentation/Gnusto/GameText/Noun/list(_:)":{"url":"\/documentation\/gnusto\/gametext\/noun\/list(_:)","type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Noun\/list(_:)","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"list","kind":"identifier"},{"text":"([","kind":"text"},{"preciseIdentifier":"s:6Gnusto8GameTextV","text":"GameText","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:6Gnusto8GameTextV4NounV","text":"Noun","kind":"typeIdentifier"},{"text":"]) -> ","kind":"text"},{"preciseIdentifier":"s:6Gnusto8GameTextV","text":"GameText","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:6Gnusto8GameTextV4NounV","text":"Noun","kind":"typeIdentifier"}],"kind":"symbol","title":"list(_:)","abstract":[{"type":"text","text":"Several nouns as one — “a sword, a lamp, and some scales” — carrying"},{"type":"text","text":" "},{"type":"text","text":"the number the whole phrase has rather than the number any one of"},{"type":"text","text":" "},{"type":"text","text":"them has."}]},"doc://Gnusto/documentation/Gnusto":{"kind":"symbol","abstract":[{"type":"text","text":"An engine for writing interactive fiction in Swift."}],"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto","url":"\/documentation\/gnusto","title":"Gnusto","role":"collection"},"doc://Gnusto/documentation/Gnusto/GameText/Noun":{"kind":"symbol","abstract":[{"type":"text","text":"A rendered noun phrase that also knows its own number, for the lines"},{"type":"text","text":" "},{"type":"text","text":"whose verb has to agree with it."}],"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Noun","title":"GameText.Noun","url":"\/documentation\/gnusto\/gametext\/noun","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Noun"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Noun"}]},"doc://Gnusto/documentation/Gnusto/GameText":{"kind":"symbol","abstract":[{"text":"Every stock player-facing line the engine can say, as one overridable","type":"text"},{"text":" ","type":"text"},{"text":"value — so a game can speak in its own voice without touching behavior.","type":"text"}],"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText","title":"GameText","url":"\/documentation\/gnusto\/gametext","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"GameTe