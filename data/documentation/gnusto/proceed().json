{"variants":[{"paths":["\/documentation\/gnusto\/proceed()"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"url":"doc:\/\/Gnusto\/documentation\/Gnusto\/proceed()","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"roleHeading":"Function","externalID":"s:6Gnusto7proceedyyKF","title":"proceed()","symbolKind":"func","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"proceed"},{"text":"() ","kind":"text"},{"text":"throws","kind":"keyword"}],"modules":[{"name":"Gnusto"}],"role":"symbol"},"seeAlsoSections":[{"identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/WritingRules","doc:\/\/Gnusto\/documentation\/Gnusto\/Rule","doc:\/\/Gnusto\/documentation\/Gnusto\/Rules","doc:\/\/Gnusto\/documentation\/Gnusto\/Intent","doc:\/\/Gnusto\/documentation\/Gnusto\/Command","doc:\/\/Gnusto\/documentation\/Gnusto\/say(_:)","doc:\/\/Gnusto\/documentation\/Gnusto\/sayOnceThisTurn(_:)","doc:\/\/Gnusto\/documentation\/Gnusto\/say(_:from:)-9dkx0","doc:\/\/Gnusto\/documentation\/Gnusto\/say(_:from:)-29lpm","doc:\/\/Gnusto\/documentation\/Gnusto\/say(_:from:)-9dafx","doc:\/\/Gnusto\/documentation\/Gnusto\/say(_:from:)-1kn0c","doc:\/\/Gnusto\/documentation\/Gnusto\/Earshot","doc:\/\/Gnusto\/documentation\/Gnusto\/refuse(_:)","doc:\/\/Gnusto\/documentation\/Gnusto\/reply(_:)","doc:\/\/Gnusto\/documentation\/Gnusto\/require(_:else:)"],"title":"Writing Rules","generated":true,"anchor":"Writing-Rules"}],"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto"]]},"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"proceed"},{"kind":"text","text":"() "},{"kind":"keyword","text":"throws"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"mentions":["doc:\/\/Gnusto\/documentation\/Gnusto\/TheTurnPipeline","doc:\/\/Gnusto\/documentation\/Gnusto\/WritingRules"],"kind":"mentions"},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Callable from any stage 1–3 "},{"type":"codeVoice","code":"before"},{"type":"text","text":"-phase rule — "},{"type":"codeVoice","code":"world.before"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"location.beforeEachTurn"},{"type":"text","text":", "},{"type":"codeVoice","code":"location.before"},{"type":"text","text":", or "},{"type":"codeVoice","code":"item.before"},{"type":"text","text":", on either"},{"type":"text","text":" "},{"type":"text","text":"the indirect or direct object — and only once per turn. "},{"type":"codeVoice","code":"proceed()"},{"type":"text","text":" means"},{"type":"text","text":" "},{"type":"text","text":"“run the default now; I take responsibility”: once it runs, the pipeline"},{"type":"text","text":" "},{"type":"text","text":"skips its own stage-4 step (so the default doesn’t run twice) "},{"type":"emphasis","inlineContent":[{"text":"and","type":"text"}]},{"type":"text","text":" "},{"type":"text","text":"skips every remaining before rule still ahead of the calling rule in this"},{"type":"text","text":" "},{"type":"text","text":"turn’s sequence — including later rules in the same before-phase, not just"},{"type":"text","text":" "},{"type":"text","text":"later phases. A guard written as a later "},{"type":"codeVoice","code":"before"},{"type":"text","text":" rule — whether a sibling"},{"type":"text","text":" "},{"type":"text","text":"in the same phase or an "},{"type":"codeVoice","code":"item.before"},{"type":"text","text":" rule on the direct object when"},{"type":"text","text":" "},{"type":"codeVoice","code":"proceed()"},{"type":"text","text":" was called from "},{"type":"codeVoice","code":"world.before"},{"type":"text","text":" — never gets to run, so it"},{"type":"text","text":" "},{"type":"text","text":"can’t refuse an action that has already happened. Calling it from an "},{"type":"codeVoice","code":"after"},{"type":"text","text":"\/each-turn"},{"type":"text","text":" "},{"type":"text","text":"rule, or calling it twice, is a programmer error and traps with a clear"},{"type":"text","text":" "},{"type":"text","text":"message rather than silently double-running the default action."}]},{"syntax":"swift","code":["mailbox.before(.open) {","    try proceed()                    \/\/ built-in open runs here","    say(\"A city map is tucked inside the lid.\")","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the default action throws (e.g. a built-in "},{"type":"codeVoice","code":"open"},{"type":"text","text":" refuses because the"},{"type":"text","text":" "},{"type":"text","text":"item is locked), that "},{"type":"codeVoice","code":"TurnInterrupt"},{"type":"text","text":" propagates out of "},{"type":"codeVoice","code":"proceed()"},{"type":"text","text":" "},{"type":"text","text":"exactly as it would have out of the pipeline’s own stage 4."}]}],"kind":"content"}],"abstract":[{"type":"text","text":"Runs the stage-4 default action (a game\/plugin override if one is"},{"type":"text","text":" "},{"type":"text","text":"registered for this intent, else the built-in) immediately, then returns"},{"type":"text","text":" "},{"type":"text","text":"so the calling rule can embellish the result — print something more, read"},{"type":"text","text":" "},{"type":"text","text":"state the default action changed, and so on."}],"references":{"doc://Gnusto/documentation/Gnusto":{"kind":"symbol","abstract":[{"type":"text","text":"An engine for writing interactive fiction in Swift."}],"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto","url":"\/documentation\/gnusto","title":"Gnusto","role":"collection"},"doc://Gnusto/documentation/Gnusto/say(_:from:)-9dafx":{"url":"\/documentation\/gnusto\/say(_:from:)-9dafx","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/say(_:from: