{"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto"]]},"kind":"symbol","sections":[],"variants":[{"paths":["\/documentation\/gnusto\/proceed()"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"proceed"},{"kind":"text","text":"() "},{"kind":"keyword","text":"throws"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/Gnusto\/documentation\/Gnusto\/WritingRules"]},{"kind":"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Callable from any stage 1–3 "},{"type":"codeVoice","code":"before"},{"type":"text","text":"-phase rule — "},{"type":"codeVoice","code":"world.before"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"location.beforeEachTurn","type":"codeVoice"},{"text":", ","type":"text"},{"code":"location.before","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"item.before","type":"codeVoice"},{"text":", on either","type":"text"},{"text":" ","type":"text"},{"text":"the indirect or direct object — and only once per turn. ","type":"text"},{"code":"proceed()","type":"codeVoice"},{"text":" means","type":"text"},{"text":" ","type":"text"},{"text":"“run the default now; I take responsibility”: once it runs, the pipeline","type":"text"},{"text":" ","type":"text"},{"text":"skips its own stage-4 step (so the default doesn’t run twice) ","type":"text"},{"inlineContent":[{"text":"and","type":"text"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"skips every remaining before rule still ahead of the calling rule in this","type":"text"},{"text":" ","type":"text"},{"text":"turn’s sequence — including later rules in the same before-phase, not just","type":"text"},{"text":" ","type":"text"},{"text":"later phases. A guard written as a later ","type":"text"},{"code":"before","type":"codeVoice"},{"text":" rule — whether a sibling","type":"text"},{"text":" ","type":"text"},{"text":"in the same phase or an ","type":"text"},{"code":"item.before","type":"codeVoice"},{"text":" rule on the direct object when","type":"text"},{"text":" ","type":"text"},{"code":"proceed()","type":"codeVoice"},{"text":" was called from ","type":"text"},{"code":"world.before","type":"codeVoice"},{"text":" — never gets to run, so it","type":"text"},{"text":" ","type":"text"},{"text":"can’t refuse an action that has already happened. Calling it from an ","type":"text"},{"code":"after","type":"codeVoice"},{"text":"\/each-turn","type":"text"},{"text":" ","type":"text"},{"text":"rule, or calling it twice, is a programmer error and traps with a clear","type":"text"},{"text":" ","type":"text"},{"text":"message rather than silently double-running the default action.","type":"text"}],"type":"paragraph"},{"code":["mailbox.before(.open) {","    try proceed()                    \/\/ built-in open runs here","    say(\"A city map is tucked inside the lid.\")","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"If the default action throws (e.g. a built-in ","type":"text"},{"code":"open","type":"codeVoice"},{"text":" refuses because the","type":"text"},{"text":" ","type":"text"},{"text":"item is locked), that ","type":"text"},{"code":"TurnInterrupt","type":"codeVoice"},{"text":" propagates out of ","type":"text"},{"code":"proceed()","type":"codeVoice"},{"text":" ","type":"text"},{"text":"exactly as it would have out of the pipeline’s own stage 4.","type":"text"}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"title":"Writing Rules","generated":true,"anchor":"Writing-Rules","identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/WritingRules","doc:\/\/Gnusto\/documentation\/Gnusto\/Rule","doc:\/\/Gnusto\/documentation\/Gnusto\/Rules","doc:\/\/Gnusto\/documentation\/Gnusto\/Intent","doc:\/\/Gnusto\/documentat