{"abstract":[{"text":"Runs the stage-4 default action (a game\/plugin override if one is","type":"text"},{"text":" ","type":"text"},{"text":"registered for this intent, else the built-in) immediately, then returns","type":"text"},{"text":" ","type":"text"},{"text":"so the calling rule can embellish the result — print something more, read","type":"text"},{"text":" ","type":"text"},{"text":"state the default action changed, and so on.","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/Gnusto\/documentation\/Gnusto"]]},"seeAlsoSections":[{"anchor":"Writing-Rules","title":"Writing Rules","identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/WritingRules","doc:\/\/Gnusto\/documentation\/Gnusto\/Rule","doc:\/\/Gnusto\/documentation\/Gnusto\/Rules","doc:\/\/Gnusto\/documentation\/Gnusto\/Intent","doc:\/\/Gnusto\/documentation\/Gnusto\/Command","doc:\/\/Gnusto\/documentation\/Gnusto\/say(_:)","doc:\/\/Gnusto\/documentation\/Gnusto\/sayOnceThisTurn(_:)","doc:\/\/Gnusto\/documentation\/Gnusto\/say(_:from:)-9dkx0","doc:\/\/Gnusto\/documentation\/Gnusto\/say(_:from:)-29lpm","doc:\/\/Gnusto\/documentation\/Gnusto\/say(_:from:)-9dafx","doc:\/\/Gnusto\/documentation\/Gnusto\/say(_:from:)-1kn0c","doc:\/\/Gnusto\/documentation\/Gnusto\/Earshot","doc:\/\/Gnusto\/documentation\/Gnusto\/refuse(_:)","doc:\/\/Gnusto\/documentation\/Gnusto\/reply(_:)","doc:\/\/Gnusto\/documentation\/Gnusto\/require(_:else:)"],"generated":true}],"identifier":{"url":"doc:\/\/Gnusto\/documentation\/Gnusto\/proceed()","interfaceLanguage":"swift"},"metadata":{"title":"proceed()","roleHeading":"Function","modules":[{"name":"Gnusto"}],"symbolKind":"func","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"proceed"},{"kind":"text","text":"() "},{"kind":"keyword","text":"throws"}],"role":"symbol","externalID":"s:6Gnusto7proceedyyKF"},"primaryContentSections":[{"declarations":[{"platforms":