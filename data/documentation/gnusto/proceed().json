,{"type":"text","text":" rule on the direct object when"},{"type":"text","text":" "},{"code":"proceed()","type":"codeVoice"},{"type":"text","text":" was called from "},{"code":"world.before","type":"codeVoice"},{"type":"text","text":" — never gets to run, so it"},{"type":"text","text":" "},{"type":"text","text":"can’t refuse an action that has already happened. Calling it from an "},{"code":"after","type":"codeVoice"},{"type":"text","text":"\/each-turn"},{"type":"text","text":" "},{"type":"text","text":"rule, or calling it twice, is a programmer error and traps with a clear"},{"type":"text","text":" "},{"type":"text","text":"message rather than silently double-running the default action."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["mailbox.before(.open) {","    try proceed()                    \/\/ built-in open runs here","    say(\"A city map is tucked inside the lid.\")","}"]},{"inlineContent":[{"type":"text","text":"If the default action throws (e.g. a built-in "},{"code":"open","type":"codeVoice"},{"type":"text","text":" refuses because the"},{"type":"text","text":" "},{"type":"text","text":"item is locked), that "},{"code":"TurnInterrupt","type":"codeVoice"},{"type":"text","text":" propagates out of "},{"code":"proceed()","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"exactly as it would have out of the pipeline’s own stage 4."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnusto\/proceed()"]}],"references":{"doc://Gnusto/documentation/Gnusto/say(_:from:)-29lpm":{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/say(_:from:)-29lpm","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"say","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Item","preciseId