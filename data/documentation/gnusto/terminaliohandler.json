o/TerminalIOHandler/updateCompletions(_:)":{"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"updateCompletions"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"CompletionCandidates","preciseIdentifier":"s:6Gnusto20CompletionCandidatesV"},{"kind":"text","text":")"}],"kind":"symbol","url":"\/documentation\/gnusto\/terminaliohandler\/updatecompletions(_:)","title":"updateCompletions(_:)","abstract":[{"type":"text","text":"Stores the completion candidates the engine computed for the next input"},{"type":"text","text":" "},{"type":"text","text":"line. Tab uses them; no repaint is needed."}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TerminalIOHandler\/updateCompletions(_:)"},"doc://Gnusto/documentation/Gnusto/ConsoleIOHandler":{"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ConsoleIOHandler"}],"navigatorTitle":[{"kind":"identifier","text":"ConsoleIOHandler"}],"kind":"symbol","url":"\/documentation\/gnusto\/consoleiohandler","title":"ConsoleIOHandler","abstract":[{"type":"text","text":"Plain terminal IO."}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/ConsoleIOHandler"},"doc://Gnusto/documentation/Gnusto/ScriptedIOHandler":{"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScriptedIOHandler"}],"navigatorTitle":[{"kind":"identifier","text":"ScriptedIOHandler"}],"kind":"symbol","url":"\/documentation\/gnusto\/scriptediohandler","title":"ScriptedIOHandler","abstract":[{"type":"text","text":"Feeds a fixed list of commands and records everything into a transcript —"},{"type":"text","text":" "},{"type":"text","text":"for tests and automated playthroughs. Ships in the library because game"},{"type":"text","text":" "},{"type":"text","text":"authors want transcript tests too."}],"identifier":"doc:\/