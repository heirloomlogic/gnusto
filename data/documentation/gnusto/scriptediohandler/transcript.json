gine assembles it after","type":"text"},{"text":" ","type":"text"},{"text":"each turn and pushes it to the IO handler, because the synchronous line","type":"text"},{"text":" ","type":"text"},{"text":"editor can’t reach back into the ","type":"text"},{"code":"GameWorld","type":"codeVoice"},{"text":" actor mid-read.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"CompletionCandidates","kind":"identifier"}]},"doc://Gnusto/documentation/Gnusto/ConsoleIOHandler":{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/ConsoleIOHandler","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ConsoleIOHandler","kind":"identifier"}],"abstract":[{"text":"Plain terminal IO.","type":"text"}],"type":"topic","title":"ConsoleIOHandler","url":"\/documentation\/gnusto\/consoleiohandler","role":"symbol","navigatorTitle":[{"text":"ConsoleIOHandler","kind":"identifier"}],"kind":"symbol"},"doc://Gnusto/documentation/Gnusto/TerminalIOHandler":{"url":"\/documentation\/gnusto\/terminaliohandler","kind":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TerminalIOHandler","title":"TerminalIOHandler","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TerminalIOHandler","kind":"identifier"}],"abstract":[{"text":"A full-screen, Infocom-style terminal front end: a fixed status bar (room,","type":"text"},{"text":" ","type":"text"},{"text":"score, turns) above a story window that re-wraps its entire transcript to","type":"text"},{"text":" ","type":"text"},{"text":"the window width — so resizing the terminal reflows the text — with its own","type":"text"},{"text":" ","type":"text"},{"text":"line editor (arrow keys, history) and PageUp\/PageDown scrollback.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"TerminalIOHandler","kind":"identifier"}]},"doc://Gnusto/documentation/Gnusto/GameStatus":{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameStatus","fragments":[{"text":"enum","kind":"