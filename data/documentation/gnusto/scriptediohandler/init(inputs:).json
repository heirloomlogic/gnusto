usto","url":"\/documentation\/gnusto","title":"Gnusto","role":"collection"},"doc://Gnusto/documentation/Gnusto/ScriptedIOHandler/init(inputs:)":{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/ScriptedIOHandler\/init(inputs:)","kind":"symbol","role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"inputs"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto5InputO","text":"Input"},{"kind":"text","text":"])"}],"type":"topic","abstract":[{"text":"Creates a handler that will feed the given input units in order — use","type":"text"},{"text":" ","type":"text"},{"text":"this to script a front-end ","type":"text"},{"type":"codeVoice","code":".quit"},{"text":" (Ctrl-C) alongside typed lines.","type":"text"}],"title":"init(inputs:)","url":"\/documentation\/gnusto\/scriptediohandler\/init(inputs:)"},"doc://Gnusto/documentation/Gnusto/ScriptedIOHandler":{"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScriptedIOHandler"}],"navigatorTitle":[{"kind":"identifier","text":"ScriptedIOHandler"}],"kind":"symbol","url":"\/documentation\/gnusto\/scriptediohandler","title":"ScriptedIOHandler","abstract":[{"type":"text","text":"Feeds a fixed list of commands and records everything into a transcript —"},{"type":"text","text":" "},{"type":"text","text":"for tests and automated playthroughs. Ships in the library because game"},{"type":"text","text":" "},{"type":"text","text":"authors want transcript tests too."}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/ScriptedIOHandler"},"doc://Gnusto/documentation/Gnusto/IOHandler":{"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"IOHandler"}],"navigatorTitle":[{"kind":"identifier","text":"IOHandler"}],"kind":"symbol","url":"\/documentation\/gnusto\/iohandler","title":