":"text"},{"text":" ","type":"text"},{"text":"which means having something to hand it. A subject that cannot supply its","type":"text"},{"text":" ","type":"text"},{"text":"own examples cannot be swept, so the compiler says so where the subject is","type":"text"},{"text":" ","type":"text"},{"text":"written, rather than a runtime fallback saying it after the line has shipped","type":"text"},{"text":" ","type":"text"},{"text":"unchecked.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Two protocols refine it, on independent axes, and together they say how a"},{"type":"text","text":" "},{"type":"text","text":"line about each subject may be "},{"type":"emphasis","inlineContent":[{"text":"written","type":"text"}]},{"type":"text","text":": "},{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/DroppableSubject","isActive":true},{"type":"text","text":" is a fixed"},{"type":"text","text":" "},{"type":"text","text":"sentence, "},{"type":"reference","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/NamedSubject","isActive":true},{"type":"text","text":" is a closure over the subject."}],"type":"paragraph"}]}],"metadata":{"navigatorTitle":[{"text":"LineSubject","kind":"identifier"}],"title":"LineSubject","roleHeading":"Protocol","modules":[{"name":"Gnusto"}],"symbolKind":"protocol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LineSubject","kind":"identifier"}],"role":"symbol","externalID":"s:6Gnusto11LineSubjectP"},"topicSections":[{"title":"Type Properties","identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/LineSubject\/samples"],"generated":true,"anchor":"Type-Properties"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"What a ","type":"text"},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Line","isActive":true,"type":"reference"},{"text":" can be about.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/docum