text","text":" "},{"kind":"identifier","text":"Game"}],"kind":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Game"},"doc://Gnusto/documentation/Gnusto/ConsoleIOHandler":{"title":"ConsoleIOHandler","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/ConsoleIOHandler","abstract":[{"text":"Plain terminal IO.","type":"text"}],"navigatorTitle":[{"text":"ConsoleIOHandler","kind":"identifier"}],"role":"symbol","url":"\/documentation\/gnusto\/consoleiohandler","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ConsoleIOHandler","kind":"identifier"}],"kind":"symbol","type":"topic"},"doc://Gnusto/documentation/Gnusto/REPL":{"kind":"symbol","abstract":[{"text":"The outer loop: prompt → parse → perform → print, until the game ends or","type":"text"},{"text":" ","type":"text"},{"text":"input runs out. Holds the only ","type":"text"},{"code":"await","type":"codeVoice"},{"text":" in a Gnusto game.","type":"text"}],"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/REPL","title":"REPL","navigatorTitle":[{"text":"REPL","kind":"identifier"}],"url":"\/documentation\/gnusto\/repl","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"REPL","kind":"identifier"}]},"doc://Gnusto/documentation/Gnusto/Location/south(_:)":{"abstract":[{"text":"An exit leading south to ","type":"text"},{"code":"to","type":"codeVoice"},{"text":".","type":"text"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Location\/south(_:)","title":"south(_:)","role":"symbol","url":"\/documentation\/gnusto\/location\/south(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"south","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Location","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto8LocationV"},{"text":") -> ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto8MapEntryV","text":"MapEntry"}],"type":"topic","kind":"symbol"},"doc://Gnusto/documentation/Gnusto/adjectives(_:)":{"role":"symbol","abstract":[{"text":"Additional words the parser accepts before the item’s noun.","type":"text"}],"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/adjectives(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"adjectives"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"...) -> "},{"kind":"typeIdentifier","text":"ItemTrait","preciseIdentifier":"s:6Gnusto9ItemTraitV"}],"url":"\/documentation\/gnusto\/adjectives(_:)","title":"adjectives(_:)","kind":"symbol"},"doc://Gnusto/documentation/Gnusto/say(_:)":{"role":"symbol","type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/say(_:)","title":"say(_:)","abstract":[{"type":"text","text":"Prints a message as part of the turn’s output."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"say","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":")","kind":"text"}],"kind":"symbol","url":"\/documentation\/gnusto\/say(_:)"},"doc://Gnusto/documentation/Gnusto/AnatomyOfAGame":{"role":"article","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/AnatomyOfAGame","abstract":[{"type":"text","text":"How a single Swift type becomes a world the engine can run."}],"kind":"article","type":"topic","title":"Anatomy of a Game","url":"\/documentation\/gnusto\/anatomyofagame"},"doc://Gnusto/documentation/Gnusto/AddingCustomVerbs":{"kind":"article","url":"\/documentation\/gnusto\/addingcustomverbs","abstract":[{"text":"Teach the parser words the built-in table doesn’t know.","type":"text"}],"role":"article","title":"Adding Custom Verbs","type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/AddingCustomVerbs"},"doc://Gnusto/documentation/Gnusto/refuse(_:)":{"role":"symbol","type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/refuse(_:)","title":"refuse(_:)","abstract":[{"type":"text","text":"Blocks the current action with a complaint. The default action and any"},{"type":"text","text":" "},{"type":"text","text":"remaining "},{"type":"codeVoice","code":"before"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"after"},{"type":"text","text":" rules are skipped; world time still passes."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"refuse","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Never","kind":"typeIdentifier","preciseIdentifier":"s:s5NeverO"}],"kind":"symbol","url":"\/documentation\/gnusto\/refuse(_:)"},"doc://Gnusto/documentation/Gnusto/WritingRules":{"role":"article","type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/WritingRules","title":"Writing Rules","abstract":[{"type":"text","text":"Attach game logic to items, locations, and the world."}],"kind":"article","url":"\/documentation\/gnusto\/writingrules"},"doc://Gnusto/documentation/Gnusto/BootstrapError":{"role":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/BootstrapError","abstract":[{"type":"text","text":"All problems with a game definition, reported at once."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BootstrapError","kind":"identifier"}],"navigatorTitle":[{"text":"BootstrapError","kind":"identifier"}],"kind":"symbol","type":"topic","title":"BootstrapError","url":"\/documentation\/gnusto\/bootstraperror"},"doc://Gnusto/documentation/Gnusto/Location":{"kind":"symbol","type":"topic","abstract":[{"text":"A place in the world.","type":"text"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Location","title":"Location","navigatorTitle":[{"kind":"identifier","text":"Location"}],"url":"\/documentation\/gnusto\/location","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Location","kind":"identifier"}]},"doc://Gnusto/documentation/Gnusto":{"role":"collection","abstract":[{"type":"text","text":"An engine for writing interactive fiction in Swift."}],"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto","kind":"symbol","title":"Gnusto","url":"\/documentation\/gnusto"},"doc://Gnusto/documentation/Gnusto/TestingYourGame":{"role":"article","type":"topic","title":"Testing Your Game","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TestingYourGame","abstract":[{"text":"Play scripted sessions in your test suite and assert on the transcript.","type":"text"}],"kind":"article","url":"\/documentation\/gnusto\/testingyourgame"},"doc://Gnusto/documentation/Gnusto/Item":{"role":"symbol","navigatorTitle":[{"text":"Item","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Item","title":"Item","abstract":[{"type":"text","text":"A thing in the world."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Item","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/gnusto\/item"},"doc://Gnusto/documentation/Gnusto/IOHandler":{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/IOHandler","abstract":[{"text":"Where the game’s text goes and player input comes from. Synchronous by","type":"text"},{"text":" ","type":"text"},{"text":"design: a blocking console read is fine for a CLI; an async variant can","type":"text"},{"text":" ","type":"text"},{"text":"be added later without breaking this protocol’s clients.","type":"text"}],"title":"IOHandler","navigatorTitle":[{"kind":"identifier","text":"IOHandler"}],"role":"symbol","url":"\/documentation\/gnusto\/iohandler","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IOHandler","kind":"identifier"}],"type":"topic","kind":"symbol"},"doc://Gnusto/documentation/Gnusto/CustomStateAndTraits":{"abstract":[{"text":"Carry your own data on entities and in globals, alongside the engine’s closed core.","type":"text"}],"title":"Custom State and Traits","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/CustomStateAndTraits","role":"article","url":"\/documentation\/gnusto\/customstateandtraits","kind":"article","type":"topic"}}}