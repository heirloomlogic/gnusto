"inlineContent":[{"type":"text","text":"It gates no movement and opens nothing. What it changes is what a rule can"},{"type":"text","text":" "},{"type":"text","text":"ask: "},{"type":"codeVoice","code":"object.isDoor"},{"type":"text","text":" is how “knock on the front door” tells itself from"},{"type":"text","text":" "},{"type":"text","text":"“knock on the bench” without the game listing its doors by hand."}]}]}],"variants":[{"paths":["\/documentation\/gnusto\/door"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Gnusto\/documentation\/Gnusto\/door","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"The item is a door — something a verb may reasonably treat as a way through"},{"type":"text","text":" "},{"type":"text","text":"rather than as a thing."}],"kind":"symbol","references":{"doc://Gnusto/documentation/Gnusto/ItemTrait":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ItemTrait","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"ItemTrait","kind":"identifier"}],"url":"\/documentation\/gnusto\/itemtrait","abstract":[{"text":"A single fact about an item, stated inside an ","type":"text"},{"code":"Item { … }","type":"codeVoice"},{"text":" block.","type":"text"}],"title":"ItemTrait","role":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/ItemTrait","kind":"symbol"},"doc://Gnusto/documentation/Gnusto/Item/isDoor":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isDoor"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"url":"\/documentation\/gnusto\/item\/isdoor","type":"topic","abstract":[{"text":"True if this item is a door — the front door, the trap door, the grating.","type":"text"}],"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Item\/isDoor","title":"isDoor","kind":"symbol","role":"symbol"},"doc://Gnusto/documentation/Gnusto/ContainersDoorsAndLocks":{"role