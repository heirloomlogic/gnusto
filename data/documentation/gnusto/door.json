Gnusto\/Item\/isDoor"},{"type":"text","text":". The trait is for the door that leads"},{"text":" ","type":"text"},{"text":"nowhere: one boarded shut, one painted on, one whose far side the map does","type":"text"},{"text":" ","type":"text"},{"text":"not model. Those are still doors to the player, and to any verb that asks.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"It gates no movement and opens nothing. What it changes is what a rule can","type":"text"},{"text":" ","type":"text"},{"text":"ask: ","type":"text"},{"code":"object.isDoor","type":"codeVoice"},{"type":"text","text":" is how “knock on the front door” tells itself from"},{"type":"text","text":" "},{"text":"“knock on the bench” without the game listing its doors by hand.","type":"text"}]}],"kind":"content"}],"references":{"doc://Gnusto/documentation/Gnusto":{"url":"\/documentation\/gnusto","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto","title":"Gnusto","abstract":[{"text":"A Swift engine for writing parser-driven interactive fiction — text adventures in the tradition of Zork and Infocom’s ZIL.","type":"text"}],"role":"collection","kind":"symbol","type":"topic"},"doc://Gnusto/documentation/Gnusto/ItemTrait":{"url":"\/documentation\/gnusto\/itemtrait","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/ItemTrait","role":"symbol","abstract":[{"type":"text","text":"A single fact about an item, stated inside an "},{"type":"codeVoice","code":"Item { … }"},{"type":"text","text":" block."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"ItemTrait"}],"kind":"symbol","title":"ItemTrait","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ItemTrait"}]},"doc://Gnusto/documentation/Gnusto/door":{"type":"topic","title":"door","kind":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/door","url":"\/documentation\/gnusto\/door","abstract":[{"type":"text","text":"The item is a door — something a verb m