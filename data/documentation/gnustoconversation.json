{"hierarchy":{"paths":[[]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The engine ships around fifty stub verbs so that no word a player tries in their"},{"type":"text","text":" "},{"type":"text","text":"first five minutes comes back as "},{"type":"emphasis","inlineContent":[{"text":"I don’t know the word","type":"text"}]},{"type":"text","text":". "},{"type":"codeVoice","code":"ask"},{"type":"text","text":", "},{"type":"codeVoice","code":"tell"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"show"},{"type":"text","text":" are deliberately not among them. A stub is a word with one line of stock"},{"type":"text","text":" "},{"type":"text","text":"prose and no mechanic behind it, and there is no line that answers "},{"type":"codeVoice","code":"ask the butler about the murder"},{"type":"text","text":" — the verb wants a topic slot, somebody to ask, and a"},{"type":"text","text":" "},{"type":"text","text":"table to look the subject up in. So the three words live here instead, with the"},{"type":"text","text":" "},{"type":"text","text":"table behind them, and a bare "},{"type":"codeVoice","code":"hello"},{"type":"text","text":" comes along with them. "},{"type":"codeVoice","code":"talk to"},{"type":"text","text":" is the engine’s own stub verb, promoted here to open a conversation."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"What the table is for is the shape a mystery needs and nothing in the engine"},{"type":"text","text":" "},{"type":"text","text":"offered: an actor who says one thing until the player can prove otherwise, and"},{"type":"text","text":" "},{"type":"text","text":"something else afterwards. A row can require a fact, be retired by one, teach"},{"type":"text","text":" "},{"type":"text","text":"one, or test what is true of the world at the moment the player raises the"},{"type":"text","text":" "},{"type":"text","text":"subject. The facts are saved, so what a suspect says is a function of how much"},{"type":"text","text":" "},{"type":"text","text":"of the case has already been made against him."}]},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/GnustoConversation\/documentation\/GnustoConversation\/Conversation"},{"type":"text","text":" is a "},{"type":"codeVoice","code":"GameContent"},{"type":"text","text":" bundle rather than a "},{"type":"codeVoice","code":"GamePlugin"},{"type":"text","text":", because"},{"type":"text","text":" "},{"type":"text","text":"it owns state: the facts learned so far, and which rows each actor has already"},{"type":"text","text":" "},{"type":"text","text":"given in full. Both are globals namespaced under the bundle, so save, restore"},{"type":"text","text":" "},{"type":"text","text":"and UNDO carry them with no work from the host. Everything else is the host’s —"},{"type":"text","text":" "},{"type":"text","text":"the actors, the rows, and every word spoken, the five stock lines included,"},{"type":"text","text":" "},{"type":"text","text":"which arrive through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GnustoConversation\/documentation\/GnustoConversation\/Conversation\/init(text:)"},{"type":"text","text":"."}]},{"type":"codeListing","code":["import Gnusto","import GnustoConversation   \/\/ .product(name: \"GnustoConversation\", package: \"Gnusto\")","","struct Fulminate: Game {","    let talk = Conversation()","","    var content: GameContents { talk }        \/\/ the verbs, the facts, the heard set","","    var rules: Rules {","        talk.greeting(","            of: julian,","            again: \"\\\"Mm,\\\" he says, to the clamp.\",","            reply: \"\\\"You're early,\\\" he says to the bench. \\\"That's all right. Nothing's early enough.\\\"\")","","        talk.topics(","            of: julian,","            fallback: \"\\\"Later,\\\" he says, without turning round. \\\"You'll have all of it after six.\\\"\"","        ) {","            topic(","                \"delphine\", \"marsh\",","                reply: \"\"\"","                    \"Delphine keeps her own counsel.\" He tightens a clamp. \"It was the counsel I liked first.\"","                    \"\"\")","        }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/GnustoConversation\/documentation\/GnustoConversation\/Conversations"},{"type":"text","text":" is the full account: how a subject is matched, what gates a"},{"type":"text","text":" "},{"type":"text","text":"row, how an answer is made to land once, and a worked interrogation."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnustoconversation"]}],"kind":"symbol","metadata":{"role":"collection","modules":[{"name":"GnustoConversation"}],"title":"GnustoConversation","symbolKind":"module","roleHeading":"Framework","externalID":"GnustoConversation"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GnustoConversation\/documentation\/GnustoConversation"},"topicSections":[{"title":"The layer","identifiers":["doc:\/\/GnustoConversation\/documentation\/GnustoConversation\/Conversation"],"anchor":"The-layer"},{"title":"What the player knows","identifiers":["doc:\/\/GnustoConversation\/documentation\/GnustoConversation\/Fact"],"anchor":"What-the-player-knows"},{"title":"Topic rows","identifiers":["doc:\/\/GnustoConversation\/documentation\/GnustoConversation\/topic(_:only:knowing:unless:learning:when:again:id:file:declaredOn:reply:)","doc:\/\/GnustoConversation\/documentation\/GnustoConversation\/topic(_:only:knowing:unless:learning:when:again:id:file:declaredOn:perform:)","doc:\/\/GnustoConversation\/documentation\/GnustoConversation\/TopicEntry","doc:\/\/GnustoConversation\/documentation\/GnustoConversation\/TopicBuilder"],"anchor":"Topic-rows"},{"title":"Articles","identifiers":["doc:\/\/GnustoConversation\/documentation\/GnustoConversation\/Conversations"],"anchor":"Articles"},{"title":"Extended Modules","identifiers":["doc:\/\/GnustoConversation\/documentation\/GnustoConversation\/Gnusto"],"anchor":"Extended-Modules","generated":true}],"abstract":[{"type":"text","text":"Adds ASK, TELL and SHOW, the per-actor tables that answer them, and a saved"},{"type":"text","text":" "},{"type":"text","text":"record of what the player has worked out."}],"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://GnustoConversation/documentation/GnustoConversation/Conversation":{"kind":"symbol","identifier":"doc:\/\/GnustoConversation\/documentation\/GnustoConversation\/Conversation","role":"symbol","navigatorTitle":[{"text":"Conversation","kind":"identifier"}],"title":"Conversation","abstract":[{"type":"text","text":"A topic-driven conversation layer: per-actor tables of subjects the player"},{"type":"text","text":" "},{"type":"text","text":"can raise, gated on and feeding a saved set of "},{"type":"emphasis","inlineContent":[{"text":"facts","type":"text"}]},{"type":"text","text":" — what the player"},{"type":"text","text":" "},{"type":"text","text":"has worked out so far."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Conversation","kind":"identifier"}],"url":"\/documentation\/gnustoconversation\/conversation","type":"topic"},"doc://GnustoConversation/documentation/GnustoConversation":{"kind":"symbol","identifier":"doc:\/\/GnustoConversation\/documentation\/GnustoConversation","role":"collection","title":"GnustoConversation","abstract":[{"text":"Adds ASK, TELL and SHOW, the per-actor tables that answer them, and a saved","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"record of what the player has worked out."}],"url":"\/documentation\/gnustoconversation","type":"topic"},"doc://GnustoConversation/documentation/GnustoConversation/Conversation/init(te