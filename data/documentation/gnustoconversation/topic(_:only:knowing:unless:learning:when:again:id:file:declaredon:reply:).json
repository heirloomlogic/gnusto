nd":"keyword","text":"#fileID"},{"kind":"text","text":", "},{"kind":"externalParam","text":"declaredOn"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Su","text":"UInt"},{"kind":"text","text":" = "},{"kind":"keyword","text":"#line"},{"kind":"text","text":", "},{"kind":"externalParam","text":"reply"},{"kind":"text","text":" "},{"kind":"internalParam","text":"line"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:18GnustoConversation10TopicEntryV","identifier":"doc:\/\/GnustoConversation\/documentation\/GnustoConversation\/TopicEntry","text":"TopicEntry"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"keywords","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The subjects this row answers to. Each is normalized exactly"},{"type":"text","text":" "},{"type":"text","text":"as the parser normalizes player input, so articles, capitals and"},{"type":"text","text":" "},{"type":"text","text":"punctuation don’t matter. At least one must normalize to a non-empty"},{"type":"text","text":" "},{"type":"text","text":"word list, or this traps at declaration time — an empty keyword, or"},{"type":"text","text":" "},{"type":"text","text":"none at all, would build a row that could never match anything."}]}]},{"name":"intents","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Restrict the row to some of the table’s intents — "},{"type":"codeVoice","code":"only: [.tell]"},{"type":"text","text":" for something the player can volunteer but not ask about."},{"type":"text","text":" "},{"type":"text","text":"Defaults to the whole table."}]}]},{"name":"required","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A fact the player must already have learned. A row they"},{"type":"text","text":" "},{"type":"text","text":"haven’t earned is skipped, so a later row — or the fallback — answers"},{"type":"text","text":" "},{"type":"text","text":"instead."}]}]},{"name":"barred","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A fact that "},{"type":"emphasis","inlineContent":[{"text":"retires","type":"text"}]},{"type":"text","text":" this row once learned. This is the lie"},{"type":"text","text":" "},{"type":"text","text":"the actor stops telling."}]}]},{"name":"taught","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A fact the player learns by hearing this answer."}]}]},{"name":"condition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A live condition on the world, checked when the player asks."},{"type":"text","text":" "},{"type":"text","text":"Use this where "},{"type":"codeVoice","code":"knowing:"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"unless:"},{"type":"text","text":" don’t fit — those are for what the"},{"type":"text","text":" "},{"type":"text","text":"player has worked out, this is for what is currently true."}]}]},{"name":"again","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"What the actor says when this is raised a second time,"},{"type":"text","text":" "},{"type":"text","text":"overriding the table’s own "},{"type":"codeVoice","code":"again:"},{"type":"text","text":". See"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GnustoConversation\/documentation\/GnustoConversation\/Conversation\/topics(of:for:fallback:again:_:)"},{"type":"text","text":" for the rules."}]}]},{"name":"id","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A stable key for the heard set. Give one to a row whose keywords or"},{"type":"text","text":" "},{"type":"text","text":"gates you expect to edit after release, or to two rows that should"},{"type":"text","text":" "},{"type":"text","text":"retire together. Also the only way to name a row for"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GnustoConversation\/documentation\/GnustoConversation\/Conversation\/hasHeard(_:from:)"},{"type":"text","text":"."}]}]},{"name":"file","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The file this row was declared in, so the keyword trap names it."}]}]},{"name":"declaredOn","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The line this row was declared on, for the same reason."}]}]},{"name":"line","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"What the actor says. Ends the turn."}]}]}]},{"kind":"content","content":[{"text":"Return Value","anchor":"return-value","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The topic row."}],"type":"paragraph"}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Matching is by keyword rather than by whole phrase: a keyword matches when"},{"type":"text","text":" "},{"type":"text","text":"every word in it appears somewhere in what the player typed. So"},{"type":"text","text":" "},{"type":"codeVoice","code":"topic(\"murder\", \"body\")"},{"type":"text","text":" answers "},{"type":"codeVoice","code":"ask butler about the murder"},{"type":"text","text":", "},{"type":"codeVoice","code":"… about that dreadful murder"},{"type":"text","text":" and "},{"type":"codeVoice","code":"… about the body"},{"type":"text","text":" alike, while"},{"type":"text","text":" "},{"type":"codeVoice","code":"topic(\"murder weapon\")"},{"type":"text","text":" needs both words present."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnustoconversation\/topic(_:only:knowing:unless:learning:when:again:id:file:declaredon:reply:)"]}],"references":{"doc://GnustoConversation/documentation/GnustoConversation/TopicEntry":{"url":"\/documentation\/gnustoconversation\/topicentry","ki