{"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GnustoConversation\/documentation\/GnustoConversation\/Conversation\/topics(of:for:fallback:again:_:)"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnustoconversation\/conversation\/topics(of:for:fallback:again:_:)"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"text":"RuleBuilder","preciseIdentifier":"s:6Gnusto11RuleBuildera","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/RuleBuilder","kind":"attribute"},{"text":" ","kind":"text"},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"topics"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":" "},{"text":"actor","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Actor","preciseIdentifier":"s:6Gnusto5ActorV","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Actor","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"for","kind":"externalParam"},{"kind":"text","text":" "},{"kind":"internalParam","text":"intents"},{"kind":"text","text":": ["},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Intent","kind":"typeIdentifier","text":"Intent","preciseIdentifier":"s:6Gnusto6IntentV"},{"kind":"text","text":"] = [.ask, .tell], "},{"kind":"externalParam","text":"fallback"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"again"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"? = nil, "},{"kind":"attribute","text":"@"},{"identifier":"doc:\/\/GnustoConversation\/documentation\/GnustoConversation\/TopicBuilder","kind":"attribute","text":"TopicBuilder","preciseIdentifier":"s:18GnustoConversation12TopicBuildera"},{"kind":"text","text":" "},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"entries"},{"kind":"text","text":": () -> ["},{"identifier":"doc:\/\/GnustoConversation\/documentation\/GnustoConversation\/TopicEntry","kind":"typeIdentifier","text":"TopicEntry","preciseIdentifier":"s:18GnustoConversation10TopicEntryV"},{"kind":"text","text":"]) -> "},{"identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Rules","kind":"typeIdentifier","text":"Rules","preciseIdentifier":"s:6Gnusto5RulesV"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"actor","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Whose table this is. Rows fire only when this actor is the"},{"type":"text","text":" "},{"type":"text","text":"one being addressed."}]}]},{"name":"intents","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The conversation intents the table answers. Defaults to"},{"type":"text","text":" "},{"type":"text","text":"ASK and TELL; pass a game’s own verb to reuse one table for it."}]}]},{"name":"fallback","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"What the actor says when nothing matches. Pass "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" (the"},{"type":"text","text":" "},{"type":"text","text":"default) to stay quiet and let the next rule — another table, a"},{"type":"text","text":" "},{"code":"GnustoActors","type":"codeVoice"},{"type":"text","text":" reaction, or this layer’s own default — answer"},{"type":"text","text":" "},{"type":"text","text":"instead."}]}]},{"name":"again","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"What the actor says when the player raises a subject they"},{"type":"text","text":" "},{"type":"text","text":"have already been given in full. Opt-in and per-row overridable:"},{"type":"text","text":" "},{"type":"text","text":"see the rules below."}]}]},{"name":"entries","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The rows, most specific first."}]}]}]},{"kind":"content","content":[{"type":"heading","text":"Return Value","level":2,"anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The before-phase rules, for the host’s "},{"type":"codeVoice","code":"rules"},{"type":"text","text":" block."}]}]},{"kind":"mentions","mentions":["doc:\/\/GnustoConversation\/documentation\/GnustoConversation\/Conversations"]},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"One rule is registered per intent, each scanning the whole table. That"},{"type":"text","text":" "},{"type":"text","text":"is what makes "},{"type":"codeVoice","code":"fallback:"},{"type":"text","text":" expressible at all — a per-row rule cannot"},{"type":"text","text":" "},{"type":"text","text":"know that no later row matched."}]},{"type":"heading","text":"Saying it once","level":2,"anchor":"Saying-it-once"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A row with no "},{"type":"codeVoice","code":"again:"},{"type":"text","text":" — neither its own nor the table’s — repeats"},{"type":"text","text":" "},{"type":"text","text":"forever and records nothing, exactly as before this parameter existed."},{"type":"text","text":" "},{"type":"text","text":"A game that never writes "},{"type":"codeVoice","code":"again:"},{"type":"text","text":" produces byte-identical saves."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The table’s "},{"type":"codeVoice","code":"again:"},{"type":"text","text":" retires "},{"type":"strong","inlineContent":[{"code":"reply:","type":"codeVoice"},{"type":"text","text":" rows only"}]},{"type":"text","text":". A "},{"type":"codeVoice","code":"perform:"},{"type":"text","text":" row"},{"type":"text","text":" "},{"type":"text","text":"opts in by naming a line of its own, because its body can move the"},{"type":"text","text":" "},{"type":"text","text":"world and adding a default to a table must never change what the world"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"does"}]},{"type":"text","text":", only what is "},{"type":"emphasis","inlineContent":[{"type":"text","text":"said"}]},{"type":"text","text":". A "},{"type":"codeVoice","code":"perform:"},{"type":"text","text":" row that does name one runs"},{"type":"text","text":" "},{"type":"text","text":"its body once; the repeat is the line alone."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A row that has been heard still "},{"type":"strong","inlineContent":[{"type":"text","text":"matches"}]},{"type":"text","text":" and still owns its keyword."},{"type":"text","text":" "},{"type":"text","text":"It never falls through to a later row or to "},{"type":"codeVoice","code":"fallback:"},{"type":"text","text":" — an actor who"},{"type":"text","text":" "},{"type":"text","text":"demonstrably has an answer should not sound blank about the subject."},{"type":"text","text":" "},{"type":"text","text":"Gating composes for free: a lie and the confession that replaces it are"},{"type":"text","text":" "},{"type":"text","text":"different rows with different keys, tracked apart."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A repeat costs a turn, like any other answer."}]}]}],"hierarchy":{"paths":[["doc:\/\/GnustoConversation\/documentation\/GnustoConversation","doc:\/\/GnustoConversation\/documentation\/GnustoConversation\/Conversation"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"metadata":{"roleHeading":"Instance Method","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"topics"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto5ActorV","text":"Actor"},{"kind":"text","text":", "},{"kind":"externalParam","