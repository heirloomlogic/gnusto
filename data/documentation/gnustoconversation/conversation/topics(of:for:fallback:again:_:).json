{"sections":[],"abstract":[{"type":"text","text":"An actor’s topic table: what they will say about what, and what they"},{"type":"text","text":" "},{"type":"text","text":"say about everything else."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GnustoConversation\/documentation\/GnustoConversation","doc:\/\/GnustoConversation\/documentation\/GnustoConversation\/Conversation"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:6Gnusto11RuleBuildera","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/RuleBuilder","text":"RuleBuilder","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"topics","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"actor","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6Gnusto5ActorV","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Actor","text":"Actor","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"for","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"intents","kind":"internalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:6Gnusto6IntentV","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Intent","text":"Intent","kind":"typeIdentifier"},{"text":"] = [.ask, .tell], ","kind":"text"},{"text":"fallback","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"again","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:18GnustoConversation12TopicBuildera","identifier":"doc:\/\/GnustoConversation\/documentation\/GnustoConversation\/TopicBuilder","text":"TopicBuilder","kind":"attribute"},{"text":" ","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"entries","kind":"internalParam"},{"text":": () -> [","kind":"text"},{"preciseIdentifier":"s:18GnustoConversation10TopicEntryV","identifier":"doc:\/\/GnustoConversation\/documentation\/GnustoConversation\/TopicEntry","text":"TopicEntry","kind":"typeIdentifier"},{"text":"]) -> ","kind":"text"},{"preciseIdentifier":"s:6Gnusto5RulesV","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Rules","text":"Rules","kind":"typeIdentifier"}],"languages":["swift"]}]},{"parameters":[{"name":"actor","content":[{"inlineContent":[{"type":"text","text":"Whose table this is. Rows fire only when this actor is the"},{"type":"text","text":" "},{"type":"text","text":"one being addressed."}],"type":"paragraph"}]},{"name":"intents","content":[{"inlineContent":[{"type":"text","text":"The conversation intents the table answers. Defaults to"},{"type":"text","text":" "},{"type":"text","text":"ASK and TELL; pass a game’s own verb to reuse one table for it."}],"type":"paragraph"}]},{"name":"fallback","content":[{"inlineContent":[{"type":"text","text":"What the actor says when nothing matches. Pass "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" (the"},{"type":"text","text":" "},{"type":"text","text":"default) to stay quiet and let the next rule — another table, a"},{"type":"text","text":" "},{"code":"GnustoActors","type":"codeVoice"},{"type":"text","text":" reaction, or this layer’s own default — answer"},{"type":"text","text":" "},{"type":"text","text":"instead."}],"type":"paragraph"}]},{"name":"again","content":[{"inlineContent":[{"type":"text","text":"What the actor says when the player raises a subject they"},{"type":"text","text":" "},{"type":"text","text":"have already been given in full. Opt-in and per-row overridable:"},{"type":"text","text":" "},{"type":"text","text":"see the rules below."}],"type":"paragraph"}]},{"name":"entries","content":[{"inlineContent":[{"type":"text","text":"The rows, most specific first."}],"type":"paragraph"}]}],"kind":"parameters"},{"kind":"content","content":[{"text":"Return Value","anchor":"return-value","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The before-phase rules, for the host’s "},{"code":"rules","type":"codeVoice"},{"type":"text","text":" block."}]}]},{"mentions":["doc:\/\/GnustoConversation\/documentation\/GnustoConversation\/Conversations"],"kind":"mentions"},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"One rule is registered per intent, each scanning the whole table. That"},{"type":"text","text":" "},{"type":"text","text":"is what makes "},{"code":"fallback:","type":"codeVoice"},{"type":"text","text":" expressible at all — a per-row rule cannot"},{"type":"text","text":" "},{"type":"text","text":"know that no later row matched."}]},{"text":"Saying it once","anchor":"Saying-it-once","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A row with no "},{"code":"again:","type":"codeVoice"},{"type":"text","text":" — neither its own nor the table’s — repeats"},{"type":"text","text":" "},{"type":"text","text":"forever and records nothing, exactly as before this parameter existed."},{"type":"text","text":" "},{"type":"text","text":"A game that never writes "},{"code":"again:","type":"codeVoice"},{"type":"text","text":" produces byte-identical saves."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The table’s "},{"code":"again:","type":"codeVoice"},{"type":"text","text":" retires "},{"inlineContent":[{"code":"reply:","type":"codeVoice"},{"type":"text","text":" rows only"}],"type":"strong"},{"type":"text","text":". A "},{"code":"perform:","type":"codeVoice"},{"type":"text","text":" row"},{"type":"text","text":" "},{"type":"text","text":"opts in by naming a line of its own, because its body can move the"},{"type":"text","text":" "},{"type":"text","text":"world and adding a default to a table must never change what the world"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"does"}],"type":"emphasis"},{"type":"text","text":", only what is "},{"inlineContent":[{"type":"text","text":"said"}],"type":"emphasis"},{"type":"text","text":". A "},{"code":"perform:","type":"codeVoice"},{"type":"text","text":" row that does name one runs"},{"type":"text","text":" "},{"type":"text","text":"its body once; the repeat is the line alone."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A row that has been heard still "},{"inlineContent":[{"type":"text","text":"matches"}],"type":"strong"},{"type":"text","text":" and still owns its keyword."},{"type":"text","text":" "},{"type":"text","text":"It never falls through to a later row or to "},{"code":"fallback:","type":"codeVoice"},{"type":"text","text":" — an actor who"},{"type":"text","text":" "},{"type":"text","text":"demonstrably has an answer should not sound blank about the subject."},{"type":"text","text":" "},{"type":"text","text":"Gating composes for free: a lie and the confession that replaces it are"},{"type":"text","text":" "},{"type":"text","text":"different rows with different keys, tracked apart."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A repeat costs a turn, like any other answer."}]}]}],"metadata":{"modules":[{"name":"GnustoConversation"}],"role":"symbol","title":"topics(of:for:fallback:again:_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"topics","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Actor","preciseIdentifier":"s:6Gnusto5ActorV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:6Gnusto6IntentV","text":"Intent","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"fallback","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"again","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?, () -> [","kind":"text"},{"text":"TopicEntry","preciseIdentifier":"s:18GnustoConversation10TopicEntryV","kind":"typeIdentifier"},{"text":"]) -> ","kind":"text"},{"text":"Rules","preciseIdentifier":"s:6Gnusto5RulesV","kind":"typeIdentifier"}],"symbolKind":"method","roleHeading":"Instance Method","externalID":"s:18GnustoConversation0B0V6topics2of3for8fallback5again_0A05RulesVAI5ActorV_SayAI6IntentVGSSSgAQSayAA10TopicEntryVGyXEtF"},"variants":[{"paths":["\/documentation\/gnustoconversation\/conversation\/topics(of:for:fallback:again:_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GnustoConversation\/documentation\/GnustoConversation\/Conversation\/topics(of:for:fallback:again:_:)"},"references":{"doc://Gnusto/documentation/Gnusto/RuleBuilder":{"type":"topic","title":"RuleBuilder","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/RuleBuilder","abstract":[{"text":"The result builder for ","type":"text"},{"type":"codeVoice","code":"rules"},{"text":" blocks.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"RuleBuilder","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RuleBuilder","kind":"identifier"}],"url":"\/documentation\/gnusto\/rulebuilder"},"doc://Gnusto/documentation/Gnusto/Actor":{"abstract":[{"text":"A character in the world — a troll, a thief, a parrot.","type":"text"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Actor","kind":"identifier"}],"identifier":"doc:\/\/Gnusto\/doc