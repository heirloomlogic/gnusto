 and the facts that decide which"},{"type":"text","text":" "},{"type":"text","text":"answer comes out."}],"role":"article"},"doc://GnustoConversation/documentation/GnustoConversation":{"identifier":"doc:\/\/GnustoConversation\/documentation\/GnustoConversation","kind":"symbol","url":"\/documentation\/gnustoconversation","type":"topic","title":"GnustoConversation","abstract":[{"text":"Adds ASK, TELL and SHOW, the per-actor tables that answer them, and a saved","type":"text"},{"text":" ","type":"text"},{"text":"record of what the player has worked out.","type":"text"}],"role":"collection"},"doc://Gnusto/documentation/Gnusto/Intent":{"title":"Intent","kind":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Intent","role":"symbol","navigatorTitle":[{"text":"Intent","kind":"identifier"}],"abstract":[{"type":"text","text":"A canonical action the player can attempt. Games can mint their own —"},{"type":"text","text":" "},{"type":"text","text":"most readably with "},{"type":"codeVoice","code":"#verb"},{"type":"text","text":", or directly ("},{"type":"codeVoice","code":"Intent(\"ring\")"},{"type":"text","text":") — and register"},{"type":"text","text":" "},{"type":"text","text":"verbs and default behavior for them."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Intent","kind":"identifier"}],"url":"\/documentation\/gnusto\/intent","type":"topic"},"doc://Gnusto/documentation/Gnusto/Rules":{"title":"Rules","kind":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Rules","role":"symbol","navigatorTitle":[{"text":"Rules","kind":"identifier"}],"abstract":[{"type":"text","text":"The collected rules of a game, declared in one "},{"type":"codeVoice","code":"rules"},{"type":"text","text":" block. Large games"},{"type":"text","text":" "},{"type":"text","text":"compose: "},{"type":"codeVoice","code":"var rules: Rules { cloakRules; barRules }"},{"type":"text","text":"."}],"fragments":[{"text":"struct","kind":"keyword"},{"text