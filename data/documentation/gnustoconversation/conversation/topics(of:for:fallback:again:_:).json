xt"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"topics","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"actor","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6Gnusto5ActorV","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Actor","text":"Actor","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"for","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"intents","kind":"internalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:6Gnusto6IntentV","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Intent","text":"Intent","kind":"typeIdentifier"},{"text":"] = [.ask, .tell], ","kind":"text"},{"text":"fallback","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"again","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:18GnustoConversation12TopicBuildera","identifier":"doc:\/\/GnustoConversation\/documentation\/GnustoConversation\/TopicBuilder","text":"TopicBuilder","kind":"attribute"},{"text":" ","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"entries","kind":"internalParam"},{"text":": () -> [","kind":"text"},{"preciseIdentifier":"s:18GnustoConversation10TopicEntryV","identifier":"doc:\/\/GnustoConversation\/documentation\/GnustoConversation\/TopicEntry","text":"TopicEntry","kind":"typeIdentifier"},{"text":"]) -> ","kind":"text"},{"preciseIdentifier":"s:6Gnusto5RulesV","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Rules","text":"Rules","kind":"typeIdentifier"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"actor","content":[{"type":"paragraph","inlineContent":[{"text":"Whose table this is. Rows fire only when this actor is the","type":"text"},{"text":" ","type":"text"},{"text":"one being addressed.","type":"text"}]}]},{"name":"intents","content":[{"type":"paragraph","inlineContent":[{"text":"The conversation intents the table answers. Defaults to","type":"text"},{"text":" ","type":"text"},{"text":"ASK and TELL; pass a game’s own verb to reuse one table for it.","type":"text"}]}]},{"name":"fallback","content":[{"type":"paragraph","inlineContent":[{"text":"What the actor says when nothing matches. Pass ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" (the","type":"text"},{"text":" ","type":"text"},{"text":"default) to stay quiet and let the next rule — another table, a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"GnustoActors"},{"text":" reaction, or this layer’s own default — answer","type":"text"},{"text":" ","type":"text"},{"text":"instead.","type":"text"}]}]},{"name":"again","content":[{"type":"paragraph","inlineContent":[{"text":"What the actor says when the player raises a subject they","type":"text"},{"text":" ","type":"text"},{"text":"have already been given in full. Opt-in and per-row overridable:","type":"text"},{"text":" ","type":"text"},{"text":"see the rules below.","type":"text"}]}]},{"name":"entries","content":[{"type":"paragraph","inlineContent":[{"text":"The rows, most specific first.","type":"text"}]}]}]},{"content":[{"type":"heading","anchor":"return-value","text":"Return Value","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The before-phase rules, for the host’s "},{"type":"codeVoice","code":"rules"},{"type":"text","text":" block."}]}],"kind":"content"},{"kind":"mentions","mentions":["doc:\/\/GnustoConversation\/documentation\/GnustoConversation\/Conversations"]},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"One rule is registered per intent, each scanning the whole table. That"},{"type":"text","text":" "},{"type":"text","text":"is what makes "},{"type":"codeVoice","code":"fallback:"},{"type":"text","text":" expressible at all — a per-row rule cannot"},{"type":"text","text":" "},{"type":"text","text":"know that no later row matched."}]},{"type":"heading","anchor":"Saying-it-once","text":"Saying it once","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A row with no "},{"type":"codeVoice","code":"again:"},{"type":"text","text":" — neither its own nor the table’s — repeats"},{"type":"text","text":" "},{"type":"text","text":"forever and records nothing, exactly as before this parameter existed."},{"type":"text","text":" "},{"type":"text","text":"A game that never writes "},{"type":"codeVoice","code":"again:"},{"type":"text","text":" produces byte-identical saves."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The table’s "},{"type":"codeVoice","code":"again:"},{"type":"text","text":" retires "},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"reply:"},{"text":" rows only","type":"text"}]},{"type":"text","text":". A "},{"type":"codeVoice","code":"perform:"},{"type":"text","text":" row"},{"type":"text","text":" "},{"type":"text","text":"opts in by naming a line of its own, because its body can move the"},{"type":"text","text":" "},{"type":"text","text":"world and adding a default to a table must never change what the world"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"does","type":"text"}]},{"type":"text","text":", only what is "},{"type":"emphasis","inlineContent":[{"text":"said","type":"text"}]},{"type":"text","text":". A "},{"type":"codeVoice","code":"perform:"},{"type":"text","text":" row that does name one runs"},{"type":"text","text":" "},{"type":"text","text":"its body once; the repeat is the line alone."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A row that has been heard still "},{"type":"strong","inlineContent":[{"text":"matches","type":"text"}]},{"type":"text","text":" and still owns its keyword."},{"type":"text","text":" "},{"type":"text","text":"It never falls through to a later row or to "},{"type":"codeVoice","code":"fallback:"},{"type":"text","text":" — an actor who"},{"type":"text","text":" "},{"type":"text","text":"demonstrably has an answer should not sound blank about the subject."},{"type":"text","text":" "},{"type":"text","text":"Gating composes for free: a lie and the confession that replaces it are"},{"type":"text","text":" "},{"type":"text","text":"different rows with different keys, tracked apart."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A repeat costs a turn, like any other answer."}]}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/GnustoConversation\/documentation\/GnustoConversation","doc:\/\/GnustoConversation\/documentation\/GnustoConversation\/Conversation"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"paths":["\/documentation\/gnustoconversation\/conversation\/topics(of:for:fallback:again:_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://GnustoConversation/documentation/GnustoConversation/TopicEntry":{"url":"\/documentation\/gnustoconversation\/topicentry","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TopicEntry","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/GnustoConversation\/documentation\/GnustoConversation\/TopicEntry","navigatorTitle":[{"text":"TopicEntry","kind":"identifier"}],"abstract":[{"text":"One row of an actor’s topic table: what it answers to, what it needs, what","type":"text"},{"text":" ","type":"text"},{"text":"it teaches, and what the actor says.","type":"text"}],"type":"topic","title":"TopicEntry"},"doc://GnustoConversation/documentation/GnustoConversation/Conversations":{"kind":"article","identifier":"doc:\/\/GnustoConversation\/documentation\/GnustoConversation\/Conversa