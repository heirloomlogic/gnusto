c"},{"kind":"text","text":" "},{"kind":"identifier","text":"topics"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":" "},{"kind":"internalParam","text":"actor"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Actor","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Actor","preciseIdentifier":"s:6Gnusto5ActorV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"for"},{"kind":"text","text":" "},{"kind":"internalParam","text":"intents"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"Intent","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Intent","preciseIdentifier":"s:6Gnusto6IntentV"},{"kind":"text","text":"] = [.ask, .tell], "},{"kind":"externalParam","text":"fallback"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"again"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"? = nil, "},{"kind":"attribute","text":"@"},{"kind":"attribute","text":"TopicBuilder","identifier":"doc:\/\/GnustoConversation\/documentation\/GnustoConversation\/TopicBuilder","preciseIdentifier":"s:18GnustoConversation12TopicBuildera"},{"kind":"text","text":" "},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"entries"},{"kind":"text","text":": () -> ["},{"kind":"typeIdentifier","text":"TopicEntry","identifier":"doc:\/\/GnustoConversation\/documentation\/GnustoConversation\/TopicEntry","preciseIdentifier":"s:18GnustoConversation10TopicEntryV"},{"kind":"text","text":"]) -> "},{"kind":"typeIdentifier","text":"Rules","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Rules","preciseIdentifier":"s:6Gnusto5RulesV"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"actor","content":[{"inlineContent":[{"text":"Whose table this is. Rows fire only when this actor is the","type":"text"},{"text":" ","type":"text"},{"text":"one being addressed.","type":"text"}],"type":"paragraph"}]},{"name":"intents","content":[{"inlineContent":[{"text":"The conversation intents the table answers. Defaults to","type":"text"},{"text":" ","type":"text"},{"text":"ASK and TELL; pass a game’s own verb to reuse one table for it.","type":"text"}],"type":"paragraph"}]},{"name":"fallback","content":[{"inlineContent":[{"text":"What the actor says when nothing matches. Pass ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" (the","type":"text"},{"text":" ","type":"text"},{"text":"default) to stay quiet and let the next rule — another table, a","type":"text"},{"text":" ","type":"text"},{"code":"GnustoActors","type":"codeVoice"},{"text":" reaction, or this layer’s own default — answer","type":"text"},{"text":" ","type":"text"},{"text":"instead.","type":"text"}],"type":"paragraph"}]},{"name":"again","content":[{"inlineContent":[{"text":"What the actor says when the player raises a subject they","type":"text"},{"text":" ","type":"text"},{"text":"have already been given in full. Opt-in and per-row overridable:","type":"text"},{"text":" ","type":"text"},{"text":"see the rules below.","type":"text"}],"type":"paragraph"}]},{"name":"entries","content":[{"inlineContent":[{"text":"The rows, most specific first.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"text":"Return Value","type":"heading","level":2,"anchor":"return-value"},{"inlineContent":[{"type":"text","text":"The before-phase rules, for the host’s "},{"type":"codeVoice","code":"rules"},{"type":"text","text":" block."}],"type":"paragraph"}],"kind":"content"},{"mentions":["doc:\/\/GnustoConversation\/documentation\/GnustoConversation\/Conversations"],"kind":"mentions"},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"inlineContent":[{"type":"text","text":"One rule is registered per intent, each scanning the whole table. That"},{"type":"text","text":" "},{"type":"text","text":"is what makes "},{"type":"codeVoice","code":"fallback:"},{"type":"text","text":" expressible at all — a per-row rule cannot"},{"type":"text","text":" "},{"type":"text","text":"know that no later row matched."}],"type":"paragraph"},{"text":"Saying it once","type":"heading","level":2,"anchor":"Saying-it-once"},{"inlineContent":[{"type":"text","text":"A row with no "},{"type":"codeVoice","code":"again:"},{"type":"text","text":" — neither its own nor the table’s — repeats"},{"type":"text","text":" "},{"type":"text","text":"forever and records nothing, exactly as before this parameter existed."},{"type":"text","text":" "},{"type":"text","text":"A game that never writes "},{"type":"codeVoice","code":"again:"},{"type":"text","text":" produces byte-identical saves."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The table’s "},{"type":"codeVoice","code":"again:"},{"type":"text","text":" retires "},{"inlineContent":[{"code":"reply:","type":"codeVoice"},{"text":" rows only","type":"text"}],"type":"strong"},{"type":"text","text":". A "},{"type":"codeVoice","code":"perform:"},{"type":"text","text":" row"},{"type":"text","text":" "},{"type":"text","text":"opts in by naming a line of its own, because its body can move the"},{"type":"text","text":" "},{"type":"text","text":"world and adding a default to a table must never change what the world"},{"type":"text","text":" "},{"inlineContent":[{"text":"does","type":"text"}],"type":"emphasis"},{"type":"text","text":", only what is "},{"inlineContent":[{"text":"said","type":"text"}],"type":"emphasis"},{"type":"text","text":". A "},{"type":"codeVoice","code":"perform:"},{"type":"text","text":" row that does name one runs"},{"type":"text","text":" "},{"type":"text","text":"its body once; the repeat is the line alone."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A row that has been heard still "},{"inlineContent":[{"text":"matches","type":"text"}],"type":"strong"},{"type":"text","text":" and still owns its keyword."},{"type":"text","text":" "},{"type":"text","text":"It never falls through to a later row or to "},{"type":"codeVoice","code":"fallback:"},{"type":"text","text":" — an actor who"},{"type":"text","text":" "},{"type":"text","text":"demonstrably has an answer should not sound blank about the subject."},{"type":"text","text":" "},{"type":"text","text":"Gating composes for free: a lie and the confession that replaces it are"},{"type":"text","text":" "},{"type":"text","text":"different rows with different keys, tracked apart."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A repeat costs a turn, like any other answer."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"type":"text","text":"An actor’s topic table: what they will say about what, and what they"},{"type":"text","text":" "},{"type":"text","text":"say about everything else."}],"hierarchy":{"paths":[["doc:\/\/GnustoConversation\/documentation\/GnustoConversation","doc:\/\/GnustoConversation\/documentation\/GnustoConversation\/Conversation"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"references":{"doc://Gnusto/documentation/Gnusto/Actor":{"url":"\/documentation\/gnusto\/actor","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Actor"}],"title":"Actor","abstract":[{"text":"A character in the world — a troll, a thief, a parrot.","type":"text"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/Actor","navigatorTitle":[{"kind":"identifier","text":"Actor"}]},"doc://GnustoConversation/documentation/GnustoConversation/Conversation":{"kind":"symbol","type":"topic","title":"Conversation","abstract":[{"text":"A topic-driven conversation layer: per-actor tables of subjects the player","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"can raise, gated on and feeding a saved set of "},{"inlineContent":[{"text":"facts","t