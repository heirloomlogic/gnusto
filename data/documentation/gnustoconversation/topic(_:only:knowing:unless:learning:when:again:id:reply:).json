":"paragraph","inlineContent":[{"type":"text","text":"A fact that "},{"inlineContent":[{"type":"text","text":"retires"}],"type":"emphasis"},{"type":"text","text":" this row once learned. This is the lie"},{"type":"text","text":" "},{"type":"text","text":"the actor stops telling."}]}],"name":"barred"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A fact the player learns by hearing this answer."}]}],"name":"taught"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A live condition on the world, checked when the player asks."},{"type":"text","text":" "},{"type":"text","text":"Use this where "},{"type":"codeVoice","code":"knowing:"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"unless:"},{"type":"text","text":" don’t fit — those are for what the"},{"type":"text","text":" "},{"type":"text","text":"player has worked out, this is for what is currently true."}]}],"name":"condition"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"What the actor says when this is raised a second time,"},{"type":"text","text":" "},{"type":"text","text":"overriding the table’s own "},{"type":"codeVoice","code":"again:"},{"type":"text","text":". See"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/GnustoConversation\/documentation\/GnustoConversation\/Conversation\/topics(of:for:fallback:again:_:)","type":"reference"},{"type":"text","text":" for the rules."}]}],"name":"again"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A stable key for the heard set. Give one to a row whose keywords or"},{"type":"text","text":" "},{"type":"text","text":"gates you expect to edit after release, to a row on an actor who shares"},{"type":"text","text":" "},{"type":"text","text":"a display name with another, or to two rows that should retire"},{"type":"text","text":" "},{"type":"text","text":"together. Also the only way to name a row for"},{"type":"text","text":" "},{"isActive":true,"id