pe":"text","text":"every word in it appears somewhere in what the player typed. So"},{"type":"text","text":" "},{"code":"topic(\"murder\", \"body\")","type":"codeVoice"},{"type":"text","text":" answers "},{"code":"ask butler about the murder","type":"codeVoice"},{"type":"text","text":", "},{"code":"… about that dreadful murder","type":"codeVoice"},{"type":"text","text":" and "},{"code":"… about the body","type":"codeVoice"},{"type":"text","text":" alike, while"},{"type":"text","text":" "},{"code":"topic(\"murder weapon\")","type":"codeVoice"},{"type":"text","text":" needs both words present."}]}],"kind":"content"}],"references":{"doc://GnustoConversation/documentation/GnustoConversation/topic(_:only:knowing:unless:learning:when:again:id:reply:)":{"type":"topic","title":"topic(_:only:knowing:unless:learning:when:again:id:reply:)","identifier":"doc:\/\/GnustoConversation\/documentation\/GnustoConversation\/topic(_:only:knowing:unless:learning:when:again:id:reply:)","abstract":[{"type":"text","text":"A topic the actor answers with one line."}],"role":"symbol","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"topic","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"..., ","kind":"text"},{"text":"only","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Intent","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto6IntentV"},{"text":"]?, ","kind":"text"},{"text":"knowing","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Fact","kind":"typeIdentifier","preciseIdentifier":"s:18GnustoConversation4FactV"},{"text":"?, ","kind":"text"},{"text":"unless","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Fact","kind":"typeIdentifier","preciseIdentifier":"s:18GnustoConversation4FactV"},{"text":"?, ","kind":"text"},{"text":"learning","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Fact","kind":"typeIdentifier","prec