:"parameters","parameters":[{"name":"keywords","content":[{"inlineContent":[{"type":"text","text":"The subjects this row answers to. Each is normalized exactly"},{"type":"text","text":" "},{"type":"text","text":"as the parser normalizes player input, so articles, capitals and"},{"type":"text","text":" "},{"type":"text","text":"punctuation don’t matter."}],"type":"paragraph"}]},{"name":"intents","content":[{"inlineContent":[{"type":"text","text":"Restrict the row to some of the table’s intents — "},{"code":"only: [.tell]","type":"codeVoice"},{"type":"text","text":" for something the player can volunteer but not ask about."},{"type":"text","text":" "},{"type":"text","text":"Defaults to the whole table."}],"type":"paragraph"}]},{"name":"required","content":[{"inlineContent":[{"type":"text","text":"A fact the player must already have learned. A row they"},{"type":"text","text":" "},{"type":"text","text":"haven’t earned is skipped, so a later row — or the fallback — answers"},{"type":"text","text":" "},{"type":"text","text":"instead."}],"type":"paragraph"}]},{"name":"barred","content":[{"inlineContent":[{"type":"text","text":"A fact that "},{"type":"emphasis","inlineContent":[{"type":"text","text":"retires"}]},{"type":"text","text":" this row once learned. This is the lie"},{"type":"text","text":" "},{"type":"text","text":"the actor stops telling."}],"type":"paragraph"}]},{"name":"taught","content":[{"inlineContent":[{"type":"text","text":"A fact the player learns by hearing this answer."}],"type":"paragraph"}]},{"name":"condition","content":[{"inlineContent":[{"type":"text","text":"A live condition on the world, checked when the player asks."},{"type":"text","text":" "},{"type":"text","text":"Use this where "},{"code":"knowing:","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"unless:","type":"codeVoice"},{"type":"text","text":" don’t fit — those are for what the"},{"type":"text","text":" "},{"type":"text","text":"player has worked out, this is for what is curre