eciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":" = 2, ","kind":"text"},{"text":"when","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"condition","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"@escaping ","kind":"attribute"},{"text":"@Sendable","kind":"attribute"},{"text":" () -> ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":" = { true }, ","kind":"text"},{"text":"prose","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MeleeCombat","preciseIdentifier":"s:17GnustoMeleeCombat0bC0V","identifier":"doc:\/\/GnustoMeleeCombat\/documentation\/GnustoMeleeCombat\/MeleeCombat","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"AggressionProse","preciseIdentifier":"s:17GnustoMeleeCombat0bC0V15AggressionProseV","identifier":"doc:\/\/GnustoMeleeCombat\/documentation\/GnustoMeleeCombat\/MeleeCombat\/AggressionProse","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"TimedEvent","preciseIdentifier":"s:6Gnusto10TimedEventV","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TimedEvent","kind":"typeIdentifier"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"actor","content":[{"inlineContent":[{"text":"The villain who fights back each turn.","type":"text"}],"type":"paragraph"}]},{"name":"key","content":[{"type":"paragraph","inlineContent":[{"text":"Ledger key sharing this villain’s health, stun and engagement","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"type":"codeVoice","code":"villain"},{"type":"text","text":"."}]}]},{"name":"name","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Global timer name for the counter-attack daemon."}]}]},{"name":"strikesFirst","content":[{"type":"paragraph","inlineContent":[{"text":"The odds out of a hundred that he starts a fight on a","type":"text"},{"type":"text","text":" "},{"type":"text","text":"turn the player hasn’t. 100 fights on sight; 0 never starts one and"},{"type":"text","text":" "},{"type":"text","text":"only ever answers a blow."}]}]},{"name":"playerStrength","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The wound that kills the player. At the default of 2"},{"text":" ","type":"text"},{"text":"the first wound is survived and the second is fatal. The player’s","type":"text"},{"text":" ","type":"text"},{"text":"wounds are one count in this bundle’s ledger, shared by every","type":"text"},{"text":" ","type":"text"},{"text":"villain whose daemon it made, and the first wound starts the count","type":"text"},{"type":"text","text":" "},{"type":"text","text":"from its own villain’s "},{"type":"codeVoice","code":"playerStrength"},{"type":"text","text":"."}]}]},{"name":"condition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An extra gate, checked first — a false gate is a quiet, draw-free turn."}]}]},{"name":"prose","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Per-Outcome counter-attack lines (miss, wound, playerDeath)."}]}]}]},{"kind":"content","content":[{"anchor":"return-value","type":"heading","text":"Return Value","level":2},{"inlineContent":[{"text":"The daemon rolling the villain’s counter-attack each turn.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"inlineContent":[{"text":"A villain on the floor spends his turn coming to instead, and that is","type":"text"},{"text":" ","type":"text"},{"text":"the whole of his tick: it ends after the countdown, so the ","type":"text"},{"code":"when:","type":"codeVoice"},{"text":" gate","type":"text"},{"text":" ","type":"text"},{"text":"is not asked, the ","type":"text"},{"code":"strikesFirst","type":"codeVoice"},{"text":" roll that would start a fight is not","type":"text"},{"text":" ","type":"text"},{"text":"made, and no blow is rolled. He is down for every turn the ledger holds","type":"text"},{"text":" ","type":"text"},{"text":"him, the last one included, where he gets up — so a knockout taken with","type":"text"},{"text":" ","type":"text"},{"code":"turnsLeft: 2","type":"codeVoice"},{"text":" buys three ticks without a counter-attack: the tick that","type":"text"},{"text":" ","type":"text"},{"text":"knocked him down and the two he spends on the floor. The unconscious","type":"text"},{"text":" ","type":"text"},{"text":"flag clears at commit, so theft and movement also wait until next turn.","type":"text"},{"text":" ","type":"text"},{"text":"A game that sets ","type":"text"},{"code":"Actor.isUnconscious","type":"codeVoice"},{"text":" by its own means buys the same","type":"text"},{"text":" ","type":"text"},{"text":"silence, for as","type":"text"},{"text":" ","type":"text"},{"text":"long as it leaves the flag set; there is no countdown behind that one,","type":"text"},{"text":" ","type":"text"},{"text":"so the game clearing it is what ends it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"emphasis","inlineContent":[{"text":"In a fight","type":"text"}]},{"text":" is the source’s ","type":"text"},{"code":"FIGHTBIT","type":"codeVoice"},{"text":". ","type":"text"},{"code":"I-FIGHT","type":"codeVoice"},{"text":" (","type":"text"},{"code":"1actions.zil:3810","type":"codeVoice"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"has a villain strike only once the player has engaged him or once his own","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"F-FIRST?"},{"text":" branch says he starts one, and ","type":"text"},{"code":"strikesFirst","type":"codeVoice"},{"text":" is that branch,","type":"text"},{"text":" ","type":"text"},{"text":"out of a hundred: the troll’s is 33 (","type":"text"},{"code":"1actions.zil:702","type":"codeVoice"},{"text":"), the thief’s 20","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":":2064","type":"codeVoice"},{"text":"), and the cyclops, who has no such branch at all, is 0. A fight","type":"text"},{"text":" ","type":"text"},{"text":"either of them starts persists — both branches set ","type":"text"},{"type":"codeVoice","code":"FIGHTBIT"},{"text":" — and he","type":"text"},{"text":" ","type":"text"},{"text":"strikes in the turn he starts it rather than telegraphing it. ","type":"text"},{"code":"I-FIGHT","type":"codeVoice"},{"text":" ","type":"text"},{"text":"clears the bit on the villain the player is no longer standing with, so","type":"text"},{"text":" ","type":"text"},{"text":"walking out ends a fight and walking back in asks the question again.","type":"text"},{"text":" ","type":"text"},{"text":"Neither 0 nor 100 draws; that is ","type":"text"},{"type":"codeVoice","code":"chance"},{"text":"’s own rule.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"when:","type":"codeVoice"},{"text":" is an extra gate evaluated before the same-room guard and","type":"text"},{"text":" ","type":"text"},{"text":"before any draw — so a villain whose combat is scoped (the thief only","type":"text"},{"text":" ","type":"text"},{"text":"fights in his lair) burns no randomness on the turns his gate is","type":"text"},{"text":" ","type":"text"},{"text":"closed, keeping every seeded draw sequence intact. It does ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"emphasis"},{"text":" gate","type":"text"},{"text":" ","type":"text"},{"text":"coming round, which happens first: a man knocked out where his gate is","type":"text"},{"text":" ","type":"text"},{"text":"shut still wakes up. Nor does it gate ","type":"text"},{"inlineContent":[{"text":"disengaging","type":"text"}],"type":"emphasis"},{"text":", which is the room’s","type":"text"},{"text":" ","type":"text"},{"text":"business rather than the host’s — the source agrees, skipping the","type":"text"},{"text":" ","type":"text"},{"text":"engrossed thief’s turn without clearing his ","type":"text"},{"code":"FIGHTBIT","type":"codeVoice"},{"text":" — so a man","type":"text"},{"text":" ","type":"text"},{"text":"admiring a gift you handed him is still in the fight when he looks up.","type":"text"},{"text":" ","type":"text"},{"text":"Gates are assumed pure: they are asked once per turn and their answer is","type":"text"},{"text":" ","type":"text"},{"text":"not otherwise observed.","type":"text"}],"type":"paragraph"}]}],"metadata":{"role":"symbol","title":"aggression(of:key:named:strikesFirst:playerStrength:when:prose:)","roleHeading":"Instance Method","modules":[{"name":"GnustoMeleeCombat"}],"externalID":"s:17GnustoMeleeCombat0bC0V10aggression2of3key5named12strikesFirst14playerStrength4when5prose0A010TimedEventVAL5ActorV_S2SS2iSbyYbcAC15AggressionProseVtF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"aggression","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Actor","preciseIdentifier":"s:6Gnusto5ActorV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"key","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"named","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"strikesFirst","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"playerStrength","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"when","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"prose","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MeleeCombat","preciseIdentifier":"s:17GnustoMeleeCombat0bC0V","kind":"type