which is the room’s","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"business rather than the host’s — the source agrees, skipping the"},{"type":"text","text":" "},{"type":"text","text":"engrossed thief’s turn without clearing his "},{"code":"FIGHTBIT","type":"codeVoice"},{"type":"text","text":" — so a man"},{"type":"text","text":" "},{"type":"text","text":"admiring a gift you handed him is still in the fight when he looks up."},{"type":"text","text":" "},{"type":"text","text":"Gates are assumed pure: they are asked once per turn and their answer is"},{"type":"text","text":" "},{"type":"text","text":"not otherwise observed."}],"type":"paragraph"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/GnustoMeleeCombat\/documentation\/GnustoMeleeCombat","doc:\/\/GnustoMeleeCombat\/documentation\/GnustoMeleeCombat\/MeleeCombat"]]},"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://GnustoMeleeCombat/documentation/GnustoMeleeCombat/MeleeCombat/aggression(of:key:daemonName:strikesFirst:playerStrength:while:prose:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"aggression"},{"kind":"text","text":"("},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6Gnusto5ActorV","text":"Actor","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"key","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"daemonName"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"strikesFirst"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"playerStrength"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"I