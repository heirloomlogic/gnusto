nd":"text","text":">"}],"title":"noWeapon","identifier":"doc:\/\/GnustoMeleeCombat\/documentation\/GnustoMeleeCombat\/MeleeCombat\/CombatText\/noWeapon","type":"topic","url":"\/documentation\/gnustomeleecombat\/meleecombat\/combattext\/noweapon","kind":"symbol"},"doc://GnustoMeleeCombat/documentation/GnustoMeleeCombat/MeleeCombat/AggressionProse/miss":{"abstract":[{"type":"text","text":"Lines rotated when the villain’s counter-attack misses."}],"role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"miss"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"]"}],"url":"\/documentation\/gnustomeleecombat\/meleecombat\/aggressionprose\/miss","identifier":"doc:\/\/GnustoMeleeCombat\/documentation\/GnustoMeleeCombat\/MeleeCombat\/AggressionProse\/miss","type":"topic","title":"miss","kind":"symbol"},"doc://GnustoMeleeCombat/documentation/GnustoMeleeCombat/MeleeCombat/VillainProse/init(miss:wound:knockout:death:)":{"abstract":[{"type":"text","text":"Creates a villain’s prose. All lines are required — villains carry no stock defaults."}],"identifier":"doc:\/\/GnustoMeleeCombat\/documentation\/GnustoMeleeCombat\/MeleeCombat\/VillainProse\/init(miss:wound:knockout:death:)","kind":"symbol","url":"\/documentation\/gnustomeleecombat\/meleecombat\/villainprose\/init(miss:wound:knockout:death:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"miss","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"wound","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"knockout","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"death","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":")","kind":"text"}],"role":"symbol","type":"topic","title":"init(miss:wound:knockout:death:)"},"doc://GnustoMeleeCombat/documentation/GnustoMeleeCombat/MeleeCombat/CombatText":{"title":"MeleeCombat.CombatText","type":"topic","abstract":[{"type":"text","text":"The system’s own voice — refusals that belong to the mechanics, not"},{"type":"text","text":" "},{"type":"text","text":"to any one villain. Override lines at init to re-skin."}],"url":"\/documentation\/gnustomeleecombat\/meleecombat\/combattext","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"CombatText","kind":"identifier"}],"navigatorTitle":[{"text":"CombatText","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/GnustoMeleeCombat\/documentation\/GnustoMeleeCombat\/MeleeCombat\/CombatText","role":"symbol"},"doc://GnustoMeleeCombat/documentation/GnustoMeleeCombat/MeleeCombat/verbs":{"abstract":[{"text":"Everything that reaches ","type":"text"},{"code":".attack","type":"codeVoice"},{"text":", claimed as melee’s: the engine’s rows,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"spliced by listing the intent, and the two it adds. attack\/kill\/hit\/fight"},{"type":"text","text":" "},{"type":"text","text":"are core vocabulary, bare-handed or "},{"type":"codeVoice","code":"with"},{"type":"text","text":" a weapon; stab and strike are"},{"type":"text","text":" "},{"type":"text","text":"melee’s own, and always name the weapon."}],"kind":"symbol","identifier":"doc:\/\/GnustoMeleeCombat\/documentation\/GnustoMeleeCombat\/MeleeCombat\/verbs","url":"\/documentation\/gnustomeleecombat\/meleecombat\/verbs","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"verbs","kind":"identifier"},{"text":": [","kind":"text"},{"kind":"typeIdentifier","text":"SyntaxRule","preciseIdentifier":"s:6