ctory","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10Foundation3URLV","text":"URL","kind":"typeIdentifier"},{"text":"?) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"kind":"text","text":" -> "},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"abstract":[{"text":"Boots a game, feeds it a list of commands, and returns the full","type":"text"},{"text":" ","type":"text"},{"text":"transcript — every line the game printed, with the player’s input","type":"text"},{"text":" ","type":"text"},{"text":"interleaved as ","type":"text"},{"type":"codeVoice","code":"> command"},{"text":" the way a player would see it.","type":"text"}],"type":"topic","role":"symbol","title":"play(_:_:seed:saveDirectory:)","identifier":"doc:\/\/GnustoTestSupport\/documentation\/GnustoTestSupport\/play(_:_:seed:saveDirectory:)","url":"\/documentation\/gnustotestsupport\/play(_:_:seed:savedirectory:)","kind":"symbol"},"doc://GnustoTestSupport/documentation/GnustoTestSupport/expectNoStockRefusal(_:_:_:sourceLocation:)":{"type":"topic","identifier":"doc:\/\/GnustoTestSupport\/documentation\/GnustoTestSupport\/expectNoStockRefusal(_:_:_:sourceLocation:)","kind":"symbol","title":"expectNoStockRefusal(_:_:_:sourceLocation:)","abstract":[{"text":"Records a Swift Testing issue for every engine stock line that survives in a","type":"text"},{"text":" ","type":"text"},{"text":"transcript.","type":"text"}],"role":"symbol","url":"\/documentation\/gnustotestsupport\/expectnostockrefusal(_:_:_:sourcelocation:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"expectNoStockRefusal","kind":"identifier"},{"kind":"text","text":"("},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"kind":"text","text":", [any "},{"preciseIdentifier":"s:6Gnusto9StockLineP","text":"StockLine","kind":"typeIdentifier"},{"kind":"text","text":"], "},{"preciseIdentifier"