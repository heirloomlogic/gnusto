“”","type":"text"},{"text":" ","type":"text"},{"text":"when the command never appears.","type":"text"}],"type":"topic","identifier":"doc:\/\/GnustoTestSupport\/documentation\/GnustoTestSupport\/turnOutput(of:in:)","kind":"symbol","url":"\/documentation\/gnustotestsupport\/turnoutput(of:in:)","role":"symbol"},"doc://GnustoTestSupport/documentation/GnustoTestSupport/frame(headed:in:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"frame"},{"text":"(","kind":"text"},{"text":"headed","kind":"externalParam"},{"kind":"text","text":": "},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":") -> "},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}],"abstract":[{"type":"text","text":"The paragraph a room heading introduces the "},{"type":"strong","inlineContent":[{"text":"last","type":"text"}]},{"type":"text","text":" time the transcript"},{"type":"text","text":" "},{"type":"text","text":"printed it: from that heading to the next prompt, and nothing after it."}],"type":"topic","role":"symbol","title":"frame(headed:in:)","identifier":"doc:\/\/GnustoTestSupport\/documentation\/GnustoTestSupport\/frame(headed:in:)","url":"\/documentation\/gnustotestsupport\/frame(headed:in:)","kind":"symbol"},"doc://GnustoTestSupport/documentation/GnustoTestSupport/expectTrap(_:says:sourceLocation:)":{"fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"expectTrap","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ExitTest","kind":"typeIdentifier","preciseIdentifier":"s:7Testing8ExitTestV"},{"text":".","kind":"text"},{"text":"Result","kind":"typeIdentifier","preciseIdentifier":"s:7Testing8ExitTestV6ResultV"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"says"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"..., "},{"kind":"externalParam","text":"sourceLocation"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Testing14SourceLocationV","text":"SourceLocation"},{"text":")","kind":"text"}],"abstract":[{"text":"Checks the message a deliberately-crashed game printed on its way out.","type":"text"}],"type":"topic","role":"symbol","title":"expectTrap(_:says:sourceLocation:)","identifier":"doc:\/\/GnustoTestSupport\/documentation\/GnustoTestSupport\/expectTrap(_:says:sourceLocation:)","url":"\/documentation\/gnustotestsupport\/expecttrap(_:says:sourcelocation:)","kind":"symbol"},"doc://GnustoTestSupport/documentation/GnustoTestSupport/expectNoEngineStubLineSurvives(in:game:sourceLocation:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"expectNoEngineStubLineSurvives"},{"kind":"text","text":"("},{"kind":"externalParam","text":"in"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6Gnusto8GameTextV","text":"GameText","kind":"typeIdentifier"},{"text":".","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto8GameTextV11StubRepliesV","text":"StubReplies"},{"kind":"text","text":", "},{"kind":"externalParam","text":"game"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"text":", ","kind":"text"},{"text":"sourceLocation","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7Testing14SourceLocationV","text":"SourceLocation","kind":"typeIdentifier"},{"kind":"text","text":")"}],"abstract":[{"text":"Records a Swift Testing issue for every stub-verb line a game still answers","type":"text"},{"type":"text","text":" "},{"type":"text","text":"in the engine’s voice."}],"type":"topic","role":"symbol","title":"expectNoEngineStubLineSurvives(in:game:sourceLocation:)","identifier":"doc:\/\/GnustoTestSupport\/docume