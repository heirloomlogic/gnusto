dentifier","text":"output"},{"kind":"text","text":"("},{"kind":"externalParam","text":"before"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"kind":"text","text":") -> "},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}]},"doc://GnustoTestSupport/documentation/GnustoTestSupport/occurrences(of:in:)":{"title":"occurrences(of:in:)","abstract":[{"text":"How many times ","type":"text"},{"type":"codeVoice","code":"needle"},{"text":" occurs in ","type":"text"},{"type":"codeVoice","code":"haystack"},{"text":" — the count assertions in","type":"text"},{"text":" ","type":"text"},{"text":"transcript tests are usually about (“this beat fires exactly once”).","type":"text"}],"type":"topic","role":"symbol","identifier":"doc:\/\/GnustoTestSupport\/documentation\/GnustoTestSupport\/occurrences(of:in:)","kind":"symbol","url":"\/documentation\/gnustotestsupport\/occurrences(of:in:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"occurrences","kind":"identifier"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sy","text":"StringProtocol"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}]},"doc://GnustoTestSupport/documentation/GnustoTestSupport/engineVoicedStubLines(in:)":{"title":"engineVoicedStubLines(in:)","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"engineVoicedStubLines"},