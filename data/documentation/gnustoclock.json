{"identifier":{"url":"doc:\/\/GnustoClock\/documentation\/GnustoClock","interfaceLanguage":"swift"},"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"topicSections":[{"anchor":"The-clock","title":"The clock","identifiers":["doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock","doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/Text"]},{"anchor":"Times-of-day","title":"Times of day","identifiers":["doc:\/\/GnustoClock\/documentation\/GnustoClock\/TimeOfDay","doc:\/\/GnustoClock\/documentation\/GnustoClock\/TimeFormat"]},{"anchor":"An-actors-day","title":"An actor’s day","identifiers":["doc:\/\/GnustoClock\/documentation\/GnustoClock\/Timetable","doc:\/\/GnustoClock\/documentation\/GnustoClock\/Stop"]},{"anchor":"Extended-Modules","generated":true,"title":"Extended Modules","identifiers":["doc:\/\/GnustoClock\/documentation\/GnustoClock\/Gnusto"]}],"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"An adventure counts moves. A mystery counts minutes: every alibi in the house","type":"text"},{"text":" ","type":"text"},{"text":"is stated as a time, and a player who cannot check one against a clock is being","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"asked to take the game’s word for it. This library gives the move counter an"},{"text":" ","type":"text"},{"text":"hour and a minute, a ","type":"text"},{"code":"time","type":"codeVoice"},{"text":" verb that reads it back, alarms that go off at a","type":"text"},{"text":" ","type":"text"},{"text":"stated hour, and timetables that keep an actor where his day says he is.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The clock is "},{"type":"strong","inlineContent":[{"type":"text","text":"derived, not ticked"}]},{"type":"text","text":". "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/now"},{"type":"text","text":" is a pure function of the"},{"type":"text","text":" "},{"type":"text","text":"engine’s "},{"type":"codeVoice","code":"moves"},{"type":"text","text":", so every rule, action, fuse and daemon in one turn reads the"},{"type":"text","text":" "},{"type":"text","text":"same time, the timer tick that closes the turn included. A clock advanced by a"},{"type":"text","text":" "},{"type":"text","text":"daemon of its own would be read differently by daemons sorting before and after"},{"type":"text","text":" "},{"text":"it, which would make the hour depend on other timers’ names. Deriving also","type":"text"},{"type":"text","text":" "},{"type":"text","text":"inherits the engine’s own notion of world time: the hour doesn’t move on a parse"},{"text":" ","type":"text"},{"text":"error or a meta command, and ","type":"text"},{"type":"codeVoice","code":"take all"},{"text":" costs one turn rather than four.","type":"text"}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock","isActive":true,"type":"reference"},{"text":" is a ","type":"text"},{"code":"GameContent","type":"codeVoice"},{"type":"text","text":" bundle rather than a "},{"type":"codeVoice","code":"GamePlugin"},{"type":"text","text":", because it has"},{"type":"text","text":" "},{"type":"text","text":"state to keep — the minutes a game has moved the clock by hand, whether it is"},{"type":"text","text":" "},{"type":"text","text":"paused, and which stop each scheduled actor was last seen keeping. A bundle’s"},{"type":"text","text":" "},{"type":"text","text":"globals namespace themselves and travel in save files, so the host lists the"},{"type":"text","text":" "},{"type":"text","text":"clock in "},{"type":"codeVoice","code":"content"},{"type":"text","text":" and gets all three for nothing. Everything else belongs to"},{"text":" ","type":"text"},{"type":"text","text":"the host: the rooms, the actors, the bodies of the alarms, and the timetables. A"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Timetable","isActive":true},{"type":"text","text":" holds no state of its own, which is what lets a game declare one"},{"type":"text","text":" "},{"type":"text","text":"as an ordinary computed property naming its own rooms, and what makes"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Timetable\/location(at:)"},{"type":"text","text":" an answer available at bootstrap, in a rule, and in"},{"type":"text","text":" "},{"type":"text","text":"a plain unit test."}]},{"syntax":"swift","type":"codeListing","code":["import Gnusto","import GnustoClock          \/\/ .product(name: \"GnustoClock\", package: \"Gnusto\")","","struct Fulminate: Game {","    let clock = Clock(startingAt: TimeOfDay(17, 30), minutesPerTurn: 2, text: clockText)","","    static let clockText: Clock.Text = {","        var text = Clock.Text()","        text.timeIs = .naming { \"Your watch says \\($0).\" }","        return text","    }()","","    var content: GameContents { clock }        \/\/ the verb, the action, the saved state","","    var timers: [TimedEvent] {","        clock.schedule(teague, named: \"teague.day\", teagueDay)","","        clock.at(TimeOfDay(17, 46), named: \"clock.blast\") {","            blastHappened = true","        }","    }","}"]},{"inlineContent":[{"text":"Reading the time needs a live turn, so ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/now"},{"text":" belongs in a rule body, a","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"describe"},{"type":"text","text":" block, an action or a timer, and not in a "},{"type":"codeVoice","code":"map"},{"text":" block, which is","type":"text"},{"type":"text","text":" "},{"type":"text","text":"evaluated at bootstrap. A "},{"code":"map","type":"codeVoice"},{"type":"text","text":" block that wants to place a scheduled actor asks"},{"type":"text","text":" "},{"text":"the timetable instead, which reads no world state:","type":"text"},{"text":" ","type":"text"},{"code":"teague.starts(in: teagueDay.location(at: clock.start))","type":"codeVoice"},{"type":"text","text":". A stored clock also"},{"type":"text","text":" "},{"text":"hands the play-test status footer a ","type":"text"},{"code":"time=5:46 pm","type":"codeVoice"},{"type":"text","text":" field, which a timed game"},{"text":" ","type":"text"},{"type":"text","text":"wants, since a line true at half past five and false at six reads the same in a"},{"type":"text","text":" "},{"text":"transcript that never says which it was.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"variants":[{"paths":["\/documentation\/gnustoclock"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[[]]},"abstract":[{"type":"text","text":"Puts a wall clock over the engine’s turn counter, so a game can be played"},{"type":"text","text":" "},{"type":"text","text":"against an evening rather than a move count."}],"metadata":{"modules":[{"name":"GnustoClock"}],"roleHeading":"Framework","role":"collection","title":"GnustoClock","externalID":"GnustoClock","symbolKind":"module"},"references":{"doc://GnustoClock/documentation/GnustoClock/Timetable":{"title":"Timetable","url":"\/documentation\/gnustoclock\/timetable","abstract":[{"type":"text","text":"An actor’s day, written down: a list of stops the clock walks them through."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Timetable"}],"navigatorTitle":[{"kind":"identifier","text":"Timetable"}],"type":"topic","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Timetable","kind":"symbol","role":"symbol"},"doc://GnustoClock/documentation/GnustoClock/Clock":{"url":"\/documentation\/gnustoclock\/clock","role":"symbol","abstract":[{"text":"A wall clock over the turn counter: a game where it is twenty to six, and","type":"text"},{"text":" ","type":"text"},{"text":"ten to six four turns later.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Clock"}],"kind":"symbol","title":"Clock","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Clock"}],"type":"topic"},"doc://GnustoClock/documentation/GnustoClock/Gnusto":{"url":"\/documentation\/gnustoclock\/gnusto","role":"collection","abstract":[],"kind":"symbol","title":"Gnusto","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Gnusto","type":"topic"},"doc://GnustoClock/documentation/GnustoClock/Clock/now":{"role":"symbol","title":"now","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"now","kind":"identifier"},{"text":": ","kind":"text"},{"text":"TimeOfDay","kind":"typeIdentifier","preciseIdentifier":"s:11GnustoClock9TimeOfDayV"}],"kind":"symbol","abstract":[{"text":"What time it is now.","type":"text"}],"url":"\/documentation\/gnustoclock\/clock\/now","type":"topic","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/now"},"doc://GnustoClock/documentation/GnustoClock/Timetable/location(at:)":{"role":"symbol","title":"location(at:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"location","kind":"identifier"},{"text":"(","kind":"text"},{"text":"at","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TimeOfDay","preciseIdentifier":"s:11GnustoClock9TimeOfDayV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Location","preciseIdentifier":"s:6Gnusto8LocationV","kind":"typeIdentifier"}],"url":"\/documentation\/gnustoclock\/timetable\/location(at:)","abstract":[{"type":"text","text":"Where the actor is — or was, or will be — at a given time."}],"kind":"symbol","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Timetable\/location(at:)","type":"topic"},"doc://GnustoClock/documentation/GnustoClock/TimeOfDay":{"role":"symbol","navigatorTitle":[{"text":"TimeOfDay","kind":"identifier"}],"title":"TimeOfDay","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TimeOfDay"}],"kind":"symbol","abstract":[{"type":"text","text":"A time on a 24-hour wall clock, with no date attached: 8:15 in the evening"},{"text":" ","type":"text"},{"text":"is ","type":"text"},{"code":"TimeOfDay(20, 15)","type":"codeVoice"},{"text":", and it is the same value tomorrow.","type":"text"}],"url":"\/documentation\/gnustoclock\/timeofday","type":"topic","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/TimeOfDay"},"doc://GnustoClock/documentation/GnustoClock/TimeFormat":{"abstract":[{"type":"text","text":"How a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/TimeOfDay"},{"type":"text","text":" is spelled for the player."}],"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TimeFormat","kind":"identifier"}],"identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/TimeFormat","kind":"symbol","navigatorTitle":[{"text":"TimeFormat","kind":"identifier"}],"title":"TimeFormat","type":"topic","url":"\/documentation\/gnustoclock\/timeformat"},"doc://GnustoClock/documentation/GnustoClock":{"title":"GnustoClock","url":"\/documentation\/gnustoclock","abstract":[{"type":"text","text":"Puts a wall clock over the engine’s turn counter, so a game can be played"},{"type":"text","text":" "},{"type":"text","text":"against an evening rather than a move count."}],"type":"topic","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock","kind":"symbol","role":"collection"},"doc://GnustoClock/documentation/GnustoClock/Stop":{"url":"\/documentation\/gnustoclock\/stop","role":"symbol","abstract":[{"text":"One appointment on an actor’s day: where they are meant to be, from when.","type":"text"}],"navigatorTitle":[{"text":"Stop","kind":"identifier"}],"kind":"symbol","title":"Stop","identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Stop","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Stop","kind":"identifier"}],"type":"topic"},"doc://GnustoClock/documentation/GnustoClock/Clock/Text":{"title":"Clock.Text","url":"\/documentation\/gnustoclock\/clock\/text","abstract":[{"type":"text","text":"The clock’s own voice: the one line the mechanics print. Override the"},{"type":"text","text":" "},{"type":"text","text":"line at init to re-skin; the clock stores its table as a "},{"type":"codeVoice","code":"let"},{"type":"text","text":", so init"},{"type":"text","text":" "},{"type":"text","text":"is the only chance."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Text","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"Text"}],"identifier":"doc:\/\/GnustoClock\/documentation\/GnustoClock\/Clock\/Text","kind":"symbol","type":"topic","role":"symbol"}}}