"navigatorTitle":[{"kind":"identifier","text":"GameContent"}],"title":"GameContent","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"GameContent"}],"url":"\/documentation\/gnusto\/gamecontent","type":"topic","abstract":[{"text":"A self-contained slice of a game’s world: its own rooms, items, and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"@Global"},{"text":" state, plus the geography, rules, and verbs that go with them.","type":"text"}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameContent"},"doc://GnustoDangerousDark/documentation/GnustoDangerousDark/DangerousDark":{"identifier":"doc:\/\/GnustoDangerousDark\/documentation\/GnustoDangerousDark\/DangerousDark","url":"\/documentation\/gnustodangerousdark\/dangerousdark","navigatorTitle":[{"kind":"identifier","text":"DangerousDark"}],"abstract":[{"text":"Darkness that kills: a warning on the first consecutive turn the player","type":"text"},{"text":" ","type":"text"},{"text":"ends in the dark, a configurable grace period, then death. Add it to a","type":"text"},{"text":" ","type":"text"},{"text":"game’s ","type":"text"},{"code":"content","type":"codeVoice"},{"text":" block; there is nothing else to wire:","type":"text"}],"type":"topic","title":"DangerousDark","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DangerousDark"}],"kind":"symbol","role":"symbol"},"doc://GnustoDangerousDark/documentation/GnustoDangerousDark/DangerousDark/Text":{"identifier":"doc:\/\/GnustoDangerousDark\/documentation\/GnustoDangerousDark\/DangerousDark\/Text","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Text"}],"abstract":[{"type":"text","text":"The dark’s own voice: the two lines the mechanics print. Override"},{"type":"text","text":" "},{"type":"text","text":"either at init to re-skin; the bundle stores its table as a "},{"type":"codeVoice","code":"let"},{"type":"text","text":", so"},{"type":"text","text":" "},{"type":"text","text":"init is the only chance."}],"title":"DangerousDark.Text","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Text"}],"url":"\/documentation\/gnustodangerousdark\/dangerousdark\/text"},"doc://GnustoDangerousDark/s16SendableMetatypeP":{"identifier":"doc:\/\/GnustoDangerousDark\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"doc://GnustoDangerousDark/documentation/GnustoDangerousDark/DangerousDark/timers":{"identifier":"doc:\/\/GnustoDangerousDark\/documentation\/GnustoDangerousDark\/DangerousDark\/timers","url":"\/documentation\/gnustodangerousdark\/dangerousdark\/timers","title":"timers","abstract":[{"type":"text","text":"The grue daemon: each dark turn ticks the counter. The warning prints on"},{"type":"text","text":" "},{"type":"text","text":"the first dark turn; dark turns 2…"},{"code":"graceTurns + 1","type":"codeVoice"},{"type":"text","text":" are a silent grace;"},{"type":"text","text":" "},{"type":"text","text":"from dark turn "},{"code":"graceTurns + 2","type":"codeVoice"},{"type":"text","text":" on, each turn rolls "},{"code":"chance(lethality)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"to be eaten. Stepping back into the light — or "},{"type":"reference","identifier":"doc:\/\/GnustoDangerousDark\/documentation\/GnustoDangerousDark\/DangerousDark\/suspended","isActive":true},{"type":"text","text":" — resets the"},{"type":"text","text":" "},{"text":"count. Guards before the draw, so a lit turn burns no randomness.","type":"text"}],"type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"timers"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"TimedEvent","preciseIdentifier":"s:6Gnusto10TimedEventV"},{"kind":"text","text":"]"}],"kind":"symbol","role":"symbol"}