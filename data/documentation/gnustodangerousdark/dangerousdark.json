{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DangerousDark","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"code":["let dark = DangerousDark()          \/\/ stock prose, one turn of grace","","var content: GameContents {","    dark","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The daemon counts consecutive turns "},{"type":"emphasis","inlineContent":[{"type":"text","text":"ending"}]},{"type":"text","text":" in darkness, wherever"},{"type":"text","text":" "},{"type":"text","text":"they’re spent, and a move counts the same as a wait. The warning turn is a"},{"type":"text","text":" "},{"type":"text","text":"guarantee (the classic fairness contract), and a lightless dash toward"},{"type":"text","text":" "},{"type":"text","text":"daylight is safe if no more than "},{"code":"graceTurns + 1","type":"codeVoice"},{"type":"text","text":" of its turns end in the"},{"type":"text","text":" "},{"type":"text","text":"dark. Any reachable light resets the count."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Death is a "},{"type":"strong","inlineContent":[{"type":"text","text":"dice roll"}]},{"type":"text","text":" once the grace runs out: the first dark turn only"},{"type":"text","text":" "},{"type":"text","text":"warns, a configurable grace of guaranteed-safe turns follows, and then every"},{"type":"text","text":" "},{"type":"text","text":"further dark turn rolls "},{"code":"chance(lethality)","type":"codeVoice"},{"type":"text","text":" to be eaten. The warning turn"},{"type":"text","text":" "},{"type":"text","text":"itself is safe. This is not Zork’s rule. Zork’s grue keeps no count and can"},{"type":"text","text":" "},{"type":"text","text":"kill only a player who tries to move out of a dark room, never one who"},{"type":"text","text":" "},{"type":"text","text":"stands still; "},{"code":"FIDELITY.md","type":"codeVoice"},{"type":"text","text":" records the difference for both Zork games."}]},{"type":"paragraph","inlineContent":[{"text":"UNDO after a death does not bring the warning back. The count is a","type":"text"},{"text":" ","type":"text"},{"code":"@Global","type":"codeVoice"},{"text":", so UNDO returns it to its value before the fatal turn, and a","type":"text"},{"text":" ","type":"text"},{"text":"next turn that also ends in the dark is a dice turn again. UNDO rewinds the","type":"text"},{"text":" ","type":"text"},{"text":"seeded random stream too, so typing the fatal turn’s command again rolls","type":"text"},{"text":" ","type":"text"},{"text":"the same death. A turn that ends in the light resets the count.","type":"text"}]},{"inlineContent":[{"type":"text","text":"To make the dark harmless for a stretch — a room whose solution is to stand"},{"type":"text","text":" "},{"type":"text","text":"in it on purpose, a scene that should not be interrupted — set"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GnustoDangerousDark\/documentation\/GnustoDangerousDark\/DangerousDark\/suspended"},{"type":"text","text":". "},{"type":"strong","inlineContent":[{"text":"Do not stop the daemon by name.","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"stopDaemon(\"grue\")"},{"type":"text","text":" "},{"type":"text","text":"freezes the counter at whatever it had reached, so resuming can land the"},{"type":"text","text":" "},{"type":"text","text":"player straight on a dice turn and cost them the warning; suspending resets"},{"type":"text","text":" "},{"type":"text","text":"the count for exactly that reason."}],"type":"paragraph"},{"inlineContent":[{"text":"The daemon is named ","type":"text"},{"code":"\"grue\"","type":"codeVoice"},{"text":". Timer names are global, but two instances","type":"text"},{"text":" ","type":"text"},{"text":"of ","type":"text"},{"code":"DangerousDark","type":"codeVoice"},{"text":" in one game already collide on their shared ","type":"text"},{"code":"@Global","type":"codeVoice"},{"text":" ","type":"text"},{"text":"namespace before the timer name matters — one lethal dark per game.","type":"text"}],"type":"paragraph"}]}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnustodangerousdark\/dangerousdark"]}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/Gnusto\/documentation\/Gnusto\/GameContent","doc:\/\/GnustoDangerousDark\/s8SendableP","doc:\/\/GnustoDangerousDark\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To"}],"hierarchy":{"paths":[["doc:\/\/GnustoDangerousDark\/documentation\/GnustoDangerousDark"]]},"topicSections":[{"identifiers":["doc:\/\/GnustoDangerousDark\/documentation\/GnustoDangerousDark\/DangerousDark\/Text"],"generated":true,"title":"Structures","anchor":"Structures"},{"identifiers":["doc:\/\/GnustoDangerousDark\/documentation\/GnustoDangerousDark\/DangerousDark\/init(graceTurns:lethality:text:)"],"generated":true,"title":"Initializers","anchor":"Initializers"},{"identifiers":["doc:\/\/GnustoDangerousDark\/documentation\/GnustoDangerousDark\/DangerousDark\/suspended","doc:\/\/GnustoDangerousDark\/documentation\/GnustoDangerousDark\/DangerousDark\/timers"],"generated":true,"title":"Instance Properties","anchor":"Instance-Properties"},{"identifiers":["doc:\/\/GnustoDangerousDark\/documentation\/GnustoDangerousDark\/DangerousDark\/GameContent-Implementations"],"generated":true,"title":"Default Implementations","anchor":"Default-Implementations"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/GnustoDangerousDark\/documentation\/GnustoDangerousDark\/DangerousDark","interfaceLanguage":"swift"},"metadata":{"title":"DangerousDark","navigatorTitle":[{"kind":"identifier","text":"DangerousDark"}],"role":"symbol","externalID":"s:19GnustoDangerousDark0bC0V","modules":[{"name":"GnustoDangerousDark"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DangerousDark","kind":"identifier"}],"symbolKind":"struct","roleHeading":"Structure"},"kind":"symbol","abstract":[{"type":"text","text":"Darkness that kills: a warning on the first consecutive turn the player"},{"type":"text","text":" "},{"type":"text","text":"ends in the dark, a configurable grace period, then death. Add it to a"},{"type":"text","text":" "},{"type":"text","text":"game’s "},{"code":"content","type":"codeVoice"},{"type":"text","text":" block; there is nothing else to wire:"}],"seeAlsoSections":[{"identifiers":["doc:\/\/GnustoDangerousDark\/documentation\/GnustoDangerousDark\/DangerousDark\/init(graceTurns:lethality:text:)","doc:\/\/GnustoDangerousDark\/documentation\/GnustoDangerousDark\/DangerousDark\/Text"],"generated":true,"title":"The content bundle","anchor":"The-content-bundle"}],"references":{"doc://GnustoDangerousDark/s16SendableMetatypeP":{"identifier":"doc:\/\/GnustoDangerousDark\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"doc://Gnusto/documentation/Gnusto/GameContent":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GameContent","kind":"identifier"}],"title":"GameContent","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameContent","role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/gnusto\/gamecontent","abstract":[{"type":"text","text":"A self-contained slice of a game’s world: its own rooms, items, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"@Global"},{"type":"text","text":" state, plus the geography, rules, and verbs that go with them."}],"navigatorTitle":[{"text":"GameContent","kind":"identifier"}]},"doc://GnustoDangerousDark/documentation/GnustoDangerousDark":{"kind":"symbol","role":"collection","abstract":[{"type":"text","text":"Darkness that kills: a warning, a grace period, then dice."}],"type":"topic","identifier":"doc:\/\/GnustoDangerousDark\/documentation\/GnustoDangerousDark","url":"\/documentation\/gnustodangerousdark","title":"GnustoDangerousDark"},"doc://GnustoDangerousDark/documentation/GnustoDangerousDark/DangerousDark/suspended":{"kind":"symbol","role":"symbol","type":"topic","url":"\/documentation\/gnustodangerousdark\/dangerousdark\/suspended","identifier":"doc:\/\/GnustoDangerousDark\/documentation\/GnustoDangerousDark\/DangerousDark\/suspended","abstract":[{"type":"text","text":"Set while the dark is harmless: the grue idles, draws no randomness,"},{"type":"text","text":" "},{"type":"text","text":"and — because the count resets on every suspended turn — resuming"},{"type":"text","text":" "},{"type":"text","text":"always begins again at the warning."}],"fragments":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"suspended"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"title":"suspended"},"doc://GnustoDangerousDark/documentation/GnustoDangerousDark/DangerousDark":{"navigatorTitle":[{"kind":"identifier","text":"DangerousDark"}],"type":"topic","identifier":"doc:\/\/GnustoDangerousDark\/documentation\/GnustoDangerousDark\/DangerousDark","role":"symbol","title":"DangerousDark","kind":"symbol","abstract":[{"text":"Darkness that kills: a warning on the first consecutive turn the player","type":"text"},{"text":" ","type":"text"},{"text":"ends in the dark, a configurable grace period, then death. Add it to a","type":"text"},{"text":" ","type":"text"},{"text":"game’s ","type":"text"},{"type":"codeVoice","code":"content"},{"text":" block; there is nothing else to wire:","type":"text"}],"url":"\/documentation\/gnustodangerousdark\/dangerousdark","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DangerousDark"}]},"doc://GnustoDangerousDark/documentation/GnustoDangerousDar