ence","isActive":true,"identifier":"doc:\/\/GnustoDangerousDark\/documentation\/GnustoDangerousDark\/DangerousDark\/suspended"},{"type":"text","text":" — resets the"},{"type":"text","text":" "},{"type":"text","text":"count. Guards before the draw, so a lit turn burns no randomness."}],"type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"timers"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto10TimedEventV","text":"TimedEvent"},{"kind":"text","text":"]"}]},"doc://Gnusto/documentation/Gnusto/TimedEvent":{"url":"\/documentation\/gnusto\/timedevent","type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TimedEvent","kind":"identifier"}],"role":"symbol","title":"TimedEvent","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/TimedEvent","abstract":[{"text":"A named timed event, declared in a game or bundle ","type":"text"},{"code":"timers","type":"codeVoice"},{"text":" block: a fuse","type":"text"},{"text":" ","type":"text"},{"text":"(fires once, N turns after it is started) or a daemon (runs at the end of","type":"text"},{"text":" ","type":"text"},{"text":"every turn while active). The body is registered at bootstrap and never","type":"text"},{"text":" ","type":"text"},{"text":"serialized; only the schedule — name → turns remaining, or the active","type":"text"},{"text":" ","type":"text"},{"text":"flag — lives in ","type":"text"},{"code":"WorldState","type":"codeVoice"},{"text":", so it saves and restores like any other","type":"text"},{"text":" ","type":"text"},{"text":"state and a restore re-binds it to the declared body by name.","type":"text"}],"navigatorTitle":[{"text":"TimedEvent","kind":"identifier"}]}}}