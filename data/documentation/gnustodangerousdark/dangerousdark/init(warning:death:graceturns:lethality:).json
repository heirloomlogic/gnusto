ype":"text","text":"once"}],"type":"emphasis"},{"text":", so a game that also points ","type":"text"},{"type":"codeVoice","code":"text.pitchBlack"},{"text":" at this sentence","type":"text"},{"text":" ","type":"text"},{"text":"(Zork does: there, the dark-room line is the threat) reads it a","type":"text"},{"text":" ","type":"text"},{"text":"single time on the turn it walks into the dark. Two different","type":"text"},{"text":" ","type":"text"},{"text":"sentences are two different sentences, and both print.","type":"text"}],"type":"paragraph"}]},{"name":"death","content":[{"inlineContent":[{"type":"text","text":"The "},{"code":"die(_:)","type":"codeVoice"},{"type":"text","text":" message, handed the "},{"type":"strong","inlineContent":[{"text":"vehicle the player was","type":"text"},{"text":" ","type":"text"},{"text":"aboard","type":"text"}]},{"type":"text","text":" — or nothing, when they were on their own feet. Write it"},{"type":"text","text":" "},{"type":"text","text":"with "},{"code":".naming(orBare:)","type":"codeVoice"},{"type":"text","text":"; see "},{"identifier":"doc:\/\/GnustoDangerousDark\/documentation\/GnustoDangerousDark\/DangerousDark\/timers","type":"reference","isActive":true},{"type":"text","text":" for why it takes a subject"},{"type":"text","text":" "},{"type":"text","text":"at all."}],"type":"paragraph"}]},{"name":"graceTurns","content":[{"inlineContent":[{"type":"text","text":"Guaranteed-Safe dark turns after the warning — warn on"},{"type":"text","text":" "},{"type":"text","text":"dark turn 1, safe through dark turn "},{"code":"graceTurns + 1","type":"codeVoice"},{"type":"text","text":", then dice."}],"type":"paragraph"}]},{"name":"lethality","content":[{"inlineContent":[{"type":"text","text":"Per-Turn percent chance of death once the dice begin (on"},{"type":"text","text":" "},{"type":"text","text":"dark turn "},{"type":"codeVoice","code":"graceTurns + 2"},{"type":"text","text":" and every dark turn after)."}],"type":"paragraph"}]}]}],"refere