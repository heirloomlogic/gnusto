umentation/GnustoDangerousDark/DangerousDark/suspended":{"abstract":[{"type":"text","text":"Set while the dark is harmless: the grue idles, draws no randomness,"},{"type":"text","text":" "},{"type":"text","text":"and — because the count resets on every suspended turn — resuming"},{"type":"text","text":" "},{"type":"text","text":"always begins again at the warning."}],"role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"suspended"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"kind":"symbol","title":"suspended","identifier":"doc:\/\/GnustoDangerousDark\/documentation\/GnustoDangerousDark\/DangerousDark\/suspended","type":"topic","url":"\/documentation\/gnustodangerousdark\/dangerousdark\/suspended"},"doc://Gnusto/documentation/Gnusto/GameText/Noun":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Noun"}],"kind":"symbol","abstract":[{"text":"A rendered noun phrase that also knows its own number, for the lines","type":"text"},{"text":" ","type":"text"},{"text":"whose verb has to agree with it.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Noun"}],"type":"topic","url":"\/documentation\/gnusto\/gametext\/noun","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/Noun","title":"GameText.Noun"},"doc://GnustoDangerousDark/documentation/GnustoDangerousDark/DangerousDark/Text/death":{"kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"death"},{"kind":"text","text":": "},{"preciseIdentifier":"s:6Gnusto8GameTextV","kind":"typeIdentifier","text":"GameText"},{"kind":"text","text":"."},{"preciseIdentifier":"s:6Gnusto8GameTextV4LineV","kind":"typeIdentifier","text":"Line"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:6Gnusto8GameTextV","kind":"typeIdentifier","text":"GameText"},{"kind":"text","text":"