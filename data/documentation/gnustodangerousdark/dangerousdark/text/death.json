":"text","text":" "},{"type":"text","text":"the first dark turn; dark turns 2…"},{"code":"graceTurns + 1","type":"codeVoice"},{"type":"text","text":" are a silent grace;"},{"type":"text","text":" "},{"type":"text","text":"from dark turn "},{"code":"graceTurns + 2","type":"codeVoice"},{"type":"text","text":" on, each turn rolls "},{"code":"chance(lethality)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"to be eaten. Stepping back into the light — or "},{"type":"reference","identifier":"doc:\/\/GnustoDangerousDark\/documentation\/GnustoDangerousDark\/DangerousDark\/suspended","isActive":true},{"type":"text","text":" — resets the"},{"type":"text","text":" "},{"text":"count. Guards before the draw, so a lit turn burns no randomness.","type":"text"}],"type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"timers"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"TimedEvent","preciseIdentifier":"s:6Gnusto10TimedEventV"},{"kind":"text","text":"]"}],"kind":"symbol","role":"symbol"}}}