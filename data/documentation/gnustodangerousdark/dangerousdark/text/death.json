umentation/GnustoDangerousDark/DangerousDark/suspended":{"identifier":"doc:\/\/GnustoDangerousDark\/documentation\/GnustoDangerousDark\/DangerousDark\/suspended","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"suspended","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"url":"\/documentation\/gnustodangerousdark\/dangerousdark\/suspended","role":"symbol","title":"suspended","kind":"symbol","abstract":[{"text":"Set while the dark is harmless: the grue idles, draws no randomness,","type":"text"},{"text":" ","type":"text"},{"text":"and — because the count resets on every suspended turn — resuming","type":"text"},{"text":" ","type":"text"},{"text":"always begins again at the warning.","type":"text"}],"type":"topic"},"doc://GnustoDangerousDark/documentation/GnustoDangerousDark/DangerousDark":{"identifier":"doc:\/\/GnustoDangerousDark\/documentation\/GnustoDangerousDark\/DangerousDark","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"DangerousDark","kind":"identifier"}],"url":"\/documentation\/gnustodangerousdark\/dangerousdark","navigatorTitle":[{"kind":"identifier","text":"DangerousDark"}],"role":"symbol","title":"DangerousDark","kind":"symbol","abstract":[{"text":"Darkness that kills: a warning on the first consecutive turn the player","type":"text"},{"text":" ","type":"text"},{"text":"ends in the dark, a configurable grace period, then death. Add it to a","type":"text"},{"text":" ","type":"text"},{"text":"game’s ","type":"text"},{"type":"codeVoice","code":"content"},{"text":" block; there is nothing else to wire:","type":"text"}],"type":"topic"},"doc://GnustoDangerousDark/documentation/GnustoDangerousDark":{"type":"topic","title":"GnustoDangerousDark","kind":"symbol","identifier":"doc:\/\/GnustoDangerousDark\/documentation\/GnustoDangerousDark","abstract":[{"text":"Darkness that kills: a warning, a grace period, then dice.","type":"te