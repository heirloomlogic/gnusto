aceTurns + 1"},{"text":" are a silent grace;","type":"text"},{"text":" ","type":"text"},{"text":"from dark turn ","type":"text"},{"type":"codeVoice","code":"graceTurns + 2"},{"text":" on, each turn rolls ","type":"text"},{"type":"codeVoice","code":"chance(lethality)"},{"text":" ","type":"text"},{"text":"to be eaten. Stepping back into the light — or ","type":"text"},{"identifier":"doc:\/\/GnustoDangerousDark\/documentation\/GnustoDangerousDark\/DangerousDark\/suspended","type":"reference","isActive":true},{"text":" — resets the","type":"text"},{"text":" ","type":"text"},{"text":"count. Guards before the draw, so a lit turn burns no randomness.","type":"text"}],"kind":"symbol","url":"\/documentation\/gnustodangerousdark\/dangerousdark\/timers","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"timers","kind":"identifier"},{"text":": [","kind":"text"},{"text":"TimedEvent","preciseIdentifier":"s:6Gnusto10TimedEventV","kind":"typeIdentifier"},{"text":"]","kind":"text"}]},"doc://GnustoDangerousDark/documentation/GnustoDangerousDark/DangerousDark/Text":{"navigatorTitle":[{"text":"Text","kind":"identifier"}],"identifier":"doc:\/\/GnustoDangerousDark\/documentation\/GnustoDangerousDark\/DangerousDark\/Text","type":"topic","role":"symbol","title":"DangerousDark.Text","abstract":[{"type":"text","text":"The dark’s own voice: the two lines the mechanics print. Override"},{"type":"text","text":" "},{"type":"text","text":"either at init to re-skin; the bundle stores its table as a "},{"code":"let","type":"codeVoice"},{"type":"text","text":", so"},{"type":"text","text":" "},{"type":"text","text":"init is the only chance."}],"kind":"symbol","url":"\/documentation\/gnustodangerousdark\/dangerousdark\/text","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Text"}]},"doc://Gnusto/documentation/Gnusto/GameText":{"kind":"symbol","role":"symbol","type":"topic","url":"\/documentation\/gnusto\/gametext","id