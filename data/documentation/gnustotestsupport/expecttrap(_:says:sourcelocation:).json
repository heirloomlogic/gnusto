"},{"type":"text","text":" rule, "},{"type":"codeVoice","code":"startFuse"},{"type":"text","text":" naming a daemon."},{"type":"text","text":" "},{"type":"text","text":"A "},{"type":"codeVoice","code":"fatalError"},{"type":"text","text":" cannot be caught, so the only way to assert on one is to run"},{"text":" ","type":"text"},{"text":"it in a child process and read what it printed. Swift Testing’s exit tests","type":"text"},{"text":" ","type":"text"},{"text":"do the running; this does the reading:","type":"text"}],"type":"paragraph"},{"code":["let result = await #expect(processExitsWith: .failure, observing: [\\.standardErrorContent]) {","    _ = try await play(ProceedMisuseGame(), [\"take wrench\"])","}","expectTrap(result, says: \"proceed() was called twice\")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"A trap test fails in two very different ways and the message says which:"},{"text":" ","type":"text"},{"inlineContent":[{"text":"nothing on stderr","type":"text"}],"type":"strong"},{"type":"text","text":" means the process died before it could print, and"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"a different message"}],"type":"strong"},{"type":"text","text":" means the trap fired with the wrong wording."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"What it costs, and when to spend it."}],"type":"strong"},{"type":"text","text":" Each call is a child process — some"},{"text":" ","type":"text"},{"text":"60 ms, against 1 ms for an in-process assertion. This is the decision point,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"so the rule lives here and "},{"code":"TestingYourGame.md","type":"codeVoice"},{"type":"text","text":" points at it. A trap wants"},{"text":" ","type":"text"},{"text":"one of three shapes, in the order they are worth reaching for; only the last","type":"text"},{"text":" ","type":"text"},{"text":"of them is this function:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Make the bad message unrepresentable, and write no test at all.","type":"text"}],"type":"strong"},{"text":" Where","type":"text"},{"text":" ","type":"text"},{"text":"a group of traps shares a sentence, fold them into one helper that derives","type":"text"},{"text":" ","type":"text"},{"text":"the whole of it — or at least takes the missing half as a ","type":"text"},{"inlineContent":[{"text":"required","type":"text"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"argument — so the next call site cannot omit or contradict it. Where a","type":"text"},{"text":" ","type":"text"},{"text":"trap guards an argument no caller could sensibly mean, change the","type":"text"},{"text":" ","type":"text"},{"text":"signature so the compiler refuses it. ","type":"text"},{"type":"codeVoice","code":"HolderTrait"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"declaredFuse(_:in:else:)"},{"text":" are the first; ","type":"text"},{"type":"codeVoice","code":"oneOf(_:_:)"},{"text":" is the second.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"A pure function, asserted in process"}],"type":"strong"},{"text":", for an ordinary precondition, or","type":"text"},{"text":" ","type":"text"},{"text":"one whose message has branches worth checking apiece. Split the message","type":"text"},{"text":" ","type":"text"},{"text":"out and test it at a millisecond — the shape ","type":"text"},{"code":"Reentry.diagnostic(depth:entity:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"TraitKey.diagnostic(for:of:)","type":"codeVoice"},{"text":" use.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"An exit test"}]},{"type":"text","text":" — this function — where the trap’s "},{"type":"emphasis","inlineContent":[{"type":"text","text":"wording"}]},{"type":"text","text":" is what an"},{"type":"text","text":" "},{"type":"text","text":"author will read to find their mistake and no pure function can stand in"},{"type":"text","text":" "},{"type":"text","text":"for the run, or where a "},{"type":"emphasis","inlineContent":[{"text":"margin","type":"text"}]},{"type":"text","text":" only a real run can measure is at stake."},{"type":"text","text":" "},{"type":"text","text":"An entity built inside a rule body; "},{"type":"codeVoice","code":"command"},{"type":"text","text":" read on the opening look; a"},{"type":"text","text":" "},{"type":"text","text":"scoring register the award table does not list; a cap that has to fire"},{"type":"text","text":" "},{"text":"before the stack does.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"}]}],"references":{"doc://GnustoTestSupport/documentation/GnustoTestSupport/expectTrap(_:says:sourceLocation:)":{"type":"topic","url":"\/documentation\/gnustotestsupport\/expecttrap(_:says:sourcelocation:)","abstract":[{"type":"text","text":"Checks the message a deliberately-crashed game printed on its way out."}],"kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"expectTrap","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ExitTest","kind":"typeIdentifier","preciseIdentifier":"s:7Testing8ExitTestV"},{"text":".","kind":"text"},{"text":"Result","kind":"typeIdentifier","preciseIdentifier":"s:7Testing8ExitTestV6ResultV"},{"text":"?, ","kind":"text"},{"text":"says","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"..., "},{"kind":"externalParam","text":"sourceLocation"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7Testing14SourceLocationV","kind":"typeIdentifier","text":"SourceLocation"},{"kind":"text","text":")"}],"identifier":"doc:\/\/GnustoTestSupport\/documentat