{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GnustoTestSupport\/documentation\/GnustoTestSupport\/expectTrap(_:says:sourceLocation:)"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"expectTrap","kind":"identifier"},{"kind":"text","text":"("},{"text":"_","kind":"externalParam"},{"kind":"text","text":" "},{"text":"result","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"ExitTest","preciseIdentifier":"s:7Testing8ExitTestV","kind":"typeIdentifier"},{"kind":"text","text":"."},{"text":"Result","preciseIdentifier":"s:7Testing8ExitTestV6ResultV","kind":"typeIdentifier"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"says"},{"text":" ","kind":"text"},{"text":"needles","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"text":"..., ","kind":"text"},{"text":"sourceLocation","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"SourceLocation","preciseIdentifier":"s:7Testing14SourceLocationV","kind":"typeIdentifier"},{"text":" = #_sourceLocation)","kind":"text"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"result","content":[{"inlineContent":[{"type":"text","text":"The exit test’s result — the value "},{"code":"#expect(processExitsWith:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"returns, which must have been asked to observe "},{"code":"standardErrorContent","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"name":"needles","content":[{"inlineContent":[{"type":"text","text":"The fragments the trap’s message must contain, in any order."}],"type":"paragraph"}]},{"name":"sourceLocation","content":[{"inlineContent":[{"type":"text","text":"The caller’s source location, for issue reporting."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"The engine answers an authoring mistake with a ","type":"text"},{"code":"fatalError","type":"codeVoice"},{"type":"text","text":" naming the"},{"text":" ","type":"text"},{"type":"text","text":"mistake — a "},{"code":"describe { }","type":"codeVoice"},{"text":" closure that calls back into the describer","type":"text"},{"text":" ","type":"text"},{"text":"running it, ","type":"text"},{"code":"proceed()","type":"codeVoice"},{"type":"text","text":" from an "},{"code":"after","type":"codeVoice"},{"type":"text","text":" rule, "},{"code":"startFuse","type":"codeVoice"},{"type":"text","text":" naming a daemon."},{"text":" ","type":"text"},{"type":"text","text":"A "},{"code":"fatalError","type":"codeVoice"},{"type":"text","text":" cannot be caught, so the only way to assert on one is to run"},{"type":"text","text":" "},{"type":"text","text":"it in a child process and read what it printed. Swift Testing’s exit tests"},{"type":"text","text":" "},{"type":"text","text":"do the running; this does the reading:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let result = await #expect(processExitsWith: .failure, observing: [\\.standardErrorContent]) {","    _ = try await play(ProceedMisuseGame(), [\"take wrench\"])","}","expectTrap(result, says: \"proceed() was called twice\")"]},{"inlineContent":[{"type":"text","text":"A trap test fails in two very different ways and the message says which:"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"nothing on stderr"}]},{"type":"text","text":" means no diagnostic was captured (an optimized"},{"type":"text","text":" "},{"type":"codeVoice","code":"precondition"},{"type":"text","text":" can trap without printing), and"},{"type":"text","text":" "},{"inlineContent":[{"text":"a different message","type":"text"}],"type":"strong"},{"type":"text","text":" means the trap fired with the wrong wording."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"What it costs, and when to spend it."}]},{"type":"text","text":" Each call is a child process — some"},{"type":"text","text":" "},{"type":"text","text":"60 ms, against 1 ms for an in-process assertion. This is the decision point,"},{"type":"text","text":" "},{"type":"text","text":"so the rule lives here and "},{"type":"codeVoice","code":"TestingYourGame.md"},{"type":"text","text":" points at it. A trap wants"},{"type":"text","text":" "},{"type":"text","text":"one of three shapes, in the order they are worth reaching for; only the last"},{"type":"text","text":" "},{"type":"text","text":"of them is this function:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Make the bad message unrepresentable, and write no test at all."}],"type":"strong"},{"text":" Where","type":"text"},{"text":" ","type":"text"},{"text":"a group of traps shares a sentence, fold them into one helper that derives","type":"text"},{"text":" ","type":"text"},{"text":"the whole of it — or at least takes the missing half as a ","type":"text"},{"inlineContent":[{"type":"text","text":"required"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"argument — so the next call site cannot omit or contradict it. Where a","type":"text"},{"text":" ","type":"text"},{"text":"trap guards an argument no caller could sensibly mean, change the","type":"text"},{"text":" ","type":"text"},{"text":"signature so the compiler refuses it. ","type":"text"},{"code":"HolderTrait","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"declaredFuse(_:in:else:)","type":"codeVoice"},{"text":" are the first; ","type":"text"},{"code":"oneOf(_:_:)","type":"codeVoice"},{"text":" is the second.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"A pure function, asserted in process"}],"type":"strong"},{"text":", for an ordinary precondition, or","type":"text"},{"text":" ","type":"text"},{"text":"one whose message has branches worth checking apiece. Split the message","type":"text"},{"text":" ","type":"text"},{"text":"out and test it at a millisecond — the shape ","type":"text"},{"code":"Reentry.diagnostic(depth:entity:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"TraitKey.diagnostic(for:of:)","type":"codeVoice"},{"text":" use.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"An exit test"}],"type":"strong"},{"text":" — this function — where the trap’s ","type":"text"},{"inlineContent":[{"type":"text","text":"wording"}],"type":"emphasis"},{"text":" is what an","type":"text"},{"text":" ","type":"text"},{"text":"author will read to find their mistake and no pure function can stand in","type":"text"},{"text":" ","type":"text"},{"text":"for the run, or where a ","type":"text"},{"inlineContent":[{"type":"text","text":"margin"}],"type":"emphasis"},{"text":" only a real run can measure is at stake.","type":"text"},{"text":" ","type":"text"},{"text":"An entity built inside a rule body; ","type":"text"},{"code":"command","type":"codeVoice"},{"text":" read on the opening look; a","type":"text"},{"text":" ","type":"text"},{"text":"scoring register the award table does not list; a cap that has to fire","type":"text"},{"text":" ","type":"text"},{"text":"before the stack does.","type":"text"}],"type":"paragraph"}]}]}]}],"sections":[],"variants":[{"paths":["\/documentation\/gnustotestsupport\/expecttrap(_:says:sourcelocation:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/GnustoTestSupport\/documentation\/GnustoTestSupport"]]},"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"expectTrap","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ExitTest","kind":"typeIdentifier","preciseIdentifier":"s: