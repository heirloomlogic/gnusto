{"hierarchy":{"paths":[["doc:\/\/GnustoTestSupport\/documentation\/GnustoTestSupport"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"expectTrap"},{"kind":"text","text":"("},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"result","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7Testing8ExitTestV","text":"ExitTest","kind":"typeIdentifier"},{"text":".","kind":"text"},{"kind":"typeIdentifier","text":"Result","preciseIdentifier":"s:7Testing8ExitTestV6ResultV"},{"text":"?, ","kind":"text"},{"text":"says","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"needles","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"..., ","kind":"text"},{"text":"sourceLocation","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"SourceLocation","preciseIdentifier":"s:7Testing14SourceLocationV"},{"text":" = #_sourceLocation)","kind":"text"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The exit test’s result — the value "},{"type":"codeVoice","code":"#expect(processExitsWith:)"},{"text":" ","type":"text"},{"type":"text","text":"returns, which must have been asked to observe "},{"type":"codeVoice","code":"standardErrorContent"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"result"},{"content":[{"inlineContent":[{"text":"The fragments the trap’s message must contain, in any order.","type":"text"}],"type":"paragraph"}],"name":"needles"},{"content":[{"inlineContent":[{"text":"The caller’s source location, for issue reporting.","type":"text"}],"type":"paragraph"}],"name":"sourceLocation"}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"inlineContent":[{"text":"The engine answers an authoring mistake with a ","type":"text"},{"type":"codeVoice","code":"fatalError"},{"text":" naming the","type":"text"},{"text":" ","type":"text"},{"text":"mistake — a ","type":"text"},{"type":"codeVoice","code":"describe { }"},{"type":"text","text":" closure that calls back into the describer"},{"type":"text","text":" "},{"type":"text","text":"running it, "},{"type":"codeVoice","code":"proceed()"},{"type":"text","text":" from an "},{"type":"codeVoice","code":"after"},{"type":"text","text":" rule, "},{"type":"codeVoice","code":"startFuse"},{"type":"text","text":" naming a daemon."},{"type":"text","text":" "},{"type":"text","text":"A "},{"type":"codeVoice","code":"fatalError"},{"type":"text","text":" cannot be caught, so the only way to assert on one is to run"},{"text":" ","type":"text"},{"text":"it in a child process and read what it printed. Swift Testing’s exit tests","type":"text"},{"text":" ","type":"text"},{"text":"do the running; this does the reading:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let result = await #expect(processExitsWith: .failure, observing: [\\.standardErrorContent]) {","    _ = try await play(ProceedMisuseGame(), [\"take wrench\"])","}","expectTrap(result, says: \"proceed() was called twice\")"]},{"inlineContent":[{"text":"A trap test fails in two very different ways and the message says which:","type":"text"},{"text":" ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"nothing on stderr"}]},{"text":" means the process died before it could print, and","type":"text"},{"text":" ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"a different message"}]},{"text":" means the trap fired with the wrong wording.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"What it costs, and when to spend it."}]},{"text":" Each call is a child process — some","type":"text"},{"text":" ","type":"text"},{"text":"60 ms, against 1 ms for an in-process assertion. This is the decision point,","type":"text"},{"text":" ","type":"text"},{"text":"so the rule lives here and ","type":"text"},{"type":"codeVoice","code":"TestingYourGame.md"},{"text":" points at it. A trap wants","type":"text"},{"text":" ","type":"text"},{"text":"one of three shapes, in the order they are worth reaching for; only the last","type":"text"},{"text":" ","type":"text"},{"text":"of them is this function:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Make the bad message unrepresentable, and write no test at all."}]},{"type":"text","text":" Where"},{"type":"text","text":" "},{"type":"text","text":"a group of traps shares a sentence, fold them into one helper that derives"},{"type":"text","text":" "},{"type":"text","text":"the whole of it — or at least takes the missing half as a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"required"}]},{"type":"text","text":" "},{"type":"text","text":"argument — so the next call site cannot omit or contradict it. Where a"},{"type":"text","text":" "},{"type":"text","text":"trap guards an argument no caller could sensibly mean, change the"},{"type":"text","text":" "},{"type":"text","text":"signature so the compiler refuses it. "},{"type":"codeVoice","code":"HolderTrait"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"declaredFuse(_:in:else:)"},{"type":"text","text":" are the first; "},{"type":"codeVoice","code":"oneOf(_:_:)"},{"type":"text","text":" is the second."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"A pure function, asserted in process"}]},{"type":"text","text":", for an ordinary precondition, or"},{"type":"text","text":" "},{"type":"text","text":"one whose message has branches worth checking apiece. Split the message"},{"type":"text","text":" "},{"type":"text","text":"out and test it at a millisecond — the shape "},{"type":"codeVoice","code":"Reentry.diagnostic(depth:entity:)"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"TraitKey.diagnostic(for:of:)"},{"type":"text","text":" use."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"An exit test"}]},{"type":"text","text":" — this function — where the trap’s "},{"type":"emphasis","inlineContent":[{"type":"text","text":"wording"}]},{"type":"text","text":" is what an"},{"type":"text","text":" "},{"type":"text","text":"author will read to find their mistake and no pure function can stand in"},{"type":"text","text":" "},{"type":"text","text":"for the run, or where a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"margin"}]},{"type":"text","text":" only a real run can measure is at stake."},{"type":"text","text":" "},{"type":"text","text":"An entity built inside a rule body; "},{"type":"codeVoice","code":"command"},{"type":"text","text":" read on the opening look; a"},{"type":"text","text":" "},{"type":"text","text":"scoring register the award table does not list; a cap that has to fire"},{"type":"text","text":" "},{"type":"text","text":"before the stack does."}]}]}],"type":"orderedList"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"paths":["\/documentation\/gnustotestsupport\/expecttrap(_:says:sourcelocation:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GnustoTestSupport\/documentation\/GnustoTestSupport\/expectTrap(_:says:sourceLocation:)"},"abstract":[{"text":"Checks the message a deliberately-crashed game printed on its way out.","type":"text"}],"sections":[],"metadata":{"modules":[{"name":"GnustoTestSupport"}],"externalID":"s:17GnustoTestSupport10expectTrap_4says14sourceLocationy7Testing04ExitB0V6ResultVSg_SSdAE06SourceH0VtF","