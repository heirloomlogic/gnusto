"},{"text":" rule, ","type":"text"},{"code":"startFuse","type":"codeVoice"},{"text":" naming a daemon.","type":"text"},{"text":" ","type":"text"},{"text":"A ","type":"text"},{"code":"fatalError","type":"codeVoice"},{"text":" cannot be caught, so the only way to assert on one is to run","type":"text"},{"text":" ","type":"text"},{"text":"it in a child process and read what it printed. Swift Testing’s exit tests","type":"text"},{"text":" ","type":"text"},{"text":"do the running; this does the reading:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let result = await #expect(processExitsWith: .failure, observing: [\\.standardErrorContent]) {","    _ = try await play(ProceedMisuseGame(), [\"take wrench\"])","}","expectTrap(result, says: \"proceed() was called twice\")"]},{"inlineContent":[{"text":"A trap test fails in two very different ways and the message says which:","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"nothing on stderr","type":"text"}],"type":"strong"},{"text":" means no diagnostic was captured (an optimized","type":"text"},{"text":" ","type":"text"},{"code":"precondition","type":"codeVoice"},{"text":" can trap without printing), and","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"a different message","type":"text"}],"type":"strong"},{"text":" means the trap fired with the wrong wording.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"What it costs, and when to spend it.","type":"text"}],"type":"strong"},{"text":" Each call is a child process — some","type":"text"},{"text":" ","type":"text"},{"text":"60 ms, against 1 ms for an in-process assertion. This is the decision point,","type":"text"},{"text":" ","type":"text"},{"text":"so the rule lives here and ","type":"text"},{"code":"TestingYourGame.md","type":"codeVoice"},{"text":" points at it. A trap wants","type":"text"},{"text":" ","type":"text"},{"text":"one of three shapes, in the order they are worth reaching for; only the last","type":"text"},{"text":" ","type":"text"},{"text":"of them is this function:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Make the bad message unrepresentable, and write no test at all."}],"type":"strong"},{"text":" Where","type":"text"},{"text":" ","type":"text"},{"text":"a group of traps shares a sentence, fold them into one helper that derives","type":"text"},{"text":" ","type":"text"},{"text":"the whole of it — or at least takes the missing half as a ","type":"text"},{"inlineContent":[{"type":"text","text":"required"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"argument — so the next call site cannot omit or contradict it. Where a","type":"text"},{"text":" ","type":"text"},{"text":"trap guards an argument no caller could sensibly mean, change the","type":"text"},{"text":" ","type":"text"},{"text":"signature so the compiler refuses it. ","type":"text"},{"type":"codeVoice","code":"HolderTrait"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"declaredFuse(_:in:else:)"},{"text":" are the first; ","type":"text"},{"type":"codeVoice","code":"oneOf(_:_:)"},{"text":" is the second.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"A pure function, asserted in process"}],"type":"strong"},{"text":", for an ordinary precondition, or","type":"text"},{"text":" ","type":"text"},{"text":"one whose message has branches worth checking apiece. Split the message","type":"text"},{"text":" ","type":"text"},{"text":"out and test it at a millisecond — the shape ","type":"text"},{"type":"codeVoice","code":"Reentry.diagnostic(depth:entity:)"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"type":"codeVoice","code":"TraitKey.diagnostic(for:of:)"},{"text":" use.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"An exit test"}],"type":"strong"},{"text":" — this function — where the trap’s ","type":"text"},{"inlineContent":[{"type":"text","text":"wording"}],"type":"emphasis"},{"text":" is what an","type":"text"},{"text":" ","type":"text"},{"text":"author will read to find their mistake and no pure function can stand in","type":"text"},{"text":" ","type":"text"},{"text":"for the run, or where a ","type":"text"},{"inlineContent":[{"type":"text","text":"margin"}],"type":"emphasis"},{"text":" only a real run can measure is at stake.","type":"text"},{"text":" ","type":"text"},{"text":"An entity built inside a rule body; ","type":"text"},{"type":"codeVoice","code":"command"},{"text":" read on the opening look; a","type":"text"},{"text":" ","type":"text"},{"text":"scoring register the award table does not list; a cap that has to fire","type":"text"},{"text":" ","type":"text"},{"text":"before the stack does.","type":"text"}]}]}],"type":"orderedList"}]}],"references":{"doc://GnustoTestSupport/documentation/GnustoTestSupport":{"title":"GnustoTestSupport","role":"collection","kind":"symbol","abstract":[{"type":"text","text":"Boot a game, feed it the commands a player would type, and assert on what it printed."}],"identifier":"doc:\/\/GnustoTestSupport\/documentation\/GnustoTestSupport","url":"\/documentation\/gnustotestsupport","type":"topic"},"doc://GnustoTestSupport/documentation/GnustoTestSupport/expectTrap(_:says:sourceLocation:)":{"title":"expectTrap(_:says:sourceLocation:)","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"expectTrap"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:7Testing8ExitTestV","text":"ExitTest"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:7Testing8ExitTestV6ResultV","text":"Result"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"says"},{"kind":"text","text":": "},{"kind":