{"identifier":{"url":"doc:\/\/GnustoTestSupport\/documentation\/GnustoTestSupport\/engineVoicedStubLines(in:)","interfaceLanguage":"swift"},"sections":[],"abstract":[{"text":"Every stub-verb line a game still answers in the engine’s voice, by property","type":"text"},{"text":" ","type":"text"},{"text":"name.","type":"text"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GnustoTestSupport\/documentation\/GnustoTestSupport"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnustotestsupport\/enginevoicedstublines(in:)"]}],"metadata":{"roleHeading":"Function","symbolKind":"func","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"engineVoicedStubLines","kind":"identifier"},{"text":"(","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"GameText","preciseIdentifier":"s:6Gnusto8GameTextV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"StubReplies","preciseIdentifier":"s:6Gnusto8GameTextV11StubRepliesV","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"externalID":"s:17GnustoTestSupport21engineVoicedStubLines2inSaySSG0A08GameTextV0F7RepliesV_tF","modules":[{"name":"GnustoTestSupport"}],"role":"symbol","title":"engineVoicedStubLines(in:)"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"engineVoicedStubLines","kind":"identifier"},{"text":"(","kind":"text"},{"text":"in","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"ours","kind":"internalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText","text":"GameText","preciseIdentifier":"s:6Gnusto8GameTextV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText\/StubReplies","text":"StubReplies","preciseIdentifier":"s:6Gnusto8GameTextV11StubRepliesV"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"]"}],"languages":["swift"]}]},{"parameters":[{"name":"ours","content":[{"inlineContent":[{"text":"The game’s ","type":"text"},{"code":"text.stubs","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The property names still identical to the engine’s wording."}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"A game that gives itself a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"stub floor"}]},{"text":" — ","type":"text"},{"code":"text.stubs","type":"codeVoice"},{"text":", rather than an","type":"text"},{"text":" ","type":"text"},{"code":"action(…)","type":"codeVoice"},{"text":" row per verb — is claiming every stub line, and the claim is","type":"text"},{"text":" ","type":"text"},{"text":"easy to half-keep: one line left unassigned means a plain modern narrator takes","type":"text"},{"text":" ","type":"text"},{"text":"over on the turn after a re-voiced one, which is exactly the defect the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Dungeon and Zork 1 floors were written to close. Naming each verb in a test"},{"type":"text","text":" "},{"type":"text","text":"catches that; it does not catch a "},{"inlineContent":[{"text":"new","type":"text"}],"type":"emphasis"},{"text":" stub arriving in the engine","type":"text"},{"text":" ","type":"text"},{"text":"tomorrow, which would slip past every named assertion at once.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"So this reads the properties off ","type":"text"},{"type":"codeVoice","code":"GameText.StubReplies"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"Mirror"},{"text":" ","type":"text"},{"text":"rather than listing them: every line the engine actually ships is compared,","type":"text"},{"text":" ","type":"text"},{"text":"and one added tomorrow is compared the day it lands. A property whose type","type":"text"},{"text":" ","type":"text"},{"text":"this cannot render is reported as its own issue rather than skipped, which is","type":"text"},{"text":" ","type":"text"},{"text":"what keeps “reflected” from quietly meaning “unchecked”.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"That last sentence has no exception to it as of #246. "},{"type":"codeVoice","code":"give"},{"type":"text","text":" used to be one:"},{"type":"text","text":" "},{"type":"text","text":"the one line about two objects, so not a "},{"type":"codeVoice","code":"GameText.Line"},{"type":"text","text":", so unreachable by"},{"type":"text","text":" "},{"type":"text","text":"reflection and compared by hand below the loop — the single line in here that"},{"type":"text","text":" "},{"type":"text","text":"could change shape without the sweep noticing. It takes a "},{"type":"codeVoice","code":"GameText.Gift"},{"type":"text","text":" "},{"type":"text","text":"now, and goes through the same door as the other stub lines."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Which sentences each line prints is the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"subject’s"}]},{"text":" business as of #255:","type":"text"},{"text":" ","type":"text"},{"code":"LineSubject.samples(one:many:)","type":"codeVoice"},{"text":" supplies them, so a subject arriving","type":"text"},{"text":" ","type":"text"},{"text":"tomorrow is swept the day it lands rather than after somebody teaches a","type":"text"},{"text":" ","type":"text"},{"text":"switch here about it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"It is split out from ","type":"text"},{"type":"reference","identifier":"doc:\/\/GnustoTestSupport\/documentation\/GnustoTestSupport\/expectNoEngineStubLineSurvives(in:game:sourceLocation:)","isActive":true},{"text":" ","type":"text"},{"text":"so the sweep can be tested for being ","type":"text"},{"inlineContent":[{"text":"alive","type":"text"}],"type":"emphasis"},{"text":": a reflection loop that matches","type":"text"},{"text":" ","type":"text"},{"text":"nothing passes silently, where one asserted to see every line cannot.","type":"text"}]}]}],"seeAlsoSections":[{"anchor":"Asserting","generated":true,"title":"Asserting","identifiers":["doc:\/\/GnustoTestSupport\/documentation\/GnustoTestSupport\/expectInOrder(_:_:sourceLocation:)","doc:\/\/GnustoTestSupport\/documentation\/GnustoTestSupport\/expectEveryNounAnswered(_:_:sourceLocation:)","doc:\/\/GnustoTestSupport\/documentation\/GnustoTestSupport\/expectNoAmbiguity(_:_:sourceLocation:)","doc:\/\/GnustoTestSupport\/documentation\/GnustoTestSupport\/expectNoEngineStubLineSurvives(in:game:sourceLocation:)"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://GnustoTestSupport/documentation/GnustoTestSupport":{"role":"collection","title":"GnustoTestSupport","url":"\/documentation\/gnustotestsupport","abstract":[{"type":"text","text":"Boot a game, feed it the commands a player would type, and assert on what it printed."}],"type":"topic","identifier":"doc:\/\/GnustoTestSupport\/documentation\/GnustoTestSupport","kind":"symbol"},"doc://Gnusto/documentation/Gnusto/GameText":{"role":"symbol","title":"GameText","url":"\/documentation\/gnusto\/gametext","abstract":[{"text":"Every stock player-facing line the engine can say, as one overridable","type":"text"},{"text":" ","type":"text"},{"text":"value — so a game can speak in its own voice without touching behavior.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GameText"}],"type":"topic","identifier":"doc:\/\/Gnusto\/documentation\/Gnusto\/GameText","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"GameText"}]},"doc://GnustoTestSupport/documentation/GnustoTestSupport/expectEveryNounAnswered(_:_:sourceLocation:)":{"role":"symbol","title":"expectEveryNounAnswered(_:_:sourceLocation:)","url":"\/documentation\/gnustotestsupport\/expecteverynounanswered(_:_:sourcelocation:)","abstract":[{"type":"text","text":"Records a Swift Testing issue if the transcript contains either answer a"},{"type":"text","text":" "},{"type":"text","text":"game gives to a noun it doesn’t know: "},{"type":"codeVoice","code":"I don't know the word \"x\""},{"type":"text","text":" for a word"},{"type":"text","text":" "},{"type":"text","text":"outside the vocabulary, and "},{"type":"codeVoice","code":"You can't see any such thing"},{"type":"text","text":" for a word the"},{"type":"text","text":" "},{"type":"text","text":"parser knows only as an adjective, or for a thing that isn’t in scope."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"expectEveryNounAnswered"},{"kind":"text","text":"("},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"sourceLocation"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7Testing14SourceLocationV","kind":"typeIdentifier","text":"SourceLocation"},{"kind":"text","text":")"}],"type":"topic","identifier":"doc:\/\/GnustoTestSupport\/documentation\/GnustoTestSupport\/expectEveryNounAnswered(_:_:sourceLocation:)","kind":"symbol"},"doc://GnustoTestSupport/documentation/GnustoTestSupport/engineVoicedStubLines(in:)":{"identifier":"doc:\/\/GnustoTestSupport\/documentation\/GnustoTestSupport\/engineVoicedStubLines(in:)","abstract":[{"type":"text","text":"Every stub-verb line a gam