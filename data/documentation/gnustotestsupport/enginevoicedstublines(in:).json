:"text"},{"text":" ","type":"text"},{"text":"Dungeon and Zork 1 floors were written to close. Naming each verb in a test","type":"text"},{"text":" ","type":"text"},{"text":"catches that; it does not catch a ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"new","type":"text"}]},{"text":" stub arriving in the engine","type":"text"},{"text":" ","type":"text"},{"text":"tomorrow, which would slip past every named assertion at once.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"So this reads the properties off ","type":"text"},{"type":"codeVoice","code":"GameText.StubReplies"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"Mirror"},{"text":" ","type":"text"},{"text":"rather than listing them: every line the engine actually ships is compared,","type":"text"},{"text":" ","type":"text"},{"text":"and one added tomorrow is compared the day it lands. A property whose type","type":"text"},{"text":" ","type":"text"},{"text":"this cannot render is reported as its own issue rather than skipped, which is","type":"text"},{"text":" ","type":"text"},{"text":"what keeps “reflected” from quietly meaning “unchecked”.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"That last sentence has no exception to it as of #246. ","type":"text"},{"type":"codeVoice","code":"give"},{"text":" used to be one:","type":"text"},{"text":" ","type":"text"},{"text":"the one line about two objects, so not a ","type":"text"},{"type":"codeVoice","code":"GameText.Line"},{"text":", so unreachable by","type":"text"},{"text":" ","type":"text"},{"text":"reflection and compared by hand below the loop — the single line in here that","type":"text"},{"text":" ","type":"text"},{"text":"could change shape without the sweep noticing. It takes a ","type":"text"},{"type":"codeVoice","code":"GameText.Gift"},{"text":" ","type":"text"},{"text":"now, and goes through the same door as the other stub lines.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Which sentences each line prints is the ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"subject’s","type":"text"}]},{"text":" business as of #255:","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"LineSubject.samples(one:many:)"},{"text":" supplies them, so a subject arriving","type":"text"},{"text":" ","type":"text"},{"text":"tomorrow is swept the day it lands rather than after somebody teaches a","type":"text"},{"text":" ","type":"text"},{"text":"switch here about it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"It is split out from ","type":"text"},{"type":"reference","identifier":"doc:\/\/GnustoTestSupport\/documentation\/GnustoTestSupport\/expectNoEngineStubLineSurvives(in:game:sourceLocation:)","isActive":true},{"text":" ","type":"text"},{"text":"so the sweep can be tested for being ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"alive","type":"text"}]},{"text":": a reflection loop that matches","type":"text"},{"text":" ","type":"text"},{"text":"nothing passes silently, where one asserted to see every line cannot.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://GnustoTestSupport/documentation/GnustoTestSupport/expectInOrder(_:_:sourceLocation:)":{"title":"expectInOrder(_:_:sourceLocation:)","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"expectInOrder"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", ["},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"sourceLocation"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"SourceLocation","preciseIdentifier":"s:7Testing14SourceLocationV"},{"kind":"text","text":")"}],"abstract":[{"text":"Records one Swift Testing issue (at the caller’s source location) if the","type":"text"},{