{"sections":[],"metadata":{"modules":[{"name":"GnustoDangerousDark"}],"title":"GnustoDangerousDark","externalID":"GnustoDangerousDark","roleHeading":"Framework","symbolKind":"module","role":"collection"},"variants":[{"paths":["\/documentation\/gnustodangerousdark"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[[]]},"topicSections":[{"identifiers":["doc:\/\/GnustoDangerousDark\/documentation\/GnustoDangerousDark\/DangerousDark","doc:\/\/GnustoDangerousDark\/documentation\/GnustoDangerousDark\/DangerousDark\/init(warning:death:graceTurns:lethality:)"],"title":"The content bundle","anchor":"The-content-bundle"},{"identifiers":["doc:\/\/GnustoDangerousDark\/documentation\/GnustoDangerousDark\/DangerousDark\/suspended"],"anchor":"Turning-the-dark-off-and-on","title":"Turning the dark off and on"},{"anchor":"The-daemon","identifiers":["doc:\/\/GnustoDangerousDark\/documentation\/GnustoDangerousDark\/DangerousDark\/timers"],"title":"The daemon"}],"identifier":{"url":"doc:\/\/GnustoDangerousDark\/documentation\/GnustoDangerousDark","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Darkness that kills: a warning, a grace period, then dice."}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"The engine’s own darkness is a description problem. A dark room prints “It is","type":"text"},{"text":" ","type":"text"},{"text":"pitch black. You can’t see a thing.”, its contents stop being resolvable nouns,","type":"text"},{"text":" ","type":"text"},{"text":"and the player is inconvenienced. They can stand there for a hundred turns.","type":"text"},{"text":" ","type":"text"},{"text":"This library supplies the consequence, on the schedule the original used.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/GnustoDangerousDark\/documentation\/GnustoDangerousDark\/DangerousDark","isActive":true,"type":"reference"},{"text":" is a ","type":"text"},{"code":"GameContent","type":"codeVoice"},{"text":" bundle with no rooms in it — one namespaced","type":"text"},{"text":" ","type":"text"},{"text":"counter, one daemon, four knobs on ","type":"text"},{"code":"init","type":"codeVoice"},{"text":". Wiring is a single line: list the","type":"text"},{"text":" ","type":"text"},{"text":"instance in the game’s ","type":"text"},{"code":"content","type":"codeVoice"},{"text":" block. It reads ","type":"text"},{"code":"player.location.isLit","type":"codeVoice"},{"text":", which","type":"text"},{"text":" ","type":"text"},{"text":"already answers the whole question of whether there is light here from anything,","type":"text"},{"text":" ","type":"text"},{"text":"so a host that has declared its dark rooms and a lamp has declared everything","type":"text"},{"text":" ","type":"text"},{"text":"this needs. The schedule is settled at ","type":"text"},{"type":"codeVoice","code":"init"},{"text":", and so is the prose — with one","type":"text"},{"text":" ","type":"text"},{"text":"subject passed at the moment it is spoken: the death line is handed the vehicle","type":"text"},{"text":" ","type":"text"},{"text":"the player was aboard, because a sentence about being found has to say where.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The daemon counts consecutive turns "},{"type":"emphasis","inlineContent":[{"type":"text","text":"ending"}]},{"type":"text","text":" in darkness, wherever they are"},{"text":" ","type":"text"},{"text":"spent. Lingering is lethal and movement is not, so a lightless dash toward the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"stairs can still work. Any reachable light resets the count to zero. Dark turn 1"},{"type":"text","text":" "},{"type":"text","text":"prints the warning; dark turns 2 through "},{"type":"codeVoice","code":"graceTurns + 1"},{"type":"text","text":" are a silent grace;"},{"type":"text","text":" "},{"type":"text","text":"from dark turn "},{"code":"graceTurns + 2","type":"codeVoice"},{"type":"text","text":" on, every turn rolls "},{"type":"codeVoice","code":"chance(lethality)"},{"type":"text","text":" to be"},{"type":"text","text":" "},{"text":"eaten. The warning turn is always safe, which is the classic fairness contract:","type":"text"},{"text":" ","type":"text"},{"text":"a player who UNDOes a death gets the warning beat back before the dice can turn","type":"text"},{"text":" ","type":"text"},{"text":"on them again.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Two instances in one game collide on their shared ","type":"text"},{"type":"codeVoice","code":"@Global"},{"text":" namespace before the","type":"text"},{"text":" ","type":"text"},{"text":"timer name matters. One lethal dark per game.","type":"text"}]},{"type":"heading","anchor":"Wiring","level":2,"text":"Wiring"},{"type":"codeListing","syntax":"swift","code":["import Gnusto","import GnustoDangerousDark","","struct Deeps: Game {","    let title = \"Deeps\"","","    let dark = DangerousDark()   \/\/ stock prose, one turn of grace, 50% a turn","","    var content: GameContents { dark }","","    var map: WorldMap { … }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A game with its own voice for the dark passes all four:"}]},{"type":"codeListing","syntax":"swift","code":["let dark = DangerousDark(","    warning: Prose.grueWarning,","    death: Prose.grueDeath,","    graceTurns: 1,","    lethality: 50)"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"death"},{"type":"text","text":" takes a subject where the other three lines do not: the "},{"inlineContent":[{"text":"vehicle the","type":"text"},{"text":" ","type":"text"},{"text":"player was aboard","type":"text"}],"type":"strong"},{"type":"text","text":", or nothing when they were on their own feet. Write both"},{"type":"text","text":" "},{"type":"text","text":"halves with "},{"type":"codeVoice","code":".naming(orBare:)"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["static let grueDeath = GameText.Line<GameText.Noun?>.naming(","    orBare: \"…the room…\"",") {","    \"…\\($0)…\"","}"]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"The death this daemon deals is always the lingering one"}]},{"text":", and the line has to","type":"text"},{"text":" ","type":"text"},{"text":"be true of that. The counter cannot reach the dice before the third dark turn, so","type":"text"},{"text":" ","type":"text"},{"text":"nothing it kills was killed on the turn it walked into the dark. Zork draws the","type":"text"},{"text":" ","type":"text"},{"text":"distinction with two separate sentences and this is the second of them: ","type":"text"},{"type":"codeVoice","code":"V-WALK"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"gverbs.zil:1578"},{"type":"text","text":") says "},{"inlineContent":[{"type":"text","text":"“You have walked into the slavering fangs of a lurking"},{"type":"text","text":" "},{"type":"text","text":"grue!”"}],"type":"emphasis"},{"type":"text","text":" and fires only on a "},{"inlineContent":[{"text":"blocked","type":"text"}],"type":"strong"},{"type":"text","text":" move in the dark, which is a branch this"},{"type":"text","text":" "},{"type":"text","text":"library does not have; "},{"code":"GOTO","type":"codeVoice"},{"type":"text","text":" ("},{"code":":2110-2114","type":"codeVoice"},{"text":") names the vehicle you are sitting in,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"or says “room”. Both halves are the game’s words — the stock line names no place"},{"type":"text","text":" "},{"type":"text","text":"at all, because a library that has not seen the game should not decide what to"},{"type":"text","text":" "},{"type":"text","text":"call the place somebody was taken from."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"warning"},{"type":"text","text":" is said "},{"type":"emphasis","inlineContent":[{"type":"text","text":"once"}]},{"type":"text","text":" per turn, through the engine’s "},{"type":"codeVoice","code":"sayOnceThisTurn(_:)"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"A game that also points "},{"type":"codeVoice","code":"text.pitchBlack"},{"type":"text","text":" at the same sentence — Zork does,"},{"text":" ","type":"text"},{"text":"because there the dark-room line ","type":"text"},{"inlineContent":[{"type":"text","text":"is"}],"type":"emphasis"},{"type":"text","text":" the threat — reads it a single time on the"},{"text":" ","type":"text"},{"text":"turn it walks into the dark, whichever speaker got there first. Two different","type":"text"},{"text":" ","type":"text"},{"text":"sentences are two different sentences, and both print. A warning swallowed for","type":"text"},{"type":"text","text":" "},{"type":"text","text":"repeating the room’s own line is still a warned turn."}]},{"level":2,"anchor":"Making-the-dark-harmless","type":"heading","text":"Making the dark harmless"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For a room whose solution is to stand in the dark on purpose, or a scene that"},{"type":"text","text":" "},{"type":"text","text":"should not be interrupted, set "},{"type":"reference","identifier":"doc:\/\/GnustoDangerousDark\/documentation\/GnustoDangerousDark\/DangerousDark\/suspended","isActive":true},{"type":"text","text":":"}]},{"type":"codeListing","code":["cryptDoor.after(.close) { dark.suspended = true }","cryptDoor.after(.open) { dark.suspended = false }"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Do not stop the daemon by name.","type":"text"}],"type":"strong"},{"type":"text","text":" It is called "},{"type":"codeVoice","code":"\"grue\""},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"stopDaemon(\"grue\")"},{"type":"text","text":" freezes the counter at whatever it had reached, so resuming"},{"text":" ","type":"text"},{"type":"text","text":"can put the player straight onto a dice turn and cost them the warning."},{"text":" ","type":"text"},{"text":"Suspending resets the count on every suspended turn, for exactly that reason, and","type":"text"},{"text":" ","type":"text"},{"text":"draws no randomness while it is set.","type":"text"}]},{"type":"heading","level":2,"text":"Worked example","anchor":"Worked-example"},{"type":"paragraph","inlineContent":[{"code":"Sources\/Zork1\/","type":"codeVoice"},{"text":" wires this over the engine’s own light mechanics — the brass","type":"text"},{"text":" ","type":"text"},{"text":"lantern is a ","type":"text"},{"code":"lightSource","type":"codeVoice"},{"text":" on two fuses, and the grue is what makes the fuses","type":"text"},{"text":" ","type":"text"},{"text":"matter. The engine’s side of it (the ","type":"text"},{"code":"dark","type":"codeVoice"},{"text":" trait, ","type":"text"},{"code":"lightSource","type":"codeVoice"},{"type":"text","text":", what counts as"},{"type":"text","text":" "},{"type":"text","text":"light reaching a room, "},{"type":"codeVoice","code":"die(_:)"},{"type":"text","text":" and the resurrection hook) is the "},{"type":"emphasis","inlineContent":[{"text":"Darkness,","type":"text"},{"text":" ","type":"text"},{"text":"Time, and Death","type":"text"}]},{"type":"text","text":" article in the "},{"code":"Gnusto","type":"codeVoice"},{"type":"text","text":" documentation."}]}],"kind":"content"}],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://GnustoDangerousDark/documentation/GnustoDangerousDark/DangerousDark/suspended":{"url":"\/documentation\/gnustodangerousdark\/dangerousdark\/suspended","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"suspended"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"role":"symbol","title":"suspended","identifier":"doc:\/\/GnustoDangerousDark\/documentation\/GnustoDangerousDark\/DangerousDark\/suspended","abstract":[{"type":"text","text":"Set while the dark is harmless: the grue idles, draws no randomness,"},{"type":"text","text":" "},{"type":"text","text":"and — because the count resets on every suspended turn — resuming"},{"type":"text","text":" "},{"type":"text","text":"always begins again at the warning."}]},"doc://GnustoDangerousDark/documentation/GnustoDangerousDark":{"title":"GnustoDangerousDark","role":"collection","abstract":[{"type":"text","text":"Darkness that kills: a warning, a grace period, then dice."}],"url":"\/documentation\/gnustodangerousdark","identifier":"doc:\/\/GnustoDangerousDark\/documentation\/GnustoDangerousDark","kind":"symbol","type":"topic"},"doc://GnustoDangerousDark/documentation/GnustoDangerousDark/DangerousDark":{"title":"DangerousDark","url":"\/documentation\/gnustodangerousdark\/dangerousdark","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DangerousDark"}],"type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"DangerousDark"}],"abstract":[{"text":"Darkness that kills: a warning on the first consecutive turn the player","type":"text"},{"text":" ","type":"text"},{"text":"ends in the dark, a configurable grace period, then death. Add it to a","type":"text"},{"text":" ","type":"text"},{"text":"game’s ","type":"text"},{"type":"codeVoice","code":"content"},{"text":" block; there is nothing else to wire:","type":"text"}],"kind":"symbol","identifier":"doc:\/\/GnustoDangerousDark\/documentation\/GnustoDangerousDark\/DangerousDark"},"doc://GnustoDangerousDark/documentation/GnustoDangerousDark/DangerousDark/timers":{"title":"timers","role":"symbol","url":"\/documentation\/gnustodangerousdark\/dangerousdark\/timers","kind":"symbol","identifier":"doc:\/\/GnustoDangerousDark\/documentation\/GnustoDangerousDark\/DangerousDark\/timers","abstract":[{"type":"text","text":"The grue daemon: each dark turn ticks the counter. The warning prints on"},{"type":"text","text":" "},{"type":"text","text":"the first dark turn; dark turns 2…"},{"type":"codeVoice","code":"graceTurns + 1"},{"type":"text","text":" are a silent grace;"},{"type":"text","text":" "},{"type":"text","text":"from dark turn "},{"type":"codeVoice","code":"graceTurns + 2"},{"type":"text","text":" on, each turn rolls "},{"type":"codeVoice","code":"chance(lethality)"},{"type":"text","text":" "},{"type":"text","text":"to be eaten. Stepping back into the light — or "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GnustoDangerousDark\/documentation\/GnustoDangerousDark\/DangerousDark\/suspended"},{"type":"text","text":" — resets the"},{"type":"text","text":" "},{"type":"text","text":"count. Guards before the draw, so a lit turn burns no randomness."}],"type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"timers"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto10TimedEventV","text":"TimedEvent"},{"kind":"text","text":"]"}]},"doc://GnustoDangerousDark/documentation/GnustoDangerousDark/DangerousDark/init(warning:death:graceTurns:lethality:)":{"url":"\/documentation\/gnustodangerousdark\/dangerousdark\/init(warning:death:graceturns:lethality:)","type":"topic","kind":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"warning"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"kind":"text","text":", "},{"kind":"externalParam","text":"death"},{"text":": ","kind":"text"},{"text":"GameText","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto8GameTextV"},{"text":".","kind":"text"},{"text":"Line","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto8GameTextV4LineV"},{"text":"<","kind":"text"},{"text":"GameText","kind":"typeIdentifier","preciseIdentifier":"s:6Gnusto8GameTextV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Noun","preciseIdentifier":"s:6Gnusto8GameTextV4NounV"},{"kind":"text","text":"?>, "},{"kind":"externalParam","text":"graceTurns"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"text":", ","kind":"text"},{"text":"lethality","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":")","kind":"text"}],"role":"symbol","title":"init(warning:death:graceTurns:lethality:)","identifier":"doc:\/\/GnustoDangerousDark\/documentation\/GnustoDangerousDark\/DangerousDark\/init(warning:death:graceTurns:lethality:)","abstract":[]}}}