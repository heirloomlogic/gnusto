{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "MCP_TIMEOUT": "180000",
    "CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS": "0"
  },
  "enabledMcpjsonServers": [
    "cloakofdarkness",
    "dungeon",
    "fulminate",
    "gramarye",
    "kindlydeep",
    "lighthouse",
    "zork1"
  ],
  "permissions": {
    "allow": [
      "Bash(bin/playtest-preflight:*)",
      "Bash(bin/playtest-replay:*)",
      "Bash(gh issue list:*)",
      "Bash(swift build:*)",
      "Bash(swift test:*)",
      "Bash(swift package describe)",
      "Bash(xcrun swift-format lint:*)",
      "mcp__cloakofdarkness",
      "mcp__dungeon",
      "mcp__fulminate",
      "mcp__gramarye",
      "mcp__kindlydeep",
      "mcp__lighthouse",
      "mcp__zork1",
      "Workflow",
      "Bash(bin/playtest-routes:*)"
    ],
    "ask": [
      "Bash(gh issue create:*)"
    ]
  }
}
