{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": [
    "cloakofdarkness",
    "dungeon",
    "fulminate",
    "gramarye",
    "kindlydeep",
    "lighthouse",
    "zork1"
  ],
  "permissions": {
    "allow": [
      "Bash(bin/playtest-replay:*)",
      "Bash(gh issue list:*)",
      "Bash(swift build:*)",
      "Bash(swift test:*)",
      "Bash(swift package describe)",
      "Bash(xcrun swift-format lint:*)"
    ],
    "ask": [
      "Bash(gh issue create:*)"
    ]
  }
}
