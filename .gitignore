.context/
# .claude/settings.json is tracked — it allowlists the play-test harness's own
# commands so a round doesn't stall on twenty permission prompts. Personal
# overrides belong in the local file, which is not.
.claude/settings.local.json
.dev-tooling
.DS_Store
.github/swift-format-matcher.json
.swift-format
.netrc
.swiftpm
/.build
/Packages
DerivedData/
# Package.resolved is not tracked for this package — dependencies resolve from
# the version ranges in Package.swift, and the dev-only tooling (docc, Persnicket)
# would otherwise churn it. The template resolves its own too.
/Package.resolved
Templates/NewGame/Package.resolved
xcuserdata/
.build
# Exported game binaries produced by bin/export-game.
/dist
